PORT=3000
NODE_ENV=development

# Database Configuration
DB_CLIENT=sqlite3
DB_FILENAME=./database/service_plus.db


# For MySQL (uncomment and configure as needed)
# DB_CLIENT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=service_plus
# DB_USER=your_username
# DB_PASSWORD=your_password

# Auth
# JWT_SECRET is REQUIRED in production (app refuses to start without it).
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=7

# CORS: comma-separated list of allowed browser origins.
# Defaults to local dev origins when unset.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# HTTPS (required in production)
# SSL_KEY_PATH=/path/to/privkey.pem
# SSL_CERT_PATH=/path/to/fullchain.pem

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Where uploaded files go. "local" (default) writes to express-be/uploads.
# "oci" stores them in OCI Object Storage; nothing touches local disk.
STORAGE_DRIVER=local

# Max upload size in MB (default 10)
# MAX_UPLOAD_MB=10

# --- OCI Object Storage (only needed when STORAGE_DRIVER=oci) ---
# Bucket to store objects in.
# OCI_BUCKET_NAME=your-bucket-name
# Object Storage namespace. Found under Bucket Details in the console.
# Looked up automatically if omitted, which costs one API call at startup.
# OCI_NAMESPACE=your-namespace
# Key prefix inside the bucket (default "uploads/")
# OCI_OBJECT_PREFIX=uploads/

# Auth option 1 — reuse an ~/.oci/config profile (easiest on a dev machine
# after running `oci setup config`).
# OCI_CONFIG_PROFILE=DEFAULT
# OCI_CONFIG_FILE=/home/you/.oci/config

# Auth option 2 — explicit credentials, better for deployed environments.
# OCI_REGION=ap-mumbai-1
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxx
# OCI_USER_OCID=ocid1.user.oc1..xxxx
# OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
# Either point at the key file...
# OCI_PRIVATE_KEY_PATH=/home/you/.oci/oci_api_key.pem
# ...or inline it (\n-escaped newlines are handled).
# OCI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OCI_PASSPHRASE=
