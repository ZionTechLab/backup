<Window x:Name="frmModulePermission1" 
        x:Class="SEACC_LOGIN.frmModulePermission"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
        xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_LOGIN" 
        mc:Ignorable="d"
        Title="SEACC Module Permission" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"  Background="{x:Null}"
        Width="800" Height="495">

    <Grid Margin="10">
        <Border Background="#FFDADADA" >
            <Border.Effect>
                <DropShadowEffect ShadowDepth="5" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="grdTitleBar" Grid.Row="0" MouseDown="grdTitleBar_MouseDown">
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF276699" Offset="0"/>
                        <GradientStop Color="#FF153854" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Label x:Name="lblTitleBar" Content=" SEACC Module Permissions"  FontSize="20" Foreground="White" FontWeight="Thin" />
                <Button x:Name="btnClose" Content="&#xE8BB;" VerticalAlignment="Top" HorizontalAlignment="Right" Width="30" Height="40" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Background="{x:Null}" BorderBrush="{x:Null}" Click="btnClose_Click" />
            </Grid>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="coloumnA" Width="400" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="chkSelectAll" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Select All" IsChecked="False"  Margin="0,0,0,410" Width="82" Checked="chkSelectAll_Checked" Unchecked="chkSelectAll_Unchecked" />
                <DataGrid x:Name="dgrModule" Margin="5,35,5,5" Background="White" Grid.Column="0"
                          RowHeaderWidth="0"
                          AlternatingRowBackground="#FFDADADA"
                          HorizontalGridLinesBrush="{x:Null}"
                          VerticalGridLinesBrush="{x:Null}"
                          IsReadOnly="False" AutoGenerateColumns="False"
                          CanUserAddRows="False" Height="395" Foreground="Black"  
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          CanUserResizeColumns="True" CanUserReorderColumns="False" VerticalAlignment="Top">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FF688CAF"/>
                    </DataGrid.Resources>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <Grid Background="{TemplateBinding Background}">
                                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="#" Width="30" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Module_Index ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Module Index" MaxWidth="0" IsReadOnly="False"/>
                        <DataGridTextColumn Binding="{Binding Module_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Module ID" Width="90" IsReadOnly="False"/>
                        <DataGridTextColumn Binding="{Binding Module_Name ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Module Name" Width="180" IsReadOnly="False"/>

                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                    <Setter Property="BorderBrush" Value="#FFE2E3E5"/>
                                    <Setter Property="BorderThickness" Value="0.5"/>
                                    <Setter Property="Content" Value="&#xE815;" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Background="#FF727272" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,5,0,10"  />

                <StackPanel Grid.Column="2" Margin="5,35,5,12" >
                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCompanyBranch" Caption="Company Branch" />
                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtUser" Caption="User Name" MouseDoubleClick="txtUser_MouseDoubleClick" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5,6,5,5" >
                        <Button x:Name="btnLoad" Content="Load" Width="100" Height="25" Margin="10" Click="btnLoad_Click" />
                        <Button x:Name="btnSave" Content="Save" Width="100" Height="25" Margin="10" Click="btnSave_Click" />
                    </StackPanel>
                </StackPanel>

            </Grid>



        </Grid>
    </Grid>
</Window>