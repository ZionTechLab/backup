<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" 
    xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" 
    xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
    x:Name="frmSearch1" x:Class="SEACC_Tender.Search_Forms.frmSearch" 
    Topmost="True" Height="429" Width="310" Loaded="frmSearch_Loaded" WindowStartupLocation="CenterScreen" Background="{x:Null}" AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid x:Name="frm_Search" Background="White" Margin="15">
        <Grid.Effect>
            <DropShadowEffect ShadowDepth="4" Opacity="0.8" BlurRadius="15"/>
        </Grid.Effect>
        <Grid Background="#FF009688"  MouseDown="Grid_MouseDown_1" Height="66" VerticalAlignment="Top">
            <SEACC_WPFControls1:SEACC_Button_Close x:Name="btn_Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" BorderBrush="#FFEC0000"/>
            <SEACC_WPFControls1:SEACC_Button x:Name="btn_Settings" Content="&#xE115;" FontFamily="Segoe MDL2 Assets" FontSize="12"  Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" Margin="0,0,22,0" Background="#7FFFFFFF" BorderBrush="{x:Null}" Click="btn_Settings_Click"/>

            <Label x:Name="lblHeader" Content="Label"  FontSize="18" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,5,5,5" />
            <Grid Background="White" Margin="10,35,10,5">
                <DockPanel>
                    <ComboBox x:Name="cbxSearch"  IsReadOnly="True" IsEditable="True" BorderBrush="{x:Null}" Margin="2" SelectionChanged="cbxSearch_SelectionChanged"/>
                    <TextBox x:Name="txtFillter"  KeyUp="txtFillter_KeyUp"  HorizontalAlignment="Stretch" BorderBrush="{x:Null}"  Margin="2"/>
                </DockPanel>
            </Grid>
        </Grid>


        <DataGrid x:Name="dgvSearch" Margin="10,71,10,10" IsReadOnly="True" CanUserResizeColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" AutoGenerateColumns="False" HorizontalGridLinesBrush="#FFA7C5C2" KeyUp="txtFillter_KeyUp" MouseLeftButtonUp="dgvSearch_MouseLeftButtonUp" Background="White" BorderBrush="White" GridLinesVisibility="Horizontal" LoadingRow="dgvSearch_LoadingRow">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#FFC1C1C1" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Padding" Value="3"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>
        <Grid Height="0" x:Name="Grd_Settings"  Margin="121,22,0,0" VerticalAlignment="Top" Background="#FFBFBFBF" >
            <Border BorderBrush="Black" BorderThickness="1">
                <CheckBox x:Name="cbx_ShowAll" Content="Show Hidden records" Margin="9,9,-9,81" Checked="cbx_ShowAll_Checked" Unchecked="cbx_ShowAll_Unchecked"/>

            </Border>
        </Grid>
    </Grid>
</Window>