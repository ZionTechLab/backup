<Window x:Class="SEACC_Tender.frm_MasCompetitor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" 
        xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        Title="frm_MasItem" WindowStartupLocation="CenterOwner" AllowsTransparency="True" Background="{x:Null}" WindowStyle="None" ShowInTaskbar="False" Height="450" Width="439">
    <Grid Margin="20" Background="White">
        <Grid.Effect>
            <DropShadowEffect ShadowDepth="10" Opacity="0.7" BlurRadius="10"/>
        </Grid.Effect>
        <Grid Margin="0,0,0,50" Grid.ColumnSpan="2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"  MouseLeftButtonDown="Grid_MouseLeftButtonDown" Background="#FF6A6A6A">
                <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" BorderBrush="#FFEC0000" Margin="0,5,5,0"/>
                <Label x:Name="lblHeader" Content="Competitor"  FontSize="18" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,5,5,5" Margin="10,2,10,5" />
            </Grid>

            <Grid Grid.Row="1" x:Name="Main" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="ColumnA" Width="390" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" Margin="0,10,0,0" HorizontalAlignment="Stretch" Grid.Column="1"  />

                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0" Margin="10,10,10,0" Background="#FFACACAC" HeaderColor="#FF6A6A6A"  Foreground="#FFA84242"/>

                <SEACC_WPFControls:SEACC_ScrollViewer Grid.Column="2" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
                    <Border BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <Grid Margin="0,20,0,0" >
                            <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close2" Content="&#xE012;" FontFamily="Segoe MDL2 Assets" FontSize="20" Click="btn_Close2_Click" Height="30" Width="30" HorizontalAlignment="Right"  VerticalAlignment="Top" BorderBrush="#FFEC0000" Margin="0,-5,0,0"/>
                            <StackPanel>
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Competitor Code" x:Name="txtCompetitor_code" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Competitor Name" x:Name="txtCompetitorname" KeyUp="txtCompetitorname_KeyUp" />
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCountry" Caption="Country" MouseDoubleClick="txtCountry_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCity" Caption="City" MouseDoubleClick="txtCity_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Remarks " x:Name="txtRemarks" Height="75" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                </SEACC_WPFControls:SEACC_ScrollViewer>

            </Grid>
        </Grid>
        <SEACC_WPFControls:SEACC_Button x:Name="btnOK" Content="OK" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Width="70" Margin="0,0,21,10" Height="25" BorderBrush="#FF9B9B9B" Foreground="White" Background="#FF41B1E1" BorderThickness="1" Padding="0" Click="btnOK_Click" />
        <SEACC_WPFControls:SEACC_Button x:Name="btnNew" Content="Add New" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Width="70" Margin="0,0,96,10" Height="25" BorderBrush="#FF9B9B9B" Foreground="White" Background="#FF41B1E1" BorderThickness="1" Padding="0" Click="btn_New_Click" />

    </Grid>
</Window>