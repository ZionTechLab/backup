<UserControl x:Class="SEACC_Tender.UC_TenderClosure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged"  >
        <Grid Margin="10,10,10,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="600"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="5" Background="#D5D5D5" x:Name="gridSplitter" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Purchases" FontSize="20" Foreground="#FF0096D6" HorizontalAlignment="Center"/>
                <GridSplitter Grid.Row="1" Height="2" Margin="5,0" Background="#FF0096D6" HorizontalAlignment="Stretch" />
                
                <SEACC_WPFControls:SEACC_DataGrid Grid.Row="2" Margin="10,10" Background="#FF808387" HeaderColor="#FF0083A1">
                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Purchase Order No"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Purchase Order Date"/>
                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                </SEACC_WPFControls:SEACC_DataGrid>
                <SEACC_WPFControls:SEACC_DataGrid Grid.Row="3" Margin="10,10" Background="#FF808387" HeaderColor="#FF0083A1">
                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="GRN No. "/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="GRN Date"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Item Code"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Qty"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="UoM"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="BL No"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="LC No"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="LC Date"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="LC Amount"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="LC Days"/>
                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                </SEACC_WPFControls:SEACC_DataGrid>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Sales" FontSize="20" Foreground="#FF0096D6" HorizontalAlignment="Center"/>
                <GridSplitter Grid.Row="1" Height="2" Margin="5,0" Background="#FF0096D6" HorizontalAlignment="Stretch" />
                <SEACC_WPFControls:SEACC_DataGrid Grid.Row="2" Margin="10,10" Background="#FF808387" HeaderColor="#FF0083A1">
                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Delivery Order No"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Delivery Order Date"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Item Code"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Item UoM"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Delivery Location"/>
                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                </SEACC_WPFControls:SEACC_DataGrid>
                <SEACC_WPFControls:SEACC_DataGrid Grid.Row="3" Margin="10,10" Background="#FF808387" HeaderColor="#FF0083A1">
                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Invoice No. "/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Invoice Date"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Invoice Amount"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Exchange Rate"/>
                        <SEACC_WPFControls:SEACC_DataGridTextColumn Header="Supplier"/>
                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                </SEACC_WPFControls:SEACC_DataGrid>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
