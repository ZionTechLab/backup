<UserControl x:Class="SEACC_Tender.UC_ttsTxnDocumentRenewal2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_Tender"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" >
        <Grid Margin="10,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="750"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--<SEACC_WPFControls:SEACC_DataGrid_Advanced Grid.Column="0" x:Name="dgr_Main" Margin="10,0" Background="#FF808387" HeaderColor="#FF0083A1"/>-->
            <GridSplitter Grid.Column="1" Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" />

            <!--Background="#FF6A6A6A"-->
            <Grid Grid.Column="0" Margin="10,0,10,0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderThickness="0" Padding="0,10" Background="#FF354961">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"  Margin="10,00,0,10">
                            <RadioButton Content="Document Based" x:Name="rdoDocument" Margin="2" Foreground="White" Click="rdoDocument_Click"/>
                            <RadioButton Content="Item Wise" x:Name="rdoItem" Margin="2" Foreground="White" Click="rdoItem_Click"/>
                            <RadioButton Content="Manufacturer Based" x:Name="rdoManufacturer" Margin="2" Foreground="White" Click="rdoManufacturer_Click"/>
                        </StackPanel>

                        <Grid Grid.Column="0" Margin="0,0,0,0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" MinWidth="120" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" MinWidth="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="0" Caption="Generic/ Item Name " x:Name="txtItemCode" MouseDoubleClick="txtItemCode_MouseDoubleClick_1"  Grid.ColumnSpan="2" TextForeground="Black" BoxForeground="White" />
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="1" Caption="Brand Name " x:Name="txtBrandName" MouseDoubleClick="txtBrandName_MouseDoubleClick"  Grid.ColumnSpan="2" TextForeground="Black" BoxForeground="White" />
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="2" Grid.Row="0" Caption="Manufacturer " x:Name="txtSupplier" MouseDoubleClick="txtSupplier_MouseDoubleClick" TextForeground="Black" BoxForeground="White" Grid.ColumnSpan="2" Height="30" VerticalAlignment="Top"/>
                            <!--<TextBlock Grid.Column="0" Grid.Row="1" Text="Generic Name" Foreground="White" Padding="5,2" />
                            <TextBlock Grid.Column="0" Grid.Row="2" Text="Manufacturer" Foreground="White" Padding="5,2"/>

                            <TextBlock Grid.Column="1" Grid.Row="1" x:Name="txtCategory" Text="-" Foreground="White" Padding="2,2,0,2" />
                            <TextBlock Grid.Column="1" Grid.Row="2" x:Name="txtType" Text="-" Foreground="White" Padding="2,2,0,2"/>-->
                        </Grid>
                    </StackPanel>
                </Border>

                <SEACC_WPFControls:SEACC_DataGrid Grid.Row="1" Height="450"  x:Name="dgr_Documents" Margin="10,10,10,0" Background="{x:Null}" HeaderColor="#FF0083A1" IsReadOnly="True" CanUserAddRows="False" CanUserResizeColumns="True" CanUserReorderColumns="False" MouseLeftButtonUp="dgr_Documents_MouseLeftButtonUp" BorderBrush="{x:Null}" Foreground="Black" RowStyle="{DynamicResource SEACC_DataGridRow}">
                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding DocRenewalID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Doc. Renewal ID" Width="100" IsReadOnly="False" />
                        <DataGridTextColumn Binding="{Binding DocumentID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Doc ID" Width="70" IsReadOnly="False" Visibility="Collapsed" />
                        <DataGridTextColumn Binding="{Binding DocumentCode ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Doc. Code" Width="100" IsReadOnly="False" />
                        <DataGridTextColumn Binding="{Binding DocumentName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Doc. Type" Width="120" IsReadOnly="False" />
                        <DataGridTextColumn Binding="{Binding RenewalType ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Renewal Type" Width="150" IsReadOnly="False" />
                        <DataGridTextColumn Binding="{Binding RenewalsID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Renewals ID" Width="50" IsReadOnly="False" Visibility="Collapsed" />
                        <DataGridTextColumn Binding="{Binding Renewals ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Renewals" Width="100" IsReadOnly="False" />
                        <DataGridTextColumn Binding="{Binding ExpiryDate ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Expiry Date" Width="150" IsReadOnly="False" />
                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                </SEACC_WPFControls:SEACC_DataGrid>
            </Grid>
            <SEACC_WPFControls:SEACC_ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition  Height="auto" />
                        <RowDefinition  Height="auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel >
                                <!--<StackPanel Orientation="Horizontal" x:Name="stackGeneralandProduct" Visibility="Collapsed">
                                    <RadioButton Content="General Certification" x:Name="rdoGCertification" Margin="10,5"  Click="rdoGCertification_Click"/>
                                    <RadioButton Content="Product Based Certification" x:Name="rdoPBCertification" IsChecked="True" Margin="10,5" Click="rdoPBCertification_Click"/>
                                </StackPanel>-->
                                <StackPanel >
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Doc Renewal ID" x:Name="txtDocRenewalID" MouseDoubleClick="txtDocRenewalID_MouseDoubleClick" />
                                </StackPanel>
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Doc. Code " x:Name="txtDocCode" MouseDoubleClick="txtDocCode_MouseDoubleClick"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Doc. Type" Padding="5,2"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Description" Padding="5,2"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" x:Name="txtDocType" Text="-" Padding="0,2"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="txtDocDescription" Text="-" Padding="0,2" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <Label Content="Document Renewal" FontSize="14" Foreground="#FF0096D6" FontWeight="Thin"/>
                                <Separator Height="2" Background="#FF33ADFF" Margin="0,-5,0,10" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Renewal Type " x:Name="txtRenewalType1" MouseDoubleClick="txtRenewalType1_MouseDoubleClick"/>
                                <SEACC_WPFControls:SEACC_LabelComboBox Caption="Renewal Type-2 " x:Name="cmbRenewalType2" Visibility="Collapsed" />
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Expiry Date " x:Name="dtpExpiryDate" ShowDate="Visible" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Remarks " x:Name="txtRemarks" Height="60"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2"  Margin="0,0,0,10">
                                <Label Content="Upload Files" FontSize="14" Foreground="#FF0096D6" FontWeight="Thin"/>
                                <Separator Height="2" Background="#FF33ADFF"  Margin="0,-5,0,5"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10,0">
                                    <SEACC_WPFControls:SEACC_Button x:Name="btnUpload" FontFamily="Segoe MDL2 Assets" Content="&#xE110;"  Margin="2" Width="30" Height="26" FontSize="12" Foreground="#FF0096D6" Background="{x:Null}" BorderBrush="#FF0096D6" Click="btnUploadLetter_Click" />
                                    <SEACC_WPFControls:SEACC_Button x:Name="btnRemove" FontFamily="Segoe MDL2 Assets" Content="&#xE894;"  Margin="2" Width="30" Height="26" FontSize="12" Foreground="#FF0096D6" Background="{x:Null}" BorderBrush="#FF0096D6" Click="btnRemove_Click"/>
                                </StackPanel>
                                <SEACC_WPFControls:SEACC_DataGrid MinHeight="100" x:Name="dgr_Upload" Margin="10,5,10,0" Background="{x:Null}" HeaderColor="#FF0083A1" IsReadOnly="True" CanUserAddRows="False" CanUserResizeColumns="True" CanUserReorderColumns="False" BorderBrush="{x:Null}" Foreground="Black" RowStyle="{DynamicResource SEACC_DataGridRow}" MouseDoubleClick="dgr_Upload_MouseDoubleClick">
                                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding FileName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="File Name" Width="150" IsReadOnly="False" />
                                        <DataGridTextColumn Binding="{Binding FilePath ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="File Path" Width="170" IsReadOnly="False" />
                                        <DataGridTextColumn Binding="{Binding isNew ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="New" Width="70" IsReadOnly="False" Visibility="Collapsed"/>
                                        <DataGridTextColumn Binding="{Binding isDeleted ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Deleted" Width="70" IsReadOnly="False" Visibility="Collapsed"/>
                                        <DataGridTextColumn Binding="{Binding Attachment_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Attachment Index" Width="100" IsReadOnly="False" Visibility="Collapsed"/>
                                        <DataGridTemplateColumn IsReadOnly="False" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding icon, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                                </SEACC_WPFControls:SEACC_DataGrid>
                            </StackPanel>
                            <StackPanel Grid.Row="2"  Margin="0,0,0,10">
                                <Label Content="Auto Reminders" FontSize="14" Foreground="#FF0096D6" FontWeight="Thin"/>
                                <Separator Height="2" Background="#FF33ADFF"  Margin="0,-5,0,10"/>
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Reminder Before " x:Name="txtReminderDays" />
                                <SEACC_WPFControls:SEACC_LabelComboBox Caption="Alert Frequence " x:Name="cmbFrequence"/>
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Alert Release Time " x:Name="dtpTime"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </SEACC_WPFControls:SEACC_ScrollViewer>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
