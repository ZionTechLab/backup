<UserControl x:Class="SEACC_Tender.UC_ttsMasDocumentList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_Tender"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="10,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" x:Name="ColumnA"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced Grid.Column="0" x:Name="dgr_Main" Margin="10,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp" />
            <GridSplitter Grid.Column="1" Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2"  Margin="10,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel Grid.Row="0">
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Doc. ID " x:Name="txtDocID" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Document " x:Name="txtDocCode" MouseDoubleClick="txtDocCode_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LabelComboBox Caption="Type " x:Name="cmbDocType"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Description " x:Name="txtDocDescription" Height="75"/>
                        <!--<SEACC_WPFControls:SEACC_LabelComboBox Caption="Renewal Type-1 " x:Name="cmbRenewalType1"/>
                        <SEACC_WPFControls:SEACC_LabelComboBox Caption="Renewal Type-2 " x:Name="cmbRenewalType2"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Select Product " x:Name="txtSelectProduct"/>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Expiry Date " x:Name="dtpExpiryDate" ShowDate="Visible"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Remarks " x:Name="txtRemarks" Height="75"/>-->
                        <StackPanel Margin="0,0,0,0" Orientation="Vertical"> 
                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkTenderWise" Caption="Tender Wise" IsChecked="True"/>
                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkItemWise" Caption="Item Wise" IsChecked="True"/>
                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkManufacturerWise" Caption="Manufacturer Wise" IsChecked="True"/>
                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkOther" Caption="Other" IsChecked="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
