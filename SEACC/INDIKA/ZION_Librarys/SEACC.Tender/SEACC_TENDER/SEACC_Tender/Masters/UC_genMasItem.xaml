<UserControl x:Class="SEACC_Tender.UC_genMasItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_Tender"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"              
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal" >

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged"  >

        <Grid x:Name="Main" Margin="0,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1"  />

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0" Background="#FF808387" HeaderColor="#FF0083A1" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"/>

            <Grid Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border  BorderThickness="1" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid   Margin="0,5"  >                                
                                <StackPanel>
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Item ID" x:Name="txtItem_ID" Visibility="Collapsed"/>
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Item Code" x:Name="txtItem_code" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Item/Generic Name" x:Name="txtItem_name" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Brand name" x:Name="txtBrand" MouseDoubleClick="txtBrand_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Description 1" x:Name="txtItem_des1"/>
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Description 2" x:Name="txtItem_des2" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="HS Code" x:Name="txtHS_code" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Categ-1" x:Name="txtItem_class" MouseDoubleClick="txtItem_class_MouseDoubleClick"/>
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Categ-2/Manufacture" x:Name="txtItem_type" MouseDoubleClick="txtItem_type_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Categ-3/Generic Item" x:Name="txtItem_category" MouseDoubleClick="txtItem_category_MouseDoubleClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border  BorderThickness="1" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid   Margin="0,5"  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Grid.Row="0">
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Sub Category" x:Name="txtSub_category"/>
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Substitute Item" x:Name="txtSubstitute_item" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Item Remarks" x:Name="txtRemarks" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="0">
                                    
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Base UOM" x:Name="txtUom" MouseDoubleClick="txtUom_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Tag 1" x:Name="txtTag1" MouseDoubleClick="txtTag1_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Tag 2" x:Name="txtTag2" MouseDoubleClick="txtTag2_MouseDoubleClick" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Expander Header="Purchase Details" FontSize="24" Foreground="#FF0096D6" >
                            <StackPanel >

                                <Border  BorderThickness="1" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                    </Border.Effect>
                                    <Grid   Margin="0,5"  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMin_stock_level" FontSize="12" Caption="Min Stk Level" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReorder_level" FontSize="12" Caption="Re Order Level" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReorder_qty" FontSize="12" Caption="Re Order Qty"  />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCost_price" FontSize="12" Caption="Cost Price" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtWght_avg_cost" FontSize="12" Caption="Weighted Avg Cost" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtHeighest_cost" FontSize="12" Caption="Heighest Purchase Cost" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLIFO_cost" FontSize="12" Caption="LIFO Cost" Visibility="Collapsed" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFIFO_cost" FontSize="12" Caption="FIFO Cost" Visibility="Collapsed" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLowest_cost" FontSize="12" Caption="Lowest Cost" />
                                        </StackPanel>

                                    </Grid>
                                    
                                </Border>

                                <Border  BorderThickness="1" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                    </Border.Effect>
                                    <Grid   Margin="0,5"  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsTIEPItem" Caption="TIEP Item" IsChecked="True"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsImportItem" Caption="Import Item" IsChecked="True"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsExportSalesItem" Caption="Export/Sales Item" IsChecked="True"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsUnitQtyPricing" Caption="Unit/Qty Pricing" IsChecked="True"/>
                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </StackPanel>
                        </Expander>

                        <Expander Header="Sales Details" FontSize="24" Foreground="#FF0096D6" >
                            <StackPanel >

                                <Border  BorderThickness="1" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                    </Border.Effect>
                                    <Grid   Margin="0,5"  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtKilo_price" FontSize="12" Caption="Kilo Price" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtSelling_price" FontSize="12" Caption="Selling Price" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtWholesale_price" FontSize="12" Caption="Wholesale Price"  />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDutyFree_price" FontSize="12" Caption="Duty Free Price" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtSVAT_price" FontSize="12" Caption="S-VAT Price" />
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAllinclusive_price" FontSize="12" Caption="All Inclusive price" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtOther_price" FontSize="12" Caption="Price Other" />
                                        </StackPanel>

                                    </Grid>

                                </Border>

                                <Border  BorderThickness="1" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                    </Border.Effect>
                                    <Grid   Margin="0,5"  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsUnitQtyPricing1" Caption="Unit/ Qty Pricing" IsChecked="True"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsUnitQtyPricing2" Caption="Unit/ Qty Pricing" IsChecked="True"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Grid.Row="0">
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsUnitQtyPricing3" Caption="Unit/ Qty Pricing" IsChecked="True"/>
                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>

</UserControl>

