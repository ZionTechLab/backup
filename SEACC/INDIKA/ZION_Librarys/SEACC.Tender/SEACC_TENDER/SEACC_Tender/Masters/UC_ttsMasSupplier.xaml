<UserControl x:Class="SEACC_Tender.UC_ttsMasSupplier"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             Background="#FFFFFF" FontWeight="Normal">
    
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid x:Name="Main" Margin="0,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" x:Name="ColumnA"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced Grid.Column="0" x:Name="dgr_Main" Margin="10,0" Background="#FF808387" HeaderColor="#FF0083A1"/>
            <GridSplitter  Grid.Column="1" Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch"/>
            <Grid  Grid.Column="2" Margin="10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border  BorderThickness="1" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!--<StackPanel Grid.Column="0" Height="130" Width="100">
                                    <Border x:Name="imageborder" HorizontalAlignment="Left" BorderBrush="#FF41B1E1" BorderThickness="1" MaxHeight="102" MaxWidth="102" VerticalAlignment="Top"  >
                                        <Image x:Name="pbxImage" Height="100" Width="100" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Image.Effect>
                                                <DropShadowEffect BlurRadius="10" Opacity="0.2"/>
                                            </Image.Effect>
                                        </Image>
                                    </Border>
                                    <SEACC_WPFControls:SEACC_Button Width="100" x:Name="btnUploadImage" Height="25" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White" Content="Add Image" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="btnUploadImage_Click" />
                                </StackPanel>-->
                                <Border Grid.Column="1" BorderThickness="1" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                    </Border.Effect>
                                    <StackPanel  Margin="0,5">
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Supplier ID" x:Name="txtSupplierID" />
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Supplier Name" x:Name="txtSupplierName" DetailBox_Width="700" />
                                        <StackPanel Orientation="Horizontal" Margin="120,0,0,0">
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsBlackListed" Caption="Blacklisted" IsChecked="True"/>
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsSuspended" Caption="Suspended" IsChecked="True"/>
                                            <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsDeactivated" Caption="Inactive" IsChecked="True"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border  BorderThickness="1" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>                               
                                <StackPanel Grid.Column="0" Grid.Row="0">
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Category 1" x:Name="txtSup_cls" DetailBox_Width="225"  />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Category 2" x:Name="txtSup_Type" DetailBox_Width="225"  />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Category 3" x:Name="txtCategory" DetailBox_Width="225" />
                                </StackPanel>
                        </Border>
                        <StackPanel Margin="0,5">
                            <Expander Header="General Details" FontSize="24" Foreground="#FF0096D6" >
                                <StackPanel >
                                    <Border  BorderThickness="1" Margin="0,0,0,10">
                                        <Border.Effect>
                                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                        </Border.Effect>
                                        <Grid   Margin="0,5"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Grid.Row="0">
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTel" Caption="Telephone #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFax" Caption="Fax #"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMobi" Caption="Mobile #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtWeb_URL" Caption="URL/Website"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmail" Caption="Email"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtArea"  Caption="Area Code"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRoute" Caption="Route Code"  FontSize="12" />
                                           </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.Row="0">
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCountry" Caption="Country" FontSize="12" MouseDoubleClick="txtCountry_MouseDoubleClick" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtProvince" Caption="Province" FontSize="12" MouseDoubleClick="txtProvince_MouseDoubleClick" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDistrict"  Caption="District"  FontSize="12" MouseDoubleClick="txtDistrict_MouseDoubleClick"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCity" Caption="City"  FontSize="12" MouseDoubleClick="txtCity_MouseDoubleClick"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTown" Caption="Town" FontSize="12" MouseDoubleClick="txtTown_MouseDoubleClick"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCurrency" Caption="Base Currency" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border  BorderThickness="1" Margin="0,0,0,10">
                                        <Border.Effect>
                                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                        </Border.Effect>
                                        <Grid   Margin="0,5"  >
                                            <StackPanel>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReg_Address" FontSize="12" Caption="Registered Address" DetailBox_Width="700" IsMultiline="True"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDel_Address" FontSize="12" Caption="Delivery Address" DetailBox_Width="700" IsMultiline="True" Visibility="Collapsed" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemarks" FontSize="12" Caption="Remarks" DetailBox_Width="696" IsMultiline="True" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Account Details" FontSize="24" Foreground="#FF0096D6" >
                                <StackPanel>
                                    <Border  BorderThickness="1" Margin="0,0,0,10">
                                        <Border.Effect>
                                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                        </Border.Effect>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Grid.Row="0">
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDep_amnt" Caption="Refundable Deposit Amt."  FontSize="12"  />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCredit_limit" Caption="Credit Limit"  FontSize="12"  />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCredit_period" Caption="Credit Period"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBalance" Caption="Outs. Balance"  FontSize="12" Visibility="Collapsed" />
                                                <!--<SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCodeLink" Caption="Acc Code Link"  FontSize="12" />-->
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAccountCode" Caption="Account Code"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAccountType" Caption="Account Type"  FontSize="12" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Grid.Row="0">
                                                <!--<SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBussRegNo" Caption="Bussines Mode" FontSize="12" />-->
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtNBTRegNo" Caption="NBT Reg #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtVATRegNo" Caption="VAT Reg #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtSVATRegNo" Caption="SVAT Reg #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkNBT" Caption="NBT Enable" FontSize="12" IsChecked="True"/>
                                                <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="rdoVAT" Caption="VAT Enable"  FontSize="12" IsChecked="True"/>
                                                <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="rdoSVAT" Caption="SVAT Enable" FontSize="12" IsChecked="True"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>

</UserControl>
