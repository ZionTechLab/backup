<UserControl x:Class="SEACC_Tender.UC_ttsMasProjectSponsor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_Tender"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal" >
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="10,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" x:Name="ColumnA"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced Grid.Column="0" x:Name="dgr_Main" Margin="10,0" Background="#FF808387" HeaderColor="#FF0083A1" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp"/>
            <GridSplitter Grid.Column="1" Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" />
            <Grid Grid.Column="2" Margin="10,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel Grid.Row="0">
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Sponsor ID " x:Name="txtSponsorID" MouseDoubleClick="txtSponsorID_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Sponsor Code" x:Name="txtSponsorCode" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Sponsor Name" x:Name="txtSponsorOrganization" ToolTip="Sponsor Organization Name"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Sponsor Email" x:Name="txtSponsorEmail"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Sponsor Mobile#" x:Name="txtSponsorTpNo"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
