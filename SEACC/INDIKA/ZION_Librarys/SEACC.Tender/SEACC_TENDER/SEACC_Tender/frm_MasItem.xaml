<Window x:Class="SEACC_Tender.frm_MasItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" 
        xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        Title="frm_MasItem" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="{x:Null}" WindowStyle="None" ShowInTaskbar="False" Width="450">
    <Grid Margin="20" Background="White">
        <Grid.Effect>
            <DropShadowEffect ShadowDepth="10" Opacity="0.7" BlurRadius="10"/>
        </Grid.Effect>
            <Grid Margin="0,0,0,50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#FF6A6A6A" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" BorderBrush="#FFEC0000" Margin="0,5,5,0"/>

                    <Label x:Name="lblHeader" Content="Item Master"  FontSize="18" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,5,5,5" Margin="10,2" />
                </Grid>
            <Grid Grid.Row="1" x:Name="Main" Margin="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Name="coloumnA" Width="400" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" Margin="0,10,0,0" HorizontalAlignment="Stretch" Grid.Column="1"  />

                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0" Margin="10,10,10,0" Background="#FFACACAC" HeaderColor="#FF6A6A6A"  Foreground="Black" />
                <Grid Grid.Column="2" Margin="10,10,0,0">
                    <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto" >
                        <Border BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid Margin="0,20,0,0">
                                <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close2" Content="&#xE012;" FontFamily="Segoe MDL2 Assets" FontSize="20" Click="btn_Close2_Click" Height="30" Width="30" HorizontalAlignment="Right"  VerticalAlignment="Top" BorderBrush="#FFEC0000" Margin="0,-5,0,0"/>
                                <StackPanel>
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Item ID" x:Name="txtItem_ID" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Item Code" x:Name="txtItem_code" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Generic Name" x:Name="txtGenericname" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Brand" x:Name="txtBrand" MouseDoubleClick="txtBrand_MouseDoubleClick"/>

                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Class" x:Name="txtClass" MouseDoubleClick="txtClass_MouseDoubleClick"/>
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Category" x:Name="txtCategory" MouseDoubleClick="txtCategory_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Manufacture" x:Name="txtItem_type" MouseDoubleClick="txtItem_type_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Strength" x:Name="txtTag1" MouseDoubleClick="txtTag1_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Shelf Life" x:Name="txtTag2" MouseDoubleClick="txtTag2_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="UoM" x:Name="txtUoM" MouseDoubleClick="txtUoM_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Pack Size" x:Name="txtPackSize" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Specification" x:Name="txtSpecification" Height="45" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </SEACC_WPFControls:SEACC_ScrollViewer>
                    </Grid>
                

            </Grid>
            </Grid>
            <SEACC_WPFControls:SEACC_Button x:Name="btnOK" Content="OK" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Width="70" Margin="0,0,21,10" Height="25" BorderBrush="#FF9B9B9B" Foreground="White" Background="#FF41B1E1" BorderThickness="1" Padding="0" Click="btnOK_Click" />
            <SEACC_WPFControls:SEACC_Button x:Name="btnNew" Content="Add New" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Width="70" Margin="0,0,96,10" Height="25" BorderBrush="#FF9B9B9B" Foreground="White" Background="#FF41B1E1" BorderThickness="1" Padding="0" Click="btn_New_Click" />

    </Grid>
    
</Window>
