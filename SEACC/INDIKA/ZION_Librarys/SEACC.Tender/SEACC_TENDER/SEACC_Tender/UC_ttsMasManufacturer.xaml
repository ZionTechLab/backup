<UserControl x:Class="SEACC_Tender.UC_ttsMasManufacturer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             Background="#FFFFFF" FontWeight="Normal">
    
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid x:Name="Main" Margin="0,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" x:Name="ColumnA"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced Grid.Column="0" x:Name="dgr_Main" Margin="10,0" Background="#FF808387" HeaderColor="#FF0083A1"/>
            <GridSplitter  Grid.Column="1" Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch"/>
            <Grid  Grid.Column="2" Margin="10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border  BorderThickness="1" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>
                            <Border Grid.Column="1" BorderThickness="1" Margin="0,0,0,10">
                                <Border.Effect>
                                    <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                </Border.Effect>
                                <StackPanel  Margin="0,5">
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Manufacturer ID" x:Name="txtManufacturerID" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Manufacturer Name" x:Name="txtManufacturerName" DetailBox_Width="700" />
                                    <StackPanel Orientation="Horizontal" Margin="120,0,0,0">
                                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsBlackListed" Caption="Blacklisted" IsChecked="True"/>
                                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsSuspended" Caption="Suspended" IsChecked="True"/>
                                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsDeactivated" Caption="Inactive" IsChecked="True"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border  BorderThickness="1" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>                               
                                <StackPanel Grid.Column="0" Grid.Row="0">
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Category 1" x:Name="txtManufacturer_cls" DetailBox_Width="225"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Category 2" x:Name="txtManufacturer_Type" DetailBox_Width="225"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Category 3" x:Name="txtManufacturer_Category" DetailBox_Width="225" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="0,5">
                            <Expander Header="Item Details" FontSize="24" Foreground="#FF0096D6" >
                                <StackPanel >
                                    <Border BorderThickness="1" Margin="0,-30,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                        <Border.Effect>
                                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                        </Border.Effect>
                                        <Grid Margin="0,0,0,0" Height="150">
                                            <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                                                <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE710;" Width="30" FontSize="12"  FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Foreground="White" Background="#FF6A6A6A" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Top" Click="btnGridItemAdd_Click" />
                                                <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontSize="12"  FontFamily="Segoe MDL2 Assets" Background="#FF6A6A6A" Foreground="#FFC70000" BorderBrush="{x:Null}" Click="btnGridItemDelete_Click" />
                                            </StackPanel>
                                            <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_Items" Margin="0,35,0,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" IsReadOnly="False" CanUserAddRows="False" CanUserResizeColumns="True" MouseLeftButtonUp="dgr_Items_MouseLeftButtonUp" Headerforeground="White" BorderBrush="#FF0081FF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                                    <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="#" Width="30" IsReadOnly="False" />
                                                    <DataGridTextColumn Binding="{Binding ItemID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item ID" Width="120" IsReadOnly="False" Visibility="Collapsed" />
                                                    <DataGridTextColumn Binding="{Binding ItemDescription ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item Description" Width="120" IsReadOnly="True" />
                                                    <DataGridTextColumn Binding="{Binding ItemSpecification ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item Specification" Width="120" IsReadOnly="True"/>
                                                    <DataGridTextColumn Binding="{Binding ItemCategoryID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item Category ID" Width="120" IsReadOnly="True" Visibility="Collapsed"/>
                                                    <DataGridTextColumn Binding="{Binding ItemCategory ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item Category" Width="120" IsReadOnly="True"/>
                                                    <DataGridTextColumn Binding="{Binding UoMCode ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="UoM Code" Width="60" Visibility="Collapsed"/>
                                                    <DataGridTextColumn Binding="{Binding UoM ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="UoM" Width="60" IsReadOnly="True"/>
                                                    <DataGridTextColumn Binding="{Binding Remarks ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Remarks" Width="120" IsReadOnly="False" />
                                                </SEACC_WPFControls:SEACC_DataGrid.Columns>
                                            </SEACC_WPFControls:SEACC_DataGrid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                            <Expander Header="General Details" FontSize="24" Foreground="#FF0096D6" >
                                <StackPanel >
                                    <Border  BorderThickness="1" Margin="0,0,0,10">
                                        <Border.Effect>
                                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                        </Border.Effect>
                                        <Grid   Margin="0,5"  >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Grid.Row="0">
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTel" Caption="Telephone #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFax" Caption="Fax #"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMobi" Caption="Mobile #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtWeb_URL" Caption="URL/Website"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmail" Caption="Email"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtArea"  Caption="Area Code"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRoute" Caption="Route Code"  FontSize="12" />
                                           </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.Row="0">
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCountry" Caption="Country" FontSize="12" MouseDoubleClick="txtCountry_MouseDoubleClick" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtProvince" Caption="Province" FontSize="12" MouseDoubleClick="txtProvince_MouseDoubleClick" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDistrict"  Caption="District"  FontSize="12" MouseDoubleClick="txtDistrict_MouseDoubleClick"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCity" Caption="City"  FontSize="12" MouseDoubleClick="txtCity_MouseDoubleClick"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTown" Caption="Town" FontSize="12" MouseDoubleClick="txtTown_MouseDoubleClick"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCurrency" Caption="Base Currency" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border  BorderThickness="1" Margin="0,0,0,10">
                                        <Border.Effect>
                                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                        </Border.Effect>
                                        <Grid   Margin="0,5"  >
                                            <StackPanel>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReg_Address" FontSize="12" Caption="Registered Address" DetailBox_Width="700" IsMultiline="True"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDel_Address" FontSize="12" Caption="Delivery Address" DetailBox_Width="700" IsMultiline="True" Visibility="Collapsed" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemarks" FontSize="12" Caption="Remarks" DetailBox_Width="696" IsMultiline="True" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!--<Expander Header="Account Details" FontSize="24" Foreground="#FF0096D6" >
                                <StackPanel>
                                    <Border  BorderThickness="1" Margin="0,0,0,10">
                                        <Border.Effect>
                                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                        </Border.Effect>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Grid.Row="0">
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDep_amnt" Caption="Refundable Deposit Amt."  FontSize="12"  />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCredit_limit" Caption="Credit Limit"  FontSize="12"  />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCredit_period" Caption="Credit Period"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBalance" Caption="Outs. Balance"  FontSize="12" Visibility="Collapsed" />
                                                --><!--<SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCodeLink" Caption="Acc Code Link"  FontSize="12" />--><!--
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAccountCode" Caption="Account Code"  FontSize="12" />
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAccountType" Caption="Account Type"  FontSize="12" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Grid.Row="0">
                                                --><!--<SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBussRegNo" Caption="Bussines Mode" FontSize="12" />--><!--
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtNBTRegNo" Caption="NBT Reg #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtVATRegNo" Caption="VAT Reg #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtSVATRegNo" Caption="SVAT Reg #" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkNBT" Caption="NBT Enable" FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="rdoVAT" Caption="VAT Enable"  FontSize="12"/>
                                                <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="rdoSVAT" Caption="SVAT Enable" FontSize="12"  />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>-->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>

</UserControl>
