<UserControl x:Class="SEACC_Tender.Transactions.UC_TenderReadings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_Tender"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"              
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal" >

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged"  >

        <Grid x:Name="Main" Margin="0,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="ColumnA" Width="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" />
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp"/>
            <SEACC_WPFControls:SEACC_ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,0">
                    <Border  BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <StackPanel Grid.Column="0">
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Tender/BID No." x:Name="txtTenderNo" MouseDoubleClick="txtTenderNo_MouseDoubleClick"/>
                            <!--<SEACC_WPFControls:SEACC_LableTextBox Caption="SR No" x:Name="txtSRNo" FontSize="12"/>-->
                            <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="BID Opened Date" x:Name="dtpReadingDate" FontSize="12" ShowDate="Visible" ShowTime="Hidden"/>
                        </StackPanel>
                    </Border>
                    <!--<Popup x:Name="pop_Error" PopupAnimation="Slide" IsOpen="False" StaysOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTenderNo}" HorizontalOffset="120">
                        <Border BorderThickness="0,0,1,1" Margin="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="10"/>
                            </Border.Effect>
                            <Grid Background="White">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid Background="#FFFF4848">
                                    <Image Grid.Row="0" Source="/SEACC_Tender;component/Resources/error.png" Margin="5,2,2,2" Stretch="Fill" Height="20" Width="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Label Grid.Row="0" FontSize="14" Content="Error" Margin="40,0,0,0" Foreground="White"/>
                                </Grid>
                                <TextBlock Grid.Row="1" x:Name="txtError" Padding="10,15,25,25"/>
                            </Grid>
                        </Border>
                    </Popup>-->

                    <Grid Margin="0,0,0,20" Height="200">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="5,0,0,0">
                            <Label Content="Tender Items" FontSize="18" Foreground="#FF0096D6" />
                        </StackPanel>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_Items" Margin="0,35,0,0" Background="{x:Null}" HeaderColor="#FF0083A1" BorderBrush="{x:Null}" Foreground="Black" IsReadOnly="True" CanUserAddRows="False" CanUserResizeColumns="True" MouseLeftButtonUp="dgr_Tender_MouseLeftButtonUp" CellEditEnding="dgr_Tender_CellEditEnding" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" RowStyle="{DynamicResource SEACC_DataGridRow}">
                            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                <!--<DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="#" Width="20" IsReadOnly="True" Visibility="Collapsed" />-->
                                <DataGridTextColumn Binding="{Binding SRNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="SR No" Width="50" IsReadOnly="False" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding ItemID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item ID" Width="70" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding GenericName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item Name" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Specification ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Specification" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Binding="{Binding UoMCode ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="UoMCode" Width="70" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding UoM ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="UoM" Width="45" IsReadOnly="True"/>
                                <DataGridTextColumn Binding="{Binding Quantity ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Quantity" Width="60" IsReadOnly="False" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Strength ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Strength" Width="70" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding ShelfLife ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Shelf Life" Width="70" IsReadOnly="False" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Packing ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Packing" Width="105" IsReadOnly="True" />
                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                    </Grid>
                    <Grid>
                        <Grid Margin="5,0,0,0" >
                            <Label Content="Document Renewal" FontSize="18" Foreground="#FF0096D6"/>
                            <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                                <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Foreground="White" Background="#FF6A6A6A" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Top" Click="btnGridItemAdd_Click" />
                                <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets" BorderBrush="{x:Null}" Foreground="Red" Background="#FF6A6A6A" Click="btnGridItemDelete_Click" />
                            </StackPanel>
                        </Grid>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_Tender" Margin="0,38,0,0" Background="{x:Null}" HeaderColor="#FF0083A1" BorderBrush="{x:Null}" Foreground="Black" IsReadOnly="False" CanUserAddRows="False" CanUserResizeColumns="True" MouseLeftButtonUp="dgr_Tender_MouseLeftButtonUp" CellEditEnding="dgr_Tender_CellEditEnding" RowStyle="{DynamicResource SEACC_DataGridRow}" >
                            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding SRNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="SRNo" Width="70" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding ItemID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item ID" Width="70" IsReadOnly="False" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item Name" Width="140" IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding CompetitorID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Competitor ID" Width="120" IsReadOnly="False" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding Competitor ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Competitor" Width="140" IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Terms ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Terms" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding CurrencyID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Currency ID" Width="100"   IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding Currency ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Currency" Width="80"   IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding UnitPrice ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Unit Price" Width="70" IsReadOnly="False" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding BidBond ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Bid Bond" Width="80" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding PaymentReceipt ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Payment Receipt" Width="100" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding LocalAgent ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Local Agent" Width="110" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding Delivery ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Delivery" Width="110" IsReadOnly="False" />
                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                        <Popup x:Name="pop_Event" Placement="Center" PopupAnimation="Slide" IsOpen="False" StaysOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" LostFocus="pop_Event_LostFocus" PlacementTarget="{Binding ElementName=SEACC_Form}" >
                            <Popup.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.7" RenderingBias="Quality" ShadowDepth="10"/>
                            </Popup.Effect>
                            <Border BorderThickness="0,0,1,1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15"/>
                                </Border.Effect>
                                <Grid Width="350" Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Background="#FF0083A1" Grid.Row="0">
                                        <Image Grid.Row="0" Source="/SEACC_Tender;component/Resources/pencil-xxl.png" Margin="5,2,2,2" Stretch="Fill" Height="16" Width="16" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <Label Grid.Row="0" FontSize="14" Margin="30,0,0,0" Content="Terms" Foreground="White"/>
                                        <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" Foreground="#FFEC0000"/>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Vertical">
                                        <SEACC_WPFControls:SEACC_TextBox x:Name="txtTerms" Height="95" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        <SEACC_WPFControls:SEACC_Button Content="Save" x:Name="btn_PoPSave" Background="#FF017089" Height="30" Foreground="White" Click="btn_PoPSave_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </SEACC_WPFControls:SEACC_ScrollViewer>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
