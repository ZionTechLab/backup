<UserControl x:Class="SEACC_Tender.UC_ttsPreBidMeeting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_Tender"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"  
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal">

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="0,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" Name="ColumnA"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced Grid.Column="0" x:Name="dgr_Main" Margin="10,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp"/>
            <GridSplitter Grid.Column="1" Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" />
            <SEACC_WPFControls:SEACC_ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" >
                <Grid Grid.Column="2" Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderThickness="1" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,0,0">
                                    <StackPanel>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Pre Bid Meeting #" x:Name="txtPreBidMeetigNo" MouseDoubleClick="txtPreBidMeetigNo_MouseDoubleClick"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Tender/BID No. " x:Name="txtTenderNo" MouseDoubleClick="txtTenderNo_MouseDoubleClick"/>
                                        <!--<SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Meeting Date " x:Name="dtpMeetingDate" ShowDate="Visible" ShowTime="Visible" />-->
                                        <!--<Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="315"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Caption="Upload MoM" x:Name="txtUploadMoM" DetailBox_Width="190" ToolTip="Minutes of Meetings"/>
                                        <SEACC_WPFControls:SEACC_Button Grid.Column="1" FontFamily="Segoe MDL2 Assets" Content="&#xE110;" Width="30" Height="26" FontSize="12" Foreground="#FF0096D6" Background="{x:Null}" BorderBrush="#FF0096D6" HorizontalAlignment="Left" Click="SEACC_Button_Click" />
                                    </Grid>-->
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Remarks" x:Name="txtRemarks" MinHeight="60"/>
                                    </StackPanel>
                                    <local:UC_Attachments x:Name="Attachments" Height="150" Margin="0,10,10,10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <StackPanel>
                                        <Label Content="Pre Bid Meeting" FontSize="18" Foreground="#FF0096D6" FontWeight="Thin"/>
                                        <Separator Height="2" Background="#FF33ADFF" Margin="0,-2,0,10" />
                                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Pre Bid Meeting date " x:Name="dtpPreBidMeetingDate" ShowDate="Visible"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Address Line-1 " FontSize="12" x:Name="txtAddress1"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Address Line-2 " FontSize="12" x:Name="txtAddress2"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Town" FontSize="12" x:Name="txtTown" MouseDoubleClick="txtTown_MouseDoubleClick"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="City" FontSize="12" x:Name="txtCity" MouseDoubleClick="txtCity_MouseDoubleClick"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Country" FontSize="12" x:Name="txtCountry" MouseDoubleClick="txtCountry_MouseDoubleClick"/>                                        
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!--<Popup x:Name="pop_Error" PopupAnimation="Slide" IsOpen="False" StaysOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTenderNo}" HorizontalOffset="120" LostFocus="pop_Error_LostFocus" >
                            <Border BorderThickness="0,0,1,1" Margin="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="10"/>
                                </Border.Effect>
                                <Grid Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Background="#FFFF4848" Grid.Row="0">
                                        <Image Source="/SEACC_Tender;component/Resources/error.png" Margin="5,2,2,2" Stretch="Fill" Height="20" Width="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <Label FontSize="14" Content="Error" Margin="40,0,0,0" Foreground="White"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" x:Name="txtError" Padding="10,15,25,25"/>
                                </Grid>
                            </Border>
                        </Popup>-->
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="5,0,5,0">
                        <Border BorderThickness="1" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>
                            <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5" Height="20" >
                                <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Foreground="White" Background="#FF6A6A6A" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Bottom" Click="btnGridItemAdd_Click"/>
                                <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets" BorderBrush="{x:Null}" Foreground="Red" Background="#FF6A6A6A" Click="btnGridItemDelete_Click" />
                            </StackPanel>
                        </Border>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_Tender" Margin="0,0,0,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" IsReadOnly="False" CanUserAddRows="False" CanUserResizeColumns="True" MouseLeftButtonUp="dgr_Tender_MouseLeftButtonUp" >
                            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding LineNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="#" Width="40" IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding CompetitorID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Competitor ID" Width="70" IsReadOnly="True" Visibility="Collapsed" />
                                <DataGridTextColumn Binding="{Binding Competitor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Competitor" Width="220" IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Representer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Representer" Width="150" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding Designation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Designation" Width="150" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Remarks" Width="150" IsReadOnly="False" />
                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                    </StackPanel>
                </Grid>
            </SEACC_WPFControls:SEACC_ScrollViewer>

            
        </Grid>
        </SEACC_WPFControls_Local:SEACC_Form>
   
</UserControl>
