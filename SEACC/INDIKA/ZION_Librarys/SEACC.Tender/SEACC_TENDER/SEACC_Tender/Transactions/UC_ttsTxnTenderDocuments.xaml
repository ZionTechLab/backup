<UserControl x:Class="SEACC_Tender.UC_ttsTxnTenderDocuments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_Tender"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal">

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid x:Name="Main" Margin="10,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="ColumnA" Width="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp"/>
            <GridSplitter Grid.Column="1" Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch"   />

            <SEACC_WPFControls:SEACC_ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderThickness="1" Margin="0,5,0,5">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <StackPanel>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Tender/BID No." x:Name="txtTenderID" MouseDoubleClick="txtTenderID_MouseDoubleClick"/>
                        </StackPanel>
                    </Border>
                    <!--<Popup x:Name="pop_Error" PopupAnimation="Slide" IsOpen="False" StaysOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=txtTenderID}" HorizontalOffset="120">
                        <Border BorderThickness="0,0,1,1" Margin="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="10"/>
                            </Border.Effect>
                            <Grid Background="White">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid Background="#FFFF4848">
                                    <Image Grid.Row="0" Source="/SEACC_Tender;component/Resources/error.png" Margin="5,2,2,2" Stretch="Fill" Height="20" Width="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Label Grid.Row="0" FontSize="14" Content="Error" Margin="40,0,0,0" Foreground="White"/>
                                </Grid>
                                <TextBlock Grid.Row="1" x:Name="txtError" Padding="10,15,25,25"/>
                            </Grid>
                        </Border>
                    </Popup>-->
                    
                    <Grid Grid.Row="1" Margin="0,-35,0,0">
                        <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Foreground="White" Background="#FF6A6A6A" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Top" Click="btnGridItemAdd_Click" />
                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets" BorderBrush="{x:Null}" Foreground="Red" Background="#FF6A6A6A" Click="btnGridItemDelete_Click" />
                        </StackPanel>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_TenderDoc" Margin="0,38,0,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" IsReadOnly="False" CanUserAddRows="False" CanUserResizeColumns="True" Grid.ColumnSpan="2" >
                            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                <!--<DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="#" Width="70" IsReadOnly="False" />-->
                                <DataGridTextColumn Binding="{Binding DocID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Doc ID" Width="60" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding TenderDocument ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Tender Document" Width="150" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding Description ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Description" Width="250"   IsReadOnly="False" />
                                <!--<DataGridTextColumn Binding="{Binding UploadDocument ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Upload Document" Width="120"   IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding DocValidPeriod ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Doc. Valid Period" Width="120"   IsReadOnly="False" />-->
                                <DataGridCheckBoxColumn Binding="{Binding Submitted ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Submitted ?" Width="100" IsReadOnly="False" />
                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                    </Grid>
                    <Grid Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" >
                        <Label x:Name="lblNext" Content="Pre Bid Meeting>>>" Foreground="#FF0096D6" FontSize="24" HorizontalAlignment="Right" MouseLeftButtonUp="lblNext_MouseLeftButtonUp"/>
                    </Grid>
                </Grid>
            </SEACC_WPFControls:SEACC_ScrollViewer>

        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
