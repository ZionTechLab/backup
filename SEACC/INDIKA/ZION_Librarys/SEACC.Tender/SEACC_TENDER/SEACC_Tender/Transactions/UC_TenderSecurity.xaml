<UserControl x:Class="SEACC_Tender.Transactions.UC_TenderSecurity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_Tender"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal" >
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="10,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColumnA" Width="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced Grid.Column="0" x:Name="dgr_Main" Margin="10,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1"/>
            <GridSplitter Grid.Column="1" Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" />
            <SEACC_WPFControls:SEACC_ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <StackPanel>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Tender/BID No." x:Name="txtTenderID" MouseDoubleClick="txtTenderID_MouseDoubleClick"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer " x:Name="txtCustomer" MouseDoubleClick="txtCustomer_MouseDoubleClick"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="5,-30,15,5">
                        <StackPanel Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"  Height="20">
                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Foreground="White" Background="#FF6A6A6A" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Top" Click="btnGridItemAdd_Click"/>
                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets" BorderBrush="{x:Null}" Foreground="Red" Background="#FF6A6A6A" Click="btnGridItemDelete_Click" />
                        </StackPanel>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgv_SecType" Margin="0,38,0,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" IsReadOnly="False" CanUserAddRows="False" CanUserResizeColumns="True" MouseLeftButtonUp="dgv_SecType_MouseLeftButtonUp">
                            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding LineNo}" Header="#" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Binding="{Binding IndentNo}" Header="Indent No" Width="100" IsReadOnly="False"/>
                                <DataGridTextColumn Binding="{Binding SecurityTypeID}" Header="Security Type ID" Width="100" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding SecurityType}" Header="Security Type" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Binding="{Binding RefNo}" Header="Ref #" Width="100" IsReadOnly="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Amount}" Header="Amount" Width="100" IsReadOnly="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding BankID}" Header="Bank ID" Width="100" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding Bank}" Header="Bank" Width="100" IsReadOnly="False"/>
                                <DataGridTextColumn Binding="{Binding BranchID}" Header="Branch ID" Width="100" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding Branch}" Header="Branch" Width="100" IsReadOnly="False"/>
                                <DataGridTextColumn Binding="{Binding Account}" Header="Account" Width="100" IsReadOnly="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                        <Popup x:Name="pop_Event" Placement="MousePoint" PopupAnimation="Slide" IsOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" >
                            <Popup.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.7" RenderingBias="Quality" ShadowDepth="10"/>
                            </Popup.Effect>
                            <Border BorderThickness="0,0,1,1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15"/>
                                </Border.Effect>

                                <Grid Width="250" Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Content="Security Types" FontSize="14" Foreground="White" Background="#FF0083A1"/>
                                    <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" BorderBrush="#FFEC0000"/>
                                    <ListBox x:Name="lstSecurityItems" Grid.Row="1" Margin="2"   Height="120" Foreground="Black" BorderBrush="#FF41B1E1" BorderThickness="1" >
                                        <!--<ListBoxItem >Perform Bond</ListBoxItem>
                                    <ListBoxItem >BID Bond</ListBoxItem>
                                    <ListBoxItem >Bank Guarantee</ListBoxItem>
                                    <ListBoxItem >Advance Payment Guarantee</ListBoxItem>-->
                                    </ListBox>
                                    <SEACC_WPFControls:SEACC_Button Grid.Row="2" Content="Save" x:Name="btn_PoPSave" Margin="2" Background="#FF41B1E1" Foreground="White" Click="btn_PoPAdd_Click" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </SEACC_WPFControls:SEACC_ScrollViewer>
            
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
