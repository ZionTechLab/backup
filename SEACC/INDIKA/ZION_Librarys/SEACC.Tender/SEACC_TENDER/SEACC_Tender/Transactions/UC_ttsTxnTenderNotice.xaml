<UserControl x:Class="SEACC_Tender.UC_ttsTxnTenderNotice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_Tender"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_Tender.UserControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"              
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal" Loaded="UserControl_Loaded" >

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >

        <Grid x:Name="Main" Margin="0,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="ColumnA" Width="350" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1"  />
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp"/>
            <SEACC_WPFControls:SEACC_ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Border Grid.Row="0" BorderThickness="1" Margin="5,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,5" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Tender ID" x:Name="txtTenderID" FontSize="12" MouseDoubleClick="txtTenderID_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Tender/Bid No." x:Name="txtTenderNo" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer" x:Name="txtTenderer" MouseDoubleClick="txtTenderer_MouseDoubleClick"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Project Sponsor" x:Name="txtProjectSponsor" MouseDoubleClick="txtProjectSponsor_MouseDoubleClick"/>
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Tender Source" x:Name="txtTenderSource" MouseDoubleClick="txtTenderSource_MouseDoubleClick"/>
                                <!--<SEACC_WPFControls:SEACC_LabelComboBox Caption="Tender Source" x:Name="cmbTenderSource" DetailBox_Width="225" BorderBrush="{x:Null}"/>-->
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Notice Date" x:Name="dtpNoticeDate" ShowDate="Visible" ShowTime="Hidden" />
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Doc. Collection Date" x:Name="dtpDocCloseDate" ShowDate="Visible" ShowTime="Visible" />
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Tender Closing Date" x:Name="dtpSubClosingDate" ShowDate="Visible" ShowTime="Visible" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Description" x:Name="txtTenderDescription" IsMultiline="True" Height="60" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Order List No" x:Name="txtTenderOrderListNo" Visibility="Collapsed" />
                                <local:UC_Attachments x:Name="Attachments" Height="150" Margin="0,10,10,10" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Expander Header="Contact Person's Details" x:Name="expander1" FontSize="24" Foreground="#FF0096D6" Expanded="expander1_Expanded" >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Name" x:Name="txtName" FontSize="12" />
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Designation" x:Name="txtDesignation" FontSize="12"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Email" x:Name="txtEmail" FontSize="12"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Office Phone No." x:Name="txtOfficeNo" FontSize="12"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Mobile No." x:Name="txtMobileNo" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Address Line-1" x:Name="txtAddress1" FontSize="12"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Address Line-2" x:Name="txtAddress2" FontSize="12"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Address Line-3" x:Name="txtAddress3" FontSize="12"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Town" x:Name="txtTown" FontSize="12" MouseDoubleClick="txtTown_MouseDoubleClick"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="City" x:Name="txtCity" FontSize="12" MouseDoubleClick="txtCity_MouseDoubleClick"/>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Country" x:Name="txtCountry" FontSize="12" MouseDoubleClick="txtCountry_MouseDoubleClick"/>
                                    </StackPanel>
                                </Grid>

                            </Expander>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Expander Header="Items" x:Name="expander2" FontSize="24" Foreground="#FF0096D6" Expanded="expander2_Expanded" >
                                <Border BorderThickness="1" Margin="0,-30,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <Border.Effect>
                                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                                    </Border.Effect>
                                    <Grid Margin="0,0,0,0" Height="200">
                                        <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE710;" Width="30" FontSize="12"  FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Foreground="White" Background="#FF6A6A6A" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Top" Click="btnGridItemAdd_Click" />
                                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontSize="12"  FontFamily="Segoe MDL2 Assets" Background="#FF6A6A6A" Foreground="#FFC70000" BorderBrush="{x:Null}" Click="btnGridItemDelete_Click" />
                                        </StackPanel>
                                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_Tender" Margin="0,35,0,0" Background="#FF6A6A6A" HeaderColor="#FF0083A1" IsReadOnly="False" CanUserAddRows="False" CanUserResizeColumns="True" MouseLeftButtonUp="dgr_Tender_MouseLeftButtonUp" CellEditEnding="dgr_Tender_CellEditEnding" Headerforeground="White" BorderBrush="#FF0081FF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                                <!--<DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="#" Width="20" IsReadOnly="True" Visibility="Collapsed" />-->
                                                <DataGridTextColumn Binding="{Binding SRNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="SR No" Width="50" IsReadOnly="False" >
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Binding="{Binding ItemID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item ID" Width="70" IsReadOnly="True" Visibility="Collapsed"/>
                                                <DataGridTextColumn Binding="{Binding ItemName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item" Width="100" IsReadOnly="True" />
                                                <DataGridTextColumn Binding="{Binding GenericName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Item Name" Width="130" IsReadOnly="True" />
                                                <DataGridTextColumn Binding="{Binding Specification ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Specification" Width="120" IsReadOnly="True"/>
                                                <DataGridTextColumn Binding="{Binding UoMCode ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="UoMCode" Width="70" IsReadOnly="True" Visibility="Collapsed"/>
                                                <DataGridTextColumn Binding="{Binding UoM ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="UoM" Width="45" IsReadOnly="True"/>
                                                <DataGridTextColumn Binding="{Binding Quantity ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Quantity" Width="60" IsReadOnly="False" >
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <!--<DataGridTextColumn Binding="{Binding Delivery ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Deliverys" Width="80" IsReadOnly="True" />-->
                                                <DataGridTemplateColumn IsReadOnly="False" Width="60" Header="Delivery">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding  Icon, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Height="20" Width="16" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Binding="{Binding Strength ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Strength" Width="70" IsReadOnly="False" />
                                                <DataGridTextColumn Binding="{Binding ShelfLife ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Shelf Life" Width="70" IsReadOnly="False" >
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Binding="{Binding Packing ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Packing" Width="105" IsReadOnly="True" />
                                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                                        </SEACC_WPFControls:SEACC_DataGrid>
                                    </Grid>
                                </Border>
                            </Expander>
                        </Grid>

                        <Popup x:Name="pop_Spec" Placement="Center" PopupAnimation="Slide" IsOpen="False" StaysOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" LostFocus="pop_Spec_LostFocus" PlacementTarget="{Binding ElementName=SEACC_Form}" >
                            <Border BorderThickness="0,0,1,1" Margin="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="10"/>
                                </Border.Effect>
                                <Grid Width="350" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="95"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <Grid Background="#FF0083A1" Grid.Row="0">
                                        <Image Grid.Row="0" Source="/SEACC_Tender;component/Resources/pencil-xxl.png" Margin="5,2,2,2" Stretch="Fill" Height="16" Width="16" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <Label Grid.Row="0" FontSize="14" Margin="30,0,0,0" Content="Item Specification" Foreground="White" />
                                        <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" Foreground="#FFEC0000"/>
                                    </Grid>
                                    <SEACC_WPFControls:SEACC_TextBox Grid.Row="1" x:Name="txtItemSpecification" IsMultiline="True" Height="95" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <SEACC_WPFControls:SEACC_Button Grid.Row="2" Content="Save" x:Name="btn_PoPSave" Background="#FF017089" Foreground="White" Click="btn_PoPSave_Click" />
                                </Grid>
                            </Border>
                        </Popup>
                        <Popup x:Name="pop_ItemName" Placement="Center" PopupAnimation="Slide" IsOpen="False" StaysOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" LostFocus="pop_ItemName_LostFocus" PlacementTarget="{Binding ElementName=SEACC_Form}" >
                            <Border BorderThickness="0,0,1,1" Margin="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="10"/>
                                </Border.Effect>
                                <Grid Width="350" Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Background="#FF0083A1" Grid.Row="0">
                                        <Image Grid.Row="0" Source="/SEACC_Tender;component/Resources/pencil-xxl.png" Margin="5,2,2,2" Stretch="Fill" Height="16" Width="16" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <Label Grid.Row="0" FontSize="14" Margin="30,0,0,0" Content="Item Name" Foreground="White" />
                                        <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close1" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close1_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" Foreground="#FFEC0000"/>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Vertical">
                                        <SEACC_WPFControls:SEACC_TextBox x:Name="txtItemName" IsMultiline="True" Height="95" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        <SEACC_WPFControls:SEACC_Button Content="Save" x:Name="btn_PoPSave1" Background="#FF017089" Height="30" Foreground="White" Click="btn_PoPSave1_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                        <Popup x:Name="pop_Packing" Placement="Center" PopupAnimation="Slide" IsOpen="False" StaysOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" LostFocus="pop_Packing_LostFocus" PlacementTarget="{Binding ElementName=SEACC_Form}" >
                            <Border BorderThickness="0,0,1,1" Margin="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="10"/>
                                </Border.Effect>
                                <Grid Width="350" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="95"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <Grid Background="#FF0083A1" Grid.Row="0">
                                        <Image Grid.Row="0" Source="/SEACC_Tender;component/Resources/pencil-xxl.png" Margin="5,2,2,2" Stretch="Fill" Height="16" Width="16" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <Label Grid.Row="0" FontSize="14" Margin="30,0,0,0" Content="Packing" Foreground="White" />
                                        <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close3" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close3_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" Foreground="#FFEC0000"/>
                                    </Grid>

                                    <SEACC_WPFControls:SEACC_TextBox Grid.Row="1" x:Name="txtPacking" IsMultiline="True" Height="95" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <SEACC_WPFControls:SEACC_Button Grid.Row="2" Content="Save" x:Name="btn_PoPSave3" Background="#FF017089" Foreground="White" Click="btn_PoPSave3_Click" />
                                </Grid>
                            </Border>
                        </Popup>
                        <Popup x:Name="pop_Delivery" Placement="Center" PopupAnimation="Slide" StaysOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" Margin="5" PlacementTarget="{Binding ElementName=Main}" OpacityMask="#FF705555" >
                            <Border BorderThickness="0,0,1,1" Margin="10" Background="Black">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="7" />
                                </Border.Effect>
                                <Grid Background="#FFE2E2E2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="50"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Background="#FF0083A1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Image Grid.Row="0" Source="/SEACC_Tender;component/Resources/add-list-xxl.png" Margin="10,10,2,2" Stretch="Fill" Height="28" Width="22" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Label FontSize="16" Content="Delivery Details" Foreground="White" Margin="35,5,0,0" VerticalAlignment="Center" />
                                            <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Margin="10,5,5,0" FontSize="10" Click="btn_Close2_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top"/>
                                        </Grid>
                                        <StackPanel Margin="10,5,10,10" Grid.Row="1" Background="#332E2E2E">
                                            <Grid Margin="10,5" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="7"/>
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Column="0" Grid.Row="0" FontSize="12" Text="SR No" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="0" Grid.Row="1" FontSize="12" Text="Item Name" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="0" Grid.Row="2" FontSize="12" Text="UoM" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="0" Grid.Row="3" FontSize="12" Text="Total Qty" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="0" Grid.Row="4" FontSize="12" Text="Available Qty" Foreground="White" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1" Grid.Row="0" FontSize="12" Text=":" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Grid.Row="1" FontSize="12" Text=":" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Grid.Row="2" FontSize="12" Text=":" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Grid.Row="3" FontSize="12" Text=":" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Grid.Row="4" FontSize="12" Text=":" Foreground="White" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2" Grid.Row="0" FontSize="12" Text="-" x:Name="txtSRRefNo" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Grid.Row="1" FontSize="12" Text="-" x:Name="txtGenericName" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Grid.Row="2" FontSize="12" Text="-" x:Name="txtUoM" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Grid.Row="3" FontSize="12" Text="-" x:Name="txtTotalQty" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Grid.Row="4" FontSize="12" Text="-" x:Name="txtAvailableQty" Foreground="White" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <!--<Separator Grid.Row="1" Height="5" Background="#FF425B74"  Margin="10,0,10,0"/>-->
                                    <Grid Grid.Row="1" Margin="10,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <SEACC_WPFControls:SEACC_DataGrid Grid.Column="0" Margin="0,0,5,0" x:Name="dgv_DeliveryDetails" MinHeight="100" Background="{x:Null}" HeaderColor="#FF00728D" RowStyle="{DynamicResource SEACC_DataGridRow}" BorderBrush="{x:Null}" IsReadOnly="False" CanUserAddRows="False" CellEditEnding="dgv_DeliveryDetails_CellEditEnding">
                                            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding DeliveryID , Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="#" Width="50" IsReadOnly="True"/>
                                                <!--<DataGridTextColumn Binding="{Binding SRNo , Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Serial No" Width="100" IsReadOnly="True" Visibility="Collapsed">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>-->
                                                <DataGridTextColumn Binding="{Binding DeliveryDate , Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Delivery Date" Width="120"/>
                                                <DataGridTextColumn Binding="{Binding Qty , Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Quantity" Width="70">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Binding="{Binding Location , Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Location" Width="120"/>
                                                <DataGridTemplateColumn Width="30" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <SEACC_WPFControls:SEACC_Button x:Name="btnRemove" FontFamily="Segoe MDL2 Assets" Content="&#xE894;"  Margin="2" Width="20" Height="16" FontSize="10" Foreground="Red" Background="{x:Null}" BorderBrush="{x:Null}" Click="btnRemove_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                                        </SEACC_WPFControls:SEACC_DataGrid>

                                    </Grid>
                                    <Separator Grid.Row="2" Height="5" Background="#FF0083A1" Margin="10,0,10,0"/>
                                    <Grid  Grid.Row="3" Margin="10,5,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid Background="#FFFCA604" Grid.Column="0" Margin="20,0,84,0" x:Name="Warning" Grid.ColumnSpan="2" >
                                            <Grid Margin="0,0,20,0">
                                                <Image Grid.Row="0" Source="/SEACC_Tender;component/Resources/warning_amber_384x384.png" Margin="5,2,2,2" Stretch="Fill" Height="30" Width="30" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                <!--<Label Grid.Row="0" FontSize="14" Content="Error" Margin="40,0,0,0" Foreground="#FFFCA604" VerticalAlignment="Top" HorizontalAlignment="Left"/>-->
                                                <TextBlock x:Name="txtWarning" Text="Warning" FontSize="12" Margin="45,0,0,0" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                <TextBlock x:Name="txtError" FontSize="10" Margin="45,0,0,5" Text="-" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="4" />
                                            </Grid>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <SEACC_WPFControls:SEACC_Button  Content="New" x:Name="btn_PoPNew2" Margin="2" Width="75" Background="#FF017089" BorderBrush="White" Foreground="White" Click="btn_PoPNew2_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Popup>
                        <!--<Popup x:Name="pop_Error" PopupAnimation="Slide" IsOpen="False" StaysOpen="True" HorizontalAlignment="Left" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=txtDeliveryQuantity}" HorizontalOffset="0">
                            <Border BorderThickness="0,0,1,1" Margin="10,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="10"/>
                                </Border.Effect>
                                <Grid Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Background="#FFFF4848">
                                        <Image Grid.Row="0" Source="/SEACC_Tender;component/Resources/error.png" Margin="5,2,2,2" Stretch="Fill" Height="20" Width="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <Label Grid.Row="0" FontSize="14" Content="Error" Margin="40,0,0,0" Foreground="White"/>
                                    </Grid>
