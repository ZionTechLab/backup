<Window x:Class="SEACC_PRODUCTION_PHARMA.Controls.frm_RawMeterial_FGTN_Input"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SEACC_PRODUCTION_PHARMA.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib" 
        mc:Ignorable="d" AllowsTransparency="True" WindowStyle="None"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION_PHARMA.Controls" FontWeight="Normal"
        Title="frm_RawMeterial_SemiFinished" Height="350" Width="700" WindowStartupLocation="CenterScreen" >
    <Grid Margin="0,0,3,3">
        <Border Background="#FFFBDECD"  >
            <!--Background="#FFFBDECD"-->
            <Border.Effect>
                <DropShadowEffect ShadowDepth="5" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>
        <Grid>
            <StackPanel>
                <Grid Background="#FFF49F6D" MouseLeftButtonDown="Grid_MouseLeftButtonDown" >
                    <StackPanel Orientation="Horizontal" >
                        <Label Content="Input Raw Meterial List " FontSize="16" Foreground="White" Height="33" Width="660" Margin="2,0,0,0" />
                        <Button x:Name="btnCloseTop" Content="&#xE894;" Height="20" Width="27" FontSize="14" HorizontalAlignment="Right" FontFamily="Segoe MDL2 Assets" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="Black" Margin="0,5" Click="btnCloseTop_Click"/>
                    </StackPanel>
                </Grid>
                <StackPanel>
                    <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,5,6,5"   Height="20" >
                        <SEACC_WPFControls:SEACC_Button Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0"  Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Top" Click="btnGridItemAdd_Click_1" />
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets"  Background="#FF727272" BorderBrush="{x:Null}" Foreground="#FFD31111" Click="btnGridItemDelete_Click" />
                    </StackPanel>

                    <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_MererialInput" Margin="5,1,5,0" Background="White" HeaderColor="#FF727272" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="230" Foreground="Black" RowHeight="{x:Static sys:Double.NaN}" VerticalScrollBarVisibility="Auto" LoadingRow="dgr_MererialReq_LoadingRow" CellEditEnding="dgr_MererialReq_CellEditEnding"  >
                        
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                        </DataGrid.Resources>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <SEACC_WPFControls:SEACC_DataGrid.Columns>

                            <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="#" Width="15" IsReadOnly="False" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Item_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Material ID" Width="105" IsReadOnly="True" />

                            <DataGridTextColumn Binding="{Binding ItemNameMat ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black" Header="Material Name" Width="250"   IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                        <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding UoM ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="UoM" Width="50" IsReadOnly="True" />

                            <DataGridTextColumn Binding="{Binding FloorQty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header= "Floor Qty." Width="120"  IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Qty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header= "Input Qty." Width="120"  IsReadOnly="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </SEACC_WPFControls:SEACC_DataGrid.Columns>

                    </SEACC_WPFControls:SEACC_DataGrid>

                </StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,15,0" >
                        <SEACC_WPFControls:SEACC_Button x:Name="btnCancel" Content="Cancel" Width="80" Height="27" Margin="0,0,15,0" Click="btnCancel_Click" />
                        <SEACC_WPFControls:SEACC_Button x:Name="btnClose" Content="Close" Width="80" Height="27" Click="btnClose_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
