                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_RawMeterialCost" Margin="0,38,0,10"  Background="White" HeaderColor="#FF727272" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="80" Foreground="Black" CanUserResizeColumns="True" MouseDoubleClick="dgr_DirectCost_MouseDoubleClick" LoadingRow="dgr_DirectMeterialCost_LoadingRow" CellEditEnding="dgr_DirectMeterialCost_CellEditEnding" >

