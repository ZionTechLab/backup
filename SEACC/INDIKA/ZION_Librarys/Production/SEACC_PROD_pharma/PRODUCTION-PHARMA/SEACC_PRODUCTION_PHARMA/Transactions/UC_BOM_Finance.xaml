                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_SemiFinishedCost" Margin="0,38,0,10"  Background="White" HeaderColor="#FF727272" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="80" Foreground="Black" CanUserResizeColumns="True"   CellEditEnding="dgr_DirectMeterialCost_CellEditEnding" LoadingRow="dgr_SemiMeterialCost_LoadingRow" MouseDoubleClick="dgr_SemiMeterialCost_MouseDoubleClick" >

