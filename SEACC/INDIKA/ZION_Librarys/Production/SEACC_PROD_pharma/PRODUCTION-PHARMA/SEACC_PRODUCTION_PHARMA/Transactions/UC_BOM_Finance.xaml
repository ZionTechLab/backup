                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="425"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <SEACC_WPFControls:SEACC_LabelTimeSelector Grid.Column="0" Grid.Row="0" Caption="BoM Create Date" x:Name="dtpProdJob_Date" ShowDate="Visible" ShowTime="Hidden" />
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="1"  Caption="BoM #" x:Name="txtProdJobID" MouseDoubleClick="txtProdJobID_MouseDoubleClick" />
                            <SEACC_WPFControls:SEACC_LabelComboBox Grid.Column="0" Grid.Row="2" Caption="BoM Status" x:Name="cmbProdJobStatus" Margin="0"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="3" Caption="Customer" x:Name="txtCustomer" Margin="0"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="4" Caption="Customer Inquiry #" x:Name="txtCustomerInquiry" Margin="0"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="5" Caption="Customer CO #/SO #" x:Name="txtCustomerCOSO" Margin="0"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="6" Grid.RowSpan="2" Caption="Comments" x:Name="txtComments" Margin="0"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="8" Grid.RowSpan="2" Caption="BoM Edit Comments" x:Name="txtReEditComments" Margin="0"/>

                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="6"  Caption="Select Invoice 1 #" x:Name="txtInv1" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="7" Caption="Select Invoice 2 #" x:Name="txtInv2" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="8" Caption="Select Invoice 3 #" x:Name="txtInv3" Visibility="Collapsed" />

                            <SEACC_WPFControls:SEACC_LableTextBox  Grid.Column="1" Grid.Row="0"  Caption="New FG Description" x:Name="txtFinishGoodDescription" VerticalAlignment="Top" />
                            <SEACC_WPFControls:SEACC_LableTextBox  Grid.Column="1" Grid.Row="1"  Caption="New FG Salse Code" x:Name="txtFinishGoodSalesCode" VerticalAlignment="Top"  />
                            <SEACC_WPFControls:SEACC_LableTextBox  Grid.Column="1" Grid.Row="2"  Caption="New FG Salse Name" x:Name="txtFinishGoodSalesName" VerticalAlignment="Top" />
