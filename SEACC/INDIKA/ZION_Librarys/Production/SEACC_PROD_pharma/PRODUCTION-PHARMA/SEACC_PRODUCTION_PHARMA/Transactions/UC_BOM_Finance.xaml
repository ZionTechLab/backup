                                <DataGridTextColumn Binding="{Binding LineNoSub2 ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="#2" Width="25" IsReadOnly="False" Visibility="Collapsed" />

