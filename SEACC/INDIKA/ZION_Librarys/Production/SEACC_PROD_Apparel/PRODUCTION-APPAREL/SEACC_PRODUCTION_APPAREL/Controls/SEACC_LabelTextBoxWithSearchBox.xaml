<UserControl x:Name="userControl" x:Class="SEACC_PRODUCTION_APPAREL.Controls.SEACC_LabelTextBoxWithSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d" GotFocus="userControl_GotFocus" Focusable="True">
    <Grid x:Name="grid">
        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLabelTextBox" x:FieldModifier="public" Caption="{Binding Caption, ElementName=userControl}" Text="{Binding Text, ElementName=userControl}" MouseDoubleClick="txtLabelTextBox_MouseDoubleClick"  />
    </Grid>
</UserControl>
