<UserControl x:Class="SEACC_PRODUCTION.UC_ProductionPlaning"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_PRODUCTION"
             mc:Ignorable="d" 
             xmlns:gunt="clr-namespace:nGantt;assembly=nGantt"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION.UserControls" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" PreviewKeyDown="SEACC_Form_PreviewKeyDown">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="800" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <DatePicker x:Name="dtpPlanDate" Width="200" HorizontalAlignment="Left" />

                <gunt:GanttControl x:Name="gc_productionSchedular"/>
            </StackPanel>
            <GridSplitter Background="#D5D5D5"  Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPlan_ID" Caption="Production Plan ID" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtJobType" Caption="Job Type" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFG_Item" Caption="FG Description"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFG_SalesCode" Caption="FG Sales Code"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFG_SalesName" Caption="FG Sales Name" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFG_UoM" Caption="FG UoM" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFG_Brand" Caption="Brand" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFG_GrnericName" Caption="Generic Name" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFG_Qty" Caption="FG Planned Qty." />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemark" Caption="Remarks" MinHeight="65" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpProductionStart_Date" Caption="Production Start"  ShowDate="Visible" ShowTime="Hidden" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpExFac_Date" Caption="Ex-Factory Release"  ShowDate="Visible" ShowTime="Hidden" />
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>