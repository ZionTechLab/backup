<UserControl x:Class="SEACC_PRODUCTION_APPAREL.UC_Production_BatchClosure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION_APPAREL.Controls" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" PreviewKeyDown="SEACC_Form_PreviewKeyDown" >
        <Grid Margin="15,10,0,50">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="*" MinWidth="0" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1100" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0"  Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />

            <SEACC_WPFControls:SEACC_ScrollViewer  Grid.Column="2" Margin="10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="UIElement_OnPreviewMouseWheel" >
                <StackPanel>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Job Closure # " x:Name="txtBatchClosure_ID"  />
                    <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Closure Date" x:Name="dtpBatchClose_Date" ShowDate="Visible" ShowTime="Hidden" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Remarks" x:Name="txtRemarks" Margin="0" MinHeight="65"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10,5,5"/>
                    <Label Content="Job Filters" FontSize="16" Foreground="#FF515151"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="BoM #" x:Name="txtProdJobID" Margin="0" TextBox_TextChanged="txtProdJobID_TextBox_TextChanged" MouseDoubleClick="txtProdJobID_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="FG Sales Name" x:Name="txtFGSalesName" Margin="0" TextBox_TextChanged="txtProdJobID_TextBox_TextChanged" MouseDoubleClick="TxtFGSalesName_OnMouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Job #" x:Name="txtBatch_ID" Margin="0" TextBox_TextChanged="txtProdJobID_TextBox_TextChanged" MouseDoubleClick="TxtBatch_ID_OnMouseDoubleClick" />
                    <Grid x:Name="grdProdJobBoMs" Margin="0,5,0,0" Visibility="Visible">
                        <Label Content="Opened Jobs :"  Foreground="#FF515151" FontSize="16" />
                        <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" Visibility="Collapsed" >
                            <SEACC_WPFControls:SEACC_Button Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0"  Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Bottom" />
                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets"  Background="#FF727272" BorderBrush="{x:Null}" Foreground="#FFD31111" />
                        </StackPanel>
                        <CheckBox x:Name="chk_selectAll" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Content="Close All"  Margin="37,32,0,0" Checked="chk_selectAll_Checked" Unchecked="chk_selectAll_Unchecked" />
                        <CheckBox x:Name="chk_SuspendselectAll" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Content="Suspend All"  Margin="110,32,0,0" Checked="chk_SuspendselectAll_Checked" Unchecked="chk_SuspendselectAll_Unchecked" />
                        <CheckBox x:Name="chk_CancelselectAll" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Content="Cancel All"  Margin="200,32,0,0" Checked="chk_CancelselectAll_Checked" Unchecked="chk_CancelselectAll_Unchecked" />
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_BoMs" Margin="0,50,0,0" Background="White" HeaderColor="#FF727272" CanUserResizeColumns="True" IsReadOnly="False" CanUserAddRows="False" MinHeight="80" LoadingRow="dgr_BoMs_LoadingRow" >

                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                            </DataGrid.Resources>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>

                            <SEACC_WPFControls:SEACC_DataGrid.Columns>

                                <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="#" Width="35" IsReadOnly="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridCheckBoxColumn Binding="{Binding IsClose ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Close"  Width="45"   IsReadOnly="False" />

                                <DataGridCheckBoxColumn Binding="{Binding IsSuspend ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Suspend"  Width="56"   IsReadOnly="False" />

                                <DataGridCheckBoxColumn Binding="{Binding IsCanceled ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Cancel"  Width="46"   IsReadOnly="False" />

                                <DataGridTextColumn Binding="{Binding BoM_No ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="BoM #" Width="80" IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding Batch_No ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Job #" Width="80" IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding FG_ItemID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"  Foreground="Black" Header="FG ID" Width="90" Visibility="Visible" IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding FG_Item ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="FG Sales Name" Width="250" MaxWidth="400" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding FG_UoM ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="UoM" Width="40" IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding FG_Qty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Job FG Qty." Width="70" IsReadOnly="True" Visibility="Visible" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding COQty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="SO Qty." Width="70" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding CO_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="SO #" Width="80"  IsReadOnly="True" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding Customer ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Customer" Width="180" IsReadOnly="True" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                    </Grid>
                </StackPanel>
            </SEACC_WPFControls:SEACC_ScrollViewer>

        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
    
