<UserControl x:Class="SEACC_PRODUCTION_APPAREL.Transactions.UC_BOM_Production"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_PRODUCTION_APPAREL"
             mc:Ignorable="d" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION_APPAREL.Controls" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" PreviewKeyDown="SEACC_Form_PreviewKeyDown" >
        <Grid Margin="15,10,0,50">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="*" MinWidth="0"/>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="850" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0"  Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" LoadingRow="dgr_Main_LoadingRow" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <SEACC_WPFControls:SEACC_ScrollViewer  Grid.Column="2" Margin="10,0" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="UIElement_OnPreviewMouseWheel" >
                <StackPanel>
                    <Border  BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <Grid Margin="0,5"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="BoM Create Date" x:Name="dtpProdJob_Date" ShowDate="Visible" ShowTime="Hidden"   />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="BoM #" x:Name="txtProdJobID" MouseDoubleClick="txtProdJobID_MouseDoubleClick"  />
                                <SEACC_WPFControls:SEACC_LabelComboBox Caption="BoM Status" x:Name="cmbProdJobStatus" Margin="0"/>
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer" x:Name="txtCustomer" Margin="0"/>
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer Inquiry #" x:Name="txtCustomerInquiry" Margin="0"/>
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer CO #/SO #" x:Name="txtCustomerCOSO" Margin="0"/>
                                <SEACC_WPFControls:SEACC_LableTextBox Grid.RowSpan="2" Caption="Comments" x:Name="txtComments" Margin="0"/>
                                <SEACC_WPFControls:SEACC_LableTextBox Grid.RowSpan="2" Caption="BoM Edit Comments" x:Name="txtReEditComments" Margin="0"/>

                                <local:UC_Attachments x:Name="Attachments" Height="150" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <SEACC_WPFControls:SEACC_LableTextBox  Caption="Prev. BoM Template" x:Name="txtPreviousBoMTemplate" VerticalAlignment="Top" MouseDoubleClick="txtPreviousFG_Item_MouseDoubleClick"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="New FG Description" x:Name="txtFinishedGoodItemDescription"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="New FG Salse Code" x:Name="txtFinishGoodSalesCode" VerticalAlignment="Top" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="New FG Salse Name" x:Name="txtFinishGoodSalesName" VerticalAlignment="Top" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="New FG Item UoM" x:Name="txtFinishGoodUOM"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="New FG Item Qty." x:Name="txtFinishGoodOrderedQty"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Est. Wastage (%)" x:Name="txtFinishedGoodEstWastage" LostFocus="txtFinishedGoodEstWastage_LostFocus" KeyUp="txtFinishedGoodEstWastage_KeyUp" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Planned Qty." x:Name="txtFinishedGoodPlannedQty"   />

                                <Grid Grid.RowSpan="5" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="27"/>
                                        <RowDefinition Height="27"/>
                                        <RowDefinition Height="27"/>
                                        <RowDefinition Height="27"/>
                                        <RowDefinition Height="27"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="55"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0" Grid.Row="1" Content="UoM :" />
                                    <Label Grid.Column="0" Grid.Row="2" Content="Finished Good Qty." />
                                    <Label Grid.Column="0" Grid.Row="3" Content="Estimated Wastage" />
                                    <Label Grid.Column="0" Grid.Row="4" Content="Planned Qty." />

                                    <Label Grid.Column="1" Grid.Row="0" Content="Width :" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtUoM1" Grid.Column="1" Grid.Row="1" Margin="2" MouseDoubleClick="txtUoM1_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtFGQty1"  Grid.Column="1" Grid.Row="2" Margin="2" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtEstWastage1" Grid.Column="1" Grid.Row="3" Margin="2" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtPlannedQty1" Grid.Column="1" Grid.Row="4" Margin="2" />

                                    <Label Grid.Column="2" Grid.Row="0" Content="Length :" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtUoM2" Grid.Column="2" Grid.Row="1"  Margin="2" MouseDoubleClick="txtUoM2_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtFGQty2" Grid.Column="2" Grid.Row="2" Margin="2" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtEstWastage2" Grid.Column="2" Grid.Row="3" Margin="2" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtPlannedQty2" Grid.Column="2" Grid.Row="4" Margin="2" />

                                    <Label Grid.Column="3" Grid.Row="0" Content="Height :" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtUoM3" Grid.Column="3" Grid.Row="1"  Margin="2" MouseDoubleClick="txtUoM3_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtFGQty3" Grid.Column="3" Grid.Row="2" Margin="2" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtEstWastage3" Grid.Column="3" Grid.Row="3" Margin="2" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtPlannedQty3" Grid.Column="3" Grid.Row="4" Margin="2" />

                                    <Label Grid.Column="4" Grid.Row="0" Content="Weight :" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtUoM4" Grid.Column="4" Grid.Row="1"  Margin="2" MouseDoubleClick="txtUoM4_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtFGQty4" Grid.Column="4" Grid.Row="2" Margin="2" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtEstWastage4" Grid.Column="4" Grid.Row="3" Margin="2" />
                                    <SEACC_WPFControls:SEACC_TextBox x:Name="txtPlannedQty4" Grid.Column="4" Grid.Row="4" Margin="2" />
                                </Grid>

                                <SEACC_WPFControls:SEACC_LabelTimeSelector Grid.Column="1" Grid.Row="8" Caption="Ex-Factory Release" x:Name="dtpExFac_Date" ShowDate="Visible" ShowTime="Hidden"   />
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Grid.Column="1" Grid.Row="7" Caption="Production Start" x:Name="dtpProductionStart_Date" ShowDate="Visible" ShowTime="Hidden"   />
                            </StackPanel>
                            
                        </Grid>
                    </Border>

                    <Grid>
                        <Label Content="Materials :" Foreground="#FF515151" FontSize="16" />
                        <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                            <SEACC_WPFControls:SEACC_Button Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0"  Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Bottom" Click="btnMeterialGridAdd_Button_Click" />
                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets"  Background="#FF727272" BorderBrush="{x:Null}" Foreground="#FFD31111" Click="btnGridItemDelete_Click" />
                        </StackPanel>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_MererialReq" Margin="0,38,0,0" Background="White" HeaderColor="#FF727272" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="80" Foreground="Black" RowHeight="{x:Static sys:Double.NaN}" CanUserResizeColumns="True" LoadingRow="dgr_MererialReq_LoadingRow" CellEditEnding="dgr_MererialReq_CellEditEnding" MouseDoubleClick="dgr_MererialReq_MouseDoubleClick">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                            </DataGrid.Resources>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>

                            <SEACC_WPFControls:SEACC_DataGrid.Columns>

                                <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"  Foreground="Black" Header="#" Width="25" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding Item_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Material ID" Width="80" IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding ItemName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Material" Width="240" IsReadOnly="True" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding UoM_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="UoM ID" Visibility="Collapsed" Width="50"   IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding UoM ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="UoM" Width="50"   IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding Qty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Consumption" Width="90"   IsReadOnly="False" Foreground="Black" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                               
                                <DataGridTextColumn Binding="{Binding Wastage ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="In Wastage (%)" Width="90"   IsReadOnly="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding TotalQty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Total Consumption" Width="120"   IsReadOnly="True" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding SectionID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="UoM" Width="50"  Visibility="Collapsed"  IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding SectionName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Prod. Section" Width="105"   IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding EstTime ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="SMV Time (Mins)" MaxWidth="0" Width="0"   IsReadOnly="False" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding LabourCount ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="No. of Labour" MaxWidth="0" Width="0"   IsReadOnly="False" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>


                                <DataGridCheckBoxColumn Binding="{Binding IsSemiFinished ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Header="Semi Finished"  Width="85"   IsReadOnly="True" >
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment"  Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <EventSetter Event="Checked" Handler="dgr_MererialReq_MaterialChecked"/>
                                            <EventSetter Event="Unchecked" Handler="dgr_MererialReq_MaterialUnchecked"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>

                                <DataGridTextColumn Binding="{Binding MatOption_Count ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Material Option(s)" Width="120"   IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                    </Grid>

                    <Grid>
                        <Label Content="WIP Flow :" Foreground="#FF515151" FontSize="16" />
                        <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                            <SEACC_WPFControls:SEACC_Button x:Name="btnWIPItemAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0"  Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" Click="btnWIPItemAdd_Click" Height="20" VerticalAlignment="Bottom" />
                            <SEACC_WPFControls:SEACC_Button x:Name="btnWIPItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets"  Background="#FF727272" BorderBrush="{x:Null}" Foreground="#FFD31111" Click="btnWIPItemDelete_Click" />
                        </StackPanel>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_WIPFlow" Margin="0,38,0,0" Background="White" HeaderColor="#FF727272" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="80" Foreground="Black" RowHeight="{x:Static sys:Double.NaN}" CanUserResizeColumns="True" LoadingRow="dgr_WIPFlow_LoadingRow" CellEditEnding="dgr_WIPFlow_CellEditEnding" MouseDoubleClick="dgr_WIPFlow_MouseDoubleClick">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                            </DataGrid.Resources>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>

                            <SEACC_WPFControls:SEACC_DataGrid.Columns>

                                <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"  Foreground="Black" Header="#" Width="25" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding Item_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="S/F ID" Width="80"  IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding ItemName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="WIP Section Semi Finished Good" Width="240" IsReadOnly="True" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding UoM_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="UoM ID" Visibility="Collapsed" Width="50"   IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding UoM_Name ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="UoM" Width="50"   IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding Qty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Qty" Width="90"   IsReadOnly="False" Foreground="Black" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding OutSection_Name ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Out Section /Prod. Section" Width="155"   IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding InSection_Name ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="In Section / Next Section" Width="155"   IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                

                                <DataGridTextColumn Binding="{Binding Material_Count ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Required Materials" Width="120"   IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                    </Grid>

                    <Grid>
                        <Label Content="Sub Contract In Items :" Foreground="#FF515151" FontSize="16" />
                        <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" />
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_SubInItem" Margin="0,38,0,0" Background="White" HeaderColor="#FF727272" IsReadOnly="False" CanUserAddRows="False" CanUserSortColumns="False" CanUserDeleteRows="False" MinHeight="80" Foreground="Black" RowHeight="{x:Static sys:Double.NaN}" CanUserResizeColumns="True" LoadingRow="dgr_SubInItem_LoadingRow" MouseDoubleClick="dgr_SubInItem_MouseDoubleClick">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                            </DataGrid.Resources>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>

                            <SEACC_WPFControls:SEACC_DataGrid.Columns>

                                <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"  Foreground="Black" Header="#" Width="25" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding MatGrid_LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"  Foreground="Black" Header="Materail #" MaxWidth="0" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding Item_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="S/F ID" Width="80"  IsReadOnly="True" />

                                <DataGridTextColumn Binding="{Binding ItemName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="Sub-In Semi Finished Good" Width="240" IsReadOnly="True" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding UoM_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="UoM ID" Visibility="Collapsed" Width="50"   IsReadOnly="True" />
                                
                                <DataGridTextColumn Binding="{Binding UoM_Name ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Header="UoM" Width="50"   IsReadOnly="True" />

