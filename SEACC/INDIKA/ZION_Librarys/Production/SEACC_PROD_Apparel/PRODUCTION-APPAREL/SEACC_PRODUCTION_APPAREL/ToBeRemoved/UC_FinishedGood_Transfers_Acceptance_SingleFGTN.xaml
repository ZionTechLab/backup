<UserControl x:Class="SEACC_PRODUCTION_APPAREL.UC_FinishedGood_Transfers_Acceptance_SingleFGTN"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION_APPAREL.Controls" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" PreviewKeyDown="SEACC_Form_PreviewKeyDown" >
        <Grid Margin="15,10,0,50">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="*" MinWidth="0" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="850" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0"  Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" LoadingRow="dgr_Main_LoadingRow" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />

            <SEACC_WPFControls:SEACC_ScrollViewer  Grid.Column="2" Margin="10,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Acceptance Date" x:Name="dtpAcpt_Date" ShowDate="Visible" ShowTime="Hidden" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Acceptance #" x:Name="txtAcceptance_ID"  />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="BoM #" x:Name="txtProdJob_ID" MouseDoubleClick="txtProdJob_ID_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="FG Description" x:Name="txtFGDescription" MouseDoubleClick="txtFGDescription_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="FG Sales Name" x:Name="txtFGSalesName" MouseDoubleClick="txtFGSalesName_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Job #" x:Name="txtBatch_ID" MouseDoubleClick="txtBatch_ID_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="FGTN #" x:Name="txtFGTN_ID" MouseDoubleClick="txtFGTN_ID_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Issuing From" x:Name="txtFromStore" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Issuing To" x:Name="txtToStore" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="UoM" x:Name="txtFG_UoM"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="FGTN Qty." x:Name="txtFGTNQty" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Prev. Accepted Qty." x:Name="txtPreviousAcptQty"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Pending FGTN Qty." x:Name="txtPendingFGTNQty" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Accepting Qty." x:Name="txtAcptQty" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Remarks" x:Name="txtRemarks" MinHeight="60"/>
                </StackPanel>
            </SEACC_WPFControls:SEACC_ScrollViewer>

        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
