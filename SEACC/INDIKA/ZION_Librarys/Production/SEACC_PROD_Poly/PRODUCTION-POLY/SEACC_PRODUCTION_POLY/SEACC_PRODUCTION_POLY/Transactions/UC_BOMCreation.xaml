<UserControl x:Class="SEACC_PRODUCTION_POLY.UC_BOMCreation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_PRODUCTION_POLY"
             mc:Ignorable="d" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION_POLY.UserControls" Background="#FFFFFF" FontWeight="Normal" >
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" PreviewKeyDown="SEACC_Form_PreviewKeyDown" >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="*" MinWidth="0" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="850" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0"  Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" LoadingRow="dgr_Main_LoadingRow" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <SEACC_WPFControls:SEACC_ScrollViewer  Grid.Column="2" Margin="10,0" VerticalScrollBarVisibility="Auto" >
                <StackPanel>
                    <Border  BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid   Margin="0,5"  >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <!-- 0 -->
                                    <RowDefinition Height="auto"/>
                                    <!-- 1 -->
                                    <RowDefinition Height="auto"/>
                                    <!-- 2 -->
                                    <RowDefinition Height="auto"/>
                                    <!-- 3 -->
                                    <RowDefinition Height="auto"/>
                                    <!-- 4 -->
                                    <RowDefinition Height="auto"/>
                                    <!-- 5 -->
                                    <RowDefinition Height="auto"/>
                                    <!-- 6 -->
                                    <RowDefinition Height="auto"/>
                                    <!-- 7 -->
                                    <RowDefinition Height="auto"/>
                                    <!-- 8 -->
                                    <RowDefinition Height="auto"/>
                                    <!-- 9 -->

                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="0"  Caption="Salesman" x:Name="txtSalesMan" MouseDoubleClick="txtSalesMan_MouseDoubleClick"  />
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Grid.Column="0" Grid.Row="1" Caption="Job Create Date" x:Name="dtpProdJob_Date" ShowDate="Visible" ShowTime="Hidden"  VerticalAlignment="Top" />
                                <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="2"  Caption="BoM/Job #" x:Name="txtProdJobID" MouseDoubleClick="txtProdJobID_MouseDoubleClick"  />
                                <SEACC_WPFControls:SEACC_LabelComboBox Grid.Column="0" Grid.Row="3" Caption="BoM/Job Status" x:Name="cmbProdJobStatus" Margin="0" />
                                <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="4" Caption="Customer" x:Name="txtCustomer" Margin="0" MouseDoubleClick="txtCustomer_MouseDoubleClick"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="5" Caption="Customer Inquiry #" x:Name="txtCustomerInquiry" Margin="0" MouseDoubleClick="txtCustomerInquiry_MouseDoubleClick"/>
                                <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="6" Caption="Customer CO #/SO #" x:Name="txtCustomerCOSO" Margin="0" MouseDoubleClick="txtCustomerCOSO_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="7" Grid.RowSpan="2" Caption="Comments" x:Name="txtComments"/>
                                <local:UC_Attachments Grid.Column="0" Grid.Row="9"   x:Name="Attachments" Height="150" />

                                <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="1" Grid.Row="0" x:Name="txtJobTemplate" FontSize="12" Caption="Prev. BoM Template" MouseDoubleClick="txtJobTemplate_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="1" Grid.Row="1" x:Name="txtFinishedGood_ID" FontSize="12" Caption="FG Description" MouseDoubleClick="txtFinishedGood_ID_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox  Grid.Column="1" Grid.Row="2"  Caption="FG Quantity UoM" x:Name="txtFinishGoodUOMQty" VerticalAlignment="Top" MouseDoubleClick="txtFinishGoodUOM_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox  Grid.Column="1" Grid.Row="3" Caption="FG Quantity" x:Name="txtFinishGoodOrderedQty" VerticalAlignment="Top" />
                                <SEACC_WPFControls:SEACC_LableTextBox  Grid.Column="1" Grid.Row="4" Caption="FG Weight UoM" x:Name="txtFinishGoodUOMWeight" VerticalAlignment="Top" MouseDoubleClick="txtFinishGoodUOMWeight_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox  Grid.Column="1" Grid.Row="5" Caption="FG Weight" x:Name="txtFinishGoodOrderedWeight" VerticalAlignment="Top" />
                                <SEACC_WPFControls:SEACC_LabelCheckBox Grid.Column="1" Grid.Row="6" Caption="Finished Good" x:Name="chkIsFinishedGood" IsChecked="True" />
                                <SEACC_WPFControls:SEACC_LabelCheckBox Grid.Column="1" Grid.Row="7" Caption="Semi Finished Good" x:Name="chkIsSemiFinished"  IsChecked="True" />
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Grid.Column="1" Grid.Row="8" Caption="Production Start" x:Name="dtpProductionStart_Date" ShowDate="Visible" ShowTime="Hidden"  VerticalAlignment="Top" />
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Grid.Column="1" Grid.Row="9" Caption="Ex-Factory Release" x:Name="dtpExFac_Date" ShowDate="Visible" ShowTime="Hidden"  VerticalAlignment="Top" />
                            </Grid>

                           
                        </StackPanel>
                    </Border>

                    <Grid>
                        <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0"  Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Bottom" Click="SEACC_Button_AddDevliveryLocations_Click" />
                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets"  Background="#FF727272" BorderBrush="{x:Null}" Foreground="#FFD31111" Click="btnGridItemDelete_Click" />
                        </StackPanel>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_DeliveryPlan" Margin="0,38,0,0" Background="White" HeaderColor="#FF727272" IsReadOnly="False" CanUserAddRows="False" MinHeight="80" Foreground="Black"  LoadingRow="dgr_DeliveryPlan_LoadingRow" CellEditEnding="dgr_DeliveryPlan_CellEditEnding">

                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                            </DataGrid.Resources>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>

                            <SEACC_WPFControls:SEACC_DataGrid.Columns>

                                <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="#" Width="25" IsReadOnly="True" Foreground="Black">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding BranchNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Branch No" Width="40" Visibility="Collapsed" IsReadOnly="True" Foreground="Black"  />

                                <DataGridTextColumn Binding="{Binding Date ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Delivery Date" Width="85"   IsReadOnly="False" Foreground="Black">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding Branch ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Deliver To (Branch)" Width="120"   IsReadOnly="True" Foreground="Black" />

                                <DataGridTextColumn Binding="{Binding Address ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Address" Width="200"   IsReadOnly="False" Foreground="Black">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <EventSetter Event="KeyDown" Handler="OnTextBoxKeyDown"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding UoM ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Qty. UoM" Width="65"   IsReadOnly="True" Foreground="Black" />

                                <DataGridTextColumn Binding="{Binding Qty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Qty." Width="80"   IsReadOnly="False" Foreground="Black" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding WeightUoM ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Wei. UoM" Width="65"   IsReadOnly="True" Foreground="Black" />

                                <DataGridTextColumn Binding="{Binding Weight ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Weight" Width="80"   IsReadOnly="False" Foreground="Black" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                
                                <DataGridTextColumn Binding="{Binding DeliveryTerms ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Delivery Terms" Width="*"   IsReadOnly="False" Foreground="Black">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <EventSetter Event="KeyDown" Handler="OnTextBoxKeyDown"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                    </Grid>

                    <Grid Margin="0, 20" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="174*"/>
                            <ColumnDefinition Width="52*"/>
                            <ColumnDefinition Width="499*"/>
                        </Grid.ColumnDefinitions>
                        <Border  BorderThickness="1" Grid.ColumnSpan="3">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid   Margin="0,5" Background="#FFF4E7A7"  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="247"/>
                                    <ColumnDefinition Width="239*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1" Grid.Row="0" Background="#FFF4E7A7" >

                                    <Grid Margin="6" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="20*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0"  Text="Total Ordered Qty." VerticalAlignment="Center"/>
                                        <SEACC_WPFControls:SEACC_TextBox  x:Name="txtTotalDeliveryOrderedQty" Grid.Row="0" Grid.Column="1" Margin="25,0,0,0" Grid.ColumnSpan="3" MaxWidth="100" MinWidth="100" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Visibility="Visible" HorizontalAlignment="Right" >
                        <Label x:Name="lblNextUI" Content="BOM DETAILS (Production) >>>" FontSize="18" Foreground="#FFF49F6D" FontWeight="Bold" MouseLeftButtonUp="lblNextUI_MouseLeftButtonUp"  />
                    </StackPanel>
                </StackPanel>
            </SEACC_WPFControls:SEACC_ScrollViewer>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
