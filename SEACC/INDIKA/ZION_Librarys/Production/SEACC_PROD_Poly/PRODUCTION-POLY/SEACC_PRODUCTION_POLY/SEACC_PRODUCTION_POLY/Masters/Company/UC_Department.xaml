<UserControl x:Class="SEACC_PRODUCTION_POLY.Masters.Company.UC_Department"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_PRODUCTION_POLY.Masters.Company"
             mc:Ignorable="d" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION_POLY.UserControls" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" PreviewKeyDown="SEACC_Form_PreviewKeyDown">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Margin="0,0,5,0" Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"/>
            <GridSplitter Background="#D5D5D5"  Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <StackPanel>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDepartmentID"  Caption="Department ID" MouseDoubleClick="txtDepartmentID_MouseDoubleClick"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDeptName"  Caption="Department Name"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDivisionID" Caption="Division" MouseDoubleClick="txtDivisionID_MouseDoubleClick"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAddress" MinHeight="65" Caption="Address"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTelephone" Caption="Telephone"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTelephone1" Caption="Telephone 2" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtExtension" Caption="Extension No" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFax" Caption="Fax"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtContactPerson" Caption="Head of Dept."/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDescription" MinHeight="65" Caption="Remarks" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
