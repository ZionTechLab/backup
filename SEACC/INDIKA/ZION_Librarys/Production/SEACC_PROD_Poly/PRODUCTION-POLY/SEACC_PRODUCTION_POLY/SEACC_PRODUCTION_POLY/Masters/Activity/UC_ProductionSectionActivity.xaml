<UserControl x:Class="SEACC_PRODUCTION_POLY.Masters.UC_ProductionSectionActivity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_PRODUCTION_POLY.Masters"
             mc:Ignorable="d" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION_POLY.UserControls" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" PreviewKeyDown="SEACC_Form_PreviewKeyDown">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Margin="0,0,5,0" Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"/>
            <GridSplitter Background="#D5D5D5"  Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtActivityID" Caption="Activity ID" MouseDoubleClick="txtActivityID_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtActivitydescription" Caption="Description" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtSectionName" Caption="Production Section" MouseDoubleClick="txtSectionName_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="tsShiftHrs" Caption="Day-time Shift Hrs." />
                        <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="tsShiftHrsNight" Caption="Night-time Shift Hrs." />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemark" Caption="Remarks" MinHeight="65" />
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10,5,5"/>
                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                            <!--<Image Source="/SEACC_HR;component/Resources/Setting50.png" Height="36" Width="18"/>-->
                            <Label x:Name="lblRateSetting" Content="Activity Rate Per Hour / Per Day" FontSize="18" Foreground="#FF0096D6" />
                        </StackPanel>
                        
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLabourRate" Caption="Labour Rate (Day Shift)" FontSize="10" />

                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLabourRateNight" Caption="Labour Rate (Night Shift)" FontSize="10" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFactoryOH_Rate" Caption="Factory OH Rate" FontSize="10" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtOtherCostRate" Caption="Other Cost Rate  " FontSize="10" />
                        
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
