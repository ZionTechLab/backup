<UserControl x:Class="SEACC_PRODUCTION_POLY.Reports.UC_Report"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_PRODUCTION_POLY.Reports"
             xmlns:SEACC_WPFControls2="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
             xmlns:SEACC_WPFControls3="clr-namespace:SEACC_WPFControls.Controls;assembly=SEACC_WPFControls"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION_POLY.UserControls"
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" PreviewKeyDown="SEACC_Form_PreviewKeyDown">
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="472"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Column="0"  >
                <SEACC_WPFControls2:SEACC_DataGrid x:Name="dgv_Reports" MouseLeftButtonUp="dgv_Reports_MouseLeftButtonUp"  CanUserResizeColumns="True" HeadersVisibility="None" RowHeight="35" Background="#FF515151" HeaderColor="#FFF49F6D" AlternatingRowBackground="#FF2D3E4F" >
                    <SEACC_WPFControls2:SEACC_DataGrid.Columns>
                        <!--<DataGridTextColumn Header="Report ID" Binding="{Binding ReportID}" Width="70" />-->
                        <DataGridTextColumn Header="Report Name" Binding="{Binding ReportName}" ClipboardContentBinding="{x:Null}" Width="300"/>
                    </SEACC_WPFControls2:SEACC_DataGrid.Columns>
                </SEACC_WPFControls2:SEACC_DataGrid>
            </ScrollViewer>

            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

            <Grid Margin="10,0" Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel MaxWidth="550">
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="BoM/Job#" x:Name="txtBoMJob" Visibility="Visible"  />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Customer" x:Name="txtCutomer" MouseDoubleClick="txtCutomer_MouseDoubleClick"   />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Customer Inquiry" x:Name="txtCustomerInquiry" Visibility="Collapsed" />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Customer Order" x:Name="txtCustomerOrder"  Visibility="Collapsed"  />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Job Type" x:Name="txtJobTypes" Visibility="Collapsed"  />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Prod. Section" x:Name="txtProdSection" MouseDoubleClick="txtProdSection_MouseDoubleClick"   />
                        <SEACC_WPFControls3:SEACC_LablelMultipleSelectBox  Caption="BoM/Job Status" x:Name="msbProdJob_Status" Text="All Status" Foreground="Black"  />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Product Range" x:Name="txtProRange"  Visibility="Collapsed" />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Product Category" x:Name="txtProdCategory" Visibility="Collapsed" />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Product Size" x:Name="txtProdSize" Visibility="Collapsed" />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Raw Material" x:Name="txtRawMeterial" MouseDoubleClick="txtRawMeterial_MouseDoubleClick"   />
                        <SEACC_WPFControls2:SEACC_LableTextBox Caption="Finished Good" x:Name="txtFinishedGood" MouseDoubleClick="txtFinishedGood_MouseDoubleClick"  />
                        <SEACC_WPFControls2:SEACC_LabelTimeSelector VerticalAlignment="Top" Caption="Prod. Planned From" x:Name="dtp_FromDate" ShowDate="Visible" ShowTime="Hidden" Foreground="White" />
                        <SEACC_WPFControls2:SEACC_LabelTimeSelector VerticalAlignment="Top" Caption="Prod. Planned To" x:Name="dtp_ToDate" ShowDate="Visible" ShowTime="Hidden" Foreground="White"/>
                        <Grid Margin="0,10,0,0" >
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <SEACC_WPFControls2:SEACC_Button x:Name="btn_Print" Content="Generate" Height="30" Width="90" Background="#FF7E7777" Foreground="White" Margin="5" Click="btn_Print_Click"/>
                                <SEACC_WPFControls2:SEACC_Button x:Name="btn_Clear" Content="Clear" Height="30" Width="90"  Background="#FF7E7777" Foreground="White" Margin="5" Click="btn_Clear_Click"/>
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
