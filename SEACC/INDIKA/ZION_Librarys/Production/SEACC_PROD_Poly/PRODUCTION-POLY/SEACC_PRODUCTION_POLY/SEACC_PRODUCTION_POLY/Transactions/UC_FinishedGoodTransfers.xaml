<UserControl x:Class="SEACC_PRODUCTION_POLY.Transactions.UC_FinishedGoodTransfers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:local="clr-namespace:SEACC_PRODUCTION_POLY.Transactions"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PRODUCTION_POLY.UserControls" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" PreviewKeyDown="SEACC_Form_PreviewKeyDown" >
        <Grid Margin="15,10,0,50">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="*" MinWidth="0" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="850" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0"  Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" LoadingRow="dgr_Main_LoadingRow" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />

            <SEACC_WPFControls:SEACC_ScrollViewer  Grid.Column="2" Margin="10,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="FGTN Date" x:Name="dtpFGTN_Date" ShowDate="Visible" ShowTime="Hidden" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="FGTN #" x:Name="txtFGTN_ID"  />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="BoM/Job #" x:Name="txtProdJob_ID" Margin="0" MouseDoubleClick="txtJob_ID_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="FG Description" x:Name="txtFGItem" Margin="0" MouseDoubleClick="txtFGItem_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Quantity UoM" x:Name="txtFG_QtyUoM" Margin="0"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="SO Qty" x:Name="txtSoQty" Margin="0"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Weight UoM" x:Name="txtFG_WeiUoM" Margin="0"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="SO Weight" x:Name="txtSoWeight" Margin="0"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Prev. Issued Qty." x:Name="txtPreviouslyIssuedQty" Margin="0"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Issuing FGTN Qty" x:Name="txtCurrentlyIssuingQty" Margin="0"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Prev. Issued Weight" x:Name="txtPreviouslyIssuedWeight" Margin="0"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Issuing FGTN Weight" x:Name="txtCurrentlyIssuingWeight" Margin="0"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Issuing From" x:Name="txtFromSection" Margin="0" MouseDoubleClick="txtFromStore_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Issuing To" x:Name="txtToStore" Margin="0" MouseDoubleClick="txtToStore_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Remarks" x:Name="txtRemarks" Margin="0" MinHeight="60"/>
                </StackPanel>
            </SEACC_WPFControls:SEACC_ScrollViewer>

        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
