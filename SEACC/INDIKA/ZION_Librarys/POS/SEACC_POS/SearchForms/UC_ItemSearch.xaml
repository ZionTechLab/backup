<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" x:Class="SEACC_POS.Search_Forms.UC_ItemSearch" 
             mc:Ignorable="d"  Height="50" >
    <Grid>
        <Grid Focusable="True" >
            <Label x:Name="lblHeader" Content="Label"  FontSize="12" VerticalContentAlignment="Center" Foreground="White" Margin="5"/>
            <Grid Margin="97,5,90,5"  >
                <DockPanel>
                    <ComboBox x:Name="cbxSearch"  IsReadOnly="True" IsEditable="True" BorderBrush="{x:Null}" Margin="2" Width="125" FontSize="12" VerticalContentAlignment="Center" SelectionChanged="cbxSearch_SelectionChanged" />
                    <TextBox x:Name="txtFillter" x:FieldModifier="public" HorizontalAlignment="Stretch" BorderBrush="{x:Null}"  Margin="2" FontSize="12" KeyUp="txtFillter_KeyUp" Background="White" VerticalContentAlignment="Center"/>
                </DockPanel>
            </Grid>
            <SEACC_WPFControls:SEACC_Button x:Name="btn_Clear" HorizontalAlignment="Right" Width="38" FontFamily="Segoe MDL2 Assets" Content="&#xE750;" FontSize="22"  Margin="0,5,5,5" Background="#FF394264" Foreground="White" Click="btn_Clear_Click" Visibility="Collapsed" />
            <SEACC_WPFControls:SEACC_Button HorizontalAlignment="Right" Width="38" FontFamily="Segoe MDL2 Assets" Content="&#xE751;" FontSize="22"  Margin="0,5,47,5" Background="#FF394264" Foreground="White" Visibility="Collapsed"  />
            

        </Grid>

        <Popup x:Name="pop_Detail" x:FieldModifier="public" PlacementTarget="{Binding ElementName=txtFillter }" Placement="Bottom" PopupAnimation="Fade" IsOpen="False" StaysOpen="False" Height="500" Opened="pop_Detail_Opened">
            <Grid Background="#FF163351">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" x:Name="dgvSearch" FontSize="12" IsReadOnly="True" CanUserResizeColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" AutoGenerateColumns="False" HorizontalGridLinesBrush="#FFA7C5C2" BorderBrush="#FF163351" GridLinesVisibility="Horizontal" KeyUp="dgvSearch_KeyUp" MouseLeftButtonUp="dgvSearch_MouseLeftButtonUp" Foreground="White" Background="#FF163351" PreviewKeyDown="dgvSearch_PreviewKeyDown" MouseRightButtonUp="dgvSearch_MouseRightButtonUp"  >
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#FF0091EA" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="Padding" Value="3"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="#FF163351" />
                            <!--<Setter Property="Height" Value="25" />-->
                            <Setter Property="Padding" Value="3"/>
                            <!--<Setter Property="ToolTip">
                                    <Setter.Value>
                                        <Image Source="{Binding ImageSource}" MaxHeight="200" MaxWidth="200" RenderOptions.BitmapScalingMode="LowQuality"/>
                                    </Setter.Value>
                                </Setter>-->
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <Image x:Name="pbxImage" x:FieldModifier="public" Grid.Row="1" Width="200" Height="200" Source="/SEACC_POS;component/Resources/Main_Icons/no-image-available.png" Margin="0,10,0,4"/>

            </Grid>
        </Popup>
    </Grid>
</UserControl>