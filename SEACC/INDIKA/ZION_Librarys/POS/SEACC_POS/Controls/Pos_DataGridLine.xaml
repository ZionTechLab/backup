<UserControl x:Name="userControl" x:Class="SEACC_POS.Pos_DataGridLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"   GotFocus="UserControl_GotFocus" LostFocus="UserControl_LostFocus" Background="#7FDADADA" MouseDown="UserControl_MouseDown" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Width_GridColumn0, ElementName=userControl}"/>
                <ColumnDefinition Width="{Binding Width_GridColumn1, ElementName=userControl}"/>
                <ColumnDefinition Width="{Binding Width_GridColumn2, ElementName=userControl}"/>
                <ColumnDefinition Width="{Binding Width_GridColumn3, ElementName=userControl}"/>
                <ColumnDefinition Width="{Binding Width_GridColumn4, ElementName=userControl}"/>
                <ColumnDefinition Width="{Binding Width_GridColumn5, ElementName=userControl}"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Grid.RowSpan="2"  >
                <Border BorderThickness="0,0,1,0" BorderBrush="Black">
                    <TextBox x:Name="txt_ItemCode" Text="{Binding ItemCode, ElementName=userControl}" VerticalAlignment="Center" Margin="5" Background="{x:Null}" BorderBrush="{x:Null}" GotFocus="GridCell_GotFocus" />
                </Border>
            </Grid>
            <Grid Grid.Column="1" Grid.RowSpan="2" >
                <Border BorderThickness="0,0,1,0" BorderBrush="Black">
                    <TextBox x:Name="txt_Desc" Text="{Binding ItemName, ElementName=userControl}" VerticalAlignment="Center" Margin="5" Background="{x:Null}" BorderBrush="{x:Null}" GotFocus="GridCell_GotFocus" />
           </Border>
                </Grid>
            <Grid Grid.Column="2" Grid.RowSpan="2" >
                <Border BorderThickness="0,0,1,0" BorderBrush="Black">
                    <TextBox x:Name="txt_UOM" Text="{Binding UOM, ElementName=userControl}" VerticalAlignment="Center" Margin="5" Background="{x:Null}" BorderBrush="{x:Null}" GotFocus="GridCell_GotFocus" />
                </Border>
            </Grid>
            <Grid Grid.Column="3" Grid.RowSpan="2" >
                <Border BorderThickness="0,0,1,0" BorderBrush="Black">
                    <TextBox x:Name="txt_QTY" Text="{Binding QTY, ElementName=userControl}" VerticalAlignment="Center" Margin="5" Background="{x:Null}" BorderBrush="{x:Null}" GotFocus="GridCell_GotFocus" />
                </Border>
            </Grid>
            <Grid Grid.Column="4" Grid.RowSpan="2" >
                <Border BorderThickness="0,0,1,0" BorderBrush="Black">
                    <TextBox x:Name="txt_UnitPrice" Text="{Binding UnitPrice, ElementName=userControl}" VerticalAlignment="Center" Margin="5" Background="{x:Null}" BorderBrush="{x:Null}" GotFocus="GridCell_GotFocus" />
                </Border>
            </Grid>
            <Grid Grid.Column="5" Grid.RowSpan="2" >
                <TextBox x:Name="txt_Amount" Text="{Binding Amount, ElementName=userControl}" VerticalAlignment="Center" Margin="5" Background="{x:Null}" BorderBrush="{x:Null}" GotFocus="GridCell_GotFocus" />
            </Grid>
        </Grid>


    </Grid>
</UserControl>
