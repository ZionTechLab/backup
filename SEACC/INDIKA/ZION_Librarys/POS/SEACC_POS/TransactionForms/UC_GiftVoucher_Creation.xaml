<UserControl x:Class="SEACC_POS.UC_GiftVoucher_Creation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
        xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_POS"
        mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal">

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form"  SizeChanged="SEACC_Form_SizeChanged" >
        <Grid Margin="15,0,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="15,0,5,0" Background="#FF394264" HeaderColor="#FF293A56" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" LoadingRow="dgr_Main_LoadingRow" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Gift Voucher Serial" x:Name="txtVoucherSerial" MouseDoubleClick="txtVoucherSerial_MouseDoubleClick"  />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Voucher Amount" x:Name="txtAmount" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Voucher Create Date" x:Name="dtpVoucherDate" ShowDate="Visible"  ShowTime="Hidden"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Validity Days" x:Name="txtValidityDays" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Expiry Date" x:Name="dtpExpiryDate" ShowDate="Visible"  ShowTime="Hidden" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox Caption="Redeam Status" x:Name="chkRedeemed" IsChecked="True" IsEnabled="False"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Remarks" x:Name="txtRemarks" MinHeight="65"/>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10,5,5"/>
                        <Label Content="Import Gift Vouchers from Excel" FontSize="16" Foreground="#FF0096D6"/>

                        <SEACC_WPFControls:SEACC_LabelTextBoxWithCheckBox  x:Name="txtExcelFilePath" Caption="Excel File" FontSize="12" Margin="4,0,0,0" MouseDoubleClick="txtExcelPath_MouseDoubleClick" TextBox_Checked="txtExcelFilePath_TextBox_CheckedUnChecked" TextBox_UnChecked="txtExcelFilePath_TextBox_CheckedUnChecked" />
                        <SEACC_WPFControls:SEACC_LabelCheckBox Caption="Approved Sheet" x:Name="chkApprovedExcel" IsChecked="True" />
                        <SEACC_WPFControls:SEACC_DataGrid IsReadOnly="True" Name="dgrExcelData" VerticalAlignment="Center" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="80" Margin="4,5,4,4" HeaderColor="#FF727272" CanUserAddRows="False" CanUserDeleteRows="False" Background="{x:Null}" HideContextMenu="False" CanUserResizeColumns="True" LoadingRow="DgrExcelData_OnLoadingRow" >

                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                            </DataGrid.Resources>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="5,2"/>
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>

                            <SEACC_WPFControls:SEACC_DataGrid.Columns>

                                <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"  Foreground="Black" Header="#" Width="25" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <!--<DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                                    <Setter Property="Background" Value="#FF727272" />
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="Padding" Value="5,0,5,0" />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>-->
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding VoucherSerial ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Voucher Serial" Width="120"  IsReadOnly="False" Foreground="Black">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <!--<DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="Background" Value="#FF727272" />
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="Padding" Value="5,2" />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>-->
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding Amount ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Amount" Width="100"  IsReadOnly="False" Foreground="Black">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <!--<DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                                    <Setter Property="Background" Value="#FF727272" />
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="Padding" Value="5,2" />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>-->
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding IssuedDate ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Issued Date" Width="100"  IsReadOnly="False" Foreground="Black">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <!--<DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="Background" Value="#FF727272" />
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="Padding" Value="5,2" />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>-->
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding ValidDays ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Validity Days" Width="100"  IsReadOnly="False" Foreground="Black">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <!--<DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                                    <Setter Property="Background" Value="#FF727272" />
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="Padding" Value="5,2" />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>-->
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding ExpiryDate ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Expiry Date" Width="100"  IsReadOnly="False" Foreground="Black">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <!--<DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="Background" Value="#FF727272" />
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="Padding" Value="5,2" />
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>-->
                                </DataGridTextColumn>

                            </SEACC_WPFControls:SEACC_DataGrid.Columns>


                        </SEACC_WPFControls:SEACC_DataGrid>

                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
