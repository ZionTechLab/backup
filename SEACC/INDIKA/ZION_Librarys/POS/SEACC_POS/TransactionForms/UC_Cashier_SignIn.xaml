<UserControl x:Class="SEACC_POS.TransactionForms.UC_Cashier_SignIn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_POS"
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form"  SizeChanged="SEACC_Form_OnSizeChanged" >
        <Grid Margin="15,0,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="15,0,5,0" Background="#FF394264" HeaderColor="#FF293A56" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" LoadingRow="dgr_Main_LoadingRow" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Day Index" x:Name="txtDayDetailIndex" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Date" x:Name="dtpTxDate" ShowDate="Visible" ShowTime="Hidden"  IsEnabled="False" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Terminal ID" x:Name="txtTerminal_ID" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Cashier" x:Name="txtCashier"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Float Amount" x:Name="txtFloatInAmount" ISNumaric="True"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox Caption="Day End Completed" x:Name="chkManagerSignOffApproved" IsEnabled="False" IsChecked="True" />

                        <Grid x:Name="grdCashWithdrawals" Margin="0,20,0,0">
                            <Label Content="Cash Withdrawals :" FontSize="16" />
                            <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                                <SEACC_WPFControls:SEACC_Button x:Name="btnCashWithdrawAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0"  Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Bottom" Click="btnCashWithdrawAdd_Click" />
                                <SEACC_WPFControls:SEACC_Button x:Name="btnCashWithdrawDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets"  Background="#FF727272" BorderBrush="{x:Null}" Foreground="#FFD31111" Click="btnCashWithdrawDelete_Click" />
                            </StackPanel>
                            <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_CashOut" Margin="0,32,0,0" Background="White" HeaderColor="#FF727272" IsReadOnly="False" CanUserResizeColumns="True" CanUserAddRows="False" CanUserDeleteRows="False" CellEditEnding="dgr_CashOut_CellEditEnding" LoadingRow="dgr_CashOut_LoadingRow" MinHeight="80" >

                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                                </DataGrid.Resources>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                    <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>

                                <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="#" Width="15" IsReadOnly="True" >
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Binding="{Binding Time ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Withdrawal Time" Width="100"   IsReadOnly="True" Foreground="Black">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Binding="{Binding Withdraw_Amount ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header= "Withdraw Amount" Width="120"  IsReadOnly="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Binding="{Binding Remark ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Remark" Width="300"   IsReadOnly="False" Foreground="Black">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style>
                                                <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                                <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                                <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <EventSetter Event="KeyDown" Handler="OnTextBoxKeyDown"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>

                                </SEACC_WPFControls:SEACC_DataGrid.Columns>
                            </SEACC_WPFControls:SEACC_DataGrid>
                        </Grid>

                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>

