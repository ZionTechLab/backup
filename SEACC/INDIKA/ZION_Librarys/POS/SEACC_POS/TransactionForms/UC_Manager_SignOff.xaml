<UserControl x:Class="SEACC_POS.TransactionForms.UC_Manager_SignOff"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_POS"
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal">
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form"  SizeChanged="SEACC_Form_OnSizeChanged" >
        <Grid Margin="15,0,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="15,0,5,0" Background="#FF394264" HeaderColor="#FF293A56" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" LoadingRow="dgr_Main_LoadingRow" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Date" x:Name="dtpTxDate" ShowDate="Visible" ShowTime="Hidden"  IsEnabled="False" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Terminal ID" x:Name="txtTerminal_ID" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Cashier" x:Name="txtCashier"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Physical Cash Amt." x:Name="txtFloatOutAmount" ISNumaric="True"/>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>

