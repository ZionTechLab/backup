<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
        xmlns:local="clr-namespace:SEACC_POS" 
        xmlns:Digiteq="clr-namespace:Digiteq;assembly=SEACC_WPFControls" 
        xmlns:Search_Forms="clr-namespace:SEACC_POS.Search_Forms"
        xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_POS"
        x:Name="frmPosReturnsWindow" x:Class="SEACC_POS.Frm_Item_Returns" 
        Title="frm_posSales" Height="760" Width="1366" WindowStyle="None" WindowStartupLocation="Manual"  AllowsTransparency="True"   
        ResizeMode="CanResizeWithGrip" StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged" Loaded="Window_Loaded" PreviewKeyUp="window_PreviewKeyUp" >

    <!--Main Grid-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >

            <Grid>
                <Grid.RowDefinitions>

                    <!--Title Bar-->
                    <RowDefinition Height="65"/>

                    <!--POS Grid-->
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!--Title Bar-->
                <Grid Grid.Row="0" Background="#FF431621" x:Name="GRD_Titlebar"  MouseDown="GRD_Titlebar_MouseDown" >

                    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form"  Visibility="Collapsed" />

                    <Grid  x:Name="GRD_ControlBox" HorizontalAlignment="Right">
                        <SEACC_WPFControls:SEACC_Button_Close x:Name="btnClose" Content="&#xE8BB;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets"  Click="btnClose_Click" />
                        <SEACC_WPFControls:SEACC_Button x:Name="btnRestore" Content="&#xE923;"  HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,30,0" Click="btnRestore_Click" />
                        <SEACC_WPFControls:SEACC_Button x:Name="btnMinimize" Content="&#xE921;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,60,0" Click="btnMinimize_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right" Margin="0,0,150,0" >
                        <Digiteq:UC_UserIndicator x:Name="usrIndicator"  Height="34" Width="173" UserName="Anoj Thilina" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <local:R2Logo x:Name="R2logoSoftware" VerticalAlignment="Top" Margin="-20,-5,0,0" />
                        <SEACC_WPFControls:Clock  Height="Auto" Background="{x:Null}" FontSize="8" Foreground="#FF9F9C9C" HorizontalAlignment="Left" Width="208" Margin="5,-5,0,0" />
                    </StackPanel>
                </Grid>


                <Grid Grid.Row="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="ColDefPricePanel"  Width="315"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="405*"/>
                            <ColumnDefinition Width="294*"/>
                            <ColumnDefinition Width="218*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="5,10" Background="#FF8E1431" >

                            <Grid Grid.Row="1" Margin="5,0,5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="stpSellingModeRadioButtons" Grid.Column="0" VerticalAlignment="Center">
                                    <RadioButton x:Name="rdoItemSearch" Content="Items" Margin="5,0,0,5" VerticalContentAlignment="Center" Foreground="White" Checked="rdoItemSearch_Checked"/>
                                    <RadioButton x:Name="rdoGiftVoucherSearch" Content="POS Trans."  Margin="5,5,0,0" VerticalContentAlignment="Center" Foreground="White" Checked="rdoPreTransactionSearch_Checked"/>
                                </StackPanel>

                                <Search_Forms:UC_ItemSearch x:Name="ucPreTransactionSearch" Grid.Column="1" Background="#FF8E1431" Visibility="Hidden" IsEnabled="False" PreviewKeyDown="ucPreviousTxSearch_PreviewKeyDown"  SelectionOK="ucPreviousTxSearch_SelectionOK" />
                                <Search_Forms:UC_ItemSearch x:Name="ucItemSearch" Grid.Column="1" Background="#FF8E1431" Visibility="Visible" IsEnabled="True"  PreviewKeyDown="Srh_Items_PreviewKeyDown"  SelectionOK="Srh_Items_SelectionOK" />
                            </Grid>


                        </Grid>
                        <SEACC_WPFControls:SEACC_DataGrid Name="dgrItems"  KeyboardNavigation.TabNavigation="None"  AutoGenerateColumns="False"  Grid.Row="1" FontSize="12" IsReadOnly="False" CellEditEnding="dgItems_CellEditEnding" MouseLeftButtonUp="dgItems_MouseLeftButtonUp" CanUserAddRows="False" Background="#FFEFF3FF" CanUserResizeColumns="True" Grid.ColumnSpan="3"
                                             Grid.Column="0" BeginningEdit="dgItems_BeginningEdit" LoadingRow="dgItems_LoadingRow" PreviewKeyUp="dgItems_PreviewKeyUp" Margin="15,0" MouseDoubleClick="dgItems_MouseDoubleClick" HeaderColor="#FF8E1431" Foreground="White" >
                            
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="dgc_ItemCode" Header="Item ID" Binding="{Binding ItemCode}" Width="70" CanUserSort="False" IsReadOnly="True" >
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Height" Value="35" />
                                            <Setter Property="Padding" Value="10,0,0,0" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn x:Name="dgc_Description" Header="Item Description" Binding="{Binding Desc}" Width="225" CanUserSort="False" IsReadOnly="True"  >
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Padding" Value="10,0,0,0" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn x:Name="dgc_UOM" Header="UoM" Binding="{Binding UOM}"  Width="50" CanUserSort="False" IsReadOnly="True" >
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn x:Name="dgc_QTY" Header="Qty." Binding="{Binding QTY  ,Mode=TwoWay , UpdateSourceTrigger=LostFocus  }" CanUserSort="False"  Width="80" >
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Padding" Value="0,0,5,0" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="dgc_UnitPrice" Header="Unit Price" Binding="{Binding UnitPrice_Display  ,Mode=TwoWay , UpdateSourceTrigger=LostFocus }" CanUserSort="False"  Width="75" >
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Padding" Value="0,0,5,0" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn x:Name="dgc_NetAmount" Header="Net Amount" Binding="{Binding NetAmount_Display}" CanUserSort="False"   Width="85" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Padding" Value="0,0,5,0" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="dgc_IsFreeItem" Header="Free Item" Binding="{Binding IsFreeItem}" CanUserSort="False" Width="60" FontFamily="Segoe MDL2 Assets" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Height" Value="35" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="dgc_LineDiscPresent" Header="Std. Disc %" Binding="{Binding LineDiscPresent_Display  ,Mode=TwoWay , UpdateSourceTrigger=LostFocus }" CanUserSort="False"   Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Padding" Value="0,0,5,0" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn x:Name="dgc_LineDiscAm" Header="Std. Disc" Binding="{Binding LineDiscAmount_Display  ,Mode=TwoWay , UpdateSourceTrigger=LostFocus }" CanUserSort="False"   Width="70">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Padding" Value="0,0,5,0" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn x:Name="dgc_Amount" Header="Amount" Binding="{Binding AccumulatedAmount_Display}" CanUserSort="False"   Width="85" IsReadOnly="True">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Padding" Value="0,0,5,0" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn x:Name="clmGridDelete" Header="Del."  Width="50" CanUserSort="False" IsReadOnly="True" >
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                            <Setter Property="Height" Value="35" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="Text" Value="Del." />
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="dgc_PrvTxID" Header="Return Txn #" Binding="{Binding PreviousTrans_ID_Dispaly}" CanUserSort="False" Width="100" IsReadOnly="True"  >
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="dgc_Remarks" Header="Remarks" Binding="{Binding Remarks}" CanUserSort="False" Width="150" IsReadOnly="False"  >
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="Background" Value="#FF8E1431" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>

                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>
                            
                             <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="false">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                        </SEACC_WPFControls:SEACC_DataGrid>
                    </Grid>

                    <Grid Grid.Column="1" Background="#ffaaaaaa" >

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <!-- Currency and Buttons 0-->
                                <RowDefinition Height="65" />

                                <!-- POS Transaction ID 1 -->
                                <RowDefinition Height="Auto" />

                                <!-- Sub Total 2-->
                                <RowDefinition Height="Auto "/>

                                <!-- Discount & Total 3-->
                                <RowDefinition Height="Auto"/>

                                <!-- Service Charges 4-->
                                <RowDefinition Height="0" />

                                <!-- Tax (NBT / VAT / SVAT) 5-->
                                <RowDefinition Height="Auto"/>

                                <!-- Grand Total 6-->
                                <RowDefinition Height="100"/>

                                <!-- Payment 7-->
                                <RowDefinition Height="80"/>

                                <!-- 8-->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" x:Name="grdCurrency" Background="#FF688CAF" Margin="7,7,7,0" MouseDown="grdCurrency_MouseDown" Visibility="Collapsed" >
                                <TextBlock Text="Currency" VerticalAlignment="Top" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="White" FontSize="14" />
                                <Grid Margin="5,0,5,2"  VerticalAlignment="Bottom">
                                    <TextBlock x:Name="lblCurrencyCode"  Text="LKR"  FontSize="15" Foreground="White"  Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                                        <TextBlock Text="Rs. "  FontSize="15" Foreground="White" />
                                        <TextBlock x:Name="lblCurrencyRate" Text="00.00"  FontSize="15" Foreground="White" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Row="0" Margin="0,7,2,0"  Orientation="Horizontal"  HorizontalAlignment="Right" >
                                <SEACC_WPFControls:SEACC_Button x:Name="btnClear" Content="NEW" FontSize="18" Width="145" Background="#FF431621"  Foreground="White" Click="btnClear_Click"  Margin="0,5,5,5" BorderBrush="{x:Null}"/>
                                <!--<SEACC_WPFControls:SEACC_Button x:Name="btnHold" Content="HOLD" FontSize="18" Width="93" Click="btnHold_Click" Background="#FF431621" Foreground="White" Margin="5" BorderBrush="{x:Null}" />-->
                                <SEACC_WPFControls:SEACC_Button x:Name="btnDelete" Content="CANCEL" FontSize="18" Width="145" Click="btnDelete_Click" Background="#FF431621" Foreground="White" Margin="5" BorderBrush="{x:Null}" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="7,7,7,10" >
                                <StackPanel>
                                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTransactionID" Caption ="Transaction #" BoxForeground="Black" FontSize="14" MouseDoubleClick="grd_Transaction_MouseDown" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="7,0,7,10" >
                                <StackPanel>
                                    <Separator Height="5" Background="Black" Margin="0,2,5,2"/>
                                    <TextBlock Text="Sub Total" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="black" FontSize="22" Margin="0,0,0,14" />
                                </StackPanel>
                                <StackPanel   HorizontalAlignment="Right" Margin="2,2,5,2" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <TextBlock Text="Rs. " VerticalAlignment="Center" FontSize="22" Foreground="black" />
                                    <TextBlock x:Name="tbSubTotal" Text="00.00" FontSize="22" Foreground="black" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="3" Margin="7,6,7,10" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,2" MouseLeftButtonUp="DiscountGrid_MouseLeftButtonUp" >
                                    <StackPanel>
                                        <Separator Height="5" Background="Black" Margin="0,2,5,2"/>
                                        <TextBlock Text="Discount (Ctrl+D)" VerticalAlignment="Top" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="black" FontSize="18" />
                                        <Grid Margin="5,0,5,2"  VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="67*"/>
                                                <ColumnDefinition Width="225*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel   Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" >
                                                <TextBlock Text="Rs. "  FontSize="18" Foreground="black" VerticalAlignment="Center" />
                                                <TextBlock x:Name="tbDiscount" Text="00.00"  FontSize="18" Foreground="black" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <Popup x:Name="pop_Discount"  Placement="Left" PopupAnimation="Fade" IsOpen="False" StaysOpen="False" AllowsTransparency="True" PreviewKeyUp="pop_Discount_PreviewKeyUp" >
                                        <Border BorderThickness="0,0,1,1">
                                            <Border.Effect>
                                                <DropShadowEffect/>
                                            </Border.Effect>

                                            <Grid Background="#FF431621" Height="200" Width="500">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="35"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="35"/>
                                                </Grid.RowDefinitions>

                                                <Grid Background="#FF8E1431" Grid.Row="0">
                                                    <TextBlock Text="Discount" Foreground="White" Margin="10,5,5,5"  Width="200" HorizontalAlignment="Left" FontSize="16"/>
                                                    <SEACC_WPFControls:SEACC_Button_Close x:Name="btnDiscoutPopClose" Content="&#xE8BB;" Foreground="White" Margin="10,5"  FontSize="12" HorizontalAlignment="Right" FontFamily="Segoe MDL2 Assets" Background="{x:Null}" BorderBrush="{x:Null}" Click="btnDiscoutPopClose_Click" />
                                                </Grid>

                                                <Grid x:Name="grdMultipleDiscount" Grid.Row="1" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="1*"/>
                                                        <RowDefinition Height="1*"/>
                                                        <RowDefinition Height="1*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="5*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox x:Name="chkDisc1" Grid.Row="0" Grid.Column="0" Content="Discount 1" FontSize="16" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="White" Checked="chk_Ammounts" Unchecked="chk_Ammounts" />
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" >
                                                        <TextBox x:Name="txtDisc1Pct"  FontSize="16"  VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="50" Height="30" LostFocus="txtDiscPct_LostFocus"  />
                                                        <TextBlock Text="%" FontSize="16" Foreground="White" VerticalAlignment="Center" Height="30" Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBox x:Name="txtDisc1Amount" Grid.Row="0" Grid.Column="2" FontSize="16" Margin="30,5,43,5" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" LostFocus="txtDiscAmount_LostFocus"  />

                                                    <CheckBox x:Name="chkDisc2" Visibility="Hidden" Grid.Row="1" Grid.Column="0" Content="Discount 2" FontSize="16" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="White" Unchecked="chk_Ammounts" Checked="chk_Ammounts" />
                                                    <StackPanel Visibility="Hidden" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" >
                                                        <TextBox x:Name="txtDisc2Pct"  FontSize="16"  VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="50" Height="30" LostFocus="txtDiscPct_LostFocus"  />
                                                        <TextBlock Text="%" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBox Visibility="Hidden" x:Name="txtDisc2Amount" Grid.Row="1" Grid.Column="2" FontSize="16" Margin="30,5,43,5" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Height="30" LostFocus="txtDiscAmount_LostFocus" />

                                                    <CheckBox Visibility="Hidden" x:Name="chkDisc3"  Grid.Row="2" Grid.Column="0" Content="Discount 3" FontSize="16" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="White" Checked="chk_Ammounts" Unchecked="chk_Ammounts" />
                                                    <StackPanel Visibility="Hidden" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" >
                                                        <TextBox x:Name="txtDisc3Pct"  FontSize="16"  VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="50" Height="30" LostFocus="txtDiscPct_LostFocus"  />
                                                        <TextBlock Text="%" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBox Visibility="Hidden" x:Name="txtDisc3Amount" Grid.Row="2" Grid.Column="2" FontSize="16" Margin="30,5,43,5" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Height="30" LostFocus="txtDiscAmount_LostFocus" />
                                                </Grid>

                                                <Grid Background="#FF8E1431" Grid.Row="2">
                                                    <SEACC_WPFControls:SEACC_Button x:Name="btnDiscountOk" Width="100" Content="OK" FontSize="16" Margin="5" Background="{x:Null}" BorderBrush="#FF163351" Foreground="White" Click="btnDiscountOk_Click" />
                                                </Grid>

                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Grid Margin="0" Grid.Row="1">
                                    <StackPanel>
                                        <Rectangle Height="1" Fill="#FFD6DBE9"/>
                                        <TextBlock Text="Total" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="black" FontSize="18" Margin="0,0,0,14" />
                                    </StackPanel>
                                    <StackPanel   HorizontalAlignment="Right" Margin="2,2,5,2" VerticalAlignment="Bottom" Orientation="Horizontal">
                                        <TextBlock Text="Rs. "  FontSize="18" VerticalAlignment="Center" Foreground="black" />
                                        <TextBlock x:Name="tbAccumilatedTotal" Text="00.00"  FontSize="18" Foreground="black" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="4" Background="#FF688CAF" Margin="7,7,7,0" MouseLeftButtonUp="ServiceChargeGrid_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Service Charges" VerticalAlignment="Top" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="White" FontSize="14" />
                                    <Grid Margin="5,0,5,2"  VerticalAlignment="Bottom">
                                        <StackPanel   Orientation="Horizontal" HorizontalAlignment="Right" >
                                            <TextBlock Text="Rs. "  FontSize="15" Foreground="White" />
                                            <TextBlock x:Name="lblServiceCharges" Text="{Binding Text, ElementName=txtServiceChargeAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  FontSize="15" Foreground="White" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Popup x:Name="pop_ServiceCharges"  Placement="Left" PopupAnimation="Fade" IsOpen="False" StaysOpen="False" AllowsTransparency="True" PreviewKeyUp="pop_ServiceCharges_PreviewKeyUp" >
                                    <Border BorderThickness="0,0,1,1">
                                        <Border.Effect>
                                            <DropShadowEffect/>
                                        </Border.Effect>

                                        <Grid Background="White" Height="160" Width="500"  >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="35"/>
                                                <RowDefinition Height="60*"/>
                                                <RowDefinition Height="35"/>
                                            </Grid.RowDefinitions>

                                            <Grid Background="#FF3F6E9E" Grid.Row="0">
                                                <TextBlock Text="Service Charges" Foreground="White" Margin="10,5,5,5"  Width="200" HorizontalAlignment="Left" FontSize="16"/>
                                                <SEACC_WPFControls:SEACC_Button_Close x:Name="btnServiceChargePopClose" Content="&#xE8BB;" Foreground="White" Margin="10,5"  FontSize="12" HorizontalAlignment="Right" FontFamily="Segoe MDL2 Assets" Background="{x:Null}" BorderBrush="{x:Null}" Click="btnServiceChargePopClose_Click" />
                                            </Grid>

                                            <Grid Grid.Row="1" Background="#FF11253A">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="31*" />
                                                    <ColumnDefinition Width="19*" />
                                                    <ColumnDefinition Width="25*" />
                                                    <ColumnDefinition Width="25*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*"/>
                                                    <RowDefinition Height="1*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Total" Foreground="White" FontSize="16" Margin="50,11,0,11" Height="21" Width="31" />
                                                <TextBox x:Name="txtscSubTotal" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0" Width="180" HorizontalAlignment="Left" Height="Auto" Margin="30,7,43,7" Text="{Binding Path=Text, ElementName=tbAccumilatedTotal, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" FontSize="16" VerticalContentAlignment="Center" IsEnabled="False" HorizontalContentAlignment="Right"  />

                                                <CheckBox x:Name="chkServiceCharge" Grid.Row="1" Grid.Column="0" Content="Service Charge" FontSize="16" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,0" Foreground="White" Checked="chk_Ammounts" Unchecked="chk_Ammounts" Height="20" Width="121" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Width="68" >
                                                    <TextBox x:Name="txtServiceChargePct" Text="00.00"  FontSize="16"  VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="50" Height="30" LostFocus="txtServiceChargePct_LostFocus"  />
                                                    <TextBlock Text="%" FontSize="16" Foreground="White" VerticalAlignment="Center" Height="30" Margin="5,0,0,0"/>
                                                </StackPanel>
                                                <TextBox x:Name="txtServiceChargeAmount" Text="00.00" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" FontSize="16" Margin="30,7,43,7" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" LostFocus="txtServiceChargeAmount_LostFocus"  />
                                            </Grid>

                                            <Grid Background="#FF3F6E9E" Grid.Row="2">
                                                <SEACC_WPFControls:SEACC_Button x:Name="btnServiceChargeOk" Width="100" Content="OK" FontSize="16" Margin="5" Background="{x:Null}" BorderBrush="#FF163351" Foreground="White" Click="btnServiceChargeOk_Click" />
                                            </Grid>

                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>

                            <StackPanel Grid.Row="5"  Margin="7,7,7,10" Visibility="Collapsed"  >
                                <Separator Height="10" Background="Black" Margin="0,2,5,2"/>
                                <Grid Height="40"  >
                                    <TextBlock Text="NBT" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="black" FontSize="14" Margin="0,0,0,17" />
                                    <Grid Margin="5,0,5,2"  VerticalAlignment="Bottom">
                                        <StackPanel   Orientation="Horizontal" HorizontalAlignment="Right" >
                                            <TextBlock Text="Rs. "  FontSize="15" Foreground="black" />
                                            <TextBlock x:Name="tbNBT" Text="00.00"  FontSize="15" Foreground="black" />
                                        </StackPanel>
                                        <CheckBox x:Name="chkNBT" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" Checked="chk_Ammounts" Unchecked="chk_Ammounts"  />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0" >
                                            <TextBlock x:Name="tbNBTPresentage" Text="25"  FontSize="15" Foreground="black"  VerticalAlignment="Center" />
                                            <TextBlock Text=" %"  FontSize="15" Foreground="black" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Rectangle Height="1" Fill="#FFD6DBE9"/>

                                <Grid Height="40"  >
                                    <TextBlock Text="VAT" VerticalAlignment="Top" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="black" FontSize="14" />
                                    <Grid Margin="5,0,5,2"  VerticalAlignment="Bottom">
                                        <StackPanel   Orientation="Horizontal" HorizontalAlignment="Right" >
                                            <TextBlock Text="Rs. "  FontSize="15" Foreground="Black" />
                                            <TextBlock x:Name="tbVAT" Text="00.00"  FontSize="15" Foreground="Black" />
                                        </StackPanel>
                                        <CheckBox x:Name="chkVAT" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" Unchecked="chk_Ammounts" Checked="chk_Ammounts"  />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0" >
                                            <TextBlock x:Name="tbVATPresentage" Text="25"  FontSize="15" Foreground="Black"  VerticalAlignment="Center" />
                                            <TextBlock Text=" %"  FontSize="15" Foreground="Black" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Rectangle Height="1" Fill="#FFD6DBE9"/>

                                <Grid  Height="40" >
                                    <TextBlock Text="SVAT" VerticalAlignment="Top" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="Black" FontSize="14" />
                                    <Grid Margin="5,0,5,2"  VerticalAlignment="Bottom">
                                        <StackPanel   Orientation="Horizontal" HorizontalAlignment="Right" >
                                            <TextBlock Text="Rs. "  FontSize="15" Foreground="Black" />
                                            <TextBlock x:Name="tbOtherTax" Text="00.00"  FontSize="15" Foreground="Black" />
                                        </StackPanel>
                                        <CheckBox x:Name="chkOtherTax" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" Checked="chk_Ammounts" Unchecked="chk_Ammounts"  />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0" >
                                            <TextBlock x:Name="tbOtherTaxPresentage" Text="25"  FontSize="15" Foreground="Black"  VerticalAlignment="Center" />
                                            <TextBlock Text=" %"  FontSize="15" Foreground="Black" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Row="6" Margin="7,7,7,12" >
                                <StackPanel>
                                    <Separator Height="10" Background="Black" Margin="0,2,5,2"/>
                                    <TextBlock Text="Grand Total" VerticalAlignment="Top" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="Black" FontSize="24" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel   HorizontalAlignment="Right" Margin="2,2,5,2" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <TextBlock Text="Rs. "  FontSize="24" Foreground="Black" />
                                    <TextBlock x:Name="tbGrandTotal" Text="00.00"  FontSize="24" Foreground="Black" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="7" Margin="7,5,7,9" MouseLeftButtonUp="grdPaymentsRow_MouseLeftButtonUp" Background="#FF431621" >
                                <Grid Margin="0,7,7,0" Grid.Row="0"  >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60*"/>
                                        <ColumnDefinition Width="20*"/>
                                        <ColumnDefinition Width="10*"/>
                                        <ColumnDefinition Width="30*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Amount (Ctrl+A)" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Padding="4,2,2,2" HorizontalAlignment="Left" Foreground="White" FontSize="22" />
                                    <Button Grid.Column="3" VerticalAlignment="Top" Background="#FF431621" Click="btnPosPayment_Click" VerticalContentAlignment="Center" BorderBrush="{x:Null}" Margin="0,0,0,8">
                                        <Image Source="/SEACC_POS;component/Resources/PaymentType_Icons/PaymentAdv.png" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>

        <!--Grid Footer-->
        <Grid  Grid.Row="1" Background="#FFD16C19">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="No of Items :" HorizontalAlignment="Left" Foreground="White" Margin="2" />
                    <TextBlock x:Name="tbNoOfItems" Text="0" HorizontalAlignment="Right" Foreground="White" Margin="2" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>