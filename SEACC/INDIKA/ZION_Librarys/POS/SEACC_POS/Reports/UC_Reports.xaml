<UserControl x:Class="SEACC_POS.UC_Reports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:seaccWpfControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
             xmlns:seaccPos="clr-namespace:SEACC_POS"
             mc:Ignorable="d" Background="#FFFFFF">
    <seaccPos:SEACC_Form x:Name="SEACC_Form">
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="472"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Column="0"  >
                <seaccWpfControls:SEACC_DataGrid x:Name="dgv_Reports" MouseLeftButtonUp="dgv_Reports_MouseLeftButtonUp"  CanUserResizeColumns="True" HeadersVisibility="None" RowHeight="35" Background="#FF394264" HeaderColor="#FF293A56" AlternatingRowBackground="#FF2D3E4F" >
                    <seaccWpfControls:SEACC_DataGrid.Columns>
                        <DataGridTextColumn Header="Report ID" Binding="{Binding ReportID}" ClipboardContentBinding="{x:Null}" MaxWidth="0"/>
                        <DataGridTextColumn Header="Report Name" Binding="{Binding ReportName}" ClipboardContentBinding="{x:Null}" Width="300"/>
                    </seaccWpfControls:SEACC_DataGrid.Columns>
                </seaccWpfControls:SEACC_DataGrid>
            </ScrollViewer>

            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

            <Grid Margin="10,0" Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" >
                    <StackPanel MaxWidth="550">
                        <TextBlock></TextBlock>
                        <seaccWpfControls:SEACC_LableTextBox Caption="Branch" x:Name="txtBranch" BoxForeground="Black" MouseDoubleClick="txtBranch_MouseDoubleClick" />
                        <seaccWpfControls:SEACC_LableTextBox Caption="Cashier" x:Name="txtCashier" BoxForeground="Black"  MouseDoubleClick="txtCashier_MouseDoubleClick" />
                        <seaccWpfControls:SEACC_LableTextBox Caption="Counter" x:Name="txtCounter" BoxForeground="Black"  MouseDoubleClick="txtTerminl_MouseDoubleClick" />
                        <seaccWpfControls:SEACC_LableTextBox Caption="Customer" x:Name="txtCustomer" BoxForeground="Black" MouseDoubleClick="txtCustomer_MouseDoubleClick" />
                        <seaccWpfControls:SEACC_LableTextBox Caption="Sales Rep" x:Name="txtSalesRep" BoxForeground="Black" MouseDoubleClick="txtSalesRep_MouseDoubleClick" />
                        <StackPanel x:Name="stkPOSTx_Types" Orientation="Horizontal" Margin="0,2">
                            <Label Content="POS Transactions " Width="120"/>
                            <Border BorderThickness="1" MaxWidth="225" BorderBrush="#FF33ADFF">
                                <StackPanel Orientation="Vertical">
                                    <RadioButton x:Name="rdoAll" Content="All Without Cancelled " Foreground="Black" Margin="5" />
                                    <RadioButton x:Name="rdoCompleted" Content="Completed" Foreground="Black" IsChecked="True" Margin="5"/>
                                    <RadioButton x:Name="rdoHold" Content="Hold" Foreground="Black" Margin="5"/>
                                    <RadioButton x:Name="rdoCancelled" Content="Cancelled" Foreground="Black" Margin="5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <seaccWpfControls:SEACC_LabelTimeSelector VerticalAlignment="Top" Caption="From Date" x:Name="dtp_FromDate" ShowDate="Visible" ShowTime="Hidden" />
                        <seaccWpfControls:SEACC_LabelTimeSelector VerticalAlignment="Top" Caption="To Date" x:Name="dtp_ToDate" ShowDate="Visible" ShowTime="Hidden"/>
                        <Grid Margin="0,10,0,0" >
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <seaccWpfControls:SEACC_Button x:Name="btn_Print" Content="Generate" Height="30" Width="90" Click="btn_Print_Click" Background="#FF293A56" Foreground="White" Margin="5"/>
                                <seaccWpfControls:SEACC_Button x:Name="btn_Clear" Content="Clear" Height="30" Width="90" Click="btn_Clear_Click" Background="#FF293A56" Foreground="White" Margin="5"/>
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </seaccPos:SEACC_Form>
</UserControl>







