<UserControl x:Class="SEACC_servii.UC_GoodIssueNote"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal" >
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" Background="#FF27363B" HeaderColor="#FFDB6E32" />

            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />

            <StackPanel Grid.Column="2" Margin="10,0">
                <Border BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <Grid   Margin="0,5"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="GIN ID" x:Name="txtGINID" MouseDoubleClick="txtGINID_MouseDoubleClick"/>
                            <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="GIN Date" x:Name="dtpGIN" ShowDate="Visible" ShowTime="Hidden"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="GRN ID" x:Name="txtGRN" MouseDoubleClick="txtGRN_MouseDoubleClick" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Estimation ID" x:Name="txtEstimation" Visibility="Collapsed"/>                            
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer" x:Name="txtCustomer" MouseDoubleClick="txtCustomer_MouseDoubleClick" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0">
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Vehicle Tracking ID" x:Name="txtVehicleTracking" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Warehouse" x:Name="txtStore" MouseDoubleClick="txtStore_MouseDoubleClick"  />
                            <SEACC_WPFControls:SEACC_LabelComboBox Caption="Storage Period" x:Name="cmbtoragePeriod" Visibility="Collapsed"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Remarks" x:Name="txtRemark" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Currency ID" x:Name="txtCurrency" Visibility="Collapsed"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Currency Rate" x:Name="txtCurrencyRate" Visibility="Collapsed"/>                            
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderThickness="1" Margin="0,10,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <Grid   Margin="0,5"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Vehicle No" x:Name="txtVehicleNo" MouseDoubleClick="txtVehicleNo_MouseDoubleClick"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Container No" x:Name="txtContainerNo"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Driver NIC" x:Name="txtDriverNIC"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0">
                            <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Date In" x:Name="dtpIn" ShowDate="Visible" ShowTime="Visible"/>
                            <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Date Out" x:Name="dtpOut" ShowDate="Visible" ShowTime="Visible"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Driver Name" x:Name="txtDriverName"/>
                        </StackPanel>
                    </Grid>
                </Border>


                <Grid>
                    <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Click="btnGridItemAdd_Click" Foreground="#FFE2E2E2" Background="#FF27363B" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Bottom" />
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets" Click="btnGridItemDelete_Click" Background="#FF27363B" BorderBrush="{x:Null}" Foreground="#FFE41300" />
                    </StackPanel>
                    <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_details" Margin="0,30,0,0" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" Height="180" CellEditEnding="dgr_details_CellEditEnding" Background="#FF27363B" HeaderColor="#FFDB6E32">
                        <SEACC_WPFControls:SEACC_DataGrid.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.1"/>
                        </SEACC_WPFControls:SEACC_DataGrid.Effect>

                        <SEACC_WPFControls:SEACC_DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="#" Width="30"   IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding GRN ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="GRN NO" Width="100"   IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding StoreID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Warehouse Code" Width="100"   IsReadOnly="True" Visibility="Collapsed" />
                            <DataGridTextColumn Binding="{Binding Store ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Warehouse" Width="100"   IsReadOnly="True" Visibility="Collapsed" />
                            <DataGridTextColumn Binding="{Binding itemID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Commodity ID" Width="100"   IsReadOnly="True" Visibility="Collapsed"/>
                            <DataGridTextColumn Binding="{Binding itemName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Commodity" Width="130"   IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding remarks ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="GIN Remarks" Width="200"   IsReadOnly="False" />
                            <DataGridTextColumn Binding="{Binding Avil_qty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Available QTY" Width="100"   IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding qtySettle ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Issued QTY" Width="100"   IsReadOnly="False" />
                            <DataGridTextColumn Binding="{Binding unitweight ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Unit Weight" Width="80"   IsReadOnly="True" Visibility="Collapsed"/>
                            <DataGridTextColumn Binding="{Binding GrossWeight ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Weight" Width="80"   IsReadOnly="True" />
                        </SEACC_WPFControls:SEACC_DataGrid.Columns>
                    </SEACC_WPFControls:SEACC_DataGrid>
                </Grid>

                <Border BorderBrush="#FF2C2B2B" Background="#FFE6E6E6" BorderThickness="1" Margin="0,10,0,10" Visibility="Hidden">
                    <Grid   Margin="0,5"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0">
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Sub Total" x:Name="txtSubTotal" Visibility="Collapsed"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Discount Percentage" x:Name="txtDiscountPercentage" Visibility="Collapsed"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Discount Total" x:Name="txtDiscountTotal" Visibility="Collapsed"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Grand Total" x:Name="txtGrandTotal" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>

