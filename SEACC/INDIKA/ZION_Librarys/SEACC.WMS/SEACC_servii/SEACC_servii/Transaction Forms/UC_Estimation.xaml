<UserControl x:Class="SEACC_servii.Master_Forms.UC_Estimation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal" >
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1_1" Background="#FF27363B" HeaderColor="#FFDB6E32"  />

            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />

            <StackPanel Grid.Column="2" Margin="10,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <Grid   Margin="0,5"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Estimation ID" x:Name="txtEstimationID" MouseDoubleClick="txtEstimationID_MouseDoubleClick"/>
                            <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Estimation Date" x:Name="dtpEstimation" ShowDate="Visible" ShowTime="Hidden"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer" x:Name="txtCustomer" MouseDoubleClick="txtCustomer_MouseDoubleClick" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Currency ID" x:Name="txtCurrency" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Currency Rate" x:Name="txtCurrencyRate" Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0">
                            <SEACC_WPFControls:SEACC_LabelComboBox Caption="Storage Period" x:Name="cmbStoragePeriod" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Remarks" x:Name="txtRemark"  />
                            <!--<SEACC_WPFControls:SEACC_LableTextBox Caption="Currency ID" x:Name="txtCurrency" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Currency Rate" x:Name="txtCurrencyRate" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Discount Percentage" x:Name="txtDiscountPercentage" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Discount Total" x:Name="txtDiscountTotal" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Grand Total" x:Name="txtGrandTotal" />-->
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Click="btnGridItemAdd_Click" Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Top" />
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets" Click="btnGridItemDelete_Click" Background="#FF727272" BorderBrush="{x:Null}" Foreground="#FFD31111" />
                    </StackPanel>
                    <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_details" Margin="0,30,0,0" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" Height="180" CellEditEnding="dgr_details_CellEditEnding" MouseDoubleClick="dgr_details_MouseDoubleClick" Background="#FF27363B" HeaderColor="#FFDB6E32">
                        <SEACC_WPFControls:SEACC_DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding itemID ,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Header="Item ID" Width="70"   IsReadOnly="True" Visibility="Collapsed"/>
                            <DataGridTextColumn Binding="{Binding itemName ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Commodity" Width="100"   IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding remark ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Description" Width="120"   IsReadOnly="False" />
                            <DataGridTextColumn Binding="{Binding weight ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Weight" Width="60"   IsReadOnly="False" />
                            <DataGridTextColumn Binding="{Binding uomID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="UOM ID" Width="60"   IsReadOnly="False" Visibility="Collapsed" />
                            <DataGridTextColumn Binding="{Binding uomCode ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="UOM" Width="60"   IsReadOnly="False" />
                            <DataGridTextColumn Binding="{Binding qty ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Quantity" Width="80"   IsReadOnly="False" />
                            <DataGridTextColumn Binding="{Binding qtySettle ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="QS" Width="50"   IsReadOnly="False" Visibility="Collapsed" />
                            <DataGridTextColumn Binding="{Binding qtySettle ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Weight Settle" Width="85"   IsReadOnly="False" Visibility="Collapsed" />
                            <DataGridTextColumn Binding="{Binding weightSettle ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Weight Settle" Width="85"   IsReadOnly="False" Visibility="Collapsed" />
                            <DataGridTextColumn Binding="{Binding unitPrice ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Unit Price" Width="90"   IsReadOnly="False" />
                            <DataGridTextColumn Binding="{Binding unitDiscount ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Unit Discount" Width="85"   IsReadOnly="False" Visibility="Collapsed" />
                            <DataGridTextColumn Binding="{Binding totalDiscount ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Total Discount" Width="95"   IsReadOnly="True" Visibility="Collapsed" />
                            <DataGridTextColumn Binding="{Binding totalAmount ,Mode=TwoWay ,UpdateSourceTrigger=PropertyChanged}"   Header="Total Amount" Width="150"   IsReadOnly="True" />
                        </SEACC_WPFControls:SEACC_DataGrid.Columns>
                    </SEACC_WPFControls:SEACC_DataGrid>
                </Grid>

                <Border BorderBrush="#FF2C2B2B" Background="#FFE6E6E6" BorderThickness="1" Margin="0,20,0,10">
                    <Grid   Margin="0,5"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <!--<SEACC_WPFControls:SEACC_LableTextBox Caption="Estimation ID" x:Name="txtEstimationID"/>
                            <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Estimation Date" x:Name="dtpEstimation" ShowDate="Visible" ShowTime="Hidden"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer" x:Name="txtCustomer" MouseDoubleClick="txtCustomer_MouseDoubleClick" />
                            <SEACC_WPFControls:SEACC_LabelComboBox Caption="Storage Period" x:Name="cmbStoragePeriod" />-->
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0">
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Sub Total" x:Name="txtSubTotal"/>
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Discount Percentage" x:Name="txtDiscountPercentage" KeyUp="txtDiscountPercentage_KeyUp" LostFocus="txtDiscountPercentage_LostFocus" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Discount Amount" x:Name="txtDiscountTotal" KeyUp="txtDiscountTotal_KeyUp" LostFocus="txtDiscountTotal_LostFocus" />
                            <SEACC_WPFControls:SEACC_LableTextBox Caption="Grand Total" x:Name="txtGrandTotal" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>

        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>