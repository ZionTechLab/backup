<Window
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
       xmlns:local="clr-namespace:Digiteq" 
       xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
       x:Class="SEACC_servii.frm_Login"
       Title="Login" Height="483" Width="303" WindowStartupLocation="CenterScreen"  AllowsTransparency="True" WindowStyle="None" Background="{x:Null}" FontWeight="Thin" Loaded="Window_Loaded" >
    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="10" Background="White" >

        <Grid.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.5"/>
        </Grid.Effect>
        <Image x:Name="ez_logo_png" Source="ez_logo.png" VerticalAlignment="Top"  Height="105" Margin="0,32,0,0" />
        <Label Foreground="#FF999999" Content="User Login" VerticalAlignment="Top"  FontSize="16" FontWeight="Normal" HorizontalAlignment="Center" Margin="92,127,92,0"/>


        <Grid Background="#FFFAFFBD" Margin="20,180,20,0" Height="34" VerticalAlignment="Top">
            <TextBlock Text="User Name"  Visibility="{Binding Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=txtUserName}"    Foreground="#FF6C6C6C" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0"    />

            <TextBox ToolTip="Enter Your User Name"  Background="Transparent" BorderBrush="#FFEAE9E9" x:Name="txtUserName"   SelectionBrush="#FFE9E9E9" VerticalContentAlignment="Center" />
        </Grid>

        <Grid Background="#FFFAFFBD" Margin="20,220,20,0" Height="34" VerticalAlignment="Top">
            <TextBlock x:Name="lblPwd"  Text="Password"  Visibility="{Binding Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=txtPassword}"    Foreground="#FF6C6C6C" VerticalAlignment="Center" Margin="10,0,0,0"   />

            <PasswordBox ToolTip="Enter Your Password" BorderBrush="#FFEAE9E9" x:Name="txtPassword" SelectionBrush="#FFFDFDFD" Background="Transparent" VerticalContentAlignment="Center" KeyUp="txtPassword_KeyUp_1" />

            <Label x:Name="lblShowPassword"  Width="22" Height="28"  Background="White" Margin="248,170,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF302B2B" MouseDown="lblShowPassword_MouseDown" MouseUp="lblShowPassword_MouseUp" FontFamily="Segoe MDL2 Assets" Content="&#xEB67;" MouseLeave="lblShowPassword_MouseLeave" />

        </Grid>




        <SEACC_WPFControls:SEACC_Button_Close x:Name="Btn_Close" Content="&#xE8BB;" Margin="0,0,0,0" VerticalAlignment="Top" BorderBrush="#FFEEF0F5"  HorizontalAlignment="Right" Width="24" Foreground="#FFF0F0F0" Click="Btn_Close_Click" FontFamily="Segoe MDL2 Assets" Height="24" FontSize="10"/>
        <TextBox x:Name="txtVisiblePasswordbox" BorderBrush="#FF41B1E1" HorizontalAlignment="Left" Margin="88,147,0,0" VerticalAlignment="Top" Width="172" Height="23" Visibility="Hidden" Foreground="Gray" />

        <SEACC_WPFControls:SEACC_Button IsDefault="True" x:Name="Btn_SignIn" Content="Login" Margin="20,269,20,0" VerticalAlignment="Top" Height="36" BorderBrush="White" Foreground="White" Click="Btn_SignIn_Click" Background="#FFFF1313" FontWeight="Normal" FontSize="14">
            <SEACC_WPFControls:SEACC_Button.Effect>
                <DropShadowEffect Opacity="0.2" BlurRadius="10"/>
            </SEACC_WPFControls:SEACC_Button.Effect>
        </SEACC_WPFControls:SEACC_Button>
        <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="#FFD4D4D4" Padding="8" FontWeight="Thin" FontFamily="Utsaah" Height="104" VerticalAlignment="Bottom"><Run Text="Welcome to the real world of Office ERP Software"/><LineBreak/><Run Text="SEACC R2 ERP Powered by DIGITEQ SOLUTIONS (PVT) LTD"/><LineBreak/><Run Text="We are sure you will be delighted to use and access SEACC R2 ERP Software the way you desire !!"/><LineBreak/><LineBreak/><Run/><LineBreak/></TextBlock>
        <!--<Image Margin="0,322,-1,0" Source="2.png" Stretch="Fill" Opacity="0.2"/>-->

        <!--<SEACC_WPFControls:SEACC_Button x:Name="btn_FrogotMyPassword"  Foreground="#FFEEEEEE" Content=" Forgot My Password" Margin="22,0,22,58" Click="FotgotMyPassword_Button_Click_1" VerticalAlignment="Bottom" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" />
        <SEACC_WPFControls:SEACC_Button x:Name="btn_RequestNewAccount" Foreground="#FFEEEEEE" Content=" Request for a new Account" Margin="22,0,22,37" Background="{x:Null}" BorderBrush="{x:Null}" VerticalAlignment="Bottom" HorizontalContentAlignment="Left" Click="btn_RequestNewAccount_Click" />-->
        <!--<Label Foreground="#FF999999" Content="Password" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Margin="17,0,0,293"/>
        <Label Foreground="#FF999999" Content="User Name" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,116,0,0" Height="23"/>-->

    </Grid>
</Window>
