<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SEACC_servii.User_Controls" 
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" 
        xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" x:Class="SEACC_servii.frm_LandingPage" 
        Title="frm_LandingPage" StateChanged="Window_StateChanged"  WindowStartupLocation="Manual" AllowsTransparency="True" WindowStyle="None"   ResizeMode="CanResizeWithGrip" Loaded="Window_Loaded"   SizeChanged="Window_SizeChanged"  KeyUp="Window_KeyUp_1" PreviewMouseDown="Window_PreviewMouseDown" FontWeight="Thin"  Foreground="Black" 
        >

    <WindowChrome.WindowChrome>
        <WindowChrome
            ResizeBorderThickness="5"
            CaptionHeight="10"
            GlassFrameThickness="0" >
        </WindowChrome>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        
        <Style x:Key="TabItemFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="3,3,3,1" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabItemStyle1" TargetType="{x:Type TabItem}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource TabItemFocusVisual}"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="6,1,6,1"/>
            <Setter Property="BorderBrush" Value="#FFD1D1D1"/>
            <Setter Property="Background" Value="#FFF9F9F9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid SnapsToDevicePixels="true">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Close" Click="MenuItemClose_Click" />
                                    <MenuItem Header="Close All" Click="MenuItemCloseAll_Click"/>
                                    <MenuItem Header="Close All But This" Click="MenuItemCloseAllbutThis_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <Grid Margin="0" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="Content" Grid.Column="0" ContentSource="Header" HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                    <SEACC_WPFControls1:SEACC_Button x:Name="close" Grid.Column="1" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="btnTabClose_Click" FontSize="6" BorderBrush="{x:Null}" Foreground="#FF6A6A6A" Background="Transparent" Margin="1,1,-3,1" VerticalAlignment="Stretch"  />

                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="Bd" Value="#FF4F93D1"/>

                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" TargetName="Bd" Value="#FF2A82D1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="false"/>
                                    <Condition Property="IsMouseOver" Value="true"/>
                                </MultiTrigger.Conditions>

                            </MultiTrigger>
                            <Trigger Property="TabStripPlacement" Value="Bottom">
                                <Setter Property="BorderThickness" TargetName="Bd" Value="1,0,1,1"/>
                            </Trigger>
                            <Trigger Property="TabStripPlacement" Value="Left">
                                <Setter Property="BorderThickness" TargetName="Bd" Value="1,1,0,1"/>
                            </Trigger>
                            <Trigger Property="TabStripPlacement" Value="Right">
                                <Setter Property="BorderThickness" TargetName="Bd" Value="0,1,1,1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true"/>
                                    <Condition Property="TabStripPlacement" Value="Top"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Margin" Value="-2,-2,-2,-1"/>
                                <Setter Property="Margin" TargetName="Content" Value="0,0,0,1"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true"/>
                                    <Condition Property="TabStripPlacement" Value="Bottom"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Margin" Value="-2,-1,-2,-2"/>
                                <Setter Property="Margin" TargetName="Content" Value="0,1,0,0"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true"/>
                                    <Condition Property="TabStripPlacement" Value="Left"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Margin" Value="-2,-2,-1,-2"/>
                                <Setter Property="Margin" TargetName="Content" Value="0,0,1,0"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="true"/>
                                    <Condition Property="TabStripPlacement" Value="Right"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Margin" Value="-1,-2,-2,-2"/>
                                <Setter Property="Margin" TargetName="Content" Value="1,0,0,0"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Scrollbar Thumbs-->
        <Style x:Key="ScrollThumbs" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid x:Name="Grid">
                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto" Fill="Transparent" />
                            <Border x:Name="Rectangle1" CornerRadius="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="5" Height="Auto"  Background="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Horizontal">
                                <Setter TargetName="Rectangle1" Property="Width" Value="Auto" />
                                <Setter TargetName="Rectangle1" Property="Height" Value="7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--ScrollBars-->
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Foreground" Value="LightGray" />
            <Setter Property="Background" Value="#FF535353" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Width="19" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.00001*" />
                            </Grid.RowDefinitions>

                            <Track x:Name="PART_Track" Grid.Row="0" IsDirectionReversed="true" Focusable="false">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="{TemplateBinding Foreground}" Style="{DynamicResource ScrollThumbs}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageUp" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="false" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageDown" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="false" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Thumb" Property="IsMouseOver" Value="true">
                                <Setter Value="{DynamicResource ButtonSelectBrush}" TargetName="Thumb" Property="Background" />
                            </Trigger>
                            <Trigger SourceName="Thumb" Property="IsDragging" Value="true">
                                <Setter Value="{DynamicResource DarkBrush}" TargetName="Thumb" Property="Background" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="GridRoot" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PART_Track" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="12" />
                                <Setter TargetName="Thumb" Property="Tag" Value="Horizontal" />
                                <Setter TargetName="PageDown" Property="Command" Value="ScrollBar.PageLeftCommand" />
                                <Setter TargetName="PageUp" Property="Command" Value="ScrollBar.PageRightCommand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate1">
            <Grid Background="#FF92B4F0" Height="2" VerticalAlignment="Top"></Grid>
        </DataTemplate>
    </Window.Resources>

   
    <Border BorderBrush="#FF41B1E1" BorderThickness="0.65" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="21"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="GRD_Titlebar" VerticalAlignment="Top" Background="#FF4D6082" Grid.Row="0" >
                <Grid Width="87"  HorizontalAlignment="Right" DockPanel.Dock="Right" >
                    <Grid x:Name="GRD_ControlBox" Height="34" VerticalAlignment="Top"    >
                        <SEACC_WPFControls1:SEACC_Button_Close x:Name="btnClose" Content="&#xE8BB;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" Click="btnClose_Click" />
                        <SEACC_WPFControls1:SEACC_Button x:Name="btnRestore" Content="&#xE923;"  HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,30,0" Click="btnRestore_Click"/>
                        <SEACC_WPFControls1:SEACC_Button x:Name="btnMinimize" Content="&#xE921;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,60,0" Click="btnMinimize_Click"/>
                    </Grid>
                </Grid>
                <local:UC_UserIndicator x:Name="User_Indicator"  VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Height="70" HorizontalAlignment="Right" Width="245" DockPanel.Dock="Right" Background="#FF4D6082" Foreground="White"/>
                <Grid x:Name="GridDragable" DockPanel.Dock="Top"  Background="#FF4D6082" MouseDown="GridDragable_MouseDown" >
                    <!--<Button Content="Button" HorizontalAlignment="Left" Height="18" Margin="251,41,0,0" VerticalAlignment="Top" Width="29" Click="Button_Click"/>-->
                </Grid>
            </DockPanel>

            <StatusBar x:Name="Status_Bar" Background="#FF4D6082" VerticalAlignment="Bottom" Grid.Row="2" >
                <TextBlock   Text="© Digiteq Solutions"  Foreground="White" />
            </StatusBar>

            <DockPanel Grid.Row="1"  >
                <Grid x:Name="pnlLeft" Width="300" Background="#FF4A4A4B" >
                    <DockPanel>
                        <!--Quick Launch-->
                        <Border BorderBrush="#FF707070" BorderThickness="0,1" Height="35" DockPanel.Dock="Bottom" >
                            <DockPanel  Margin="0"  >
                                <SEACC_WPFControls1:SEACC_Button x:Name="btnLeftPanalSize" Content="&#xE148;"  Click="btnLeftPanalSize_Click" Width="30" DockPanel.Dock="Right" BorderThickness="1" BorderBrush="{x:Null}" FontFamily="Segoe MDL2 Assets" Background="#FFB6B6B6" Foreground="Black" FontSize="16" ></SEACC_WPFControls1:SEACC_Button>
                                <Grid Background="White">
                                    <TextBlock  Text="Quick Search" Visibility="{Binding Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=txtQuickLaunch}"   VerticalAlignment="Center" Foreground="White" Margin="10,8,5,8" />
                                    <TextBox x:Name="txtQuickLaunch" Background="Transparent"  BorderBrush="#FF3D3D3D" Foreground="White" VerticalContentAlignment="Center" Padding="1" Margin="5,0,28,0" BorderThickness="0" KeyUp="txtQuickLaunch_KeyUp" />
                                    <SEACC_WPFControls1:SEACC_Button x:Name="btnSearch_Launch" BorderThickness="0" Background="{x:Null}" BorderBrush="#FF050505" Content="&#xE11A;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Left" Width="28" Click="btnSearch_Launch_Click" Tag="1" Foreground="Black" Margin="242,0,0,0"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Grid  DockPanel.Dock="Bottom" x:Name="Grd_Search" Height="0">
                            <Grid Margin="10,0,0,0" >
                                <SEACC_WPFControls1:SEACC_DataGrid x:Name="dgv_Search" HeadersVisibility="None" SelectionUnit="FullRow" Background="#FFAEAEAE" RowBackground="#FF9B9B9B" MouseLeftButtonUp="dgv_Search_MouseLeftButtonUp" HideContextMenu="True" >
                                    <SEACC_WPFControls1:SEACC_DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding FormID}" ClipboardContentBinding="{x:Null}" MaxWidth="0" Width="0" />
                                        <DataGridTemplateColumn >
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Image}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding FormName}" ClipboardContentBinding="{x:Null}" Width="*"/>
                                    </SEACC_WPFControls1:SEACC_DataGrid.Columns>
                                </SEACC_WPFControls1:SEACC_DataGrid>
                            </Grid>
                        </Grid>
                        <!--Quick Launch-->

                        <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top" VerticalAlignment="Stretch" Foreground="#FF339B9E" >
                            <StackPanel>
                                <StackPanel x:Name="grd_modules"/>

                                <!--Reports-->
                                <Expander Foreground="AliceBlue" FontSize="20" Header="Reports"  HorizontalAlignment="Left" Margin="3,7,0,0" VerticalAlignment="Top" Background="{x:Null}" Width="290">
                                    <StackPanel  x:Name="aa"  >
                                        <SEACC_WPFControls1:SEACC_Button Background="#FF5873A2" HorizontalContentAlignment="Left" FontSize="13" Height="33" Content="Reports" Foreground="White" x:Name="Reports" Click="Reports_Click"  />
                                    </StackPanel>
                                </Expander>
                                <!--Expanders-->
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <Grid  x:Name="rightPanal" VerticalAlignment="Stretch" >
                    <Grid Background="#FFE1E3E6"></Grid>
                    <TabControl x:Name="MDI" BorderBrush="{x:Null}" Background="{x:Null}"   />
                </Grid>  
            </DockPanel>

            <Grid x:Name="grd_popSubMenus" Grid.Row="1" OpacityMask="#FF535353" Width="300" Margin="199,-1,0,0" HorizontalAlignment="Left" Visibility="Visible" >   
                <Grid Background="#FF4A4A4B">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" >
                        <StackPanel x:Name="stkp_submodules" />
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Grid>
    </Border>

</Window>
