<UserControl x:Class="SEACC_servii.User_Management.UC_UserPermission"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF"  >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid Margin="15,0,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="650" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="#FF34495E" Margin="0,0,5,0">
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" Background="#FF27363B" HeaderColor="#FFDB6E32"/>

                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <CheckBox x:Name="chk_ReadAll" Content="All" Foreground="White" VerticalAlignment="Top"  Width="45" Margin="315,0,0,0" Checked="chk_ReadAll_Checked" Unchecked="chk_ReadAll_Unchecked" />
                    <CheckBox x:Name="chk_WriteAll" Content="All" Foreground="White" VerticalAlignment="Top"  Width="45" Margin="6,0,0,0" Checked="chk_WriteAll_Checked" Unchecked="chk_WriteAll_Unchecked"/>
                    <CheckBox x:Name="chk_EditAll" Content="All" Foreground="White" VerticalAlignment="Top"  Width="45" Margin="4,0,0,0" Checked="chk_EditAll_Checked" Unchecked="chk_EditAll_Unchecked"/>
                    <CheckBox x:Name="chk_DeleteAll" Content="All" Foreground="White"  VerticalAlignment="Top"  Width="45" Margin="3,0,0,0" Checked="chk_DeleteAll_Checked" Unchecked="chk_DeleteAll_Unchecked"/>
                    <CheckBox x:Name="chk_CheckableAll" Content="All" Foreground="White" VerticalAlignment="Top"  Width="45" Margin="3,0,0,0" Checked="chk_CheckableAll_Checked" Unchecked="chk_CheckableAll_Unchecked"/>
                    <CheckBox x:Name="chk_ApprovableAll" Content="All" Foreground="White"  VerticalAlignment="Top"  Width="45" Margin="3,0,0,0" Checked="chk_ApprovableAll_Checked" Unchecked="chk_ApprovableAll_Unchecked"/>
                </StackPanel>
            </Grid>
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0" >
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel Width="400" HorizontalAlignment="Left">
                        <SEACC_WPFControls:SEACC_LableTextBox Width="350" HorizontalAlignment="Left" x:Name="txtUserID" Caption="User" MouseDoubleClick="txtUserID_MouseDoubleClick"/>



                        <Grid>

                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
