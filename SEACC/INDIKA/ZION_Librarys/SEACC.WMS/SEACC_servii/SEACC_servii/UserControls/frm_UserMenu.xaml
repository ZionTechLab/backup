        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" x:Class="SEACC_servii.User_Controls.frm_UserMenu"
        Title="frm_UserMenu" Height="500" Width="400" AllowsTransparency="True" WindowStyle="None"  LostFocus="Window_LostFocus" FocusableChanged="Window_FocusableChanged" Deactivated="Window_Deactivated" Topmost="True" Loaded="Window_Loaded" Background="{x:Null}">
    <Grid x:Name="s" Background="#FF767676" ManipulationCompleted="Grid_ManipulationCompleted" LostFocus="Grid_LostFocus" Margin="5,0,5,5">
        <Grid.Effect>
            <DropShadowEffect Opacity="0.4" ShadowDepth="2" Color="#FF007ACC"/>
        </Grid.Effect>
        <Grid Margin="0,285,0,0" >
            <TextBlock Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Foreground="White" Margin="140,-14,140,-10"/>
            <Button Width="80" Height="35" Content="Logout" />
        </Grid>
        <!--<SEACC_WPFControls:SEACC_Button Content="Log Off" Foreground="White" HorizontalAlignment="Left" Margin="10,234,0,0" VerticalAlignment="Top" Width="125" Height="25"  Background="#FF0F9C2F"/>
        <SEACC_WPFControls:SEACC_Button Foreground="White" Content="Close" HorizontalAlignment="Left" Margin="155,234,0,0" VerticalAlignment="Top" Width="125" Height="25" Background="#FFAC2020"/>-->

        <Label Content="Current Work Location" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Foreground="White"/>
        <Label Content="Attendance Status" HorizontalAlignment="Left" Margin="10,36,0,0" VerticalAlignment="Top" Foreground="White"/>

        <Label Content=":" HorizontalAlignment="Left" Margin="135,10,0,0" VerticalAlignment="Top" Foreground="White"/>
        <Label Content=":" HorizontalAlignment="Left" Margin="135,36,0,0" VerticalAlignment="Top" Foreground="White"/>
        <Label Content="Avaliblity " HorizontalAlignment="Left" Margin="10,62,0,0" VerticalAlignment="Top" Foreground="White"/>

        <Label x:Name="lblWorkLocation" Content="Digiteq Office Kadana" HorizontalAlignment="Left" Margin="155,10,0,0" VerticalAlignment="Top" Foreground="White"/>
        <Label x:Name="txtAttendanceStatus" Content="In Office" HorizontalAlignment="Left" Margin="155,36,0,0" VerticalAlignment="Top" Foreground="White"/>
        <Label Content="Reminders" HorizontalAlignment="Left" Margin="10,103,0,0" VerticalAlignment="Top" Foreground="White"/>



        <RichTextBox HorizontalAlignment="Left" Height="100" Margin="10,129,0,0" VerticalAlignment="Top" Width="270">
            <FlowDocument>
                <Paragraph>
                    <Run Text="Add More and Delete Grid View"/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
        <TextBox HorizontalAlignment="Left" Height="38" Margin="71,65,0,0" TextWrapping="Wrap" Text="In Meeting Room No.2 10 am-12pm" VerticalAlignment="Top" Width="209"/>

    </Grid>
</Window>
