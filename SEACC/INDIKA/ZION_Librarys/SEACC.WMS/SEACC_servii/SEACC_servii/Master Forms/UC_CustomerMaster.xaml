<UserControl x:Class="SEACC_servii.Master_Forms.UC_CustomerMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" Background="#FF27363B" HeaderColor="#FFDB6E32" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer ID" x:Name="txtCustomerID" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer Code" x:Name="txtCustomerCode" MouseDoubleClick="txtCustomerCode_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer Name" x:Name="txtCustomerName" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer Class" x:Name="txtCustomerClass" MouseDoubleClick="txtCustomerClass_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer Type" x:Name="txtCustomerType" MouseDoubleClick="txtCustomerType_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer Category" x:Name="txtCustomerCategory" MouseDoubleClick="txtCustomerCategory_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Customer Status" x:Name="txtCustomerStatus" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Business Reg. No." x:Name="txtBusinessRegNo"  />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="VAT Reg. No." x:Name="txtVatRegNo"  />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Address" x:Name="txtCustomerAddress"  />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Town" x:Name="txtCustomerTown" MouseDoubleClick="txtCustomerTown_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="City" x:Name="txtCustomerCity" MouseDoubleClick="txtCustomerCity_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="District" x:Name="txtCustomerDistrict" MouseDoubleClick="txtCustomerDistrict_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Province" x:Name="txtCustomerProvince" MouseDoubleClick="txtCustomerProvince_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Country" x:Name="txtCustomerCountry" MouseDoubleClick="txtCustomerCountry_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="ZIP Code" x:Name="txtCustomerZipCode" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="E Mail" x:Name="txtCustomerEmail" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Phone" x:Name="txtCustomerPhone" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Mobile" x:Name="txtCustomerMobile" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Fax" x:Name="txtCustomerFax" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>