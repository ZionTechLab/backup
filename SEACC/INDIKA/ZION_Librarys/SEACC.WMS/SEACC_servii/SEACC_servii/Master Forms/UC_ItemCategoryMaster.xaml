<UserControl x:Class="SEACC_servii.Master_Forms.UC_ItemCategoryMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d" Background="#FFFFFF">
    
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp"  />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <StackPanel>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Category ID" x:Name="txtItemCatID" MouseDoubleClick="txtItemCatID_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Category Name" x:Name="txtItemCatName" />
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Type" x:Name="txtItemTypeName" MouseDoubleClick="txtItemTypeName_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Category Prefix" x:Name="txtCatPrefix" />
                    <SEACC_WPFControls:SEACC_LabelCheckBox Caption="Sub Cat. Enable" x:Name="chkSubCatEnable" IsChecked="True" />
                    <SEACC_WPFControls:SEACC_LabelCheckBox Caption="Sub Cat.2 Enable" x:Name="chkSubCat2Enable" IsChecked="True" />
                    <SEACC_WPFControls:SEACC_LabelCheckBox Caption="Serial No. Enable" x:Name="chkSerialNoEnable" IsChecked="True" />
                    <SEACC_WPFControls:SEACC_LabelCheckBox Caption="Serial No.2 Enable" x:Name="chkSerialNo2Enable" IsChecked="True" />
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Category Counter" x:Name="txtCatCounter" />
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Category Length" x:Name="txtCatLength" />
                </StackPanel>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>