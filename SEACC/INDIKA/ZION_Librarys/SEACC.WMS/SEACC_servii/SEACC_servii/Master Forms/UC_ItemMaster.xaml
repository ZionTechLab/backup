<UserControl x:Class="SEACC_servii.Master_Forms.UC_ItemMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" Background="#FF27363B" HeaderColor="#FFDB6E32" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Commodity Code" x:Name="txtCommodityCode" MouseDoubleClick="txtCommodityCode_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Name" x:Name="txtCommodityName" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="UoM" x:Name="txtUOM" MouseDoubleClick="txtUOM_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Class" x:Name="txtCommodityClass" MouseDoubleClick="txtCommodityClass_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Type" x:Name="txtCommodityType" MouseDoubleClick="txtCommodityType_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Category" x:Name="txtCommodityCategory" MouseDoubleClick="txtCommodityCategory_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Brand" x:Name="txtCommodityBrand" MouseDoubleClick="txtCommodityBrand_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Description" x:Name="txtCommodityDescription" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="1-15 Days Price" x:Name="txtGenPrice15" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="1-30 Days Price" x:Name="txtGenPrice30" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="From 15 Days" x:Name="txtExtPrice15" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="From 30 Days" x:Name="txtExtPrice30" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Unit Weight" x:Name="txtUnitWeight" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Daily Rate" x:Name="txtDailyRate" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
