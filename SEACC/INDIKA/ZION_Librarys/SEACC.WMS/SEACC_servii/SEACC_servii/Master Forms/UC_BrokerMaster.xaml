<UserControl x:Class="SEACC_servii.Master_Forms.UC_BrokerMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" Background="#FF27363B" HeaderColor="#FFDB6E32"   />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Broker ID" x:Name="txtBrokerID" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Broker Code" x:Name="txtBrokerCode" MouseDoubleClick="txtBrokerCode_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Broker Name" x:Name="txtBrokerName" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Broker Percentage" x:Name="txtBrokerPct"  />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Broker Status" x:Name="txtBrokerStatus" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Address" x:Name="txtBrokerAddress"  />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Town" x:Name="txtBrokerTown" MouseDoubleClick="txtBrokerTown_MouseDoubleClick"  Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="City" x:Name="txtBrokerCity" MouseDoubleClick="txtBrokerCity_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="District" x:Name="txtBrokerDistrict" MouseDoubleClick="txtBrokerDistrict_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Province" x:Name="txtBrokerProvince" MouseDoubleClick="txtBrokerProvince_MouseDoubleClick"  Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Country" x:Name="txtBrokerCountry" MouseDoubleClick="txtBrokerCountry_MouseDoubleClick" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="ZIP Code" x:Name="txtBrokerZipCode" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="E Mail" x:Name="txtBrokerEmail" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Phone" x:Name="txtBrokerPhone" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Mobile" x:Name="txtBrokerMobile" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Fax" x:Name="txtBrokerFax" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>

