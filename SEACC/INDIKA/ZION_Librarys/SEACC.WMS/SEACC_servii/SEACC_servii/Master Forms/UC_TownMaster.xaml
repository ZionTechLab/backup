<UserControl x:Class="SEACC_servii.Master_Forms.UC_TownMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced Margin="0,0,5,0" x:Name="dgr_Main" MouseLeftButtonUp="grd_Town_new_MouseLeftButtonUp"  />

            <GridSplitter x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" Background="#D5D5D5" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Town Code" x:Name="txtTownID" MouseDoubleClick="txtDeviceID_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Town Name" x:Name="txtTownName" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="City" x:Name="txtCityCode" MouseDoubleClick="txtCityCode_MouseDoubleClick" />
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>

    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
