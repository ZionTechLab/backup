<UserControl x:Class="SEACC_servii.Master_Forms.UC_UomMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="grd_UoM_MouseLeftButtonUp1" Background="#FF27363B" HeaderColor="#FFDB6E32" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="UOM Code" x:Name="txtUomCode" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="UOM Name" x:Name="txtUomName" />
                        <SEACC_WPFControls:SEACC_LableTextBox  Caption="UoM ID" x:Name="txtUomID" MouseDoubleClick="txtUomID_MouseDoubleClick" Visibility="Collapsed" />
                        <SEACC_WPFControls:SEACC_LableTextBox  Caption="UoM Category" x:Name="txtUomCategoryID" MouseDoubleClick="txtUomCategoryID_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsVisible" Caption="Is Visible" IsChecked="True" Visibility="Collapsed" />
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsforsale" Caption="Is For Sales" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsforPacking" Caption="Is For Packing" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsForKiloCalculation" Caption="Is For Kg. Calculation" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsforBagCalculation" Caption="Is For Bag Calculation"  IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsQty" Caption="Is Quantity" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsWeight" Caption="Is Weight" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsLength" Caption="Is Length" IsChecked="True" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>