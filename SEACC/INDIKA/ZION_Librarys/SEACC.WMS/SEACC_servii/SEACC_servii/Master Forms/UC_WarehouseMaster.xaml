<UserControl x:Class="SEACC_servii.Master_Forms.UC_WarehouseMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" Background="#FF27363B" HeaderColor="#FFDB6E32"  />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Warehouse Code" x:Name="txtWarehouseCode" MouseDoubleClick="txtWarehouseCode_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Name" x:Name="txtWarehouseName" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Address" x:Name="txtAddress"  />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Contact Person" x:Name="txtContactPersonName" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Phone" x:Name="txtWarehousePhone" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Fax" x:Name="txtWarehouseFax" />
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsDamageStore" Caption="Damage Store" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsSingleItemStock" Caption="Songle Item Store" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsMainStore" Caption="Main Store" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsTradingStore" Caption="Trading Store" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsShowRoom" Caption="Show Room" IsChecked="True" Visibility="Collapsed"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsReturnedStore" Caption="Return Store" IsChecked="True" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
