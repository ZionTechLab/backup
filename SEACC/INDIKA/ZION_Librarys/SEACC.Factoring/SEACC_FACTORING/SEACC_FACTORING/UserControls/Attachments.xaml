<UserControl x:Class="SEACC_FACTORING.UserControls.Attachments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                          xmlns:local="clr-namespace:SEACC_FACTORING.UserControls"
           mc:Ignorable="d" d:DesignWidth="300" Height="80.233" Background="#B2878787" MouseDown="UserControl_MouseDown">
    <UserControl.Effect>
        <DropShadowEffect BlurRadius="10"/>
    </UserControl.Effect>
    <Grid>
        <Image x:Name="image" HorizontalAlignment="Left" Margin="5,5,0,5" Width="{Binding ActualHeight, ElementName=image, Mode=OneWay}" Source="/SEACC_FACTORING;component/Resources/others.jpg" Stretch="Fill"/>

    </Grid>
</UserControl>
