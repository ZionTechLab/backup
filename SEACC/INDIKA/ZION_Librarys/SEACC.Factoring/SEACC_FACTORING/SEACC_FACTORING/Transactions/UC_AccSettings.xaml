<UserControl x:Class="SEACC_FACTORING.UC_AccSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_FACTORING"
              xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_FACTORING.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" >
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Accounts" VerticalAlignment="Center" FontSize="18" Height="24" Margin="0,4,0,6"/>
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#FF494949" VerticalAlignment="Bottom" Height="1"/>
            <StackPanel Grid.Row="1" Margin="0,10,0,0" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="Factoring Charges"  Foreground="Black" />
                    <Label Grid.Column="0" Grid.Row="1" Content="VAT on Factoring Charges"  Foreground="Black" />
                    <Label Grid.Column="0" Grid.Row="2" Content="NBT on Factoring Charges"  Foreground="Black" />
                    <Label Grid.Column="0" Grid.Row="3" Content="Cheques in Hand"  Foreground="Black" />
                    <Label Grid.Column="0" Grid.Row="4" Content="Factoring Control"  Foreground="Black" />

                    <SEACC_WPFControls:SEACC_TextBox Grid.Column="1" Grid.Row="0" x:Name="txtFactCharges" MouseDoubleClick="txtFactCharges_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_TextBox Grid.Column="1" Grid.Row="1" x:Name="txtFactCharges_VAT" MouseDoubleClick="txtFactCharges_VAT_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_TextBox Grid.Column="1" Grid.Row="2" x:Name="txtFactCharges_NBT" MouseDoubleClick="txtFactCharges_NBT_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_TextBox Grid.Column="1" Grid.Row="3" x:Name="txtCIH" MouseDoubleClick="txtCIH_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_TextBox Grid.Column="1" Grid.Row="4"  x:Name="txtFactoringControl" MouseDoubleClick="txtFactoringControl_MouseDoubleClick"/>                      
                        
                </Grid>
                
            </StackPanel> 
        </Grid>

    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
