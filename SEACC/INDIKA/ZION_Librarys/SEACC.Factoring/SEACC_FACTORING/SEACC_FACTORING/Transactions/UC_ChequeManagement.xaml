<UserControl x:Class="SEACC_FACTORING.UC_ChequeManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_FACTORING"
              xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_FACTORING.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" >
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid x:Name="Main" Margin="0,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="800" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,5,0" >

                <Grid  Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition  Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"></RowDefinition>
                    </Grid.RowDefinitions>
                    <SEACC_WPFControls:SEACC_ToggleButton x:Name="btn_Factor"  Text="Factoring Approval" Grid.Column="0" BorderBrush="#FFF49F6D" Click="btn_Factor_Click" />

                    <SEACC_WPFControls:SEACC_ToggleButton x:Name="btn_Deposit"  Text="Cheque Deposit" Grid.Column="1" BorderBrush="#FFF49F6D" Click="btn_Deposit_Click" />
                    <SEACC_WPFControls:SEACC_ToggleButton x:Name="btn_Reconsilation"  Text="Cheque Reconsilation" Grid.Column="2"  BorderBrush="#FFF49F6D" Click="btn_Reconsilation_Click" />
                </Grid>
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,40,0,0" Grid.Row="1" Grid.Column="0" Background="#FF515151" HeaderColor="#FFF49F6D" Visibility="Hidden" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"  />
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Factoring"  Margin="0,40,0,0" Grid.Row="1" Grid.Column="0" Background="#FF515151" HeaderColor="#FFF49F6D"  MouseLeftButtonUp1="dgr_Factoring_MouseLeftButtonUp1" />
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Reconcilation"  Margin="0,40,0,0" Grid.Row="1" Grid.Column="0" Background="#FF515151" HeaderColor="#FFF49F6D" Visibility="Hidden" MouseLeftButtonUp="dgr_Reconcilation_MouseLeftButtonUp" />
                   
                <StackPanel Orientation="Horizontal" Margin="6,0,0,-30"  VerticalAlignment="Bottom" HorizontalAlignment="Left" >
                    <TextBlock   Text="Total Records - " Foreground="#FF34495E" />
                    <TextBlock   Text="105" Foreground="#FF7E7E7E" Name="lblTotal_Count"/>
                    <TextBlock   Text=" | " Foreground="#FF34495E" />
                    <TextBlock   Text="100,456.00" Foreground="#FF7E7E7E" Name="lblTotal_Amount" />
                    <TextBlock   Text="    Selected records - " Foreground="#FF34495E" />
                    <TextBlock   Text="105" Foreground="#FF7E7E7E" Name="lblSelected_Count"/>
                    <TextBlock   Text=" | " Foreground="#FF34495E" />
                    <TextBlock   Text="100,456.00" Foreground="#FF7E7E7E" Name="lblSelected_Amount"/>
                </StackPanel>
            </Grid>

            <GridSplitter Background="#D5D5D5" Grid.Column="1" Grid.RowSpan="2" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

            <Grid  Grid.Column="2" Margin="5,0,0,0"  >
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel >
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Account No" x:Name="txtAcc_NO" MouseDoubleClick="txtAcc_NO_MouseDoubleClick" Visibility="Collapsed" />
                        <Grid Margin="6,10,0,0" x:Name="grdBankDetail" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="18"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"  Text="Bank"/>
                            <TextBlock Grid.Row="1" Grid.Column="0"  Text="branch"/>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text=":"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text=":"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="-" Name="lblbank"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="-" Name="lblbranch"/>
                        </Grid>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Deposit Date" x:Name="dtpDeposit_Date" ShowDate="Visible" ShowTime="Hidden" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Remarks" x:Name="txtRemarks" Grid.Column="0" Margin="0" />
                        <Grid Height="40" Margin="10,40,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <SEACC_WPFControls:SEACC_Button x:Name="btnClear" Content="New" Grid.Column= "0" Margin="2" BorderBrush="#FF9B9B9B" Foreground="White" Background="#FF41B1E1" BorderThickness="1" Click="btnClear_Click"/>
                            <SEACC_WPFControls:SEACC_Button x:Name="btnSave" Content="Save" Grid.Column= "1" Margin="2" BorderBrush="#FF9B9B9B" Foreground="White" Background="#FF41B1E1" BorderThickness="1" Click="btnSave_Click"/>
                        </Grid>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
            <!--<SEACC_WPFControls:SEACC_DataGrid_Advanced />-->
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>
