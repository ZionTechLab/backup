<UserControl x:Class="SEACC_FACTORING.Masters.UC_Factoring_Agreement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_FACTORING.UserControls"
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal" >
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >

        <Grid x:Name="Main" Margin="0,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1"  />

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1_1" Background="#FF515151" HeaderColor="#FFF49F6D"/>

            <Grid Grid.Column="2" Margin="10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <!--<StackPanel Grid.Column="2" Margin="10,0">-->

                    <Border  BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <Grid   Margin="0,5"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Agreement Code" x:Name="txtAgreement_ID" MouseDoubleClick="txtAgreement_ID_MouseDoubleClick"  />
                                <TextBox Name="txtAgrement_Rev" Visibility="Collapsed"/>
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Ref 1" x:Name="txtAgreement_reference1" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Ref 2" x:Name="txtAgreement_reference2" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0">
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Valid From" x:Name="dtpValid_From" ShowDate="Visible" ShowTime="Hidden" />
                                <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Valid To" x:Name="dtpValid_To" ShowDate="Visible" ShowTime="Hidden" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <Grid  Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Bank" x:Name="txtBank_ID" MouseDoubleClick="txtBank_ID_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Bank Branch" x:Name="txtBankBranch" MouseDoubleClick="txtBankBranch_MouseDoubleClick" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0">
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Factoring Acc. No" x:Name="txtAcc_NO_Factoring" MouseDoubleClick="txtAcc_NO_Factoring_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Current Acc. No" x:Name="txtAcc_NO_current" MouseDoubleClick="txtAcc_NO_current_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Clearing Acc. No" x:Name="txtAcc_NO_clearing" MouseDoubleClick="txtAcc_NO_clearing_MouseDoubleClick" />

                            </StackPanel>

                        </Grid>
                    </Border>

                    <Border  BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <Grid  Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Credit Limit" x:Name="txtCredit_Limit"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Credit Period" x:Name="txtCredit_Period"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Recurse Period" x:Name="txtrecurse_Period"  />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Service Fee (%)" x:Name="txtService_fee_pct" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0">
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Factoring Rate %" x:Name="txtFactoring_Rate" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Interest Credit %" x:Name="txtIntCredit" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Interest Recurse %" x:Name="txtIntRecurse" />
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Service Fee Min" x:Name="txtService_fee_minimum" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border  BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <Grid  Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <SEACC_WPFControls:SEACC_LableTextBox Caption="Remarks" x:Name="txtRemarks" IsMultiline="True" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <SEACC_WPFControls:SEACC_Button x:Name="btnHistory" Content="History" Width="100" HorizontalAlignment="Right" Click="btnHistory_Click"/>

                    <SEACC_WPFControls_Local:Attachments Height="29" HorizontalAlignment="Left" Width="220"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>