<UserControl x:Class="SEACC_FACTORING.UC_FactoringSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_FACTORING"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_FACTORING.UserControls"
             mc:Ignorable="d" Background="#FFFFFF" FontWeight="Normal" >
    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Grid.Column="0"  Margin="10,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" Background="#FF515151" HeaderColor="#FFF49F6D" />

            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />

            <SEACC_WPFControls:SEACC_ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel  Margin="10,0">
                    <Border  BorderThickness="1" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                        </Border.Effect>
                        <Grid   Margin="0,5"  >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="0"  Caption="Shedule ID" x:Name="txtSchedule_ID" MouseDoubleClick="txtSchedule_ID_MouseDoubleClick"  />
                            <SEACC_WPFControls:SEACC_LabelTimeSelector Grid.Column="0" Grid.Row="1" Caption="Shedule Date" x:Name="dtpSchedule_Date" ShowDate="Visible" ShowTime="Hidden"  VerticalAlignment="Top" />
                            <SEACC_WPFControls:SEACC_LableTextBox  Grid.Column="1" Grid.Row="0"  Caption="Agreement Code" x:Name="txtAgreement_Code" MouseDoubleClick="txtAgreement_Code_MouseDoubleClick" VerticalAlignment="Top" />
                            <Grid Grid.Column="1" Grid.Row="1" Margin="6,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="40*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"  Text="Bank"/>
                                <TextBlock Grid.Row="1" Grid.Column="0"  Text="branch"/>
                                <TextBlock Grid.Row="2" Grid.Column="0"  Text="Factoring Acc."/>
                                <TextBlock Grid.Row="3" Grid.Column="0"  Text="Interest Rate."/>
                                <TextBlock Grid.Row="4" Grid.Column="0"  Text="Credit Limit"/>
                                <TextBlock Grid.Row="5" Grid.Column="0"  Text="Available Credit"/>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text=":"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text=":"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text=":"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text=":"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text=":"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text=":"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="-" Name="lblbank"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="-" Name="lblbranch"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="-" Name="lblFactoringAccNo"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="-" Name="lblInerestRate"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="-" Name="lblCreditLimit" MouseLeftButtonUp="lblCreditLimit_MouseLeftButtonUp" Background="#FFE0E0E0" Foreground="Black" Width="150" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="-" Name="lblAvailableCredit" MouseLeftButtonUp="lblAvailableCredit_MouseLeftButtonUp" Background="#FFE0E0E0" Width="150" HorizontalAlignment="Left" />
                            </Grid>
                            <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="2" Caption="Remarks" x:Name="txtRemarks" Margin="0"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,-45,0,0">
                        <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                            <SEACC_WPFControls:SEACC_Button Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Click="btnGridItemAdd_Click" Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Top" />
                            <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets" Click="btnGridItemDelete_Click" Background="#FF727272" BorderBrush="{x:Null}" Foreground="#FFD31111" />
                        </StackPanel>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_Cheque" Margin="0,38,0,-8" Background="#FF515151" HeaderColor="#FFF49F6D" IsReadOnly="False" CellEditEnding="dgr_Cheque_CellEditEnding"  CanUserAddRows="False" Height="150" MouseLeftButtonUp="dgr_Cheque_MouseLeftButtonUp">
                            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding LineNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="#" Width="25" IsReadOnly="False" />
                                <DataGridTextColumn Binding="{Binding chequeRegister_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Cheque Register ID" Width="110" Visibility="Collapsed"  IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Bank_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Bank ID" Width="110"   IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding Bank ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Bank" Width="110"   IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Branch_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Branch ID" Width="110"   IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding Branch ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Branch" Width="110"   IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Cheque_NO ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Cheque #" Width="70"   IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Cheque_Date ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Cheque Date" Width="85"   IsReadOnly="True" />
                                <DataGridTextColumn Binding="{Binding Cheque_status ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Cheque Status" Width="90"   IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ChequeAmount ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"  Header="Amount" Width="80"   IsReadOnly="True" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Invoice_Numbers ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Invoice No." Width="90" IsReadOnly="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                            <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding FactoringRate ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Factoring Rate" Width="100"  >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding FactoringAmount ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="Factoring Amount" Width="120" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Service_Charges ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"  Header="Service Charges" Width="100"   >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding No_of_Days ,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="No of Days" Width="70"  IsReadOnly="True" >
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Estimate_Interest ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"  Header="Estim. Int." Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                        <Popup x:Name="pop_Event" Placement="MousePoint" PopupAnimation="Slide"  IsOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" >
                            <Popup.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.7" RenderingBias="Quality" ShadowDepth="10"/>
                            </Popup.Effect>
                            <Border BorderThickness="0,0,1,1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15"/>
                                </Border.Effect>

                                <Grid Width="250" Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Content="Invoice No." Foreground="White" Background="#FFF49F6D"/>
                                    <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close_Click" Height="22" Width="22" HorizontalAlignment="Right"  VerticalAlignment="Top" BorderBrush="#FFEC0000"/>
                                    <SEACC_WPFControls:SEACC_TextBox Grid.Row="1" Margin="2"  Name="txtInvoiceList" Height="75" />
                                    <SEACC_WPFControls:SEACC_Button Grid.Row="2" Content="Save" x:Name="btn_PoPSave" Margin="2" Background="#FF41B1E1" Foreground="White" Click="btn_PoPSave_Click" />
                                </Grid>
                            </Border>
                        </Popup>

                    </Grid>
                    <Grid Margin="0, 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="174*"/>
                            <ColumnDefinition Width="82*"/>
                            <ColumnDefinition Width="499*"/>
                        </Grid.ColumnDefinitions>
                        <Border  BorderThickness="1" Margin="0,0,0,10" Grid.ColumnSpan="3">
                            <Border.Effect>
                                <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                            </Border.Effect>
                            <Grid   Margin="0,5"  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Grid.Row="0" Background="#FFF4E7A7" Margin="0,0,5,0" Visibility="Collapsed">
                                    <Grid Margin="6,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="18"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0"  Text="Prepared By"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0"  Text="Checked By"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0"  Text="Approved By"/>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text=":"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text=":"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text=":"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Name="lblPrepared"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Name="lblChecked"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Name="lblApproved"/>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Name="lblPreparedDate"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Name="lblCheckedDate"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Name="lblApprovedDate"/>

                                        <TextBlock Grid.Row="0" Grid.Column="4" Name="lblPreparedTime"/>
                                        <TextBlock Grid.Row="1" Grid.Column="4" Name="lblCheckedTime"/>
                                        <TextBlock Grid.Row="2" Grid.Column="4" Name="lblApprovedTime"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="0" Background="#FFF4E7A7" Margin="5,0,0,0">

                                    <Grid Margin="6" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="107"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="20*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0"  Text="Face Amount" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="0,5,0,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0"  Text="Factoring Amount 80%" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="0,5,0,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0"  Text="Service Charges" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="0,5,0,4"/>
                                        <CheckBox x:Name="chkNBT" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,6" Width="130" Checked="chkNBT_Checked" Unchecked="chkNBT_Unchecked" Grid.ColumnSpan="3"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0"  Text="NBT" Margin="19,5,0,4" VerticalAlignment="Center" Grid.ColumnSpan="3"/>
                                        <CheckBox x:Name="chkVat" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" Unchecked="chkVat_Unchecked" Checked="chkVat_Checked" Grid.ColumnSpan="3"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0"  Text="VAT" Margin="19,5,0,4" VerticalAlignment="Center" Grid.ColumnSpan="3"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0"  Text="Gross Factoring Amount" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="0,5,0,4"/>
                                        <TextBlock Grid.Row="6" Grid.Column="0"  Text="Pending Margin Amount" VerticalAlignment="Center" Grid.ColumnSpan="3" Margin="0,5,0,4"/>

                                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="3" Grid.Column="3" Margin="1" Name="txtNBTPer"/>
                                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="4" Grid.Column="3" Margin="1" Name="txtVATPer"/>

                                        <TextBlock Grid.Row="3" Grid.Column="4"  Text="%" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,5,5,4"/>
                                        <TextBlock Grid.Row="4" Grid.Column="4"  Text="%" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,5,5,4"/>

                                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="0" Grid.Column="3" Margin="1" Name="txtTotFaceAmnt" Grid.ColumnSpan="3" />
                                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="1" Grid.Column="3" Margin="1" Name="txtFatoringAmnt" Grid.ColumnSpan="3"/>
                                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="2" Grid.Column="3" Margin="1" Name="txtFactoringCharges" Grid.ColumnSpan="3" />
                                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="3" Grid.Column="5" Margin="1" Name="txtNBT"/>
                                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="4" Grid.Column="5" Margin="1" Name="txtVAT"/>
                                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="5" Grid.Column="3" Margin="1" Name="txtFactoringGrossAmnt" Grid.ColumnSpan="3"/>
                                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="6" Grid.Column="3" Margin="1" Name="txtPendingMargin" Grid.ColumnSpan="3"/>
                                    </Grid>
                                </StackPanel>

                            </Grid>
                        </Border>


                    </Grid>

                </StackPanel>
            </SEACC_WPFControls:SEACC_ScrollViewer>
            
        </Grid>
        <SEACC_WPFControls:SEACC_Button x:Name="btnPrintDis" Content="Print Disbursment" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Width="140" Click="btnPrintDis_Click" Margin="0,6,337,6" Height="25" BorderBrush="#FF9B9B9B" Foreground="White" Background="#FF41B1E1" BorderThickness="1" Padding="0" />


    </SEACC_WPFControls_Local:SEACC_Form>
</UserControl>