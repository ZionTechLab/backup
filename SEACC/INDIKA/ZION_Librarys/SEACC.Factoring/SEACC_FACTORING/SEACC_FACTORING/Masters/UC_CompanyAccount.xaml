
<UserControl x:Class="SEACC_FACTORING.UC_CompanyAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_FACTORING.UserControls"
             xmlns:local="clr-namespace:SEACC_FACTORING.Masters"
             mc:Ignorable="d" Background="#FFFFFF" >

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" Background="#FF515151" HeaderColor="#FFF49F6D"/>
            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

            <StackPanel Grid.Column="2" Margin="10,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <Grid Margin="0,5">
                        <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                            <StackPanel>
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAccNo" Caption="Account No" MouseDoubleClick="txtAccNo_MouseDoubleClick"/>
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBank" Caption="Bank" MouseDoubleClick="txtBank_MouseDoubleClick"/>
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBranch" Caption="Branch" MouseDoubleClick="txtBranch_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBalanceAmnt" Caption="Balance Amount" Visibility="Collapsed"/>
                            </StackPanel>
                        </SEACC_WPFControls:SEACC_ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>


</UserControl>


