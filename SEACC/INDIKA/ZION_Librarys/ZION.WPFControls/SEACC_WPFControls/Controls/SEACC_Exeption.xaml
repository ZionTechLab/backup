<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="SEACC_WPFControls.SEACC_Exeption"
         Title="Window1"   WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True" BorderThickness="0" Topmost="True" ResizeMode="NoResize"   Background="#66000000" Width="603">
    <Window.Resources>
        <Style x:Key="iButton" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)" Storyboard.TargetName="grid">
                                                <EasingColorKeyFrame KeyTime="0" Value="#00C7C7C7"/>
                                                <EasingColorKeyFrame KeyTime="0:0:0.3" Value="#4CC7C7C7"/>
                                            </ColorAnimationUsingKeyFrames>
                                        </Storyboard>

                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)" Storyboard.TargetName="grid">
                                                <EasingColorKeyFrame KeyTime="0" Value="#4CC7C7C7"/>
                                                <EasingColorKeyFrame KeyTime="0:0:0.1" Value="#99C7C7C7"/>
                                            </ColorAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid x:Name="grid" Background="#00C7C7C7">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Border>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True"/>
                            <Trigger Property="IsDefaulted" Value="True"/>
                            <Trigger Property="IsMouseOver" Value="True"/>
                            <Trigger Property="IsPressed" Value="True"/>
                            <Trigger Property="IsEnabled" Value="False"/>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </Window.Resources>

    <Grid x:Name="grid" Width="600" Background="#FFF1F1F1"  d:LayoutOverrides="Height">

        <Grid.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="50" Color="{Binding MessegeBox_Background, ElementName=window}" Opacity="0.5"/>
        </Grid.Effect>

        <Grid x:Name="grid1" Margin="0" Background="#FFF1F1F1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#FF232323">
                <TextBlock x:Name="lbl_Caption" Text="Something went wrong....!" FontSize="28" Foreground="White" FontWeight="ExtraLight" TextWrapping="Wrap" Margin="10,8,0,0" Width="577" />
            </Grid>
            <TextBlock Grid.Row="1" Margin="10,10,0,0" Text="Please contact your system administrator"/>
            <Expander Grid.Row="2" Padding="10,0,10,10">
                <Expander.Header >
                    <TextBlock Foreground="Red" Text="More" Background="#FFF1F1F1" RenderTransformOrigin="1.448,0.752" />
                </Expander.Header>

                <WrapPanel >
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" MinHeight="25"/>
                            <RowDefinition Height="auto" MinHeight="25"/>
                            <RowDefinition Height="auto" MinHeight="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Line No."/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Method"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="File Name"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Messege"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text=":"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text=":"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text=":"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text=":"/>

                        <TextBlock x:Name="lbl_LineNo" Grid.Row="0" Grid.Column="2" Text="Line No." TextWrapping="WrapWithOverflow"/>
                        <TextBlock x:Name="lbl_Method" Grid.Row="1" Grid.Column="2" Text="Line No." TextWrapping="WrapWithOverflow" />
                        <TextBlock x:Name="lbl_File" Grid.Row="2" Grid.Column="2" Text="-" TextWrapping="WrapWithOverflow" />
                        <TextBlock x:Name="lbl_Messege" Grid.Row="3" Grid.Column="2" Text="Line No." TextWrapping="WrapWithOverflow" />
                    </Grid>
                </WrapPanel>

            </Expander>

            <StackPanel Grid.Row="3" Width="{Binding ActualWidth, ElementName=grid1, Mode=OneWay}" Orientation="Horizontal" FlowDirection="RightToLeft" >
                <Button x:Name="Btn_OK" Style="{StaticResource iButton}"  Content="OK"   Height="27" Width="85" Margin="10,0,0,0" Background="#FF232323" BorderBrush="White" Foreground="White" Click="Btn_OK_Click"    />
            </StackPanel>
        </Grid>
    </Grid>
</Window>