<Window x:Class="SEACC_WPFControls.SEACC_CommentBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEACC_CommentBox"  Height="205.788" Width="600" WindowStartupLocation="CenterScreen"  WindowStyle="None" AllowsTransparency="True" BorderThickness="0" Topmost="True" ResizeMode="NoResize"  Background="#66383838"  Loaded="Window_Loaded" >
   
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="grid1" Margin="0"  >
        <StackPanel>
            <TextBlock Text="Comments" FontSize="18" FontWeight="SemiBold" ></TextBlock>
            <TextBox  Width="550" Height="100" x:Name="txtComment"  Background="White"  />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Btn_OK" Style="{StaticResource iButton}"  Content="OK"   Height="27" Width="85"  Background="#66383838" BorderBrush="White" Foreground="White" Click="Btn_OK_Click" Margin="0,10,0,0"    />
            </StackPanel>
</StackPanel>
    </Grid>
</Window>
