<UserControl x:Name="userControl" x:Class="SEACC_WPFControls.SEACC_LabelTextBoxWithCheckBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" SizeChanged="userControl_SizeChanged" GotFocus="userControl_GotFocus" Focusable="True">
    <Grid x:Name="grid">
        <CheckBox x:Name="label" IsChecked="{Binding IsChecked, ElementName=userControl}" VerticalContentAlignment="Center" Content="{Binding Caption, ElementName=userControl}" HorizontalAlignment="Left" Width="117" Foreground="{Binding BoxForeground, ElementName=userControl}"  VerticalAlignment="Center" Checked="label_Checked" Unchecked="label_Unchecked"  />
        <TextBox x:Name="TextBox1" x:FieldModifier="public" Text="{Binding Text, ElementName=userControl}"  Margin="120,2,0,2" Foreground="{Binding TextForeground, ElementName=userControl}" Background="{Binding TextBox_Background, ElementName=userControl}" BorderBrush="{Binding TextBox_BorderBrush, ElementName=userControl}"   TextWrapping="Wrap" MaxWidth="{Binding DetailBox_Width, ElementName=userControl}" HorizontalAlignment="Left" PreviewTextInput="TextBox1_PreviewTextInput" Focusable="True"  TextChanged="TextBox1_TextChanged"/>
        <TextBlock Text="{Binding ErrorText, ElementName=userControl}" VerticalAlignment="Center" Foreground="Red" FontFamily="Segoe MDL2 Assets" Margin="0,8,-185,7" HorizontalAlignment="Right" Width="180"/>
    </Grid>
</UserControl>