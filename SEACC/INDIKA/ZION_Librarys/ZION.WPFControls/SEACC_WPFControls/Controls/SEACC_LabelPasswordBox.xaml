<UserControl x:Name="userControl" x:Class="SEACC_WPFControls.SEACC_LabelPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" >

    <Grid x:Name="grid">
        <Label x:Name="label" Content="{Binding Caption, ElementName=userControl}" FontSize="12"  HorizontalAlignment="Left" Width="120" Height="27" VerticalAlignment="Top"  />
        <!--<PasswordBox x:Name="TextBox1" 
                     Password="{Binding Password, ElementName=userControl}"  Margin="120,2,0,2" PreviewKeyDown="TextBox1_PreviewKeyDown" Background="{Binding TextBox_Background, ElementName=userControl}" BorderBrush="{Binding TextBox_BorderBrush, ElementName=userControl}" MaxWidth="{Binding DetailBox_Width, ElementName=userControl}" HorizontalAlignment="Left"   />-->
        
        <TextBlock Text="{Binding ErrorText, ElementName=userControl}" VerticalAlignment="Center" Foreground="Red" FontFamily="Segoe MDL2 Assets" Margin="0,8,-185,7" HorizontalAlignment="Right" Width="180"/>
    </Grid>
</UserControl>