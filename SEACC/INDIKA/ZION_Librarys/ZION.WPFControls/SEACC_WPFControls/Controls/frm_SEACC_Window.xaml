<Window x:Class="SEACC_WPFControls.frm_SEACC_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SEACC_WPFControls"
        mc:Ignorable="d"
        Title="frm_SEACC_Window"   ResizeMode="CanResizeWithGrip" 
        WindowStartupLocation="Manual" Background="White"   StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged" AllowsTransparency="False" WindowStyle="None" WindowState="Maximized" Height="560" Width="293" Margin="8" >

    <Border x:Name="Form_border" >
        <Grid  >
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="21"/>
            </Grid.RowDefinitions>
            <Grid  x:Name="GRD_Titlebar" Grid.Row="0" MouseDown="GRD_Titlebar_MouseDown" Background="#FF29496A" >
                <Grid  x:Name="GRD_ControlBox" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Hidden">
                    <local:SEACC_Button_Close x:Name="btnClose" Content="&#xE8BB;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets"  Click="btnClose_Click" />
                    <local:SEACC_Button x:Name="btnRestore" Content="&#xE923;"  HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,30,0" Click="btnRestore_Click" />
                    <local:SEACC_Button x:Name="btnMinimize" Content="&#xE921;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C"  Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,60,0" Click="btnMinimize_Click"/>
                </Grid>
                <TextBlock x:Name="lbl_Title" HorizontalAlignment="Left" Text="SEACC Window" Foreground="White"  VerticalAlignment="Center"  FontSize="30" Margin="67,15,0,15" FontWeight="ExtraLight"/>
                <local:SEACC_Button Content="&#xE760;" FontFamily="Segoe MDL2 Assets"  Click="btnClose_Click"  HorizontalAlignment="Left" Width="70" FontSize="40" Foreground="White" BorderBrush="{x:Null}" Background="{x:Null}" FontWeight="Thin" />


            </Grid>

            <Grid x:Name="grd_containt" Grid.Row="1" />


        </Grid>
    </Border>

</Window>
