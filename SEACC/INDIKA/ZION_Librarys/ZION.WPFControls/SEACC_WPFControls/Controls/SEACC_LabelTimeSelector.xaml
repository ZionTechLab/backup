<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_WPFControls" x:Name="userControl" 
             x:Class="SEACC_WPFControls.SEACC_LabelTimeSelector" 
             mc:Ignorable="d" d:DesignWidth="300"  SizeChanged="userControl_SizeChanged">
    <Grid >
        <Label x:Name="lblContent" x:FieldModifier="public" Content="{Binding Caption, ElementName=userControl}" FontSize="{Binding CaptionFontSize, ElementName=userControl}" HorizontalAlignment="Left" Width="120" VerticalAlignment="Top" />
        <local:SEACC_TimePicker x:Name="timePicker" Background="#FF727272" DateTimeChanged="timePicker_DateTimeChanged" ShowTime="{Binding ShowTime, ElementName=userControl}" ShowDate="{Binding ShowDate, ElementName=userControl}" Margin="120,7,0,7"  BorderBrush="{Binding TextBox_BorderBrush, ElementName=userControl}" MaxWidth="{Binding DateTimeBoxMaxWidth, ElementName=userControl}" HorizontalAlignment="Left" Height="Auto" BackgroudColor="#FF727272" FontColor="White" SeperatorColor="#FF33B9EB" />
    </Grid>
</UserControl>
