<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:local="clr-namespace:SEACC_WPFControls" x:Class="SEACC_WPFControls.frm_AboutUS"
         Title="About US" Height="483" Width="303" WindowStartupLocation="CenterScreen"  AllowsTransparency="True" WindowStyle="None" Background="{x:Null}"  FontWeight="Thin" >
    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FF484A5B" Offset="0"/>
                <GradientStop Color="#FF2D2F3E" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.5"/>
        </Grid.Effect>
        <local:SEACC_Button_Close x:Name="Btn_Close" Content="&#xE8BB;" Margin="0,3,3,0" VerticalAlignment="Top" BorderBrush="#FFEEF0F5"  HorizontalAlignment="Right" Width="24" Foreground="#FFF0F0F0" Click="Btn_Close_Click" FontFamily="Segoe MDL2 Assets" Height="24" FontSize="10"/>

        <TextBlock HorizontalAlignment="Left" Margin="25,22,0,0" TextWrapping="Wrap" Text="About US ..." VerticalAlignment="Top" Foreground="White" FontSize="25" FontWeight="Thin"/>
         </Grid>
</Window>
