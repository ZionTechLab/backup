<UserControl x:Name="userControl" x:Class="SEACC_WPFControls.SEACC_LabelImageBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" SizeChanged="userControl_SizeChanged" >
    <Grid x:Name="grid" >
        <Label x:Name="label" Content="{Binding Caption, ElementName=userControl}" FontSize="12"  HorizontalAlignment="Left" Width="120" Height="27" VerticalAlignment="Center"  />
        <Grid x:Name="grd_image" Margin="120,2,0,2" HorizontalAlignment="Left" MaxHeight="102" MaxWidth="295">
            <Border x:Name="imageborder" HorizontalAlignment="Left" BorderBrush="#FF41B1E1" BorderThickness="1" MaxHeight="102" MaxWidth="102" VerticalAlignment="Top"  >
                <Image x:Name="imageBox" Stretch="Fill"  Height="100" Width="100"  />
            </Border>
            <Button x:Name="btn_addImage" Width="65" Height="25" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White" Content="Add Image" VerticalAlignment="Bottom" Margin="106,2,2,2" HorizontalAlignment="Left" Click="btn_addImage_Click" />
        </Grid>
        <TextBlock Text="{Binding ErrorText, ElementName=userControl}" VerticalAlignment="Center" Foreground="Red" FontFamily="Segoe MDL2 Assets" Margin="0,8,-185,7" HorizontalAlignment="Right" Width="180"/>
    </Grid>
</UserControl>
