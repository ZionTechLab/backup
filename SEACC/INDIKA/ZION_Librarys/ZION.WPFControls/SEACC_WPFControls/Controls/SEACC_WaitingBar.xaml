<UserControl x:Name="userControl1" x:Class="SEACC_WPFControls.SEACC_WaitingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              mc:Ignorable="d" d:DesignWidth="300" Width="450" Height="19">
    <UserControl.Resources>
        <Storyboard x:Key="Storyboard1">
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="ellipse" RepeatBehavior="Forever">
                <SplineThicknessKeyFrame KeyTime="0" Value="0"/>
                <SplineThicknessKeyFrame KeyTime="0:0:5" Value="450,0,0,0" KeySpline="0,0.5,1,0.5"/>
                <EasingThicknessKeyFrame KeyTime="0:0:5.9" Value="450,0,0,0"/>
            </ThicknessAnimationUsingKeyFrames>
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="ellipse_Copy" RepeatBehavior="Forever">
                <SplineThicknessKeyFrame KeySpline="0,0.5,1,1" KeyTime="0" Value="0"/>
                <SplineThicknessKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0,0,1,0.5"/>
                <SplineThicknessKeyFrame KeyTime="0:0:5.3" Value="450,0,0,0" KeySpline="0,0.5,1,0.5"/>
                <EasingThicknessKeyFrame KeyTime="0:0:5.9" Value="450,0,0,0"/>
            </ThicknessAnimationUsingKeyFrames>
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="ellipse_Copy1" RepeatBehavior="Forever">
                <SplineThicknessKeyFrame KeySpline="0,0.5,1,1" KeyTime="0" Value="0"/>
                <SplineThicknessKeyFrame KeyTime="0:0:0.6" Value="0" KeySpline="0,0,1,0.5"/>
                <SplineThicknessKeyFrame KeyTime="0:0:5.6" Value="450,0,0,0" KeySpline="0,0.5,1,0.5"/>
                <EasingThicknessKeyFrame KeyTime="0:0:5.9" Value="450,0,0,0"/>
            </ThicknessAnimationUsingKeyFrames>
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="ellipse_Copy2" RepeatBehavior="Forever">
                <SplineThicknessKeyFrame KeySpline="0,0.5,1,1" KeyTime="0" Value="0"/>
                <SplineThicknessKeyFrame KeyTime="0:0:0.9" Value="0" KeySpline="0,0,1,0.5"/>
                <SplineThicknessKeyFrame KeyTime="0:0:5.9" Value="450,0,0,0" KeySpline="0,0.5,1,0.5"/>
            </ThicknessAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Width)" Storyboard.TargetName="ss">
            	<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
            	<EasingDoubleKeyFrame KeyTime="0:0:5" Value="{Binding ActualWidth, ElementName=userControl1, Mode=OneWay}"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Storyboard1}"/>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid x:Name="grid">
		<Grid Name="ss" Background="Black" HorizontalAlignment="Left"  >
			
		</Grid>
		<Grid Width="{Binding ActualWidth, ElementName=userControl1, Mode=OneWay}"></Grid>
			<Ellipse x:Name="ellipse" Fill="White" HorizontalAlignment="Left" Height="5" Stroke="Black" VerticalAlignment="Top" Width="5" Margin="11" StrokeThickness="0"/>
		
         <Ellipse x:Name="ellipse_Copy" Fill="White" HorizontalAlignment="Left" Height="5" Stroke="Black" VerticalAlignment="Top" Width="5" Margin="271.164,0,0,0" StrokeThickness="0"/>
        <Ellipse x:Name="ellipse_Copy1" Fill="White" HorizontalAlignment="Left" Height="5" Stroke="Black" VerticalAlignment="Top" Width="5" Margin="271.164,0,0,0" StrokeThickness="0"/>
        <Ellipse x:Name="ellipse_Copy2" Fill="White" HorizontalAlignment="Left" Height="5" Stroke="Black" VerticalAlignment="Top" Width="5" Margin="271.164,0,0,0" StrokeThickness="0"/>

    </Grid>
</UserControl>
