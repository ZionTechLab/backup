<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_WPFControls" 
             xmlns:local1="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" x:Name="userControl" x:Class="SEACC_WPFControls.SEACC_DataGrid_Advanced" 
             mc:Ignorable="d"   Background="#FF34495E"            >
    <Grid x:Name="Grid1">
        <local:SEACC_DataGrid x:Name="grdMain"  x:FieldModifier="public" Margin="10,30,10,0" MouseLeftButtonUp="grdMain_MouseLeftButtonUp" Background="{Binding Background, ElementName=userControl}" LoadingRow="grdMain_LoadingRow" CellEditEnding="grdMain_CellEditEnding" IsReadOnly="False" MouseDoubleClick="grdMain_MouseDoubleClick" SelectedIndex="{Binding SelectedIndex, ElementName=userControl}" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserAddRows="False" MouseRightButtonDown="grdMain_MouseRightButtonDown" KeyDown="grdMain_KeyDown" PreviewKeyDown="grdMain_PreviewKeyDown" CanUserResizeColumns="True" CanUserReorderColumns="True" CurrentCellChanged="grdMain_CurrentCellChanged" BeginningEdit="grdMain_BeginningEdit" >
        </local:SEACC_DataGrid>
  
        <Expander Foreground="#FF0096D6" Header="Filters" HorizontalAlignment="Left" Margin="10,4,0,0" VerticalAlignment="Top"  Width="300">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Border Background="#7234495E" BorderThickness="1" >
                        <Border.Effect>
                            <DropShadowEffect Color="#FF171717" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                    </Border>
                    <StackPanel x:Name="dds" Background="Transparent" Margin="8" />
                </Grid>
            </ScrollViewer>
        </Expander>
        </Grid>
</UserControl>