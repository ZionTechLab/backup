<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="SEACC_WPFControls.frm_WaitingMessege"
          Title="frm_Waiting"  AllowsTransparency="True" WindowStyle="None"  Width="1000" Loaded="Window_Loaded" Height="220">
	<Window.Resources>
		<Storyboard x:Key="Storyboard1" RepeatBehavior="Forever">
			<ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)" Storyboard.TargetName="grid" RepeatBehavior="Forever">
				<EasingColorKeyFrame KeyTime="0" Value="#FF7F8C8D"/>
				<EasingColorKeyFrame KeyTime="0:0:3" Value="#FF1ABC9C"/>
				<EasingColorKeyFrame KeyTime="0:0:9" Value="#FF27AE60"/>
				<EasingColorKeyFrame KeyTime="0:0:15" Value="#FF2980B9"/>
				<EasingColorKeyFrame KeyTime="0:0:21" Value="#FF8E44AD"/>
				<EasingColorKeyFrame KeyTime="0:0:27" Value="#FFE67E22"/>
				<EasingColorKeyFrame KeyTime="0:0:33" Value="#FFF39C12"/>
				<EasingColorKeyFrame KeyTime="0:0:39" Value="#FFC0392B"/>
				<EasingColorKeyFrame KeyTime="0:0:42" Value="#FF7F8C8D"/>
			</ColorAnimationUsingKeyFrames>
		</Storyboard>
		<Storyboard x:Key="OnLoaded1" RepeatBehavior="Forever">
			<ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="textBlock">
				<EasingColorKeyFrame KeyTime="0" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:5.727" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:7.636" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:9.545" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:21" Value="Transparent"/>
			</ColorAnimationUsingKeyFrames>
			<ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="textBlock1">
				<EasingColorKeyFrame KeyTime="0" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:7.636" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:9.545" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:11.455" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:21" Value="Transparent"/>
			</ColorAnimationUsingKeyFrames>
			<ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="textBlock2">
				<EasingColorKeyFrame KeyTime="0" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:9.545" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:11.455" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:13.364" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:21" Value="Transparent"/>
			</ColorAnimationUsingKeyFrames>
			<ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="textBlock3">
				<EasingColorKeyFrame KeyTime="0" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:11.455" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:13.364" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:15.273" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:21" Value="Transparent"/>
			</ColorAnimationUsingKeyFrames>
			<ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="textBlock4">
				<EasingColorKeyFrame KeyTime="0" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:13.364" Value="Transparent"/>
				<EasingColorKeyFrame KeyTime="0:0:15.273" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:17.182" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:21" Value="Transparent"/>
			</ColorAnimationUsingKeyFrames>
			<ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="textBlock5">
				<EasingColorKeyFrame KeyTime="0" Value="#7FFFFFFF"/>
				<EasingColorKeyFrame KeyTime="0:0:5.727" Value="White"/>
				<EasingColorKeyFrame KeyTime="0:0:21" Value="#7FFFFFFF"/>
			</ColorAnimationUsingKeyFrames>
		</Storyboard>
	</Window.Resources>
	<Window.Triggers>
		<EventTrigger RoutedEvent="FrameworkElement.Loaded">
			<BeginStoryboard Storyboard="{StaticResource Storyboard1}"/>
			<BeginStoryboard x:Name="OnLoaded1_BeginStoryboard" Storyboard="{StaticResource OnLoaded1}"/>
		</EventTrigger>
	</Window.Triggers>

	<Grid x:Name="grid" Background="#FF16A085" >
		<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" Orientation="Horizontal">
			<TextBlock x:Name="textBlock5" Text="SEACC is preparing data for you " Foreground="White" FontSize="36" FontWeight="Thin" />
			<TextBlock x:Name="textBlock" Text="." Foreground="White" FontSize="36" FontWeight="Thin" />
			<TextBlock x:Name="textBlock1" Text="." Foreground="White" FontSize="36" FontWeight="Thin" />
			<TextBlock x:Name="textBlock2" Text="." Foreground="White" FontSize="36" FontWeight="Thin" />
			<TextBlock x:Name="textBlock3" Text="." Foreground="White" FontSize="36" FontWeight="Thin" />
			<TextBlock x:Name="textBlock4" Text="." Foreground="White" FontSize="36" FontWeight="Thin" />
           
        </StackPanel>
             <TextBlock x:Name="txt_Timer" Text="00:00:00" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="25" Margin="0,0,15,15" FontWeight="Thin" Foreground="#7FFFFFFF" FontFamily="Segoe UI Semilight"/>
    </Grid>
</Window>
