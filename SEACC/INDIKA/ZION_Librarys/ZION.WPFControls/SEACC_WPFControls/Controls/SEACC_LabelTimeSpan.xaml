<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_WPFControls" x:Name="userControl" x:Class="SEACC_WPFControls.SEACC_LabelTimeSpan" 
             mc:Ignorable="d" SizeChanged="userControl_SizeChanged" >
    <Grid>
        <Label FontSize="12" HorizontalAlignment="Left" Width="120" VerticalContentAlignment="Stretch" Content="{Binding Caption, ElementName=userControl}"/>
        <local:SEACC_TimeSpan x:Name="TimeSpan" Margin="120,2,0,2" HorizontalAlignment="Left" Width="110" BorderBrush="{Binding TextBox_BorderBrush, ElementName=userControl}" Background="#FF727272" MaxWidth="125" />
    </Grid>
</UserControl>
