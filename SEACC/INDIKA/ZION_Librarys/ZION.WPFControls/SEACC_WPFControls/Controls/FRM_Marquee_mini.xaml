<Window x:Class="SEACC_WPFControls.FRM_Marquee_mini"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FRM_Marquee_News" Height="65" Width="561.875" Topmost="True" AllowsTransparency="True" WindowStyle="None" Background="{x:Null}" ShowInTaskbar="False">
    <Grid>
        <StackPanel x:Name="stackPanel" Orientation="Horizontal" HorizontalAlignment="Left" Background="#00B2B2B2">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="transferCurreny" X="-100"/>
            </StackPanel.RenderTransform>
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="StackPanel.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation From="0" To="{Binding ActualWidth, ElementName=window, Mode=OneWay}" Duration="00:00:30"
                      Storyboard.TargetProperty="X"
                      Storyboard.TargetName="transferCurreny"
                      RepeatBehavior="Forever" FrameworkElement.FlowDirection="RightToLeft"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
            <TextBlock FontSize="25"  x:Name="txtKron"  Text="Welcome to SEACC HRCM" Margin="10,0,0,0" Foreground="#FF339E9E" FontFamily="Segoe UI Light" FontWeight="Thin"/>
            <!--<SEACC_WPFControls:SEACC_Button_Close x:Name="btnClose" Content="&#xE8BB;" HorizontalAlignment="Right" Width="22" FontFamily="Segoe MDL2 Assets"   Height="22" VerticalAlignment="Top" Click="btnClose_Click" FontSize="8" />-->
        </StackPanel>


    </Grid>
</Window>
