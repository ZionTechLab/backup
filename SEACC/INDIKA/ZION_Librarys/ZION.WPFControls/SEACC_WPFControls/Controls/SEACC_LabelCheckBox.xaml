<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_WPFControls" x:Name="userControl" x:Class="SEACC_WPFControls.SEACC_LabelCheckBox" 
             mc:Ignorable="d" 
             SizeChanged="userControl_SizeChanged">
    <Grid x:Name="grid">
        <Label x:Name="label" Content="{Binding Caption, ElementName=userControl}" FontSize="12"  HorizontalAlignment="Left" Width="120" Height="27" VerticalAlignment="Top"/>
        <local:SEACC_CheckBox x:Name="ChkBx" Content="SEACC_CheckBox" HorizontalAlignment="Left" Margin="125,2,0,2" VerticalAlignment="Center" IsChecked="{Binding IsChecked, ElementName=userControl}" MaxWidth="50" Unchecked="ChkBx_Unchecked" Checked="ChkBx_Checked"  />
    </Grid>
</UserControl>
