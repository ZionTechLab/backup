<UserControl x:Name="userControl" x:Class="SEACC_WPFControls.SEACC_TimeSpan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="37.701" Background="#FF727272" >
    <Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="grd_Days" Grid.Column="0" Background="{Binding Background, ElementName=userControl}" MouseUp="grd_Days_MouseUp">
                <TextBlock  Text="Days" FontSize="9" Foreground="#FF33B9EB" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0"/>
                <Grid Margin="2,5,2,2">
                    <Border BorderBrush="#FF33B9EB" BorderThickness="0,0,0,2"></Border>
                    <TextBlock x:Name="tb_Days" Text="01" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBox x:Name="txt_Days" TextAlignment="Center" Visibility="Hidden" Margin="2,12,2,2" PreviewKeyDown="txt_Days_PreviewKeyDown" LostFocus="txt_Days_LostFocus" FontSize="13" Padding="0" PreviewTextInput="txt_Days_PreviewTextInput" />

            </Grid>

            <Grid x:Name="grd_Hours"  Grid.Column="1" Background="{Binding Background, ElementName=userControl}" MouseUp="grd_Hours_MouseUp">
                <TextBlock  Text="Hours" FontSize="9" Foreground="#FF33B9EB" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0"/>
                <Grid Margin="2,5,2,2">
                    <Border BorderBrush="#FF33B9EB" BorderThickness="0,0,0,2"></Border>
                    <TextBlock x:Name="tb_Hours" Text="01" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"  />
                </Grid>
                <TextBox x:Name="txt_Hours" TextAlignment="Center" Visibility="Hidden" Margin="2,12,2,2" PreviewKeyDown="txt_Hours_PreviewKeyDown" LostFocus="txt_Hours_LostFocus" FontSize="13" Padding="0" PreviewTextInput="txt_Hours_PreviewTextInput"/>

            </Grid>
            
            <Grid x:Name="Grd_Mts"  Grid.Column="2" Background="{Binding Background, ElementName=userControl}" MouseUp="Grd_Mts_MouseUp" >
                <TextBlock  Text="minutes" FontSize="9" Foreground="#FF33B9EB" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0"/>
                <Grid Margin="2,5,2,2">
                    <Border BorderBrush="#FF33B9EB" BorderThickness="0,0,0,2"/>
                    <TextBlock x:Name="tb_minutes" Text="01" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBox x:Name="txt_minutes" TextAlignment="Center" Visibility="Hidden" Margin="2,12,2,2" PreviewKeyDown="txt_minutes_PreviewKeyDown" LostFocus="txt_minutes_LostFocus" FontSize="13" Padding="0" PreviewTextInput="txt_minutes_PreviewTextInput"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>