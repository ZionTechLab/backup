<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" x:Class="SEACC_Reg.MainWindow"
        Title="SEACC REG" Height="320.291" Width="424.172" AllowsTransparency="True" WindowStyle="None" Background="{x:Null}" Icon="icon_Reg.ico">

    <Window.Resources>
        <Style x:Key="ButtonStyle1" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF41B1E1"/>
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="BorderBrush" Value="#FF2F7C9C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF77C1E0"/>
                </Trigger>
            </Style.Triggers>

        </Style>
        <Style x:Key="iButton_Close" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="LayoutRoot">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UserControl.Foreground)" Storyboard.TargetName="LayoutRoot">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#FF9C9C9C"/>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UserControl.Foreground)" Storyboard.TargetName="LayoutRoot">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="Red"/>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="grid">

                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True"/>
                            <Trigger Property="IsDefaulted" Value="True"/>
                            <Trigger Property="IsMouseOver" Value="True"/>
                            <Trigger Property="IsPressed" Value="True"/>
                            <Trigger Property="IsEnabled" Value="False"/>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </Window.Resources>

    <Border x:Name="Form_border" BorderBrush="#FF2E91A0" BorderThickness="2" Background="White" Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="#FF2E91A0" BlurRadius="11" Opacity="0.5"/>
        </Border.Effect>
        <Grid  >
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Background="#FF2EA081" x:Name="GRD_Titlebar" Grid.Row="0" MouseDown="GRD_Titlebar_MouseDown" >
                <Grid  x:Name="GRD_ControlBox" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Content="&#xE8BB;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets"  Click="btnClose_Click" Style="{DynamicResource iButton_Close}" />
                    <Button x:Name="btnRestore" Content="&#xE923;"  HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Style="{DynamicResource ButtonStyle1}" Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,30,0" Click="btnRestore_Click" />
                    <Button x:Name="btnMinimize" Content="&#xE921;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Style="{DynamicResource ButtonStyle1}" Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,60,0" Click="btnMinimize_Click"/>
                </Grid>
                <TextBlock x:Name="lbl_Title" HorizontalAlignment="Left" Text="SEACC Registry Editor v1.5" Foreground="White"  VerticalAlignment="Center" Margin="10,0,0,0" FontSize="18"/>
            </Grid>
            <StackPanel x:Name="grd_containt" Grid.Row="1" Height="252" VerticalAlignment="Bottom" Background="#FFBFBFBF" >
                <StackPanel.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </StackPanel.Effect>
                <Grid Margin="15,15,15,15" VerticalAlignment="Top" Height="180">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Server Name" Grid.Row="0"/>
                    <Label Content="Database" Grid.Row="1"/>
                    <Label Content="User Name" Grid.Row="2"/>
                    <Label Content="Password" Grid.Row="3" />
                    <Label Content="Company" Grid.Row="4"/>
                    <Label Content="Registyr Type" Grid.Row="5"/>

                    <TextBox x:Name="txtServer" Grid.Column="1" Grid.Row="0" Margin="2"/>
                    <TextBox x:Name="txtDB" Grid.Column="1" Grid.Row="1" Margin="2"/>
                    <TextBox x:Name="txtUser" Grid.Column="1" Grid.Row="2" Margin="2"/>
                    <PasswordBox x:Name="txtPW"  Grid.Column="1" Grid.Row="3" Margin="2"/>
                    <TextBox x:Name="txtCom"  Grid.Column="1" Grid.Row="4" Margin="2"/>
                    <TextBox x:Name="txtRegType" Grid.Column="1" Grid.Row="5" Margin="2"/>
                </Grid>
                <Grid>

                </Grid>
                <Grid Margin="0,0,15,0" HorizontalAlignment="Right" Width="257" Height="31">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnRetreve" Content="Retrive" Click="btnRetreve_Click" Grid.Column="0" Margin="2" Style="{DynamicResource ButtonStyle1}" Background="#FF2EA081"/>
                    <Button x:Name="btnCreate" Content="Create" Click="btnCreate_Click"  Grid.Column="1" Margin="2" Style="{DynamicResource ButtonStyle1}" Background="#FFEE204D"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>