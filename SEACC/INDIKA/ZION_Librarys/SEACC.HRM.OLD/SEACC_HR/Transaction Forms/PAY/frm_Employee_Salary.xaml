<Window x:Class="Digiteq.Transaction_Forms.PAY.frm_Employee_Salary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Digiteq.Transaction_Forms.PAY"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
        mc:Ignorable="d" Background="{x:Null}" 
        Title="Employee Salary" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" WindowStyle="None" Width="700" AllowsTransparency="True">
    <Grid Margin="10">
        <Border Background="#FF34495E" >
            <Border.Effect>
                <DropShadowEffect ShadowDepth="5" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid Margin="0,0,0,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="grdTitleBar" Grid.Row="0" Grid.ColumnSpan="2" >
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF364758" Offset="0"/>
                        <GradientStop Color="#FF051a2f" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Margin="5,0,0,0" >
                    <Label x:Name="lblTitleBar" Content="Employee Salary"  FontSize="25" Foreground="White" />
                    <Label x:Name="lblEmpName" Content="Employee Name" FontSize="14" Foreground="White"/>
                </StackPanel>
                <SEACC_WPFControls:SEACC_Button_Close x:Name="btnClose" Content="&#xE8BB;" VerticalAlignment="Top" HorizontalAlignment="Right" Width="30" Height="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Background="{x:Null}" BorderBrush="{x:Null}" />
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" Margin="5,5,5,5">
                <SEACC_WPFControls:SEACC_DataGrid x:Name="dgrPayItem" Background="{x:Null}" BorderBrush="{x:Null}"  Foreground="Black" RowBackground="{x:Null}"  HideContextMenu="True" GridLinesVisibility="None" AutoGenerateColumns="False"  IsReadOnly="False" CanUserAddRows="False"  >
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="#FFFFFF" />
                            <Setter Property="Height" Value="28" />
                        </Style>
                    </DataGrid.RowStyle>
                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding payItem_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="PayItemID" Width="55"   IsReadOnly="True" Visibility="Collapsed" />
                        <DataGridTextColumn Binding="{Binding payItem_Code , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Code" Width="50" IsReadOnly="False"/>
                        <DataGridTextColumn Binding="{Binding payItem_Title , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="Description" Width="*"    IsReadOnly="True"/>
                        <DataGridTextColumn Binding="{Binding payItem_Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="Amount" Width="80"  IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,10,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                </SEACC_WPFControls:SEACC_DataGrid>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" Margin="5,5,5,5">
                <SEACC_WPFControls:SEACC_DataGrid x:Name="dgrStatutary" Background="{x:Null}" BorderBrush="{x:Null}"  Foreground="Black" RowBackground="{x:Null}"  HideContextMenu="True" GridLinesVisibility="None" AutoGenerateColumns="False"  IsReadOnly="False" CanUserAddRows="False"  >
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="#FFFFFF" />
                            <Setter Property="Height" Value="28" />
                        </Style>
                    </DataGrid.RowStyle>
                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding stat_ID , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="statutary ID" Width="80"    IsReadOnly="True" Visibility="Collapsed" />
                        <DataGridTextColumn Binding="{Binding stat_Code , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Statutary Code" IsReadOnly="True" Visibility="Collapsed" />
                        <DataGridTextColumn Binding="{Binding stat_Title , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="Statutary Item" Width="90"    IsReadOnly="True" />
                        <DataGridTextColumn Binding="{Binding stat_Pct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="Statutary Pct." Width="80"  IsReadOnly="True">
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding stat_Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="Amount" Width="80"  IsReadOnly="True">
                        </DataGridTextColumn>
                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                </SEACC_WPFControls:SEACC_DataGrid>
            </Grid>

        </Grid>

        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtNetSalary" Caption="Net Salary" BoxForeground="White" Height="25" VerticalAlignment="Bottom" Margin="65,0,305,0" />

    </Grid>
</Window>
