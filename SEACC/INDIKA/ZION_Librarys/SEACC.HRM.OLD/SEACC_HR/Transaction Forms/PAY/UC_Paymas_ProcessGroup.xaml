<UserControl x:Class="Digiteq.UC_Paymas_ProcessGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             xmlns:local="clr-namespace:Digiteq"
             mc:Ignorable="d" Background="#FFFFFF">

    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" />
            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Margin="0,1,0,-1"/>
            <Grid Grid.Column="2" Margin="10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto" >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtGroupID" Caption="Process Group ID" MouseDoubleClick="txtGroupID_MouseDoubleClick"  />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtGroupTitle" Caption="Process Group Title" />
                        <SEACC_WPFControls:SEACC_LabelComboBox x:Name="cmbPayPeriod" Caption="Pay Period" />

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10,5,5"/>
                        <StackPanel Orientation="Horizontal" Margin="5,10,0,0" >
                            <Image Source="/SEACC_HR;component/Resources/Setting50.png" Height="36" Width="18"/>
                            <Label x:Name="lblPayrollGroupSetting" Content="Salary Process Group Settings" FontSize="18" Foreground="#FF0096D6" />
                        </StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtNopayStdHrs" FontSize="9" Caption="Nopay Std. Hrs. (Period)" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLateStdHrs" FontSize="9" Caption="Late Std. Hrs. (period)" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLateMaxMins" FontSize="9" Caption="Late Max Minutes (Period)" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLateMaxDays" FontSize="9" Caption="Late Max Days (Period)"  />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLateGraceMins" FontSize="9" Caption="Late Grace Minutes (Daily)" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtOT_StdHrs" FontSize="9" Caption="OT Std. Hrs. (Period)" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDobOT_StdHrs" FontSize="9" Caption="Dub.OT Std. Hrs. (Period)" />

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10,5,5"/>
                        <StackPanel Orientation="Horizontal" Margin="5,10,0,0">
                            <Image Source="/SEACC_HR;component/Resources/PayrollCalendar.png" Height="36" Width="18"/>
                            <Label x:Name="lblProcessPeriod" Content="Salary Process Group Periods" FontSize="18" Foreground="#FF0096D6" MouseLeftButtonUp="lblProcessPeriod_MouseLeftButtonUp" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="5,10,0,0" Visibility="Visible" >
                            <Image Source="/SEACC_HR;component/Resources/Paroll_GroupPremission.png" Height="36" Width="18"/>
                            <Label x:Name="lblEmpSalary" Content="Salary Process Group User Permissions" FontSize="18" Foreground="#FF0096D6" MouseLeftButtonUp="lblEmpSalary_MouseLeftButtonUp" />
                        </StackPanel>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
    
</UserControl>
