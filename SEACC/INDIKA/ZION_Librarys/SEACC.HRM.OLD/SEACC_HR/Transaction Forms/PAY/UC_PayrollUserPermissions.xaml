<UserControl x:Class="Digiteq.Transaction_Forms.PAY.UC_PayrollUserPermissions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF"  >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged_1">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="650" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="#FF34495E" Margin="0,0,5,0">
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"  />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <CheckBox x:Name="chk_ViewAll" Content="All" Foreground="White" VerticalAlignment="Top"  Width="45" Margin="332,0,0,0" Checked="chk_ViewAll_Checked" Unchecked="chk_ViewAll_Unchecked" />
                    <CheckBox x:Name="chk_SaveAll" Content="All" Foreground="White" VerticalAlignment="Top"  Width="45" Margin="2,0,0,0" Checked="chk_SaveAll_Checked" Unchecked="chk_SaveAll_Unchecked" />
                    <CheckBox x:Name="chk_EditAll" Content="All" Foreground="White" VerticalAlignment="Top"  Width="45" Margin="2,0,0,0" Checked="chk_EditAll_Checked" Unchecked="chk_EditAll_Unchecked" />
                    <CheckBox x:Name="chk_RollbackAll" Content="All" Foreground="White"  VerticalAlignment="Top"  Width="45" Margin="2,0,0,0" Checked="chk_RollbackAll_Checked" Unchecked="chk_RollbackAll_Unchecked"  Visibility="Hidden"/>
                    <CheckBox x:Name="chk_CheckableAll" Content="All" Foreground="White" VerticalAlignment="Top"  Width="45" Margin="2,0,0,0" Checked="chk_CheckableAll_Checked" Unchecked="chk_CheckableAll_Unchecked" Visibility="Hidden" />
                    <CheckBox x:Name="chk_ApprovableAll" Content="All" Foreground="White"  VerticalAlignment="Top"  Width="45" Margin="2,0,0,0" Checked="chk_ApprovableAll_Checked" Unchecked="chk_ApprovableAll_Unchecked" Visibility="Hidden" />
                </StackPanel>
            </Grid>
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0" >
                <StackPanel>
                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtUserID" Caption="User" MouseDoubleClick="txtUserID_MouseDoubleClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
