
<UserControl x:Class="Digiteq.UC_PAYE_TaxTable_1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Digiteq"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             xmlns:SEACC_WPFControls3="clr-namespace:SEACC_WPFControls.Controls;assembly=SEACC_WPFControls"
             mc:Ignorable="d" Background="#FFFFFF" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged"  >
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="670" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp" />
            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                        <StackPanel>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYETaxtableID" Caption="Tax ID" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYETaxtableCode" Caption="Tax Code" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYETaxtableName" Caption="Tax Name" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYETaxStartRange" Caption="Tax Start Range" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYETaxEndRange" Caption="Tax End Range" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYETaxRate" Caption="Tax Percentage" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYECOLAAmt" Caption="COLA Amount" />
                            <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpPAYEStartDate" Caption="Start Date" ShowDate="Visible" ShowTime="Collapsed"/>
                            <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpPAYEEndDate" Caption="End Date" ShowDate="Visible" ShowTime="Collapsed"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYEGLCODECR" Caption="GL Code Credit" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYEGLCODEDR" Caption="GL Code Debit" />
                        </StackPanel>
                    </SEACC_WPFControls:SEACC_ScrollViewer>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
