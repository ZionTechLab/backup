<UserControl x:Class="Digiteq.UC_SelectedCV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d"  Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form">
        <Grid Margin="15,54,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="coloumnA" Width="530" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <DataGrid x:Name="grd_CarderRequest"  FontSize="11"   GridLinesVisibility="Horizontal" Background="#FF595959" >
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#A0A0A0"/>
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <StaticResource ResourceKey="Body_Content_DataGrid_Centering"/>
                    </DataGrid.CellStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <StaticResource ResourceKey="HeaderStyle"/>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding ShiftID}"   Header="Division"   x:Name="ShiftID" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Binding="{Binding ShiftName}"  Header="Designatiom" Width="150"  x:Name="ShiftName"  IsReadOnly="True"/>
                        <DataGridTextColumn Binding="{Binding StartTime}"  Header="Expect Date" Width="130"  x:Name="StartTime"  IsReadOnly="True"/>
                        <DataGridTextColumn Binding="{Binding ShiftHours}"  Header="Reason" Width="135"  x:Name="EndTime"  IsReadOnly="True"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EDEDED"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <Grid  Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Expander Header="Basic Details"  FontSize="24" Foreground="#FF0096D6" IsExpanded="True">
                            <Grid  Height="510" Width="500">
                                <StackPanel>
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Cadre Request No." FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Candidate No." FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="NIC" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Passport" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Surname" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Initials" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Full Name" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="D.O.B" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Home Town" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Temporary Address" FontSize="12"/>
                                    <Grid Height="50">
                                        <Label Content="Qualifications" FontSize="12" />
                                        <CheckBox Margin="121,5,-121,0" Content="O/L" FontSize="12" />
                                        <CheckBox Margin="171,5,-171,0" Content="A/L" FontSize="12" />
                                        <CheckBox Margin="220,5,-220,-1" Content="Diploma" FontSize="12" />
                                        <CheckBox Margin="299,5,-299,0" Content="Higher Diploma" FontSize="12" />
                                        <CheckBox Margin="409,5,-409,0" Content="Degree" FontSize="12" />
                                        <CheckBox Content="Masters" FontSize="12" Margin="121,30,0,0"/>
                                        <CheckBox Content="Ph.D" FontSize="12" Margin="187,30,-66,0" />
                                    </Grid>
                                    <Grid>
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Years Of Employee" FontSize="12" />
                                        <SEACC_WPFControls:SEACC_LableTextBox Caption="No. Of Employers" FontSize="12" Margin="238,0,-238,0" />
                                    </Grid>
                                    <Grid>
                                        <Label Content="Current Employed ?" FontSize="12" Margin="0,5,0,-3" />
                                        <CheckBox Content="Yes" FontSize="12"  Margin="124,10,0,0" />
                                        <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="No Of Years"  Margin="238,4,0,-1" />
                                    </Grid>
                                    <Grid>
                                        <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Designation"  Margin="0,3,262,7" />
                                        <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Start Year"  Margin="238,3,0,7" />
                                    </Grid>
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Photo" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Photo" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Photo" FontSize="12" />
                                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Photo" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Expander>
                        <Expander Header="Interview Results" Foreground="#FF0096D6" FontSize="24">
                            <StackPanel  Width="450" >
                                <Grid Height="400">
                                    <Grid>
                                    </Grid>

                                </Grid>
                            </StackPanel>
                        </Expander>
                      
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
