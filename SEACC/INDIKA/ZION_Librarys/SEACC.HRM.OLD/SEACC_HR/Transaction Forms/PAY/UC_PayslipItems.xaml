<UserControl x:Class="Digiteq.UC_PayslipItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d"   Background="#FFFFFF" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="550" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" />
            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

            <Grid  Grid.Column="2" Margin="10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPayCode" Caption="Pay Item Code" MouseDoubleClick="txtPayCode_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPayTitle"  Caption="Pay Item Title" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPayClass"  Caption="Pay Item Class" MouseDoubleClick="txtPayClass_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPayType"  Caption="Pay Item Type" MouseDoubleClick="txtPayType_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LabelComboBox x:Name="cmbPayMode"  Caption="Input Mode"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsEarning" Caption="Earning" IsChecked="True"/>
                        <SEACC_WPFControls:SEACC_LabelComboBox x:Name="cmbPayPeriod"  Caption="Pay Frequency"/>

                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsOneTimePay" Caption="One Time Payment" IsChecked="True" checkBox_Checked="chkIsOneTimePay_checkBox_Checked" checkBox_Unchecked="chkIsOneTimePay_checkBox_Unchecked" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPayYear"  Caption="Year" MouseDoubleClick="txtPayYear_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPayMoth"  Caption="Month" MouseDoubleClick="txtPayMoth_MouseDoubleClick"/>

                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtGLCode_Credit" Visibility="Visible"  Caption="GL Code Credit"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtGLCode_Debit" Visibility="Visible"  Caption="GL Code Debit"/>

                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkNoPayApplicable"  Caption="No Pay Applicable" IsChecked="True"/>
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkZeroValueShow"  Caption="Zero Amount Show" IsChecked="True"/>

                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkPayslipApplicable"  Caption="Payslip Applicable" IsChecked="True"/>


                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,10,5,5"/>
                        <Label Content="Payslip Statutary Items" FontSize="16" Foreground="#FF0096D6"/>
                        <SEACC_WPFControls:SEACC_DataGrid x:Name="dgrStatutary" HeadersVisibility="None" Background="{x:Null}" BorderBrush="{x:Null}"  Foreground="Black" RowBackground="{x:Null}"  HideContextMenu="True" GridLinesVisibility="None" Margin="0,5,0,0" AutoGenerateColumns="False"  IsReadOnly="False" CanUserAddRows="False" MouseLeftButtonUp="dgrStatutary_MouseLeftButtonUp">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                    <Setter Property="Height" Value="28" />
                                </Style>
                            </DataGrid.RowStyle>
                            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding apply , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Apply" IsReadOnly="False"/>
                                <DataGridTextColumn Binding="{Binding statutaryPayItem_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="ID" Width="55"   IsReadOnly="True" Visibility="Collapsed" />
                                <DataGridTextColumn Binding="{Binding statutaryPayItem_Code , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="Code" Width="100"    IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding statutaryPayItem_Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="Title" Width="200"  IsReadOnly="True"/>
                            </SEACC_WPFControls:SEACC_DataGrid.Columns>
                        </SEACC_WPFControls:SEACC_DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
