<Window x:Class="Digiteq.Master_Forms.frm_Employee_PaySlipItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="{x:Null}" 
        Title="Employee Salary" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" WindowStyle="None" AllowsTransparency="True" Loaded="Window_Loaded" Closed="Window_Closed" >
    <Grid Margin="10">
        <Border Background="#FF34495E" >
            <Border.Effect>
                <DropShadowEffect ShadowDepth="5" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>
        <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" Background="#FF33477B" >
            <Grid Margin="0,0,0,50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <Grid x:Name="grdTitleBar" Grid.Row="0" MouseDown="grdTitleBar_MouseDown" >
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF364758" Offset="0"/>
                            <GradientStop Color="#FF051a2f" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <StackPanel Margin="5,0,0,0" >
                        <Label x:Name="lblTitleBar" Content="Employee Salary items"  FontSize="25" Foreground="White" />
                        <Label x:Name="lblEmpName" Content="Employee Name" FontSize="14" Foreground="White"/>
                    </StackPanel>
                    <SEACC_WPFControls:SEACC_Button_Close x:Name="btnClose" Content="&#xE8BB;" VerticalAlignment="Top" HorizontalAlignment="Right" Width="30" Height="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Background="{x:Null}" BorderBrush="{x:Null}" Click="btnClose_Click" />
                </Grid>

                <Grid Grid.Row="1"  Margin="0,0,288,0">
                    <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_PayItems"  CellEditEnding="dgr_PayItems_CellEditEnding" CellEditBegining="dgr_PayItems_CellEditBegining"  MouseLeftButtonUp1="dgr_PayItems_MouseLeftButtonUp1" Background="{x:Null}"  />
                    <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5,5,15,5"   Height="20" >
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAddAll" Content="&#xE74B;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Foreground="#FFE2E2E2" Background="#FF335F68" BorderBrush="{x:Null}" Click="btnGridItemAddAll_Click" />
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAdd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Click="btnGridItemAdd_Click" Foreground="#FFE2E2E2" Background="#FF335F68" BorderBrush="{x:Null}" Height="20" VerticalAlignment="Bottom" />
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemDelete" Content="&#xE894;" Width="30" FontFamily="Segoe MDL2 Assets" Click="btnGridItemDelete_Click" Background="#FF335F68" BorderBrush="{x:Null}" Foreground="#FFD31111" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"  Margin="0,50,38,0" HorizontalAlignment="Right" Width="250" >
                    
                    <SEACC_WPFControls:SEACC_DataGrid x:Name="dgrStatutary"  Background="{x:Null}" BorderBrush="{x:Null}"  Foreground="Black" RowBackground="{x:Null}" HeadersVisibility="None"  HideContextMenu="True" GridLinesVisibility="None" AutoGenerateColumns="False"  IsReadOnly="False" CanUserAddRows="False" MouseLeftButtonUp="dgrStatutary_MouseLeftButtonUp" >
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="#FFFFFF" />
                                <Setter Property="Height" Value="28" />
                            </Style>
                        </DataGrid.RowStyle>
                        <SEACC_WPFControls:SEACC_DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding apply , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Apply" IsReadOnly="False"/>
                            <DataGridTextColumn Binding="{Binding payItem_ID ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"   Header="PayItemID" Width="55"   IsReadOnly="True" Visibility="Collapsed" />
                            <DataGridTextColumn Binding="{Binding statutaryPayItem_ID , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="StatItemID" Width="100"    IsReadOnly="True" Visibility="Collapsed"/>
                            <DataGridTextColumn Binding="{Binding statutaryPayItem_Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="StatTitle" Width="190"  IsReadOnly="True"/>
                        </SEACC_WPFControls:SEACC_DataGrid.Columns>
                    </SEACC_WPFControls:SEACC_DataGrid>
                </Grid>
            </Grid>

        </SEACC_WPFControls1:SEACC_Form>

    </Grid>
</Window>
