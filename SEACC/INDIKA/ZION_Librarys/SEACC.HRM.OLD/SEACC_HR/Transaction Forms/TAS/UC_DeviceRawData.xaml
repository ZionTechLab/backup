<UserControl x:Class="Digiteq.UC_DeviceRawData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d"   Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form1_SizeChanged" >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="520" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0"/>
            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
                <StackPanel MaxWidth="550">
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Emoloyee No." x:Name="txtEmpID" MouseDoubleClick="txtEmpID_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="Device ID" x:Name="txtDeviceID" MouseDoubleClick="txtDeviceID_MouseDoubleClick"  />
                    <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtp_FromDate" Caption="Date From" ShowDate="Visible" ShowTime="Hidden" />
                    <SEACC_WPFControls:SEACC_LabelTimeSelector FontSize="12" x:Name="dtp_ToDate" Caption="Date To" ShowDate="Visible" ShowTime="Hidden" />
                    <SEACC_WPFControls:SEACC_Button x:Name="btn_Load"  Height="35" Content="Refresh ↺" Click="btn_Load_Click"  FontSize="20" HorizontalAlignment="Center"  FontWeight="Thin" Margin="10,10,10,0"  Width="201" Background="#FF0091EA" BorderBrush="White" Foreground="White"    />
                </StackPanel>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>