<UserControl xmlns:Digiteq="clr-namespace:Digiteq"  x:Class="Digiteq.UC_Approve_GatePass"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                </Grid.RowDefinitions>

                <SEACC_WPFControls:SEACC_Button  x:Name="btn_gp_Check" Grid.Column="0" Content="Gatepass Checking" Background="#FF555555" Foreground="White" BorderThickness="0,1" Tag="0" Click="btn_gp_Check_Click"/>
                <SEACC_WPFControls:SEACC_Button  x:Name="btn_gp_Approve" Grid.Column="1" Content="Gatepass Approval" Background="#FF555555" Foreground="White"  Tag="0" Click="btn_gp_Check_Click"/>
            </Grid>

            <GridSplitter Background="#D5D5D5" Grid.Column="1" Grid.RowSpan="2" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,30,0,0" Grid.Row="1" Grid.Column="0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" Background="#FF34495E" HeaderColor="#FF0091EA" >
                <!--<SEACC_WPFControls:SEACC_DataGrid_Advanced.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="#FF006A7A" Offset="1"/>
                    </LinearGradientBrush>
                </SEACC_WPFControls:SEACC_DataGrid_Advanced.Background>-->
            </SEACC_WPFControls:SEACC_DataGrid_Advanced>

            <Grid  Grid.Column="2"  >
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <Expander x:Name="exp_EmpDetails" Header="Employee Details" FontSize="24" Foreground="#FF0096D6"  >
                            <StackPanel HorizontalAlignment="Left">
                                <Digiteq:UC_Vw_EmployeeDemography x:Name="Vw_EmpDetails" FontSize="12" Width="540" ColorTheam="#0090A8"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="exp_History" Header="History" FontSize="24" Foreground="#FF0096D6" >
                            <StackPanel>
                                <Digiteq:UC_Leave_GP_History  x:Name="Vw_History"  />
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
            <Grid Margin="203,0,11,-42" VerticalAlignment="Bottom" Height="30" Grid.ColumnSpan="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <SEACC_WPFControls:SEACC_Button x:Name="btn_Approve" Content="Submit" Width="100" Background="#FF0096D6" Foreground="White" Click="btn_Approve_Click"  />
                    <!--<SEACC_WPFControls:SEACC_Button x:Name="btn_Reject"  Content="Reject" Width="100" Background="#FFF06060" Foreground="White"  Margin="10,0,0,0" Click="btn_Reject_Click"  />-->
                </StackPanel>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>