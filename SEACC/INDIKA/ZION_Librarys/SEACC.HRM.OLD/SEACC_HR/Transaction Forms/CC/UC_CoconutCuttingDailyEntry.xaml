<UserControl xmlns:Digiteq="clr-namespace:Digiteq" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" x:Class="Digiteq.Transaction_Forms.CoconutCuting.UC_CoconutCuttingDailyEntry"
             mc:Ignorable="d" Background="#FFFFFF" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid  Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="coloumnA" Width="785" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Background="#FF34495E" Margin="0,0,5,0">
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" CellEditEnding="grd_Main_CellEditEnding" Background="#FF34495E" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"  DG_PreviewKeyDown="dgr_Main_DG_PreviewKeyDown" LoadingRow="dgr_Main_LoadingRow"  />
                <StackPanel x:Name="gg" VerticalAlignment="Bottom" Background="Black" Margin="5,0,5,18" >
                    <!--<Digiteq:UC_AttendanceEntryRivision_Mini x:Name="uc_AttendenceRev" />-->
                </StackPanel>
            </Grid>
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,5,0">
                        <Expander x:Name="exp_Selection" Header="Employee Selection" FontSize="24" Foreground="#FF0096D6" IsExpanded="True">
                            <StackPanel>
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Employee" x:Name="txtEmpNo" MouseDoubleClick="txtEmpNo_MouseDoubleClick"  />
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Designation" x:Name="txtDesignation" MouseDoubleClick="txtDesignation_MouseDoubleClick" Visibility="Collapsed"  />
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Division" x:Name="txtDivision" MouseDoubleClick="txtDivision_MouseDoubleClick" Visibility="Collapsed"  />
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Department" x:Name="txtDepartment" MouseDoubleClick="txtDepartment_MouseDoubleClick" Visibility="Collapsed"  />
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Section" x:Name="txtSection" MouseDoubleClick="txtSection_MouseDoubleClick"  />
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Sub Section" x:Name="txtSubSection" MouseDoubleClick="txtSubSection_MouseDoubleClick" Visibility="Collapsed"   />
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Empl Category 1" x:Name="txtEmpCategory1" MouseDoubleClick="txtEmpCategory1_MouseDoubleClick" Visibility="Collapsed"  />
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Empl Category 2" x:Name="txtEmpCategory2" MouseDoubleClick="txtEmpCategory2_MouseDoubleClick" Visibility="Collapsed"  />
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Empl Category 3" x:Name="txtEmpCategory3" MouseDoubleClick="txtEmpCategory3_MouseDoubleClick" Visibility="Collapsed"  />

                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Week" x:Name="txtWeek" MouseDoubleClick="txtWeek_MouseDoubleClick" />
                                <SEACC_WPFControls:SEACC_LabelComboBox FontSize="12" x:Name="cmbPayPeriod"  Caption="Pay Frequency"/>
                                <SEACC_WPFControls:SEACC_LabelTimeSelector FontSize="12" x:Name="dtp_FromDate" Caption="Date From" Foreground="Black" ShowDate="Visible" ShowTime="Hidden" />
                                <SEACC_WPFControls:SEACC_LabelTimeSelector FontSize="12" x:Name="dtp_toDate" Caption="Date To" Foreground="Black" ShowDate="Visible" ShowTime="Hidden" />

                                <SEACC_WPFControls:SEACC_Button x:Name="btnLoad" FontSize="12" Content="Load" Background="#FF41B1E1" Foreground="White" Click="SEACC_Load_Button_Click" Width="75" Height="23" HorizontalAlignment="Left" Margin="195,20,0,0" />
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="exp_Configd" Header="Configuration Details" FontSize="24" Foreground="#FF0096D6">
                            <StackPanel>
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Cut Off Nuts (WD)" x:Name="txtCutoffNutsWeekday" IsEnabled="False" />
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Cut Off Nuts (SAT)" x:Name="txtCutoffNutsSatureday" IsEnabled="False"/>
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Cut Off Nuts (HOL)" x:Name="txtCutoffNutsHoliday" IsEnabled="False"/>
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Rate (WD)" x:Name="txtRateWeekDay" IsEnabled="False"/>
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Rate (SAT)" x:Name="txtRateSatureday" IsEnabled="False"/>
                                <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" Caption="Rate (HOL)" x:Name="txtRateHoliday" IsEnabled="False"/>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="exp_More" Header="Attandance Details" FontSize="24" Foreground="#FF0096D6">
                            <StackPanel>
                                <Digiteq:wj_Date x:Name="WJDate" />
                                <Digiteq:UC_DeviceRowDataMini x:Name="UC_Devicerawdata" Foreground="#FF8D3737"  />
                                <Digiteq:UC_Vw_EmployeeDemography x:Name="EmployeeViewer" FontSize="12" Margin="0,10,0,20" ColorTheam="#FF595959" />
                                <Digiteq:UC_Leave_GP_History x:Name="LeaveViewer"  Margin="0,10,0,20" />
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
