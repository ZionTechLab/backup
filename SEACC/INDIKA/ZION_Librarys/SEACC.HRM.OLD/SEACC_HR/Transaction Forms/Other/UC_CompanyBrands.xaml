<UserControl x:Class="Digiteq.UC_CompanyBrands"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged"  >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="grd_Main"  Margin="0,0,5,0" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel >
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBrandCode" Caption="Brand Code" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpBrandDate" Caption="Found Date" ShowDate="Visible" ShowTime="Hidden" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpBrandExpDate" Caption="Expiry Date" ShowDate="Visible" ShowTime="Hidden" />
                            <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtFoundBy"  MinHeight="27" Caption="Found By"  Margin="0,10,0,0" VerticalAlignment="Top"  />
                            <SEACC_WPFControls:SEACC_Button x:Name="btn_DocumentUpload" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White" Content="Add" FontSize="12" Width="75" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <Grid >
                                <SEACC_WPFControls:SEACC_DataGrid x:Name="grd_Founders" FontSize="12" HorizontalAlignment="Left" Margin="5,10" VerticalAlignment="Bottom" AutoGenerateColumns="False">
                                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding No}"  Header="Emp. No." Width="100" />
                                        <DataGridTextColumn Binding="{Binding FileDetail}"  Header="Name"  Width="270" />
                                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                                </SEACC_WPFControls:SEACC_DataGrid>
                            </Grid>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpLunchDate" Caption="Launch Date" ShowDate="Visible" ShowTime="Hidden"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLunchPlace" Caption="Launch Place" Margin="0,3,0,0" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemarks" Caption="Remarks" MinHeight="65" Margin="0,3,0,0" />
                        <Grid HorizontalAlignment="Left" >
                            <TextBlock Text="Founder(s) Image" Foreground="Black" FontSize="12" />
                            <WrapPanel Margin="117,0,5,0">    
                                <Border BorderBrush="#FF41B1E1" BorderThickness="1" Width="80" Height="80" HorizontalAlignment="Left" Margin="3" >
                                    <Image x:Name="imgAwd1" Stretch="Fill" Margin="0"  />
                                </Border>
                                <Border BorderBrush="#FF41B1E1" BorderThickness="1" Width="80" Height="80" HorizontalAlignment="Left" Margin="3" >
                                    <Image x:Name="imgFounder2" Stretch="Fill" Margin="0"  />
                                </Border>
                                <Border BorderBrush="#FF41B1E1" BorderThickness="1" Width="80" Height="80" HorizontalAlignment="Left" Margin="3" >
                                    <Image x:Name="imgFounder3" Stretch="Fill" Margin="0"  />
                                </Border>
                                <Border BorderBrush="#FF41B1E1" BorderThickness="1" Width="80" Height="80" HorizontalAlignment="Left" Margin="3" >
                                    <Image x:Name="imgFounders4" Stretch="Fill" Margin="0"  />
                                </Border>
                                <SEACC_WPFControls:SEACC_Button x:Name="btn_SelectImage" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White" FontSize="12" Content="Upload Images" Width="90" VerticalAlignment="Bottom" Height="25" Margin="3" />
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
