<UserControl x:Class="Digiteq.UC_EmployeeIncedentalDiary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged"   >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="700" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="grd_Main"  Margin="0,0,5,0"   />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txt_IncedentID" Caption="Incident Code" Margin="0,3,0,0"/>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpDate" Caption="Date" Margin="0,3,0,0" ShowDate="Visible" ShowTime="Hidden"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmpNo" Caption="Emp. No." Margin="0,3,0,0"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtInc_Catg" Caption="Incident Category" Margin="0,3,0,0"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtIncidentType" Caption="Incident Type" Margin="0,3,0,0"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDescription_HRD" Caption="Description (HRD)" MinHeight="65" Margin="0,3,0,0"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDescription_Mgt" Caption="Description (Mgt.)" MinHeight="65" Margin="0,3,0,0"/>
                        <Expander x:Name="exp_Approvel" Header="Certification" FontSize="24" Foreground="#FF0096D6" IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition  Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Content="Preparation" FontSize="14" Grid.Row="0" FontWeight="SemiBold"/>
                                <Border Grid.ColumnSpan="2"  Grid.Row="1" Grid.Column="0" Height="1" Background="Black"></Border>
                                <Label FontSize="12" Grid.Row="2" Grid.Column="0" Content="Prepared Date"/>
                                <DatePicker FontSize="12" Grid.Row="2" Grid.Column="1" MaxWidth="120" HorizontalAlignment="Left" Margin="0,5,0,0" x:Name="dtp_perpadDate"/>
                                <Label FontSize="12" Grid.Row="3" Grid.Column="0" Content="Prepared By"/>
                                <SEACC_WPFControls:SEACC_UserIndicator_Small x:Name="Wusr_Perpared1" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="0,5,5,5" />

                                <Label Content="Verification" FontSize="14" Grid.Row="4" FontWeight="SemiBold"/>
                                <Border Grid.ColumnSpan="2"  Grid.Row="5" Grid.Column="0" Height="1" Background="Black"></Border>
                                <Label FontSize="12" Grid.Row="6" Grid.Column="0" Content="Verified Date"/>
                                <DatePicker FontSize="12" Grid.Row="6" Grid.Column="1" Margin="0,5,0,0" MaxWidth="120" HorizontalAlignment="Left" x:Name="dtp_VerifiedDate"/>
                                <Label FontSize="12" Grid.Row="8" Grid.Column="0" Content="Verified By"/>
                                <SEACC_WPFControls:SEACC_UserIndicator_Small x:Name="Wusr_Verigied" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left" Margin="0,5,5,5" />

                                <Label Content="Approval" FontSize="14" Grid.Row="9" FontWeight="SemiBold"/>
                                <Border Grid.ColumnSpan="2"  Grid.Row="10" Grid.Column="0" Height="1" Background="Black"></Border>
                                <Label FontSize="12" Grid.Row="11" Grid.Column="0" Content="Approved Date"/>
                                <DatePicker FontSize="12" Grid.Row="11" Grid.Column="1" x:Name="dtp_Approval" Margin="0,5,0,0" MaxWidth="120" HorizontalAlignment="Left"/>
                                <Label FontSize="12" Grid.Row="12" Grid.Column="0" Content="Approved By"/>
                                <SEACC_WPFControls:SEACC_UserIndicator_Small x:Name="Wusr_approved" Grid.Row="12" Grid.Column="1" HorizontalAlignment="Left" Margin="0,5,5,5" />
                            </Grid>
                        </Expander>                       
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
