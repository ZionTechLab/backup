<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"  
             xmlns:local="clr-namespace:Digiteq" x:Class="Digiteq.UC_Staff_Loan"  
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,0,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="coloumnA" Width="600" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <local:UC_Vw_EmployeeDemography Foreground="White"  Grid.Row="0" Margin="5"  FontSize="12" Height="auto" ColorTheam="#FF34495E" />

                    <SEACC_WPFControls:SEACC_DataGrid Grid.Row="2"  x:Name="grd_History" Margin="5" Background="#FF34495E" CanUserResizeColumns="True">
                        <SEACC_WPFControls:SEACC_DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding LoanID}" ClipboardContentBinding="{x:Null}" Header="#"/>
                            <DataGridTextColumn Binding="{Binding Amount}" ClipboardContentBinding="{x:Null}" Header="Amount" Width="100"/>
                            <DataGridTextColumn Width="100" Binding="{Binding Start_Date}" ClipboardContentBinding="{x:Null}" Header="Start Date"/>
                            <DataGridTextColumn Width="100" Binding="{Binding Installment}" ClipboardContentBinding="{x:Null}" Header="Installment"/>
                            <DataGridTextColumn Width="100" Binding="{Binding Outstanding}" ClipboardContentBinding="{x:Null}" Header="Outstanding"/>
                        </SEACC_WPFControls:SEACC_DataGrid.Columns>
                    </SEACC_WPFControls:SEACC_DataGrid>

                    <GridSplitter Background="#FFBCC0C3" Grid.Row="3" HorizontalAlignment="Stretch"  />

                    <SEACC_WPFControls:SEACC_DataGrid x:Name="grd_Settlment" Grid.Row="4" CanUserResizeColumns="True" Margin="5" >
                        <SEACC_WPFControls:SEACC_DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding LoanID}"  Header="#"/>
                            <DataGridTextColumn Binding="{Binding Inst_Date}"  Header="Date" Width="100"/>
                            <DataGridTextColumn Width="100" Binding="{Binding Installment}"  Header="Installment"/>
                            <DataGridTextColumn Width="100" Binding="{Binding Outstanding}"  Header="Outstanding"/>
                        </SEACC_WPFControls:SEACC_DataGrid.Columns>
                    </SEACC_WPFControls:SEACC_DataGrid>
                </Grid>
            </Grid>

            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

            <Grid  Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel >
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmpNO" Caption="Employee No"  />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLoanID" Caption="Loan ID" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtp_StartDate" Caption="Start Date" ShowDate="Visible" ShowTime="Hidden" />
                        <SEACC_WPFControls:SEACC_LableTextBox  x:Name="txtAmount" Caption="Amount"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txt_No_of_Installment" Caption="No. of Installment" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtInstallmetAmount" Caption="Installment Amount" />
                        <Grid>
                            <Label Content="Status"/>
                            <CheckBox Margin="123,8,0,0" Content="Active" />
                        </Grid>
                        <Expander Header="Approvals" FontSize="24" Foreground="#FF0096D6" >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition  Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="cbx_Checked" Grid.Row="0"  Content="Checked" FontSize="12"  VerticalAlignment="Center" />
                                <CheckBox x:Name="cbx_Approved" Grid.Row="1"  Content="Approved" FontSize="12" VerticalAlignment="Center" />
                                <SEACC_WPFControls:SEACC_UserIndicator_Small HorizontalAlignment="Left" x:Name="usr_Checked" Grid.Row="0" Grid.Column="1" Margin="5"/>
                                <SEACC_WPFControls:SEACC_UserIndicator_Small HorizontalAlignment="Left" x:Name="usr_Approved" Grid.Row="1" Grid.Column="1" Margin="5"/>
                            </Grid>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
