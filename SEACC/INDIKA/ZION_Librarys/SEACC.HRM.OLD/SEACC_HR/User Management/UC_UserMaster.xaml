<UserControl x:Class="Digiteq.UC_UserMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
              xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"  
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="750" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp" ></SEACC_WPFControls:SEACC_DataGrid_Advanced>
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel x:Name="stackPanel">
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtUserID" Caption="User ID" MouseDoubleClick="txtUserID_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtUserName" Caption="User Name" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtGroupName" Caption="Group Name" MouseDoubleClick="txtGroupName_MouseDoubleClick"/>
                        <WrapPanel Margin="0,2,0,0">
                            <Label Content="Password" HorizontalAlignment="Left" Width="115"  />
                            <PasswordBox x:Name="txtPassword" BorderBrush="#FF41B1E1" HorizontalAlignment="Left" Width="225" Margin="5,0,0,0" />
                            <!--Margin="121,2,5,2" -->
                        </WrapPanel>
                        <WrapPanel Margin="0,5,0,0" >
                            <Label Content="Confirm Password" HorizontalAlignment="Left" Width="115" />
                            <PasswordBox x:Name="txtPassword2" BorderBrush="#FF41B1E1" HorizontalAlignment="Left" Width="225" Margin="5,0,0,0"/>
                        </WrapPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmployeeCode" Caption="Employee" MouseDoubleClick="txtEmployeeCode_MouseDoubleClick"  />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMobile" Caption="Mobile" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmail" Caption="Email" />
                        <!--<SEACC_WPFControls:SEACC_LableTextBox Width="350" x:Name="txtComputerName" Caption="Computer Name"  />-->
                        <!--<SEACC_WPFControls:SEACC_LableTextBox Width="350" x:Name="txtIPAddress" Caption="IP Address" />-->
                        <SEACC_WPFControls:SEACC_LabelImageBox x:Name="pbxImage" Caption="Image" />
                        <!--<Grid Margin="5,0,0,5" HorizontalAlignment="Left">
                            <TextBlock Text="Image"></TextBlock>
                            <Border BorderBrush="#FF41B1E1" BorderThickness="1" Margin="13,10,10,0" Height="93"   Width="100">
                                <Image x:Name="pbxImage"  Stretch="Fill" Margin="0,0,0,0"  />
                            </Border>
                            <SEACC_WPFControls:SEACC_Button x:Name="btnLoadImage" Content="Add Image" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White"  Click="btnLoadImage_Click" Height="25"   Width="60" Margin="256,78,27,0"/>
                        </Grid>-->
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpLastLoggedOnDate"  Caption="Last Logged on" FontSize="12" ShowDate="Visible" ShowTime="Visible" Visibility="Collapsed" />
                        <Grid Visibility="Collapsed">
                            <Label Content="Status" HorizontalAlignment="Left" Margin="1,22,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chk_logged" Content="Logged" Margin="122,25,0,0"  />
                            <CheckBox x:Name="chk_Blocked" Content="Blocked"  Margin="198,25,0,0" />
                            <CheckBox x:Name="chk_Locked" Content="Locked" Margin="274,25,0,0"/>
                        </Grid>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>


        </Grid>



    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
