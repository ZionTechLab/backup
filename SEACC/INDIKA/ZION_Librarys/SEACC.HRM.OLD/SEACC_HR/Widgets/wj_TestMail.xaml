<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" x:Class="Digiteq.wj_TestMail" 
             mc:Ignorable="d" Background="#FFB04444"  Width="325.525" Height="367.328"  >
    <Grid>
        <Border BorderBrush="White" BorderThickness="1" Margin="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="10"/>
            </Border.Effect>
        </Border>
        <Grid Margin="15,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Alerts"  FontSize="20" Foreground="White" Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="0,8,0,0"/>
            <Border BorderBrush="White" BorderThickness="0,0,0,1"/>
            <Grid Grid.Row="1">
                <SEACC_WPFControls1:SEACC_Button Content="Alert Setings" Margin="10,10,10,0" VerticalAlignment="Top" Height="28"/>
                <SEACC_WPFControls1:SEACC_Button Content="Send Box" Margin="10,43,10,0" VerticalAlignment="Top" Height="28"/>
                <SEACC_WPFControls1:SEACC_Button Content="Send" Margin="0,286,10,0" VerticalAlignment="Top" Height="28" HorizontalAlignment="Right" Width="100" Click="SEACC_Button_Click"/>


                <Border Margin="0,88,0,0" BorderBrush="White" BorderThickness="0,1,0,0" Height="201" VerticalAlignment="Top">
                    <Grid Height="190" VerticalAlignment="Top">
                        <Label Content="Send Test mail" Foreground="White" FontSize="14" Background="#FF959595" Height="30" VerticalAlignment="Top"/>
                        <Label Content="Email Address" HorizontalAlignment="Left" Height="24" Margin="10,35,0,0" VerticalAlignment="Top" Width="89"/>
                        <TextBox x:Name="txtemail" HorizontalAlignment="Left" Height="34" Margin="10,64,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="276"/>
                        <Label Content="Text" HorizontalAlignment="Left" Height="28" Margin="10,103,0,0" VerticalAlignment="Top" Width="104"/>
                        <TextBox x:Name="txttext" HorizontalAlignment="Left" Height="58" Margin="10,129,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="276" />

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
