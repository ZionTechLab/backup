<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" xmlns:local="clr-namespace:Digiteq"  xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" x:Class="Digiteq.frm_DashBord"
        Title="frm_DashBord" Background="#FF4479B0"  ResizeMode="CanResizeWithGrip" WindowStyle="None" WindowStartupLocation="Manual"  AllowsTransparency="True"  Icon="/Resources/Icon.ico" StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged" Loaded="Window_Loaded" Height="622" Width="1362" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="21"/>
        </Grid.RowDefinitions>
        <Grid Background="#66000000" x:Name="GRD_Titlebar" Grid.Row="0" MouseDown="GRD_Titlebar_MouseDown" >
            <Grid  x:Name="GRD_ControlBox" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right">
                <SEACC_WPFControls1:SEACC_Button_Close x:Name="btnClose" Content="&#xE8BB;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets"  Click="btnClose_Click" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btnRestore" Content="&#xE923;"  HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,30,0" Click="btnRestore_Click" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btnMinimize" Content="&#xE921;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C"  Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,60,0" Click="btnMinimize_Click"/>
            </Grid>
            <local:R2Logo HorizontalAlignment="Left" Height="66" VerticalAlignment="Top" Width="241" Margin="0,5,0,0"/>
            <SEACC_WPFControls1:SEACC_Button x:Name="btnChat" Content="&#xE90A;" FontFamily="Segoe MDL2 Assets" Foreground="#FFB07919"  Background="{x:Null}" BorderBrush="{x:Null}" FontSize="20" Margin="0,34,10,0" Height="36" VerticalAlignment="Top" Click="btnChat_Click" HorizontalAlignment="Right" Width="30"/>
            <Label Content="Employee Dashboard" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" FontWeight="SemiBold" FontSize="24" Height="43" Opacity="0.1" Margin="218,13,0,0">
                <Label.Background>
                    <SolidColorBrush Color="Transparent" Opacity="0.5"/>
                </Label.Background>
            </Label>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Background="#FF535353" Grid.Column="0">
                <local:UC_UserIndicator Height="61" x:Name="userIndicator"/>
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_EmpProfile" Content="My Profile"  Height="42" Click="btn_EmpProfile_Click" Visibility="Collapsed" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_PaySlip" Content="View Pay-Slip"  Height="42" Click="btn_PaySlip_Click" Visibility="Collapsed" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_ApplyLeave" Content="Apply for Personal Leave"  Height="42" Click="btn_ApplyLeave_Click" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_dutiLeave" Content="Gate Pass(Offcial Leave)"  Height="42" Click="btn_dutiLeave_Click"  />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_RequestForLeter" Content="Request for a letter"  Height="42" Click="btn_RequestForLeter_Click"  Visibility="Collapsed"/>
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_WebLinks" Content="Web Links"  Height="42" Click="btn_WebLinks_Click"  Visibility="Collapsed"/>
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Approval" Content="Approvals - Leave"  Height="42" Click="btn_Approval_Click"  Visibility="Collapsed" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Approval_GP" Content="Approvals - Gate Pass"  Height="42" Click="btn_Approval_GP_Click" Visibility="Collapsed" />
             
            </StackPanel>
            <Grid x:Name="body" Grid.Column="1"/>

        </Grid>

        <local:UC_Chat x:Name="Chat" HorizontalAlignment="Right" Width="332" Margin="0" Grid.Row="1" Visibility="Hidden" />

    </Grid>
</Window>
