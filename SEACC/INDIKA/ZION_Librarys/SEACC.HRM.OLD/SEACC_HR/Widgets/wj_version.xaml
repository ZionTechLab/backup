<UserControl x:Class="Digiteq.wj_version"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
           mc:Ignorable="d" Foreground="White" Background="#FFB04444" Margin="5" Height="232.246" Width="306.295"  >
    <Grid>
        <Border BorderBrush="White" BorderThickness="1" Margin="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="10"/>
            </Border.Effect>
        </Border>

        <Grid Margin="15,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="SEACC version"  FontSize="20" Foreground="White" Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="0,8,0,0"/>
            <Border BorderBrush="White" BorderThickness="0,0,0,1"></Border>
            <TextBlock Text="SEACC" FontFamily="Colonna MT" FontSize="48" Opacity="0.5" Foreground="#FF766C6C" Margin="-9,42,0,0" Grid.Row="1"  VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Width="145" >
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-43.449"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
                <TextBlock.Effect>
                    <DropShadowEffect Color="White" ShadowDepth="7"/>
                </TextBlock.Effect></TextBlock>
            <Grid Grid.Row="1" Margin="0,10,10,0" Height="130" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="75"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="SEACC software type" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Version No." FontSize="9"></TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Licence status" FontSize="9"></TextBlock>
                <Border Grid.ColumnSpan="3"  Grid.Row="3" Grid.Column="0" Height="1" Background="White"></Border>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Release note number" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Release note date" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Updated date" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Updated engeneer" FontSize="9"></TextBlock>

                <TextBlock Grid.Row="0" Grid.Column="1" Text=":" HorizontalAlignment="Center" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1" Text=":" HorizontalAlignment="Center" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="1" Text=":" HorizontalAlignment="Center" FontSize="9"></TextBlock>

                <TextBlock Grid.Row="4" Grid.Column="1" Text=":" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="5" Grid.Column="1" Text=":" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="6" Grid.Column="1" Text=":" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="7" Grid.Column="1" Text=":" FontSize="9"></TextBlock>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="HRCM" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="V 0.0.1.156" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Active" FontSize="9"></TextBlock>

                <TextBlock Grid.Row="4" Grid.Column="2" Text="08" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="10/03/2015" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="10/28/2015" FontSize="9"></TextBlock>
                <TextBlock Grid.Row="7" Grid.Column="2" Text="Maduka" FontSize="9"></TextBlock>
                <StackPanel  >
                    <!-- Syacc software type-->
                    <!--vershion no-->
                    <!--Licence status-->
                    <!--  -->
                    <!--Relese note number-->
                    <!--Relese note date-->
                    <!--updated date-->
                    <!--updated Engeneer-->
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
