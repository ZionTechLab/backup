<UserControl x:Class="Digiteq.Wj_ChangePassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80*" MinWidth="80"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="150*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

  
            
                <Label Grid.Column="0" Content="Password" HorizontalAlignment="Left" Margin="9,57,0,-57"  />
        <PasswordBox Grid.Column="2" Width="200" x:Name="txtPassword" BorderBrush="#FF41B1E1"    Height="23"  HorizontalAlignment="Left"/>


        <Label Grid.Column="0" Content="Current Password" HorizontalAlignment="Left" Margin="10,72,0,-72"  />
        <PasswordBox Grid.Column="2" Width="200" x:Name="txtCurrentPassword" BorderBrush="#FF41B1E1"    Height="23"  HorizontalAlignment="Left"/>


        <Label Grid.Column="0" Content="Confirm Password" HorizontalAlignment="Left" Margin="4,-43,0,43"  />
        <PasswordBox Grid.Column="2" x:Name="txtPassword2" BorderBrush="#FF41B1E1"    Width="200" Height="23" HorizontalAlignment="Left"/>
            
        
    </Grid>
</UserControl>
