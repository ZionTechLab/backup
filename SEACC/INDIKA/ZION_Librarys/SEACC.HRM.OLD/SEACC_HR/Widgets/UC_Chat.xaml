<UserControl xmlns:Digiteq="clr-namespace:Digiteq" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             x:Class="Digiteq.UC_Chat" 
             mc:Ignorable="d" d:DesignWidth="320" Padding="17,0,0,0"  >

    <Grid >

        <Border Background="Black">
            <Border.Effect>
                <DropShadowEffect Direction="225" BlurRadius="50"/>
            </Border.Effect>
        </Border>

        <Grid Background="#FFEFEFEF">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="#FFE8E8E8" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <SEACC_WPFControls1:SEACC_Button x:Name="btn_ChatUsers" Background="Transparent" BorderBrush="#FFD1D1D1" Grid.Column="0" Content="&#xE2AF;" FontFamily="Segoe MDL2 Assets" Foreground="#FFB07919" FontSize="24" Click="btn_MainButtons" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_chatConversetion" Background="{x:Null}" BorderBrush="#FFD1D1D1" Grid.Column="1" Content="&#xE939;" FontFamily="Segoe MDL2 Assets" Foreground="#FFB07919" FontSize="24" Click="btn_MainButtons" BorderThickness="0,1,1,1" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_chatMessege" Background="{x:Null}" BorderBrush="#FFD1D1D1" Grid.Column="2" Content="&#xE90A;" FontFamily="Segoe MDL2 Assets" Foreground="#FFB07919" FontSize="24" Click="btn_MainButtons" BorderThickness="0,1,1,1" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Chatsettings" Background="Transparent" BorderBrush="#FFD1D1D1" Grid.Column="3" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#FFB07919" FontSize="24" Click="btn_MainButtons" BorderThickness="0,1,1,1" />
            </Grid>

            <Grid Grid.Row="1" x:Name="grd_Settings" Background="#FFE6E6E6" Visibility="Hidden">
                <StackPanel>
                    <SEACC_WPFControls1:SEACC_CheckBox  x:Name="chk_Merquee" Content="Display Marquee" Margin="0,10,0,0" Checked="chk_Merquee_Checked" Unchecked="chk_Merquee_Unchecked"/>
                </StackPanel>
            </Grid>
           
            <Grid  Grid.Row="1" x:Name="grd_messeges" Background="#FFE6E6E6">
                <Grid Margin="0,0,0,72">
                    <SEACC_WPFControls1:SEACC_DataGrid HeadersVisibility="None" x:Name="DG_ChatHistry" RowBackground="#FFEFEFEF" BorderBrush="#FFA01B1B" Foreground="Black"  Background="White" FontSize="20" GridLinesVisibility="None" RowHeight="NaN"   >
                        <SEACC_WPFControls1:SEACC_DataGrid.Columns>
                            <DataGridTemplateColumn  Width="*" CanUserResize="False" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <SEACC_WPFControls1:ChatLine text="{Binding messege}"  sticker="{Binding sticker}"   />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </SEACC_WPFControls1:SEACC_DataGrid.Columns>
                    </SEACC_WPFControls1:SEACC_DataGrid>


                    <!--<ScrollViewer>
                        <ScrollViewer.Background>
                            <ImageBrush  TileMode="Tile" ImageSource="/SEACC_HR;component/Resources/Patern_1.jpg"/>
                        </ScrollViewer.Background>
                        <StackPanel x:Name="Grd_ChatHistry"/>
                    </ScrollViewer>-->


                </Grid>
                <Grid x:Name="grd_Emo" Background="#FFF1F1F1" Margin="0,25,51,72">
                    <Grid.Effect>
                        <DropShadowEffect Color="#FFDAC2A6" Direction="400" BlurRadius="10"/>
                    </Grid.Effect>
                    <ScrollViewer>
                        <WrapPanel x:Name="pnl_Emo"  />
                    </ScrollViewer>
                </Grid>
                <Grid Background="#FFE6E6E6" VerticalAlignment="Bottom" Margin="7,0,7,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txt_ChatText" Margin="63,10,33,10" TextWrapping="Wrap" MinHeight="40" MaxHeight="65" VerticalScrollBarVisibility="Auto"/>
                    <SEACC_WPFControls1:SEACC_Button x:Name="btn_ChatNewLine"   Content="&#xEA62;"  HorizontalAlignment="Right"  FontFamily="Segoe MDL2 Assets" Foreground="#FFB07919"  Background="{x:Null}" BorderBrush="{x:Null}" FontSize="20" Margin="0,10,4,10" Width="29" Click="btn_ChatNewLine_Click" />
                    <SEACC_WPFControls1:SEACC_Button x:Name="btn_ChatEmo"  Content="&#xE170;"  HorizontalAlignment="Left"  FontFamily="Segoe MDL2 Assets" Foreground="#FFB07919"  Background="{x:Null}" BorderBrush="{x:Null}" FontSize="20" Margin="7,10,0,10" Width="24" Click="btn_ChatEmo_Click"  />
                    <SEACC_WPFControls1:SEACC_Button   Content="&#xE132;"  HorizontalAlignment="Left"  FontFamily="Segoe MDL2 Assets" Foreground="#FFB07919"  Background="{x:Null}" BorderBrush="{x:Null}" FontSize="20" Margin="34,10,0,10" Width="24"  />
                </Grid>
            </Grid>
            <Grid Grid.Row="1" x:Name="grd_Users" Background="White" Visibility="Hidden">
                <SEACC_WPFControls1:SEACC_DataGrid HeadersVisibility="None" x:Name="DG_users" RowBackground="#FFEFEFEF" BorderBrush="#FFA01B1B" Foreground="Black" RowHeight="50" Background="White" FontSize="20" GridLinesVisibility="None" MouseLeftButtonUp="DG_users_MouseLeftButtonUp" >
                    <SEACC_WPFControls1:SEACC_DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding User_ID}" Width="0" Visibility="Hidden"/>
                        <DataGridTemplateColumn  Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <SEACC_WPFControls1:SEACC_UserIndicator Name="ff" UserName="{Binding UserName}" UserImage="{Binding Image}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding IsLoged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                    </SEACC_WPFControls1:SEACC_DataGrid.Columns>
                </SEACC_WPFControls1:SEACC_DataGrid>
            </Grid>
            <Grid Grid.Row="1" x:Name="dgv_ChatCon" Background="White" Visibility="Hidden">
                <SEACC_WPFControls1:SEACC_DataGrid HeadersVisibility="None" x:Name="dgv_ChatConversation" RowBackground="#FFEFEFEF" BorderBrush="#FFA01B1B" Foreground="Black" RowHeight="50" Background="White" FontSize="20" GridLinesVisibility="None" >
                    <SEACC_WPFControls1:SEACC_DataGrid.Columns>
                        <DataGridTextColumn  Binding="{Binding chatMessage}"  Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn  Binding="{Binding conectedUser}"  Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!--<DataGridTextColumn Binding="{x:Null}" ClipboardContentBinding="{x:Null}" Header="Chat ID"/>
                        <DataGridTextColumn Binding="{x:Null}" ClipboardContentBinding="{x:Null}" Header="Chat Name"/>-->

                    </SEACC_WPFControls1:SEACC_DataGrid.Columns>

                </SEACC_WPFControls1:SEACC_DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>