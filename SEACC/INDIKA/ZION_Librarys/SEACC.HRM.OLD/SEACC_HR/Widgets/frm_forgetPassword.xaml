<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"  
        xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" x:Class="Digiteq.frm_forgetPassword"
        Topmost="False" WindowStartupLocation="CenterScreen"  Height="260" Width="350"  ResizeMode="NoResize" AllowsTransparency="True" WindowStyle="None" >

    <Grid Margin="0,0,5,5">

        <Rectangle Fill="#FFCCD6DC" Margin="0,0,0,0" Grid.RowSpan="2"  >
            <Rectangle.Effect>
                <DropShadowEffect/>
            </Rectangle.Effect>
        </Rectangle>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="260*"/>
        </Grid.RowDefinitions>

        <Grid Background="#FF3887A9" MouseDown="Window_MouseDown">
            <Label Content="Request New Password" BorderBrush="#FFB28F8F" FontSize="14"/>
            <SEACC_WPFControls:SEACC_Button_Close x:Name="Btn_Close" Content="&#xE8BB;" VerticalAlignment="Top" BorderBrush="#FFEEF0F5"  HorizontalAlignment="Right" Width="25" Foreground="#FF110E0E" FontFamily="Segoe MDL2 Assets" Height="25" FontSize="10" Background="{x:Null}" FontWeight="Bold" Click="Btn_Close_Click"/>
        </Grid>
        
        <StackPanel Margin="0,4,0,0" Grid.Row="1">
            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtYourName" Caption="Your Name" />
            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmployeeID" Caption="Employee ID" MouseDoubleClick="txtEmployeeID_MouseDoubleClick"  />
            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDepatment" Caption="Department" Visibility="Collapsed" />
            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDesignation" Caption="Designation" Visibility="Collapsed"/>
            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmailAddress" Caption="Email Address"/>
            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMobileNo" Caption="Mobile Number" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="135,0,0,20" HorizontalAlignment="Left" Grid.Row="1">
            <SEACC_WPFControls:SEACC_Button x:Name="btnSend" Width="85" Height="23" Background="#FF3887A9" Content="Send" VerticalAlignment="Top" Click="ucbtnSend_Click" Margin="0,0,10,0" />
            <SEACC_WPFControls:SEACC_Button x:Name="ucbtnCancel" Width="85" Height="23" Background="#FF3887A9" Content="Cancel" VerticalAlignment="Top" Click="ucbtnCancel_Click" Margin="10,0,0,0"/>
        </StackPanel>
        <!--<SEACC_WPFControls:SEACC_LableTextBox x:Name="uclblYourName"  Content="Your Name"  HorizontalAlignment="Left" Height="27" Margin="6,10,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_TextBox x:Name="uctxtYourName"  HorizontalAlignment="Left" Height="27" Margin="85,10,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_LableTextBox x:Name="uclblEmployeeID"  Content="Employee ID"  HorizontalAlignment="Left" Height="27" Margin="6,42,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_TextBox x:Name="uctxtEmployeeID"  HorizontalAlignment="Left" Height="27" Margin="85,42,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_LableTextBox x:Name="uclblDepartment" Content="Department"  HorizontalAlignment="Left" Height="27" Margin="6,74,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_TextBox x:Name="uctxtDepartment"  HorizontalAlignment="Left" Height="27" Margin="85,74,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_LableTextBox x:Name="uclblDesignation"  Content="Designation"  HorizontalAlignment="Left" Height="27" Margin="6,106,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_TextBox x:Name="uctxtDesignation"  HorizontalAlignment="Left" Height="27" Margin="85,106,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_LableTextBox x:Name="uclblEmailAddress" Content="Email Address"  HorizontalAlignment="Left" Height="27" Margin="6,138,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_TextBox x:Name="uctxtEmailAddress"  HorizontalAlignment="Left" Height="27" Margin="85,138,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_LableTextBox x:Name="uclblMobile" Content="Mobile"  HorizontalAlignment="Left" Height="27" Margin="6,170,0,0" VerticalAlignment="Top"/>
        <SEACC_WPFControls:SEACC_TextBox x:Name="uctxtMobile"  HorizontalAlignment="Left" Height="27" Margin="85,170,0,0" VerticalAlignment="Top"/>

        <SEACC_WPFControls:SEACC_Button x:Name="btnSend" Width="85" Height="23" Background="#FF41B1E1" Content="Send" HorizontalAlignment="Left" Margin="64,213,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.237,-0.243" Click="ucbtnSend_Click" />
        <SEACC_WPFControls:SEACC_Button x:Name="ucbtnCancel" Width="85" Height="23" Background="#FF41B1E1" Content="Cancel" HorizontalAlignment="Left" Margin="154,213,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.237,-0.243" Click="ucbtnCancel_Click"/>
        <Image HorizontalAlignment="Left" Height="100" Margin="219,12,0,0" VerticalAlignment="Top" Width="100"/>-->
        </Grid>
    </Grid>
</Window>
