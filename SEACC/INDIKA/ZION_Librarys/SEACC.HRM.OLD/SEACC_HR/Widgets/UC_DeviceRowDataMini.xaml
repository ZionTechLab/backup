<UserControl x:Class="Digiteq.UC_DeviceRowDataMini"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Padding="0,5,0,0" >
    <StackPanel Background="#FF595959"  >
     
        <TextBlock Text="Device Raw Data" Padding="7,2,0,2" FontSize="14" Foreground="White" />
        <SEACC_WPFControls:SEACC_DataGrid    x:Name="grd_RowDataDetails"    Background="Transparent" Foreground="Black" HeaderColor="#FF363636" Headerforeground="White" Margin="5,0,0,0">
            <SEACC_WPFControls:SEACC_DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding DeviceID}"   Header="DeviceID" Width="70"/>
                <DataGridTextColumn  Binding="{Binding DeviceDate}" Header="Date" Width="70"/>
                <DataGridTextColumn  Binding="{Binding DeviceTime}" Header="Time" Width="70"/>
            </SEACC_WPFControls:SEACC_DataGrid.Columns>
        </SEACC_WPFControls:SEACC_DataGrid>
    </StackPanel>
</UserControl>
