<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" 
    xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" xmlns:local="clr-namespace:Digiteq" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Digiteq.frmCanteen"
        Title="frmCanteen" Width="1332.18" Background="#FF4F82B8"  ResizeMode="CanResizeWithGrip" WindowStyle="None" WindowStartupLocation="Manual"  AllowsTransparency="True"  Icon="Resources/Icon.ico" Loaded="Window_Loaded" StateChanged="Window_StateChanged_1" >
    <Grid>

        <Grid DockPanel.Dock="Top" Background="#66000000" Height="85" VerticalAlignment="Top" MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Image  Source="Resources/Cafetaria.png" Stretch="Fill" HorizontalAlignment="Left" Width="102"/>
            <StackPanel Margin="88,0,0,-5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="45" Text="W"   FontFamily="Segoe Script" VerticalAlignment="Bottom" />
                <TextBlock Foreground="White" FontSize="30" Text="elcome "   FontFamily="Segoe Script" VerticalAlignment="Bottom" Margin="-2,0,0,6" />
                <TextBlock Foreground="White" FontSize="45" Text="T"   FontFamily="Segoe Script" VerticalAlignment="Bottom" TextDecorations="{x:Null}" />
                <TextBlock Foreground="White" FontSize="30" Text="o "   FontFamily="Segoe Script" VerticalAlignment="Bottom" Margin="-3,0,0,6" TextDecorations="{x:Null}" />
                <TextBlock Foreground="White" FontSize="45" Text="C"   FontFamily="Segoe Script" VerticalAlignment="Bottom" TextDecorations="{x:Null}" />
                <TextBlock Foreground="White" FontSize="30" Text="afeteria"   FontFamily="Segoe Script" VerticalAlignment="Bottom" Margin="1,0,0,8" TextDecorations="{x:Null}" />

            </StackPanel>
            <Grid  x:Name="GRD_ControlBox" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right"   >
                <SEACC_WPFControls1:SEACC_Button_Close x:Name="btnClose" Content="&#xE8BB;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets"  Click="btnClose_Click" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btnRestore" Content="&#xE923;"  HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,30,0" Click="btnRestore_Click_1" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btnMinimize" Content="&#xE921;" HorizontalAlignment="Right" Width="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C"  Background="{x:Null}" BorderBrush="{x:Null}" Margin="0,0,60,0"/>
            </Grid>

            <Label Foreground="White" FontSize="22" Content="opulent Caterers"  HorizontalContentAlignment="Center" Margin="0,30,0,2" HorizontalAlignment="Right" />
            <local:UC_Clock Height="81" Margin="0,1,187,0" VerticalAlignment="Top" Background="{x:Null}" HorizontalAlignment="Right" Width="355"/>


        </Grid>


        <Grid Margin="0,195,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.25*" MinWidth="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <Grid  Grid.Column="0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height=".25*"/>
                </Grid.RowDefinitions>
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Vegi" Content="Vegetable" Margin="5" Grid.Row="1"    Background="#FF009688" Foreground="White" BorderBrush="White" Click="btn_Vegi_Click"/>
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Egg" Content="Egg" Margin="5" Grid.Row="2" Background="#FF009688"  Foreground="White" BorderBrush="White" Click="btn_Egg_Click"/>

                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Fish" Content=" Fish" Margin="5" Grid.Row="3"  Background="#FF009688"  Foreground="White" BorderBrush="White" Click="btn_Fish_Click"/>
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_che" Content="Chicken" Margin="5" Grid.Row="4"  Background="#FF009688"  Foreground="White" BorderBrush="White" Click="btn_che_Click"/>
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Special" Content=" Special" Margin="5" Grid.Row="5" Background="#FF009688"  Foreground="White" BorderBrush="White" Click="btn_Special_Click"/>
            </Grid>

            <Grid Grid.Column="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid  Grid.Row="0"  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                    </Grid.ColumnDefinitions>

                    <SEACC_WPFControls1:SEACC_Button Content="BREAKFAST" Grid.Column="1" Click="SEACC_Button_Click_1" Background="#FF59854E" Foreground="White" BorderBrush="White" Margin="5" />
                    <SEACC_WPFControls1:SEACC_Button Content="LUNCH" Grid.Column="2"  Click="SEACC_Button_Click_2" Background="#007A99" Foreground="White" BorderBrush="White" Margin="5" />
                    <SEACC_WPFControls1:SEACC_Button Content=" DINNER"  Grid.Column="3"  Click="SEACC_Button_Click_3" Background="#FF682C4D" Foreground="White" BorderBrush="White" Margin="5" />
                </Grid>
                <DataGrid  Grid.Row="1"  x:Name="grd_Canteen" AutoGenerateColumns="False"  Foreground="White" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFA8A8A8" RowBackground="#FF34495E" HeadersVisibility="Column" Margin="15">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#FF009688" />
                            <Setter Property="Height" Value="25" />
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding ID}" ClipboardContentBinding="{x:Null}" Header="NO." Width="110"/>
                        <DataGridTextColumn Binding="{Binding EmpNo}" ClipboardContentBinding="{x:Null}" Header="Employee Number" Width="200"/>
                        <DataGridTextColumn Binding="{Binding EmpName}" ClipboardContentBinding="{x:Null}" Header="Employee Name" Width="200"/>
                        <DataGridTextColumn Binding="{Binding MealType}" ClipboardContentBinding="{x:Null}" Header="Meal Type" Width="200"/>
                        <DataGridTextColumn Binding="{Binding Amount}" ClipboardContentBinding="{x:Null}" Header="Amount" Width="174"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid  Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_New" Margin="5" Content="New" Grid.Row="0" Background="#FF009688" Foreground="White" BorderBrush="White" Click="btn_New_Click"/>
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Print" Margin="5" Content="Print" Grid.Row="1" Background="#FF009688"  Foreground="White" BorderBrush="White" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Cancle" Margin="5" Content="Cancel" Grid.Row="2" Background="#FF009688"  Foreground="White" BorderBrush="White"  Click="btn_Cancle_Click" />
                <SEACC_WPFControls1:SEACC_Button x:Name="btn_Tender" Margin="5" Content="Tender" Grid.Row="3" Background="#FF009688"  Foreground="White" BorderBrush="White" Click="btn_Tender_Click"  />

            </Grid>

        </Grid>

        <StackPanel Margin="10,90,0,0" Orientation="Horizontal" HorizontalAlignment="Left" Width="700" Height="94" VerticalAlignment="Top">

            <local:UC_UserIndicator x:Name="User_Indicator"  VerticalAlignment="Top"  Height="90"  Width="400" MouseDoubleClick="User_Indicator_MouseDoubleClick_1" />
            <Label x:Name="lblAmount" Content="0.00 LKR" Foreground="White" FontSize="48" Padding="1" FontWeight="Thin" Width="200" Margin="10,0,0,0" />





        </StackPanel>


    </Grid>
</Window>
