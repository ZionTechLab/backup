<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
                 xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
                 xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" x:Class="Digiteq.UC_DeviceMaster" 
                 mc:Ignorable="d" Background="#FFFFFF">
    <UserControl.Resources>
    </UserControl.Resources>
  
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="grd_DeviceDetails_MouseLeftButtonUp1" />
            <GridSplitter x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" Background="#D5D5D5" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Device Code" x:Name="txtDeviceID" MouseDoubleClick="txtDeviceID_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Device Name" x:Name="txtDeviceName"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Description" MinHeight="65" x:Name="txtDescription" />
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>

    </SEACC_WPFControls1:SEACC_Form>
</UserControl>