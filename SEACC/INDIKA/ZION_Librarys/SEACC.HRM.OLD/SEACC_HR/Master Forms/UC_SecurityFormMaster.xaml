<UserControl x:Class="Digiteq.Master_Forms.UC_SecurityFormMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="750" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp" x:Name="dgr_Main"  Margin="0,0,5,0" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFormID" Caption="Form ID"  MouseDoubleClick="txtFormID_MouseDoubleClick_1" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFormName" Caption="Form Name"  />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFormCategoryID" Caption="Form Category ID"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDisplayName" Caption="Display Name" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCounter" Caption="Counter" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtSortOrder" Caption="Sort Order" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtLength" Caption="Length" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPrefix" Caption="Prefix" />
                        <Grid HorizontalAlignment="Left" Margin="5,0,0,0">
                            <TextBlock Text="Image"></TextBlock>
                            <Border BorderBrush="#FF41B1E1" BorderThickness="1" Margin="13,10,10,0" Height="93"   Width="100">
                                <Image x:Name="pbxImage"  Stretch="Fill" Margin="0,0,0,0"  />
                            </Border>
                            <SEACC_WPFControls:SEACC_Button x:Name="btnLoadImage" Content="Add Image" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White"  Height="25" Click="btnLoadImage_Click"  Width="60" Margin="256,78,27,0"/>
                        </Grid>
                        <Grid>
                            <Label Content="Status" HorizontalAlignment="Left" Margin="1,34,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chk_isEnable" Content="Is Enable" HorizontalAlignment="Left" Margin="122,39,0,0"  />
                            <CheckBox x:Name="chk_isVisible" Content="Is Visible" HorizontalAlignment="Left" Margin="198,39,0,0" />
                            <CheckBox x:Name="chk_isViewer" Content="Is Viewer" HorizontalAlignment="Left" Margin="274,39,0,0"/>
                            <CheckBox x:Name="chk_isAutoGenerate" Content="Is Auto Generate" HorizontalAlignment="Left" Margin="122,78,0,0"/>
                        </Grid>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>


        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
