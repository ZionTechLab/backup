<UserControl x:Class="Digiteq.UC_CompanyMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
           xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
              xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d"   Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"  />
            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >

                        <StackPanel>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCompanyCode" Caption="Company Code" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCompanyName" Caption="Company Name" MouseDoubleClick="txtCompanyName_MouseDoubleClick" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAddress" Caption="Address"  MinHeight="65"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTelephone1" Caption="Telephone 1" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTelephone2" Caption="Telephone 2" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTelephone3" Caption="Telephone 3"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFax" Caption="Fax"  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmail" Caption="Email"  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtUrl" Caption="Web Url"  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtVatRegNo" Caption="VAT Register No."  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMdName" Caption="MD's Name" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMdTelephone" Caption="MD's Telephone" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBusinessRegNo" Caption="Business Reg. No."  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEPFRegNo" Caption="EPF Reg. No."  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtETFRegNo" Caption="ETF Reg. No."  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPAYERegNo" Caption="PAYE Reg. No."  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTaxIdentityNo" Caption="Tax Identification No."  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFinancialYear" Caption="Financial Year" Visibility="Collapsed" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMonth" Caption="Month" Visibility="Collapsed"/>
                            <SEACC_WPFControls:SEACC_LabelImageBox x:Name="imgMain" Caption="Main Logo" FontSize="12"/>
                            <SEACC_WPFControls:SEACC_LabelImageBox x:Name="imgLogo" Caption="Logo Only" FontSize="12"/>
                            <SEACC_WPFControls:SEACC_LabelImageBox x:Name="imgText" Caption="Text only" FontSize="12"/>
                        </StackPanel>
                        
                    </SEACC_WPFControls:SEACC_ScrollViewer>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
