<UserControl x:Class="Digiteq.UC_BudgetPlan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
          xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"  
             mc:Ignorable="d"   Background="#FFFFFF">

    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form">
        <Grid Margin="15,0,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <DataGrid x:Name="grd_Plan" Background="#FF34495E" />
                </ScrollViewer>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Margin="2,0,0,0" Background="#D5D5D5" />
            <Grid Grid.Column="2">
                <StackPanel VerticalAlignment="Top">
                <SEACC_WPFControls:SEACC_LableTextBox  Caption="Payroll Year" Height="27"/>
                </StackPanel>
            </Grid>
            </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
