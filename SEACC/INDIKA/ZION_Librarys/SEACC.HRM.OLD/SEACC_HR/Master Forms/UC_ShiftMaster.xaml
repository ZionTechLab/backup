<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
              xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" x:Class="Digiteq.UC_ShiftMaster" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid Margin="15,10,0,50" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="ddd_MouseLeftButtonUp1" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel >
                        <Expander Header="Shift Definition"  FontSize="24" Foreground="#FF0096D6" IsExpanded="True">
                            <StackPanel >
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtShiftID" Caption="Shift Code"  FontSize="12" MouseDoubleClick="txtShiftID_MouseDoubleClick"/>
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtShiftName" Caption="Name"  FontSize="12" />
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtShiftRemarks" Caption="Remarks"  MinHeight="82" FontSize="12" />
                                <SEACC_WPFControls:SEACC_LabelComboBox x:Name="cmb_ShiftType" Caption="Shift Type" FontSize="12"></SEACC_WPFControls:SEACC_LabelComboBox>
                                <!--<Grid>
                                    <Label Content="Shift Type" FontSize="12" Margin="0,5,0,0"/>
                                    <ComboBox Height="24" FontSize="12" Margin="120,0,0,0" x:Name="cmb_ShiftType" Width="110" HorizontalAlignment="Left" SelectionChanged="cmb_OTRoundMode_SelectionChanged"  />
                                </Grid>-->
                            </StackPanel>
                        </Expander>
                        <Expander Header="Working Hours"  FontSize="24" Foreground="#FF0096D6" Margin="0,10,0,0" >
                            <StackPanel >
                                <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="tp_ShiftStartTime" Caption="Start Time"  FontSize="12" />
                                <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_ShiftHours" Caption="Shift Hours"   FontSize="12" />
                                <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_ShiftHours_Min" Caption="Shift Hours(Min.)"   FontSize="12" />
                                <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_NextShiftHours" Caption="Next Shift Hours"   FontSize="12" />
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBaseRate" Caption="Base Rate" Text="0"   FontSize="12" />
                                <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_ShiftGracePeriod" Caption="Shift Grace period"   FontSize="12" />

                                <Expander Header="Advance"  FontSize="18" Foreground="#FF0096D6" Margin="10,0,0,0" >
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                                        <Grid >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"  />
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock  Grid.Column="0" Grid.Row="0" FontSize="12"/>
                                            <CheckBox x:Name="chk_Sunday" Content="Sunday" VerticalAlignment="Center" FontSize="12" Grid.Column="0" Grid.Row="1" Margin="3" Checked="chk_Sunday_Checked" Unchecked="chk_Sunday_Unchecked" />
                                            <CheckBox x:Name="chk_Monday" Content="Monday" VerticalAlignment="Center" FontSize="12" Grid.Column="0" Grid.Row="2" Margin="3" Checked="chk_Monday_Checked" Unchecked="chk_Monday_Unchecked"/>
                                            <CheckBox x:Name="chk_Tuesday" Content="Tuesday" VerticalAlignment="Center" FontSize="12" Grid.Column="0" Grid.Row="3" Margin="3" Checked="chk_Tuesday_Checked" Unchecked="chk_Tuesday_Unchecked"/>
                                            <CheckBox x:Name="chk_Wednsday" Content="Wednesday" VerticalAlignment="Center" FontSize="12" Grid.Column="0" Grid.Row="4" Margin="3" Checked="chk_Wednsday_Checked" Unchecked="chk_Wednsday_Unchecked"/>
                                            <CheckBox x:Name="chk_Thursday" Content="Thursday" VerticalAlignment="Center" FontSize="12" Grid.Column="0" Grid.Row="5" Margin="3" Checked="chk_Thursday_Checked" Unchecked="chk_Thursday_Unchecked"/>
                                            <CheckBox x:Name="chk_friday" Content="Friday" VerticalAlignment="Center" FontSize="12" Grid.Column="0" Grid.Row="6" Margin="3" Checked="chk_friday_Checked" Unchecked="chk_friday_Unchecked"/>
                                            <CheckBox x:Name="chk_Saturday" Content="Saturday" VerticalAlignment="Center" FontSize="12" Grid.Column="0" Grid.Row="7" Margin="3" Checked="chk_Saturday_Checked" Unchecked="chk_Saturday_Unchecked"/>


                                            <TextBlock   Grid.Column="1" Grid.Row="0" FontSize="12" Text="Shift Hours" Margin="10,0,0,0"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_sunday_ShiftHours" Grid.Column="1" Grid.Row="1" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Monday_ShiftHours" Grid.Column="1" Grid.Row="2" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Tuesday_ShiftHours" Grid.Column="1" Grid.Row="3" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Wednsday_ShiftHours" Grid.Column="1" Grid.Row="4" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Thuseday_ShiftHours" Grid.Column="1" Grid.Row="5" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_friday_ShiftHours" Grid.Column="1" Grid.Row="6" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_saturday_ShiftHours" Grid.Column="1" Grid.Row="7" FontSize="12" Margin="3" />

                                            <TextBlock   Grid.Column="2" Grid.Row="0" FontSize="12" Text="Shift Hrs. Min." Margin="10,0,0,0"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_sunday_ShiftHours_min" Grid.Column="2" Grid.Row="1" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Monday_ShiftHours_min" Grid.Column="2" Grid.Row="2" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Tuesday_ShiftHours_min" Grid.Column="2" Grid.Row="3" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Wednsday_ShiftHours_min" Grid.Column="2" Grid.Row="4" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Thuseday_ShiftHours_min" Grid.Column="2" Grid.Row="5" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_friday_ShiftHours_min" Grid.Column="2" Grid.Row="6" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_saturday_ShiftHours_min" Grid.Column="2" Grid.Row="7" FontSize="12" Margin="3" />

                                            <TextBlock   Grid.Column="3" Grid.Row="0" FontSize="12" Text="Next Shift Hrs." Margin="10,0,0,0"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_sunday_Nxt_Shift_Hours" Grid.Column="3" Grid.Row="1" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Monday_Nxt_Shift_Hours" Grid.Column="3" Grid.Row="2" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Tuesday_Nxt_Shift_Hours" Grid.Column="3" Grid.Row="3" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Wednsday_Nxt_Shift_Hours" Grid.Column="3" Grid.Row="4" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Thuseday_Nxt_Shift_Hours" Grid.Column="3" Grid.Row="5" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_friday_Nxt_Shift_Hours" Grid.Column="3" Grid.Row="6" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_saturday_Nxt_Shift_Hours" Grid.Column="3" Grid.Row="7" FontSize="12" Margin="3" />

                                            <TextBlock   Grid.Column="4" Grid.Row="0" FontSize="12" Text="Base Rate" Margin="8,0,0,0"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Sunday_BaseRate" Grid.Column="4" Grid.Row="1" FontSize="12"  Margin="3,10" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Monday_BaseRate" Grid.Column="4" Grid.Row="2" FontSize="12"  Margin="3,10" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Tuesday_BaseRate" Grid.Column="4" Grid.Row="3" FontSize="12"  Margin="3,10" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Wednsday_BaseRate" Grid.Column="4" Grid.Row="4" FontSize="12"  Margin="3,10" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Thuseday_BaseRate" Grid.Column="4" Grid.Row="5" FontSize="12"  Margin="3,10" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Friday_BaseRate" Grid.Column="4" Grid.Row="6" FontSize="12"  Margin="3,10" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Saturday_BaseRate" Grid.Column="4" Grid.Row="7" FontSize="12"  Margin="3,10" BorderBrush="#ABABAB"/>

                                            <TextBlock   Grid.Column="5" Grid.Row="0" FontSize="12" Text="Grace Period" Margin="10,0,0,0"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_sunday_Sft_grace" Grid.Column="5" Grid.Row="1" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Monday_Sft_grace" Grid.Column="5" Grid.Row="2" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Tuesday_Sft_grace" Grid.Column="5" Grid.Row="3" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Wednsday_Sft_grace" Grid.Column="5" Grid.Row="4" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Thuseday_Sft_grace" Grid.Column="5" Grid.Row="5" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_friday_Sft_grace" Grid.Column="5" Grid.Row="6" FontSize="12" Margin="3" />
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_saturday_Sft_grace" Grid.Column="5" Grid.Row="7" FontSize="12" Margin="3" />

                                        </Grid>
                                    </ScrollViewer>
                                </Expander>

                                <Expander Header="Lunch Hour"  FontSize="18" Foreground="#FF0096D6" Margin="10,10,0,0" >
                                    <Grid>
                                        <StackPanel>
                                            <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="tp_LunchStartTime" Caption="Start Time"  FontSize="12" />
                                            <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_LunchDuration" Caption="Lunch Duration"   FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </Expander>

                            </StackPanel>
                        </Expander>
                        <Expander Header="Over Time" Foreground="#FF0096D6" FontSize="24" Margin="0,10,0,0">
                            <StackPanel >
                                <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chk_OtApplicable"  Caption="OT Applicable" FontSize="12" Foreground="Black" checkBox_Checked="chk_OtApplicable_checkBox_Checked" checkBox_Unchecked="chk_OtApplicable_checkBox_Unchecked" />
                                <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chk_EarlyOTApplicable"  Caption="Early OT Applicable" FontSize="12" Foreground="Black" IsChecked="True" checkBox_Checked="chk_EarlyOTApplicable_checkBox_Checked" checkBox_Unchecked="chk_EarlyOTApplicable_checkBox_Unchecked"/>

                                <SEACC_WPFControls:SEACC_LabelComboBox x:Name="cmb_OTRoundMode" Caption="OT Rounding Mode" FontSize="12" CmbSelectionChanged="cmb_OTRoundMode_CmbSelectionChanged" ></SEACC_WPFControls:SEACC_LabelComboBox>

                                <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_OTRoundMinutes" Caption="Round Minutes"   FontSize="12" />

                                <SEACC_WPFControls:SEACC_LableTextBox Caption="OT Rate" FontSize="12" x:Name="txtOTRate" IsEnabled="False" />
                                <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_EOT_GracePeriod" Caption="Early OT Grace period"  FontSize="12" />
                                <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_OT_GracePeriod" Caption="OT Grace period"  FontSize="12" />
                                <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_ShiftOtMin" Caption="Shift OT (Min.)"   FontSize="12" />
                                <SEACC_WPFControls:SEACC_LabelTimeSpan x:Name="ts_ShiftOTMax" Caption="Shift OT (Max.)"   FontSize="12" />
                                <Expander Header="Advance"  FontSize="18" Foreground="#FF0096D6" Margin="10,0,0,0">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                                        <Grid >
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock  Grid.Column="0" Grid.Row="0" FontSize="12" Margin="10,0,0,0"/>
                                            <CheckBox x:Name="chk_Weekday_OT" Content="Weekdays" FontSize="12" Grid.Column="0" Grid.Row="1" Margin="0,0,0,3" Checked="chk_Weekday_OT_Checked" Unchecked="chk_Weekday_OT_Unchecked" />
                                            <CheckBox x:Name="chk_Saturday_OT" Content="Saturday" FontSize="12" Grid.Column="0" Grid.Row="2" Margin="0,0,0,3" Checked="chk_Saturday_OT_Checked" Unchecked="chk_Saturday_OT_Unchecked" />
                                            <CheckBox x:Name="chk_Sunday_OT" Content="Sunday" FontSize="12" Grid.Column="0" Grid.Row="3" Margin="0,0,0,3" Checked="chk_Sunday_OT_Checked_1" Unchecked="chk_Sunday_OT_Unchecked" />
                                            <CheckBox x:Name="chk_PoyaDay_OT" Content="Poyaday" FontSize="12" Grid.Column="0" Grid.Row="4" Margin="0,0,0,3" Checked="chk_PoyaDay_OT_Checked" Unchecked="chk_PoyaDay_OT_Unchecked" />
                                            <CheckBox x:Name="chk_CompanyHoliday_OT" Content="Company Holiday" FontSize="12" Grid.Column="0" Grid.Row="5" Margin="0,0,0,3" Checked="chk_CompanyHoliday_OT_Checked" Unchecked="chk_CompanyHoliday_OT_Unchecked" />

                                            <TextBlock   Grid.Column="1" Grid.Row="0" FontSize="12" Text="OT Rate" Margin="12,0,0,0"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Weekday_OTRate" Grid.Column="1" Grid.Row="1" FontSize="12"  Margin="3" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Saturday_OTRate" Grid.Column="1" Grid.Row="2" FontSize="12"  Margin="3" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Sunday_OTRate" Grid.Column="1" Grid.Row="3" FontSize="12"  Margin="3" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_Poyaday_OTRate" Grid.Column="1" Grid.Row="4" FontSize="12"  Margin="3" BorderBrush="#ABABAB"/>
                                            <SEACC_WPFControls:SEACC_TextBox  x:Name="txt_CompanyHoliday_OTRate" Grid.Column="1" Grid.Row="5" FontSize="12"  Margin="3" BorderBrush="#ABABAB"/>


                                            <TextBlock   Grid.Column="2" Grid.Row="0" FontSize="12" Text="OT Grace Period" Margin="20,0,0,0"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Weekday_OT_grace" Grid.Column="2" Grid.Row="1" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Saturday_OT_grace" Grid.Column="2" Grid.Row="2" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Sunday_OT_grace" Grid.Column="2" Grid.Row="3" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_PoyaDay_OT_grace" Grid.Column="2" Grid.Row="4" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_CompanyHoliday_OT_grace" Grid.Column="2" Grid.Row="5" FontSize="12" Margin="3"/>



                                            <TextBlock   Grid.Column="3" Grid.Row="0" FontSize="12" Text="OT Min." Margin="20,0,0,0"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Weekday_OT_min" Grid.Column="3" Grid.Row="1" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Saturday_OT_min" Grid.Column="3" Grid.Row="2" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Sunday_OT_min" Grid.Column="3" Grid.Row="3" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Poyaday_OT_min" Grid.Column="3" Grid.Row="4" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_CompanyHoliday_OT_min" Grid.Column="3" Grid.Row="5" FontSize="12" Margin="3"/>


                                            <TextBlock   Grid.Column="4" Grid.Row="0" FontSize="12" Text="OT max." Margin="20,0,0,0"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Weekday_OT_max" Grid.Column="4" Grid.Row="1" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Saturday_OT_max" Grid.Column="4" Grid.Row="2" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Sunday_OT_max" Grid.Column="4" Grid.Row="3" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_Poyaday_OT_max" Grid.Column="4" Grid.Row="4" FontSize="12" Margin="3"/>
                                            <SEACC_WPFControls:SEACC_TimeSpan x:Name="ts_CompanyHoliday_OT_max" Grid.Column="4" Grid.Row="5" FontSize="12" Margin="3"/>

                                            <TextBlock   Grid.Column="5" Grid.Row="0" FontSize="12" Text="Lunch Time Ded." Margin="2,0,0,0"/>
                                            <CheckBox x:Name="chk_OTLunchDeduction_Weekday" Grid.Column="5" Grid.Row="1" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                            <CheckBox x:Name="chk_OTLunchDeduction_Satureday" Grid.Column="5" Grid.Row="2" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                            <CheckBox x:Name="chk_OTLunchDeduction_Sunday" Grid.Column="5" Grid.Row="3" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                            <CheckBox x:Name="chk_OTLunchDeduction_Poyaday" Grid.Column="5" Grid.Row="4" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                            <CheckBox x:Name="chk_OTLunchDeduction_CompanyHoliday" Grid.Column="5" Grid.Row="5" HorizontalAlignment="Center"  VerticalAlignment="Center"/>

                                        </Grid>
                                    </ScrollViewer>
                                </Expander>
                            </StackPanel>

                        </Expander>

                        <Expander Header="Other"  FontSize="24" Foreground="#FF0096D6" Margin="0,10,0,0"  >
                            <Grid>
                                <StackPanel>
                                    <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="shiftStatus"  Caption="Shift Status" FontSize="12" Foreground="Black" IsChecked="True"/>
                                    <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtp_EffictiveDate" Caption="Effective Date" FontSize="12" ShowDate="Visible" ShowTime="Hidden" />
                                    <SEACC_WPFControls:SEACC_LabelTimeSelector FontSize="12" x:Name="dtp_ExpDate" Caption="Expire Date" ShowDate="Visible" ShowTime="Hidden" />
                                </StackPanel>
                            </Grid>
                        </Expander>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
