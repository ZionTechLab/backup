<UserControl x:Class="Digiteq.UC_DeptMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid Margin="15,0,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="grd_DeptMaster_MouseLeftButtonUp1"/>
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid  Grid.Column="2" Margin="10,0,0,0" >
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDepartmentID"  Caption="Department Code" MouseDoubleClick="txtDepartmentID_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDeptName"  Caption="Department Name"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDivisionID" Caption="Division" MouseDoubleClick="txtDivisionID_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAddress" MinHeight="65" Caption="Address"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTelephone" Caption="Telephone 1"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTelephone1" Caption="Telephone 2"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtExtension" Caption="Extension No"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFax" Caption="Fax"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtContactPerson" Caption="HOD" MouseDoubleClick="txtContactPerson_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDescription" MinHeight="65" Caption="Remarks" />
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>

    </SEACC_WPFControls1:SEACC_Form>
</UserControl>

