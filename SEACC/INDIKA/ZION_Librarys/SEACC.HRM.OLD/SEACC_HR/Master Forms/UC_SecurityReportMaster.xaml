<UserControl x:Class="Digiteq.Master_Forms.UC_SecurityReportMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="670" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReportID" Caption="Report ID"  MouseDoubleClick="txtReportID_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReportName" Caption="Report Name" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtSortOrder" Caption="Sort Order"  />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReportCategoryID" Caption="Report Category ID" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDisplayName" Caption="Display Name" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDisplayName2" Caption="Dispaly Name 2" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReportPath" Caption="Report Path" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPrintCount" Caption="Print Count" />
                        <Grid>
                            <Label Content="Status" HorizontalAlignment="Left" Margin="1,34,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chk_isEnable" Content="Is Enable" HorizontalAlignment="Left" Margin="124,39,0,0"  />
                            <CheckBox x:Name="chk_isSetPaper" Content="Is Set Paper" HorizontalAlignment="Left" Margin="224,39,0,0" />
                            <CheckBox x:Name="chk_isSetPrinter" Content="Is Set Printer" HorizontalAlignment="Left" Margin="124,78,0,0"/>
                            <CheckBox x:Name="chk_isSetTerminal" Content="Is Set Terminal" HorizontalAlignment="Left" Margin="224,78,0,0"/>
                            <CheckBox x:Name="chk_isSetUser" Content="Is Set User" HorizontalAlignment="Left" Margin="124,117,0,0"/>
                            <CheckBox x:Name="chk_isDefaultPrinter" Content="Is Default Printer" HorizontalAlignment="Left" Margin="224,117,0,0"/>
                        </Grid>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
