<UserControl x:Class="Digiteq.Master_Forms.UC_HRWeek"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Digiteq.Master_Forms"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" mc:Ignorable="d" Background="#FFFFFF"
             >

    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_HRMonth_SizeChanged">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />

            <Grid  Grid.Column="2" Margin="10,0,0,0" >
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox ToolTip="Double click to Select Week" Caption="Week ID" x:Name="txt_WeekID" MouseDoubleClick="txt_WeekID_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox ToolTip="Double click on textbox to select Year" Caption="Year No." x:Name="txtYearID" MouseDoubleClick="txtYearID_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Start Date" ShowDate="Visible" ShowTime="Hidden" x:Name="dtp_StartDate" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="End Date" ShowDate="Visible" ShowTime="Hidden" x:Name="dtp_EndDate" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Working Days" x:Name="txtWorkingdaysMan" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Target" x:Name="txtTarget" />
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>

    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
