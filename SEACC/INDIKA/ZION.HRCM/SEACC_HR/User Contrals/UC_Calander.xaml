             xmlns:local="clr-namespace:Digiteq" 
             x:Class="Digiteq.UC_Calander" 
             mc:Ignorable="d" Width="366.537" Foreground="White" Background="#FF2C2D2F" Height="163" SizeChanged="UserControl_SizeChanged" MouseDown="UserControl_MouseDown">
