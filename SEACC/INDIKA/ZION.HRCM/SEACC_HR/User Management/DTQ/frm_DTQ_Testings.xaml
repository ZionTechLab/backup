<Window x:Class="Digiteq.User_Management.DTQ.frm_DTQ_Testings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Digiteq.User_Management.DTQ"
        mc:Ignorable="d" 
        Title="DTQ Testing Kit" Height="600" Width="400" WindowStartupLocation="CenterScreen" Icon="/SEACC_HR;component/Resources/digiteq_Logo.png" WindowStyle="ToolWindow">
    <Grid>
        <StackPanel>
            <DatePicker x:Name="dp_DtqTest" Width="160" Height="25" Margin="0,30,0,0"   />
            <Button x:Name="btn_HeadCountAlert" Content="Daily Head Count Alert" HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="25" Margin="0,15,0,0" Click="btn_HeadCountAlert_Click"/>
            <Button x:Name="btn_PresenceAlert" Content="Daily Attendance Alert" HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="25" Margin="0,15,0,0" Click="btn_PresenceAlert_Click"/>
            <Button x:Name="btn_PayrollProcessAlert" Content="Payroll Process Alert" HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="25" Margin="0,15,0,0" Click="btn_PayrollProcessAlert_Click"/>
            <Button x:Name="btn_EntitleLaveSetUp" Content="Employee Entitle Leave" HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="25" Margin="0,15,0,0" Click="btn_EntitleLaveSetUp_Click"/>
            <Button x:Name="btn_CrossTab" Content="Cross Tab Report" HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="25" Margin="0,15,0,0" Click="btn_CrossTab_Click"/>
        </StackPanel>
    </Grid>
</Window>
