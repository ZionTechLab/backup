<UserControl x:Class="Digiteq.User_Management.UC_SystemBackup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged"  >
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="ddd_MouseLeftButtonUp1" />
            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0" >
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                        <StackPanel >
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTargetLocation" Caption="Target Location" Text="-Double click for set folder-" MouseDoubleClick="txtTargetLocation_MouseDoubleClick" />
                            <!--<ProgressBar x:Name="progressBar_Master" Height="10" Margin="5" Width="300" HorizontalAlignment="Left" Maximum="10" Visibility="Collapsed"/>
                            <ProgressBar x:Name="progressBar_Sub" Height="10" Margin="5" Width="300" HorizontalAlignment="Left" Visibility="Collapsed" />-->
                            <SEACC_WPFControls:SEACC_Button x:Name="btnBackup" FontSize="12" Content="Backup" Background="#FF41B1E1" Foreground="White"  Width="105" Height="25"  Margin="0,10,15,0" Click="btn_backup_Click" />
                            <Expander Header="Settings" FontSize="24" Foreground="#FF0096D6" Margin="0,5,0,0" >
                                <StackPanel>
                                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtServerBackupPath" Caption="Server Backup Path" FontSize="12" MouseDoubleClick="txtServerBackupPath_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFoldersTobeBackup1" Caption="Folder 1" FontSize="12" MouseDoubleClick="txtFoldersTobeBackup1_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFoldersTobeBackup2" Caption="Folder 2" FontSize="12" MouseDoubleClick="txtFoldersTobeBackup2_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFoldersTobeBackup3" Caption="Folder 3" FontSize="12" MouseDoubleClick="txtFoldersTobeBackup3_MouseDoubleClick" />
                                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtBackupNamePrefix" Caption="Backup Name Prefix" FontSize="12" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </SEACC_WPFControls:SEACC_ScrollViewer>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>