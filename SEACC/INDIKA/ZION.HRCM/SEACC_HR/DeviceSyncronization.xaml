<Window xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"  x:Class="Digiteq.DeviceSyncronization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
        Title="DeviceSyncronization" Height="300" Width="500" Background="#C1CDC9" WindowStyle="ToolWindow">
    <Grid>
     
        <Grid Margin="20,0,0,0">
            <Label Content="Attendance Data Download" FontSize="20" FontWeight="Bold"  />
        </Grid>
        <Grid Margin="10,40,0,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                
               
               
            </Grid.RowDefinitions>

           <DataGrid Grid.Column="0" Grid.RowSpan="8" x:Name="dgv_Main" Visibility="Hidden"/>
            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDeviceID" Grid.Column="0" Grid.Row="0" Caption="Device" MouseDoubleClick="txtDeviceID_MouseDoubleClick"/>
            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDeviceDescription" Grid.Column="0"  Grid.Row="1" Caption="Description"/>
            <SEACC_WPFControls:SEACC_LabelTimeSelector  x:Name="dtp_FromDate" Grid.Column="0"  Grid.Row="2" Caption="From Date"/>
            <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpToDate" Grid.Column="0"  Grid.Row="3" Caption="To Date"/>
            <SEACC_WPFControls:SEACC_Button Content="Download" Grid.Column="0"  Grid.Row="5" Click="SEACC_Button_Click"  Background="#156FA9" Foreground="White"/>
        </Grid>

    </Grid>
</Window>
