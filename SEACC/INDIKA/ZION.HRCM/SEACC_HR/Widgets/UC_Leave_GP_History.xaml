<UserControl x:Class="Digiteq.UC_Leave_GP_History"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Digiteq" 
             mc:Ignorable="d" >
    <Grid Margin="5,0">
        <StackPanel>
            <TextBlock Name="tbx_Leave" Text="Leave Details" FontWeight="SemiBold" FontSize="14" Margin="0,5"></TextBlock>
            <SEACC_WPFControls:SEACC_DataGrid x:Name="grd_LeaveDetails" HeaderColor="#FFF06060" MouseLeftButtonUp="grd_LeaveDetails_MouseLeftButtonUp">
                <SEACC_WPFControls:SEACC_DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding LeaveID}"   Header="Leave ID" Width="60"/>
                    <DataGridTextColumn Binding="{Binding LeavePeriod}"   Header="Leave Period" Width="200"/>
                    <DataGridTextColumn  Binding="{Binding Reason}" Header="Reason" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn  Binding="{Binding LeaveHours}" Header="Days" Width="70"/>
                    <DataGridTextColumn  Binding="{Binding CheckedBy}" Header="Checked By" Width="120"/>
                    <DataGridTextColumn Binding="{Binding ApprovedBy}" Header="Approved By" Width="120"/>
                </SEACC_WPFControls:SEACC_DataGrid.Columns>
            </SEACC_WPFControls:SEACC_DataGrid>
            <TextBlock Name="tbx_GatePass" Text="GatePass Details" FontWeight="SemiBold" FontSize="14" Margin="0,5"></TextBlock>
            <SEACC_WPFControls:SEACC_DataGrid    x:Name="grd_GatePass" HeaderColor="#FFF06060" CanUserResizeRows="True" MinRowHeight="22" MouseLeftButtonUp="grd_GatePass_MouseLeftButtonUp" >
                <SEACC_WPFControls:SEACC_DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding GPID}"   Header="GP ID" Width="60"/>
                    <DataGridTextColumn Binding="{Binding Date}"   Header="Date" Width="200"/>
                    <DataGridTextColumn  Binding="{Binding Reason}" Header="Reason" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn  Binding="{Binding Hours}" Header="Hours" Width="70"/>
                    <DataGridTextColumn  Binding="{Binding CheckedBy}" Header="Checked By" Width="120"/>
                    <DataGridTextColumn Binding="{Binding ApprovedBy}" Header="Approved By" Width="120"/>
                </SEACC_WPFControls:SEACC_DataGrid.Columns>
            </SEACC_WPFControls:SEACC_DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
