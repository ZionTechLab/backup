<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" x:Class="Digiteq.wj_Leave" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <StackPanel>
        <Expander Header="Entitled Leave"  FontSize="24" Foreground="#FF0096D6" IsExpanded="True" Margin="5,0">
            <StackPanel Margin="5,0">
                <Border BorderBrush="#FF0096D6" BorderThickness="0,1,0,0"/>
                <Grid>
                    <Label x:Name="lblleaveYearPeroid" Content="Entitle Leaves From" FontSize="15" Foreground="White" />
                    <SEACC_WPFControls:SEACC_Button x:Name="btnPayrollYear" HorizontalAlignment="Right" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontSize="12" BorderBrush="{x:Null}" Foreground="White" Width="32" Click="btnPayrollYear_Click" >
                        <SEACC_WPFControls:SEACC_Button.Background>
                            <ImageBrush ImageSource="/SEACC_HR;component/Resources/Calendar-50.png" Stretch="Uniform"/>
                        </SEACC_WPFControls:SEACC_Button.Background>
                    </SEACC_WPFControls:SEACC_Button>
                </Grid>
                <SEACC_WPFControls:SEACC_DataGrid  x:Name="grdBalanceLeave" Margin="0,5">
                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding LeaveType}" ClipboardContentBinding="{x:Null}" Header="Leave Type" Width="155"/>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding EntitleLeave}" ClipboardContentBinding="{x:Null}" Header="Entitle" Width="90"/>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Utilized}" ClipboardContentBinding="{x:Null}" Header="Utilized" Width="90"/>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Balance}" ClipboardContentBinding="{x:Null}" Header="Balance" Width="90"/>
                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                </SEACC_WPFControls:SEACC_DataGrid>
            </StackPanel>
        </Expander>
        <Expander Header="Leave History"  FontSize="24" Foreground="#FF0096D6" IsExpanded="True" Margin="5,0">
            <StackPanel Margin="5,0">
                <Border BorderBrush="#FF0096D6" BorderThickness="0,1,0,0"/>
                <SEACC_WPFControls:SEACC_DataGrid    x:Name="grd_LeaveHistory"    Margin="0,5" LoadingRow="grd_LeaveHistory_LoadingRow" MouseLeftButtonUp="grd_LeaveHistory_MouseLeftButtonUp">
                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding LeaveID}"   Header="Leave ID" Width="55"/>
                        <DataGridTextColumn Binding="{Binding Status}"   Header="Status" Width="100"/>
                        <DataGridTextColumn  Binding="{Binding LeaveStartDate}" Header="Leave Start" Width="150"/>
                        <DataGridTextColumn  Binding="{Binding LeaveEndDate}" Header="Leave End" Width="150"/>
                        <DataGridTextColumn Binding="{Binding NoOfDays}" Header="No. of Days" Width="70"/>
                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                </SEACC_WPFControls:SEACC_DataGrid>
            </StackPanel>
        </Expander>


    </StackPanel>
</UserControl>
