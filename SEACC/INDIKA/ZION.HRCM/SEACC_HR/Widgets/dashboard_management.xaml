<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" 
    xmlns:local="clr-namespace:Digiteq"
    xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
    x:Class="Digiteq.dashboard_management" 
             mc:Ignorable="d" 
             >
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto" >
        <Grid >

            <local:UC_Clock HorizontalAlignment="Left" Height="86"  VerticalAlignment="Top" Width="391" Background="{x:Null}" Margin="10,10,0,0"/>

            <local:WJ_Chat Margin="415,354,0,0" Background="#FF6D7A34" VerticalAlignment="Top" HorizontalAlignment="Left" Height="177" Width="402"/>
            <local:UC_Notes HorizontalAlignment="Left" Height="207" Margin="10,104,0,0" VerticalAlignment="Top" Width="391" Background="#FF61B044"/>
            <local:wj_version HorizontalAlignment="Left" Height="222" Margin="10,316,0,-7" VerticalAlignment="Top" Width="391"/>
            <local:wj_Backup HorizontalAlignment="Left" Height="339" Margin="415,10,0,0" VerticalAlignment="Top" Width="402" Background="#FF403333"/>
            <Grid Margin="822,379,0,-110" Height="262" VerticalAlignment="Top" HorizontalAlignment="Left" Width="300" Background="#FF2D509B" >
                <Border BorderBrush="White" BorderThickness="1" Margin="5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="10"/>
                    </Border.Effect>
                    <Grid>
                        <SEACC_WPFControls1:SEACC_Button Content="Log Out" HorizontalAlignment="Left" Height="27" Margin="150,46,0,0" VerticalAlignment="Top" Width="91"/>
                        <SEACC_WPFControls1:SEACC_Button Content="Turn Off" HorizontalAlignment="Left" Height="27" Margin="150,78,0,0" VerticalAlignment="Top" Width="91"/>

                        <SEACC_WPFControls1:SEACC_Button Content="Lock" HorizontalAlignment="Left" Height="27" Margin="150,110,0,0" VerticalAlignment="Top" Width="91"/>

                    </Grid>
                </Border>
                <Grid Margin="15,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Users Loged in"  FontSize="20" Foreground="White" Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="0,8,0,0"/>
                    <Border BorderBrush="White" BorderThickness="0,0,0,1"></Border>
                    <Grid Grid.Row="1" Margin="0,10,111,0" Height="203" VerticalAlignment="Top" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>




                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />

                            <ColumnDefinition MinWidth="75"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Digiteq" Grid.Row="0" Grid.Column="1" FontSize="9" Foreground="White"  />
                        <TextBlock Text="Anoj " Grid.Row="1" Grid.Column="1" FontSize="9" Foreground="White" />
                        <TextBlock Text="Shivon" Grid.Row="2" Grid.Column="1" FontSize="9" Foreground="White" />
                        <TextBlock Text="Asanka" Grid.Row="3" Grid.Column="1" FontSize="9" Foreground="White" />
                        <TextBlock Grid.Row="4" Grid.Column="1" FontSize="9" Foreground="White"><Run Text="Sandeepani"/><InlineUIContainer>
                            		</InlineUIContainer></TextBlock>
                        <TextBlock Text="Priyankara" Grid.Row="5" Grid.Column="1" FontSize="9" Foreground="White" />
                        <TextBlock Grid.Row="6" Grid.Column="1" FontSize="9" Foreground="White" ><Run Text="randima"/><InlineUIContainer>
                            		</InlineUIContainer></TextBlock>

                        <Image Margin="2" Source="dtq.PNG" Stretch="Fill" Grid.Row="0" Grid.Column="0"/>
                        <Image Margin="2" Source="10407770_10203185296904898_8505141602620641248_n.jpg" Stretch="Fill" Grid.Row="1" Grid.Column="0"/>
                        <Image Margin="2" Source="1779032_10202402499317481_1291852238_n.jpg" Stretch="Fill" Grid.Row="2" Grid.Column="0"/>

                        <Image Margin="2" Source="12122783_10153276276867635_8075881745179996437_n.jpg" Stretch="Fill" Grid.Row="3" Grid.Column="0"/>
                        <Image Margin="2" Source="12009554_174536132881257_7506343433362948836_n.jpg" Stretch="Fill"  Grid.Row="4" Grid.Column="0"/>

                        <Image Margin="2" Source="12109063_896345187080529_5854306789974689196_n.jpg" Stretch="Fill"  Grid.Row="5" Grid.Column="0" />

                        <Image Margin="2" Source="11196264_10206100884341663_8919071641980495115_n.jpg" Stretch="Fill" Grid.Row="6" Grid.Column="0" />

                    </Grid>
                </Grid>
            </Grid>


            <local:wj_TestMail HorizontalAlignment="Left" Height="364" Margin="822,10,0,0" VerticalAlignment="Top" Width="300"/>

        </Grid>
    </ScrollViewer>

</UserControl>
