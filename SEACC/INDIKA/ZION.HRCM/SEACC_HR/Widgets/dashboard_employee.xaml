<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Digiteq" xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" x:Class="Digiteq.dashboard_employee" 
             mc:Ignorable="d" 
             >
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto" >
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <local:UC_Clock Grid.Row="0" HorizontalAlignment="Left" Height="86"  VerticalAlignment="Top" Width="600" Background="{x:Null}" Margin="10,10,0,0"/>

            <local:UC_ChangePassword Grid.Row="1" Margin="10" Height="223" Width="400" VerticalAlignment="Top" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" >
                <local:WJ_Chat Background="#FF6D7A34" Margin="10"  VerticalAlignment="Top" HorizontalAlignment="Left" Height="157" Width="214" Visibility="Collapsed"></local:WJ_Chat>
                <local:UC_Notes HorizontalAlignment="Left" Margin="10"  Height="207" VerticalAlignment="Top" Width="241" Background="#FF61B044" Visibility="Collapsed"/>
                <local:wj_version HorizontalAlignment="Left" Margin="10"  Height="197" VerticalAlignment="Top" Width="181" Visibility="Collapsed"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>

</UserControl>
