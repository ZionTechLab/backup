<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" x:Name="frm_Splash" x:Class="Digiteq.frmSplash"
        Title="MainWindow" Height="483" Width="303" AllowsTransparency="True" WindowStyle="None" Background="{x:Null}" WindowStartupLocation="CenterScreen" Icon="Resources/Icon.ico" >
    <Window.Resources>
        <Storyboard x:Key="OnLoaded1">
            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="Btn_Name">
                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}"/>
                <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)" Storyboard.TargetName="grid">
                <EasingColorKeyFrame KeyTime="0" Value="#003887A9"/>
                <EasingColorKeyFrame KeyTime="0:0:2" Value="#FF3887A9"/>
            </ColorAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)" Storyboard.TargetName="grid">
                <EasingColorKeyFrame KeyTime="0:0:1" Value="#0054C5F5"/>
                <EasingColorKeyFrame KeyTime="0:0:2" Value="#FF54C5F5"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard x:Name="OnLoaded1_BeginStoryboard" Storyboard="{StaticResource OnLoaded1}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="grid" Margin="10" >
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FF54C5F5" Offset="0"/>
                <GradientStop Color="#FF3887A9" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.5"/>
        </Grid.Effect>
        <ProgressBar x:Name="ProgressBar1" HorizontalAlignment="Left" Height="12" Margin="10,157,0,0" VerticalAlignment="Top" Width="426" Foreground="#FFEC3C00" Visibility="Hidden"/>
        <SEACC_WPFControls:SEACC_WaitingBar Margin="-94,343,0,0" VerticalAlignment="Top" Width="Auto"/>
        <SEACC_WPFControls:SEACC_Button_Close x:Name="Btn_Name" Content="&#xE8BB;" Margin="262,0,0,0" VerticalAlignment="Top" BorderBrush="#FF41B1E1" Click="Btn_Name_Click" HorizontalAlignment="Left" Width="22" Foreground="#FFF0F0F0" FontFamily="Segoe MDL2 Assets" Padding="5" Height="21" FontSize="10"/>

        <Image Margin="0,322,-1,0" Source="2.png" Stretch="Fill" Opacity="0.2"/>

    </Grid>
</Window>
