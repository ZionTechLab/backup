<UserControl x:Class="Digiteq.UC_EmployeeEntitleLeaves"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged"  >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="800" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="#FF34495E" Margin="0,0,5,0">
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" CellEditEnding="dgr_Main_CellEditEnding" />
            </Grid>

            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />

            <Grid Grid.Column="2" Margin="10,0,0,0" MaxWidth="350">
                <StackPanel>
                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPayrollYear" Caption="Payroll Year" MouseDoubleClick="txtPayrollYear_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtEmpNo" Caption="Employee No." MouseDoubleClick="txtEmpNo_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtDivision" Caption="Division" MouseDoubleClick="txtDivision_MouseDoubleClick"  />
                    <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtDepartment" Caption="Department" MouseDoubleClick="txtDepartment_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtSection" Caption="Section" MouseDoubleClick="txtSection_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtSubSection" Caption="Sub Section" MouseDoubleClick="txtSubSection_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtCategory" Caption="Category" MouseDoubleClick="txtCategory_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkAutoCalucation" FontSize="12" Caption="Auto Caculate" />
                    <SEACC_WPFControls:SEACC_Button x:Name="btn_load" FontSize="12" Content="Load" Background="#FF41B1E1" Foreground="White"  Width="105" Height="25" HorizontalAlignment="Right" Margin="0,10,5,0" Click="btn_load_Click" />
                    <Grid/>
                </StackPanel>
            </Grid>

        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
