<UserControl x:Class="Digiteq.User_Contrals.UC_Customization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d">
        <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="692" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp"  />
            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                        <StackPanel>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtValueID" Caption="Value ID"  MouseDoubleClick="txtValueID_MouseDoubleClick" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtValueName" Caption="Value Name" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtConfigValue" Caption="Config Value"/>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtConfigTypeValueId" Caption="Config Value Id" />
                        </StackPanel>
                    </SEACC_WPFControls:SEACC_ScrollViewer>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>

</UserControl>
