<UserControl x:Class="Digiteq.UC_CityMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
              xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d"  Background="#FFFFFF"  >

    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp"  />
            
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            
            <Grid  Grid.Column="2" Margin="10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="District"  x:Name="txtdistrictID" MouseDoubleClick="txtdistrictID_MouseDoubleClick_1"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="City Name" x:Name="txtCityName" MouseDoubleClick="txtCityName_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Province" x:Name="txtProvince" MouseDoubleClick="txtProvince_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCityCode" Caption="City Code"  MouseDoubleClick="txtCityCode_MouseDoubleClick_1" Visibility="Hidden"/>                        
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
