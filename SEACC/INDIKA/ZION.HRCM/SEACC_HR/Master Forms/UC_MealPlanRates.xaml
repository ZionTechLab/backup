<UserControl x:Class="Digiteq.UC_MealPlanRates"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
              xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d"   Background="#FFFFFF"  SizeChanged="UserControl_SizeChanged"
             >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form">
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="650" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="grd_mealPlanReats_MouseLeftButtonUp1"/>
           
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"/>
            <Grid  Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMealPlanID"  Caption="Meal Plan ID" MouseDoubleClick="txtMealPlanID_MouseDoubleClick"/>

                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMealType"  Caption="Meal Type" MouseDoubleClick="txtMealType_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMenuType"  Caption="Menu Type" MouseDoubleClick="txtMenuType_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmpCategory"  Caption="Employee Category" MouseDoubleClick="txtEmpCategory_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCompanyPay"  Caption="Company Pay" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEmployeePay"  Caption="Employee Pay" />
                        <Grid>
                            <Label Content="Active/Inactive" />
                            <CheckBox x:Name="chkActive" Content=""  Margin="119,6,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
