<UserControl x:Class="Digiteq.UC_DistrictMaster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid x:Name="Main" Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="grd_District_MouseLeftButtonUp1"  />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <StackPanel>
                    <SEACC_WPFControls:SEACC_LableTextBox  Caption="District Code" x:Name="txtDistrictCode" MouseDoubleClick="txtDistrictCode_MouseDoubleClick" Visibility="Collapsed"/>
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="District Name" x:Name="txtDistrictName" MouseDoubleClick="txtDistrictName_MouseDoubleClick" />
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Province" x:Name="txtProvinceCode" MouseDoubleClick="txtProvinceCode_MouseDoubleClick"/>                
                </StackPanel>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
