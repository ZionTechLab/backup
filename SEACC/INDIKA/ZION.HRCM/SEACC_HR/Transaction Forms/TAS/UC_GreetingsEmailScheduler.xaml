<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Digiteq"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"  
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             x:Class="Digiteq.UC_GreetingsEmailScheduler"  mc:Ignorable="d" Background="#FFFFFF" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >

        <Grid x:Name="grdAllGreetings" Grid.Row="1" Margin="0,0,0,50">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="800"/>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"   />

            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />

            <Grid  Grid.Column="2" Margin="10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtGreetID" Caption="Greet Id"   />
                        <SEACC_WPFControls:SEACC_LabelComboBox x:Name="cmbGreetParty" Caption="Greet Party" />
                        <SEACC_WPFControls:SEACC_LabelComboBox x:Name="cmbGreetType" Caption="Greet Type" />
                        <local:UC_Calander x:Name="cal_Big" Background="#FF34495E" Height="450" Width="auto" Date_MouseClick="cal_Big_Date_MouseClick" Margin="0,5"  />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Email Subject"  x:Name="txtEmailSubject" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="To" x:Name="txtAlertTo" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="BCC" x:Name="txtAlertBCC"/>
                        <SEACC_WPFControls:SEACC_LabelImageBox x:Name="imgAlert" Caption="Greeting Image" FontSize="12"/>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpTimeSlect" Caption="Alert Time" ShowDate="Visible" ShowTime="Visible"  />

                        <StackPanel Orientation="Horizontal" Margin="5,10,0,0" >
                            <Image Source="/SEACC_HR;component/Resources/Preview-96.png" Height="35" Width="25"/>
                            <Label x:Name="lblAlertPreview" Content="Alert Preview" FontSize="18" Foreground="#FF0096D6" MouseLeftButtonUp="lblAlertPreview_MouseLeftButtonUp_1" />
                        </StackPanel>
                        
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>

            </Grid>
        </Grid>

    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
