<UserControl xmlns:Digiteq="clr-namespace:Digiteq"  x:Class="Digiteq.UC_Approvals"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" >
    
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="800" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,5,0" >
                
                <Grid  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition  Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"></RowDefinition>
                </Grid.RowDefinitions>
                    <SEACC_WPFControls:SEACC_ToggleButton x:Name="btn_lv_Checking"  Text="Gatepass Approval" Grid.Column="0" BorderBrush="#66b2ff" Click="btn_AppravalTypes_Click" />
                    <SEACC_WPFControls:SEACC_ToggleButton x:Name="btn_lv_Approve"  Text="Gatepass Approval" Grid.Column="1"  BorderBrush="#d24dff" Click="btn_AppravalTypes_Click"/>
                    <SEACC_WPFControls:SEACC_ToggleButton x:Name="btn_lv_Covering"  Text="Gatepass Approval" Grid.Column="2" BorderBrush="#00b2b3" Click="btn_AppravalTypes_Click" />
                    <SEACC_WPFControls:SEACC_ToggleButton x:Name="btn_gp_Check"  Text="Gatepass Approval" Grid.Column="3"  BorderBrush="#FFC57C3C" Click="btn_AppravalTypes_Click"/>
                    <SEACC_WPFControls:SEACC_ToggleButton x:Name="btn_gp_Approve"  Text="Gatepass Approval" Grid.Column="4"  BorderBrush="#FFCD4638" Click="btn_AppravalTypes_Click"/>

                </Grid>
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,40,0,0" Grid.Row="1" Grid.Column="0" Background="#FF34495E" HeaderColor="#FF0091EA" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" />
            
            </Grid>
          
            <GridSplitter Background="#D5D5D5" Grid.Column="1" Grid.RowSpan="2" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

          

            <Grid  Grid.Column="2" Margin="5,0,0,0"  >
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>


                        <Digiteq:UC_Vw_EmployeeDemography x:Name="Vw_EmpDetails" FontSize="12" ColorTheam="#FF34495E"/>



                        <Expander x:Name="exp_History" Header="History" FontSize="24" Foreground="#FF0096D6" FontWeight="ExtraLight"  >
                            <StackPanel>
                                <Digiteq:UC_Leave_GP_History   x:Name="Vw_History"></Digiteq:UC_Leave_GP_History>
                            </StackPanel>
                        </Expander>
                   
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
            <Grid Margin="203,0,11,-42" VerticalAlignment="Bottom" Height="30" Grid.ColumnSpan="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <SEACC_WPFControls:SEACC_Button Content="Submit" Width="100" Background="#FF41B1E1" Foreground="White" Click="SEACC_Button_Click" />
                    <!--<SEACC_WPFControls:SEACC_Button  Content="Reject" Width="100" Background="#FFF06060" Foreground="White" Click="SEACC_Button_Click_1" Margin="10,0,0,0"  />-->
                </StackPanel>
               </Grid>
        </Grid>
          </SEACC_WPFControls1:SEACC_Form>
</UserControl>
