<UserControl xmlns:Digiteq="clr-namespace:Digiteq"  x:Class="Digiteq.UC_OTApproval"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"  
             mc:Ignorable="d" Background="#FFFFFF">

    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid  Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="coloumnA" Width="785" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="#FF34495E" Margin="0,20,5,0">
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" CellEditEnding="grd_Main_CellEditEnding" DG_MouseDoubleClick="grd_Main_DG_MouseDoubleClick" Background="#FF34495E" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"  />
            </Grid>
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="chk_ApproveAll" Content="Approve All" Margin="10,0" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked" Height="16" VerticalAlignment="Top" />
                    <CheckBox x:Name="chk_RejectAll" Content="Reject All" Checked="CheckBox_Checked_1" Unchecked="CheckBox_Unchecked_1" Height="16" VerticalAlignment="Top" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="450">
                        <Expander Header="Selection" FontSize="24" Foreground="#FF0096D6" IsExpanded="True">
                            <StackPanel>
                                <SEACC_WPFControls:SEACC_LabelTimeSelector FontSize="12" x:Name="dtp_FromDate" Caption="Date From" ShowDate="Visible" ShowTime="Hidden"/>
                                <SEACC_WPFControls:SEACC_LabelTimeSelector FontSize="12" x:Name="dtptoDate" Caption="Date To" ShowDate="Visible" ShowTime="Hidden"/>
                                <SEACC_WPFControls:SEACC_Button x:Name="btn_Load" FontSize="12" Content="Load" Background="#FF41B1E1" Foreground="White" HorizontalAlignment="Center" Width="75" Height="23" Margin="5,10,5,0" Click="btn_Load_Click" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Employee Details" FontSize="24" Foreground="#FF0096D6" Margin="0,10,0,0"  >
                            <StackPanel>
                                <Digiteq:UC_Vw_EmployeeDemography x:Name="EmployeeViewer" FontSize="12" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
