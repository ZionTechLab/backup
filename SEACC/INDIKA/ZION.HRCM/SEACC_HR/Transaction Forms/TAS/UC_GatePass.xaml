<UserControl xmlns:Digiteq="clr-namespace:Digiteq"  x:Class="Digiteq.UC_GatePass"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             xmlns:local="clr-namespace:Digiteq"
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF" >

    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="10,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="650"/>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="#FF34495E" Margin="0,0,5,0" >
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <local:UC_Vw_EmployeeDemography x:Name="Vw_EmployeeDemography" Foreground="White" Background="#FF34495E" ColorTheam="#007a99" HorizontalAlignment="Stretch" />
                        <Expander Header="GatePass History" Foreground="#FF0096D6" FontSize="24" IsExpanded="True" >
                            <StackPanel Margin="5,0">
                                <Border BorderBrush="White" BorderThickness="0,1,0,0"/>
                                <SEACC_WPFControls:SEACC_DataGrid  Margin="0,5" x:Name="grd_Gatepass"   MouseLeftButtonUp="grd_Gatepass_MouseLeftButtonUp" LoadingRow="grd_Gatepass_LoadingRow" IsSynchronizedWithCurrentItem="False" CanUserResizeColumns="True" >
                                    <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding GPNO}"   Header="GP#"   IsReadOnly="True" Width="55"/>
                                        <DataGridTextColumn Binding="{Binding Name}"  Header="Name" Width="150"    IsReadOnly="True" Visibility="Hidden"/>
                                        <DataGridTextColumn Binding="{Binding DateTime}"  Header="Date and Time" Width="120"  IsReadOnly="True"/>
                                        <DataGridTextColumn Binding="{Binding LeaveHours}"  Header="Leave Hours" Width="100"  IsReadOnly="True"  />
                                        <DataGridTextColumn Binding="{Binding Status}"   Header="Status"   IsReadOnly="True" Width="100"/>
                                        <DataGridTextColumn Binding="{Binding Reason}"  Header="Reason" Width="200"  IsReadOnly="True"/>
                                        <DataGridTextColumn Binding="{Binding EmpNO}"  Header="Emp. No." Width="100"    IsReadOnly="True" Visibility="Hidden"/>
                                        <DataGridTextColumn Binding="{Binding Division}"  Header="Division" Width="130"   IsReadOnly="True" Visibility="Hidden"/>
                                        <DataGridTextColumn Binding="{Binding Department}"  Header="Department" Width="90"    IsReadOnly="True" Visibility="Hidden"/>
                                        <DataGridTextColumn Binding="{Binding Section}"  Header="Section" Width="80"  IsReadOnly="True" Visibility="Hidden"/>
                                        <DataGridTextColumn Binding="{Binding SubSection}"  Header="SubSection" Width="80"  IsReadOnly="True" Visibility="Hidden"/>
                                        <DataGridTextColumn Binding="{Binding BataPayable}"  Header="Bata Payable" Width="100"  IsReadOnly="True" />
                                        <DataGridTextColumn Binding="{Binding Amount}"  Header="Amount" Width="80"  IsReadOnly="True" />
                                    </SEACC_WPFControls:SEACC_DataGrid.Columns>
                                </SEACC_WPFControls:SEACC_DataGrid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>

            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

            <Grid  Grid.Column="2" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox ToolTip="Double Click on TextBox to Select GatePass" x:Name="txtGatePassNo" Caption="Gate Pass No"   MouseDoubleClick="txtGatePassNo_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox ToolTip="Double Click on TextBox to Select Employee Number" x:Name="txtEmployeeNo" Caption="Employee No." MouseDoubleClick="txtEmployeeNo_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtp_GatePassDateTime" Caption="Date and Time" CaptionFontSize="12" ShowDate="Visible" DateTimeChanged="dtp_GatePassDateTime_DateTimeChanged" />
                        <SEACC_WPFControls:SEACC_LabelTimeSpan Caption="Request leave Time" x:Name="ts_LeaveHours" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReason" Caption="Reason" MinHeight="65" />
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chk_BataPayable" Caption="Bata Payable" checkBox_Checked="chk_BataPayable_checkBox_Checked" checkBox_Unchecked="chk_BataPayable_checkBox_Unchecked" IsChecked="False" />
                        <SEACC_WPFControls:SEACC_LableTextBox Caption="Amount" x:Name="txtrate"/>
                        <Expander Header="Approvals" FontSize="24" Foreground="#FF0096D6" IsExpanded="True" >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition  Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.ColumnSpan="2"  Grid.Row="0" Grid.Column="0" Height="1" Background="White"></Border>
                                <CheckBox x:Name="cbx_Checked"  Grid.Row="1"  Content="Checked" FontSize="12" VerticalAlignment="Center" Checked="CheckBox_Checked" />
                                <CheckBox x:Name="cbx_Approved" Grid.Row="2"  Content="Approved" FontSize="12" VerticalAlignment="Center" Checked="cbx_Approved_Checked"/>

                                <SEACC_WPFControls:SEACC_UserIndicator_Small x:Name="Wusr_Checked" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" Margin="5" Background="Red"  />
                                <SEACC_WPFControls:SEACC_UserIndicator_Small x:Name="Wusr_Approved" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" Margin="5"  />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>