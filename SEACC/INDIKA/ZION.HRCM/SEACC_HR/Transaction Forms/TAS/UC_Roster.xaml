<UserControl xmlns:Digiteq="clr-namespace:Digiteq" 
             x:Class="Digiteq.UC_Roster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
             mc:Ignorable="d" Background="#FFFFFF" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid Margin="10,10,10,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Expander x:Name="exp_Selection" Header="Selection" FontSize="24" Foreground="#FF0096D6" IsExpanded="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!--<SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="0" FontSize="12" x:Name="txtDivision" Caption="Division" MouseDoubleClick="txtDevision_MouseDoubleClick" />-->

                        <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="0" FontSize="12" x:Name="txtDepartment" Caption="Department" MouseDoubleClick="txtDepartment_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="1" Grid.Row="0" FontSize="12" x:Name="txtsection" Caption="Section" MouseDoubleClick="txtsection_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="2" Grid.Row="0" FontSize="12" x:Name="txtAttendanceGroup1" Caption="Attendance Group" MouseDoubleClick="txtAttendanceGroup1_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="3" Grid.Row="0" FontSize="12" x:Name="txtEmpNo" Caption="Employee No." MouseDoubleClick="txtEmpNo_MouseDoubleClick"/>

                        <SEACC_WPFControls:SEACC_LableTextBox Grid.Column="0" Grid.Row="1" FontSize="12" x:Name="txtMonth" Caption="Months " MouseDoubleClick="txtMonth_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Grid.Column="1" Grid.Row="1" FontSize="12" x:Name="dtp_FromDate" Caption="Date From" Foreground="Black" ShowDate="Visible" ShowTime="Collapsed" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Grid.Column="2" Grid.Row="1" FontSize="12" x:Name="dtptoDate" Caption="Date To" Foreground="Black" ShowDate="Visible" ShowTime="Collapsed"/>

                        <SEACC_WPFControls:SEACC_Button Grid.Column="3" Grid.Row="1" FontSize="12" x:Name="btnLoad" Content="Load" Background="#FF41B1E1" Foreground="White" Click="SEACC_Load_Button_Click" Width="75" Height="23" HorizontalAlignment="Left" Margin="10,5,0,5" VerticalAlignment="Bottom"/>
                    </Grid>
                </Expander>
            </Grid>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced Grid.Row="1" x:Name="dgr_Main" Background="#FF34495E" DG_MouseDoubleClick="grd_Main_DG_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Visible" />
            <!--<SEACC_WPFControls:SEACC_LabelCheckBox FontSize="12" x:Name="chkAutoShifts" Caption="Auto Generate Shifts" Foreground="White" Margin="90,2,341,0" Grid.Row="1" Height="27" VerticalAlignment="Top" IsChecked="True" />-->
            <CheckBox Content="Auto Generate Roster" IsChecked="True" FontSize="12" x:Name="chkAutoShifts" Foreground="White" Margin="90,2,341,0" Grid.Row="1" Height="27" VerticalAlignment="Top" Padding="5,-1,0,0" VerticalContentAlignment="Center"/>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
