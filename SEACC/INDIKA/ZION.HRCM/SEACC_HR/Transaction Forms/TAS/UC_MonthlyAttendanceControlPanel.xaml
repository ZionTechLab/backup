<UserControl xmlns:Digiteq="clr-namespace:Digiteq" 
             x:Class="Digiteq.UC_MonthlyAttendanceControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
             mc:Ignorable="d" Background="#FFFFFF" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >

        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#FF34495E" Margin="0,0,5,0">
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main_Group" Background="#FF34495E" MouseLeftButtonUp1="dgr_Main_Group_MouseLeftButtonUp1"   />
                <TextBlock Text="Attendance Group" Foreground="White" FontSize="14" HorizontalAlignment="Center" Height="30" VerticalAlignment="Top" />
            </Grid>
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Background="#FF34495E" Margin="0,0,5,0">
                <SEACC_WPFControls:SEACC_DataGrid_Advanced Grid.Row="1" x:Name="dgr_Group_Period" Background="#FF34495E" MouseLeftButtonUp1="dgr_Group_Period_MouseLeftButtonUp1" />
                <TextBlock Text="Attendance Group's Periods" Foreground="White" FontSize="14" HorizontalAlignment="Center" Height="30" VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
