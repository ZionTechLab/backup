<UserControl x:Class="Digiteq.UC_CompanyEvents"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                         xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="grd_Main"  Margin="0,0,5,0"   />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel  >
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEventCode" Caption="Event Code" Margin="0,3,0,0" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEventCatg" Caption="Category" Margin="0,3,0,0" />
                        <Grid>
                            <StackPanel>
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEventCommittee" Caption="Org. Committee" Margin="0,3,0,0"/>
                                <SEACC_WPFControls:SEACC_Button Content="Add" Width="50" Height="20" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEventTitle" Caption="Title" Margin="0,6,0,0" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEventBudject_Exp" Caption="Budget (Expenditure)" Margin="0,3,0,0" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtEventBudget_Rev" Caption="Budget (Revenue)" Margin="0,3,0,0" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Event Start Date" x:Name="dtp_DateTime1" ShowDate="Visible" ShowTime="Hidden"/>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector Caption="Event End Date" x:Name="dtp_DateTime2" ShowDate="Visible" ShowTime="Hidden"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCountry" Caption="Country" Margin="0,3,0,0" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtProvince" Caption="Province" Margin="0,3,0,0" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCity" Caption="City" Margin="0,3,0,0" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtTown" Caption="Town" Margin="0,3,0,0" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtVanue" Caption="Venue" Margin="0,3,0,0"/>
                        <Grid >
                            <WrapPanel HorizontalAlignment="Left" Margin="0,5,0,0">
                                <TextBlock Text="Event Logo" Foreground="Black" FontSize="12" Width="120"/>
                                <Border BorderBrush="#FF41B1E1" BorderThickness="1" Width="80" Height="80" >
                                    <Image x:Name="imglogo" Stretch="Fill"  />
                                </Border>
                                <SEACC_WPFControls:SEACC_Button x:Name="btn_SelectLogo" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White" FontSize="12" Content="Upload Logo" Height="20" Width="75" VerticalAlignment="Bottom" Margin="5,0,0,0"/>
                            </WrapPanel>
                        </Grid>
                        <Grid >
                            <WrapPanel HorizontalAlignment="Left" Margin="0,5,0,0">
                                <TextBlock Text="Event Photos" Foreground="Black" FontSize="12" Width="120"/>
                                <Border BorderBrush="#FF41B1E1" BorderThickness="1" Width="80" Height="80" HorizontalAlignment="Left" >
                                    <Image x:Name="imgEventimage" Stretch="Fill"  />
                                </Border>
                                <SEACC_WPFControls:SEACC_Button x:Name="btn_SelectImage" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White" FontSize="12" Content="Upload Images" Width="75" Height="20" VerticalAlignment="Bottom" Margin="5,0,0,0"/>
                            </WrapPanel>
                        </Grid>
                        <!--<Grid>
                            <StackPanel>
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDocumentType" Height="27" VerticalAlignment="Top" Caption="Event Teams" Margin="0,3,0,0" MinWidth="200"/>
                                <SEACC_WPFControls:SEACC_Button x:Name="btn_DocumentUpload" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White" Content="Upload" FontSize="12" Width="75" Height="20" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                        </Grid>-->
                        <Grid>
                            <StackPanel>
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDocumentType" Caption="Org. Committee" Margin="0,3,0,0"/>
                                <SEACC_WPFControls:SEACC_Button Content="Upload" Width="50" Height="20" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                        <Grid >
                            <SEACC_WPFControls:SEACC_DataGrid x:Name="grd_DocumentManagement" FontSize="12" HorizontalAlignment="Left" Margin="0,35,0,0" VerticalAlignment="Top" AutoGenerateColumns="False">
                                <SEACC_WPFControls:SEACC_DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding No}" ClipboardContentBinding="{x:Null}" Header="NO." Width="50" />
                                    <DataGridTextColumn Binding="{Binding FileDetail}" ClipboardContentBinding="{x:Null}" Header="Team"  Width="335" />
                                </SEACC_WPFControls:SEACC_DataGrid.Columns>
                            </SEACC_WPFControls:SEACC_DataGrid>
                        </Grid>

                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
