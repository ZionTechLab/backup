<UserControl x:Class="Digiteq.UC_CompanyAwardsAndCeritificates"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="grd_Main"  Margin="0,0,5,0"   />
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1" />
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel  >
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAwardCode" Caption="Award Code" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpAwardDate" Caption="Award Date" ShowDate="Visible" ShowTime="Hidden"/>
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpAwardExpDate" Caption="Award Expiry Date" ShowDate="Visible" ShowTime="Hidden"/>

                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAwardBy" Caption="Award By" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAwardPlace" Caption="Award Place"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDescription1" Caption="Description 1" MinHeight="65"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDescription2"  Caption="Description 2" MinHeight="65" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtDescription3"  Caption="Description 3" MinHeight="65"/>
                        <Grid >
                            <TextBlock Text="Award Images" Foreground="Black" FontSize="12" Margin="5,0,301,78"/>
                            <Border BorderBrush="#FF41B1E1" BorderThickness="1" Width="80" Height="80" HorizontalAlignment="Left" Margin="123,0,0,0">
                                <Image x:Name="imgAwd1" Stretch="Fill"  />
                            </Border>
                            <Border BorderBrush="#FF41B1E1" BorderThickness="1" Width="80" Height="80" HorizontalAlignment="Left" Margin="207,0,0,0">
                                <Image x:Name="imgAwd2" Stretch="Fill"  />
                            </Border>
                            <Border BorderBrush="#FF41B1E1" BorderThickness="1" Width="80" Height="80" HorizontalAlignment="Left" Margin="293,0,0,0">
                                <Image x:Name="imgAwd3" Stretch="Fill"  />
                            </Border>
                            <SEACC_WPFControls:SEACC_Button x:Name="btn_SelectImage" Background="#FF41B1E1" BorderBrush="#FF9B9B9B" Foreground="White" FontSize="12" Content="Upload Images" Width="75" HorizontalAlignment="Left" Margin="385,64,25,0"/>
                        </Grid>
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
