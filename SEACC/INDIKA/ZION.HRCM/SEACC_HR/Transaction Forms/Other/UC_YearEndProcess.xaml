<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
           xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             xmlns:local="clr-namespace:Digiteq" x:Class="Digiteq.UC_YearEndProcess" 
             mc:Ignorable="d">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged"  >
        <Grid Margin="15,0,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="coloumnA" Width="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid  Margin="0,80,5,0">
                <StackPanel>
                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtYearID" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top" Caption="Payroll Year" MouseDoubleClick="txtYearID_MouseDoubleClick"/>
                    <SEACC_WPFControls:SEACC_Button x:Name="btn_YearEndProcess"  Background="#FF41B1E1" Width="120" Height="23" Content="Update Entitle Leaves" HorizontalAlignment="Left"  BorderBrush="#FFF6F6F6" Click="btn_YearEndProcess_Click" Margin="120,0,0,0" />
                </StackPanel>
            </Grid>
                   </Grid>

        <Grid>
            <SEACC_WPFControls:SEACC_DataGrid    x:Name="grd_AttendaceRivision"    Margin="10,52,-10,-42" Background="{x:Null}" LoadingRow="grd_AttendaceRivision_LoadingRow" MouseLeftButtonUp="grd_AttendaceRivision_MouseLeftButtonUp">
                           
           
                <SEACC_WPFControls:SEACC_DataGrid.Columns>
                    <DataGridTextColumn  Binding="{Binding EmpID}" Header="Employee ID" Width="100"/>
                    <DataGridTextColumn  Binding="{Binding EmpName}" Header="Employee ID" Width="120"/>
                    <DataGridTextColumn Binding="{Binding AttendaceDate}"   Header="Date" Width="120"/>
                    <DataGridTextColumn  Binding="{Binding InDate}" Header="In Date" Width="120"/>
                    <DataGridTextColumn  Binding="{Binding INTime}" Header="Time" Width="100"/>
                    <DataGridTextColumn  Binding="{Binding OutDate}" Header="Out Date" Width="120"/>
                    <DataGridTextColumn  Binding="{Binding OutTime}" Header="Out" Width="100"/>
                    <DataGridTextColumn  Binding="{Binding WorkedMinutes}" Header="Wkd. Hrs." Width="100"/>
                    <DataGridTextColumn  Binding="{Binding OTMinutes}" Header="OT Hrs." Width="100"/>
                    <DataGridTextColumn  Binding="{Binding OTMinutesApproved}" Header="OT Hrs Approved." Width="120"/>
                    <DataGridTextColumn  Binding="{Binding NoPauHrs}" Header="NoPay Hrs." Width="100"/>
                </SEACC_WPFControls:SEACC_DataGrid.Columns>
            </SEACC_WPFControls:SEACC_DataGrid>
        </Grid>



    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
