<Window x:Class="Digiteq.Transaction_Forms.PAY.frm_Employee_SalaryAddustment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Digiteq.Transaction_Forms.PAY"
          xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
        mc:Ignorable="d"
        Title="frm_Employee_SalaryAddustment" Height="450" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" WindowStyle="None" AllowsTransparency="True" Loaded="Window_Loaded" Closed="Window_Closed" Background="{x:Null}" >
    <Grid Margin="10">
        <Border Background="#FF34495E" >
            <Border.Effect>
                <DropShadowEffect ShadowDepth="5" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>
        <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" Background="#FF33477B" >
            <Grid Margin="0,0,0,50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="grdTitleBar" Grid.Row="0" MouseDown="grdTitleBar_MouseDown" >
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF364758" Offset="0"/>
                            <GradientStop Color="#FF051a2f" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <StackPanel Margin="5,0,0,10" >
                        <Label x:Name="lblTitleBar" Content="Salary Adjustments"  FontSize="25" Foreground="White" />
                        <!--<Label x:Name="lblEmpName" Content="Employee Name" FontSize="14" Foreground="White"/>-->
                    </StackPanel>
                    <SEACC_WPFControls:SEACC_Button_Close x:Name="btnClose" Content="&#xE8BB;" VerticalAlignment="Top" HorizontalAlignment="Right" Width="30" Height="30" FontFamily="Segoe MDL2 Assets" Foreground="#FF9F9C9C" Background="{x:Null}" BorderBrush="{x:Null}" Click="btnClose_Click" />
                </Grid>

                <Grid Grid.Row="1"  >
                    <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_PayItems"  CellEditEnding="dgr_PayItems_CellEditEnding" CellEditBegining="dgr_PayItems_CellEditBegining"  MouseLeftButtonUp1="dgr_PayItems_MouseLeftButtonUp1" Background="{x:Null}"  />
                </Grid>
            </Grid>
        </SEACC_WPFControls1:SEACC_Form>
    </Grid>
</Window>
