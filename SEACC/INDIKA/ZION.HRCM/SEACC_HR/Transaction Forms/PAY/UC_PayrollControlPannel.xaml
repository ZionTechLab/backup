<UserControl xmlns:Digiteq="clr-namespace:Digiteq" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero" x:Name="btnReport" 
             x:Class="Digiteq.Transaction_Forms.PAY.UC_PayrollControlPannel"
             mc:Ignorable="d" Background="#FFFFFF"  MinHeight="300" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid  Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="coloumnA" Width="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Background="#FF34495E" Margin="0,0,5,0" Grid.Column="0" >
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main_Group" Background="#FF34495E" MouseLeftButtonUp1="dgr_Main_Group_MouseLeftButtonUp1"   />
                <TextBlock Text="Salary Process Groups" Foreground="White" FontSize="14" HorizontalAlignment="Center" Height="30" VerticalAlignment="Top" Visibility="Collapsed" />
            </Grid>
            <GridSplitter Background="#D5D5D5" x:Name="gridSplitter" Width="5" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,1,0,-1"  />
            <Grid Grid.Column="2" Margin="5,0,5,0" ToolTip="Click on &quot;Period Closed&quot; column to close a payroll period.">
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Sub_Period" Background="#FF34495E" MouseLeftButtonUp1="dgr_Main_Period_MouseLeftButtonUp1"   />
                <TextBlock Text="Salary Process Periods" Foreground="White" FontSize="14" HorizontalAlignment="Center" Height="30" VerticalAlignment="Top" />
            </Grid>
        </Grid>
        <Button x:Name="btnProcess" Content="Process" Margin="0,0,11,17" HorizontalAlignment="Right" Width="75" Height="20" VerticalAlignment="Bottom" Click="btnProcess_Click"/>
        <Button x:Name="btnAdj" Content="Adjustments" Margin="0,0,91,17" HorizontalAlignment="Right" Width="75" Height="20" VerticalAlignment="Bottom" RenderTransformOrigin="-0.36,0.6" Click="btnAdj_Click"/>
        <Button x:Name="btnDetail" Content="Detail" Margin="0,0,171,17" HorizontalAlignment="Right" Width="75" Height="20" VerticalAlignment="Bottom" RenderTransformOrigin="-0.36,0.6" Click="btnDetail_Click_1" />
        <Button x:Name="btnToExcel" Content="Salary Register" Margin="0,0,344,17" HorizontalAlignment="Right" Width="89" Height="20" VerticalAlignment="Bottom" RenderTransformOrigin="-0.36,0.6" Click="btnToExcel_Click" />
        <Button x:Name="btnBankRegister" Content="Bank Register" Margin="0,0,251,17" HorizontalAlignment="Right" Width="89" Height="20" VerticalAlignment="Bottom" RenderTransformOrigin="-0.36,0.6" Click="btnBankRegister_Click"  />
        <Button x:Name="btnSH" Content="Sig. Sheet" Margin="0,0,437,17" HorizontalAlignment="Right" Width="75" Height="20" VerticalAlignment="Bottom" RenderTransformOrigin="-0.36,0.6" Click="btnSH_Click"  />
        <Button x:Name="btnPS" Content="Pay Slip" Margin="-52,0,517,17" HorizontalAlignment="Right" Width="75" Height="20" VerticalAlignment="Bottom" RenderTransformOrigin="-0.36,0.6" Click="btnPS_Click"  />
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>