<UserControl x:Class="Digiteq.Transaction_Forms.PAY.UC_Payslip_Items_Statutary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
              xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             mc:Ignorable="d"   Background="#FFFFFF" >
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="550" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main"  Margin="0,0,5,0" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1"/>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <Grid  Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto"  >
                    <StackPanel>
                        <!--<SEACC_WPFControls:SEACC_LableTextBox x:Name="txtStatItem_ID"  Caption="Item ID" Visibility="Collapsed" />-->
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtStatCode" Caption="Statutory Code" MouseDoubleClick="txtStatCode_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtStatTitle"  Caption="Statutory Title" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtStatPercentage"  Caption="Statutory Percentage" />
                        <SEACC_WPFControls:SEACC_LabelCheckBox x:Name="chkIsFlatRate" Caption="Flat Rate Enable" IsChecked="True" checkBox_Checked="chkIsFlatRate_checkBox_Checked" checkBox_Unchecked="chkIsFlatRate_checkBox_Unchecked"/>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFlatRate" Caption="Flat Rate" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>