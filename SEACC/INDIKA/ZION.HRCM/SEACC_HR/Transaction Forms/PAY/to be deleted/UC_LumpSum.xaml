<UserControl x:Class="Digiteq.UC_LumpSum"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,15,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <DataGrid x:Name="grd_lumpsum"  GridLinesVisibility="Horizontal" AutoGenerateColumns="False"  >
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="#FF666666" />
                            <Setter Property="Foreground" Value="#FFFFFFF3" />
                            <Setter Property="BorderBrush" Value="#FF707070" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Height" Value="22" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background"  Value="#FF5BA4C3" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF707070" />
                                    <Setter Property="Foreground" Value="Black" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#FF0096D6" />
                            <Setter Property="Height" Value="25" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Code}"  Header="Lsum Code" Width="100"/>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Type}" Header="Type" Width="100"/>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Description}"  Header="Description" Width="100"/>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Status}"  Header="Status" Width="100"/>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding GLCode}"  Header="GL Code" Width="100"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
            <Grid x:Name="Contrals" Grid.Column="2" Width="500" HorizontalAlignment="Left" >
                <StackPanel  >
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Lump Sum Code" x:Name="txtCode"/>
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Type"  x:Name="txtType" />
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Description" x:Name="txtDescription" MinHeight="65" />
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="GL_Code" x:Name="txtGLCode" />
                    
                    <Grid Height="50" Margin="120,0,323,0">
                        <Label Content="Sataus" HorizontalAlignment="Left" Margin="-120,12,0,0" VerticalAlignment="Top"/>
                        <SEACC_WPFControls:SEACC_CheckBox Margin="-10,10,10,10"   />
                    </Grid>
                    <Grid/>
                    

                </StackPanel>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>
