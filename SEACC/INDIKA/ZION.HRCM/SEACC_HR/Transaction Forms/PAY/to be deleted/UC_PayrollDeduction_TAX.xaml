<UserControl x:Class="Digiteq.UC_PayrollDeduction_TAX"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             mc:Ignorable="d" Background="#FFFFFF">
    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,15,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <DataGrid x:Name="grd_PayrollDeduction_TAX"  MouseLeftButtonUp="grd_PayrollDeduction_TAX_MouseLeftButtonUp" GridLinesVisibility="Horizontal" AutoGenerateColumns="False"  >
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="#FF666666" />
                            <Setter Property="Foreground" Value="#FFFFFFF3" />
                            <Setter Property="BorderBrush" Value="#FF707070" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Height" Value="22" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background"  Value="#FF5BA4C3" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF707070" />
                                    <Setter Property="Foreground" Value="Black" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#FF0096D6" />
                            <Setter Property="Height" Value="25" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Type}"  Header="Type" Width="150"/>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding Code}" Header="Code" Width="150"/>
                        <DataGridTextColumn IsReadOnly="True" Binding="{Binding PaidBY}"  Header="Paid By" Width="150"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
            <Grid x:Name="Contrals" Grid.Column="2" Width="500" HorizontalAlignment="Left" >
                <StackPanel  >
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Type" x:Name="txtType" />
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Code" x:Name="txtCode" />
                    <SEACC_WPFControls:SEACC_LableTextBox Caption="Paid By" x:Name="txtRate" />
                    
                    <Grid/>
                    <Grid Margin="0,60,0,0">
                        <Label FontSize="15" FontWeight="SemiBold" x:Name="lblTable1Header" Content="Table Header" Margin="0,-32,0,32" />
                        <DataGrid CanUserAddRows="False" AutoGenerateColumns="False"  x:Name="grd_taxtable" GridLinesVisibility="Horizontal" >
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                            </DataGrid.Resources>
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background" Value="#FF666666" />
                                    <Setter Property="Foreground" Value="#FFFFFFF3" />
                                    <Setter Property="BorderBrush" Value="#FF707070" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Height" Value="22" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background"  Value="#FF5BA4C3" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF707070" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="#FF0096D6" />
                                    <Setter Property="Height" Value="25" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn IsReadOnly="True" Binding="{Binding EarnCode}"  Header="Earnings Code" Width="100"/>
                                <DataGridTextColumn Binding="{Binding Range1}"  Header="Range 1" Width="100"/>
                                <DataGridTextColumn Binding="{Binding Range2}"  Header="Range 2" Width="100"/>
                                <DataGridTextColumn Binding="{Binding Tax}"  Header="Tax %" Width="100"/>
                                <DataGridTextColumn Binding="{Binding Rebart}"  Header="Rebate" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                       
                    </Grid>
                    <Grid>
                        <SEACC_WPFControls:SEACC_Button x:Name="btnAdd" Background="#FF0096D6" Height="23" Width="75" Content="Add" HorizontalAlignment="Left" Margin="335,17,0,10"/>
                        <SEACC_WPFControls:SEACC_Button x:Name="btnSave" Background="#FF0096D6" Height="23" Width="75" Content="Delete" HorizontalAlignment="Left" Margin="415,17,0,10" />
                    </Grid>
                    <Grid Margin="0,30,0,0">
                        <Label FontSize="15" FontWeight="SemiBold" Content="Table Header" Margin="0,-27,0,27" x:Name="lblTable2Header"/>
                        <DataGrid CanUserAddRows="False" AutoGenerateColumns="False"  x:Name="Grd_TaxTable2" GridLinesVisibility="Horizontal" >
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                            </DataGrid.Resources>
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background" Value="#FF666666" />
                                    <Setter Property="Foreground" Value="#FFFFFFF3" />
                                    <Setter Property="BorderBrush" Value="#FF707070" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Height" Value="22" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background"  Value="#FF5BA4C3" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF707070" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="#FF0096D6" />
                                    <Setter Property="Height" Value="25" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn IsReadOnly="True" Binding="{Binding EarnCode}"  Header="Earnings Code" Width="100"/>
                                <DataGridTextColumn Binding="{Binding Range1}"  Header="Range 1" Width="100"/>
                                <DataGridTextColumn Binding="{Binding Range2}"  Header="Range 2" Width="100"/>
                                <DataGridTextColumn Binding="{Binding Tax}"  Header="Tax %" Width="100"/>
                                <DataGridTextColumn Binding="{Binding Rebart}"  Header="Rebate" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                    <Grid>
                        <SEACC_WPFControls:SEACC_Button x:Name="btnAdd_tbl2" Background="#FF0096D6" Height="23" Width="75" Content="Add" HorizontalAlignment="Left" Margin="241,10,0,0"/>
                        <SEACC_WPFControls:SEACC_Button x:Name="btnSave_tbl_2" Background="#FF0096D6" Height="23" Width="75" Content="Delete" HorizontalAlignment="Left" Margin="321,10,0,0" />
                    </Grid>
                </StackPanel>
            </Grid>

        </Grid>
    </SEACC_WPFControls1:SEACC_Form>

</UserControl>
