<UserControl x:Class="Digiteq.Transaction_Forms.PAY.UC_Employee_PaySlipItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls"
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls"
             xmlns:local="clr-namespace:Digiteq"
             mc:Ignorable="d" Background="#FFFFFF" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <SEACC_WPFControls1:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Margin="0,0,5,0" CellEditEnding="dgr_Main_CellEditEnding" CellEditBegining="dgr_Main_CellEditBegining" />
                <StackPanel  Orientation="Horizontal"  VerticalAlignment="Top" Margin="386,5,15,0"   Height="20" >
                    <SEACC_WPFControls:SEACC_Button x:Name="btnGridPaySlipAddAll" Content="&#xE118;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Foreground="#FFE2E2E2" Background="#FF335F68" BorderBrush="{x:Null}" Click="btnGridPaySlipAddAll_Click" />
                    <SEACC_WPFControls:SEACC_Button x:Name="btnGridItemAddAll" Content="&#xE104;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" Foreground="#FFE2E2E2" Background="#FF335F68" BorderBrush="{x:Null}" Click="btnGridItemAddAll_Click" />
                </StackPanel>
            </Grid>

            <Popup x:Name="pop_Event" Placement="MousePoint" PopupAnimation="Slide"  IsOpen="False" HorizontalAlignment="Left" AllowsTransparency="True" StaysOpen="False">
                <Popup.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.7" RenderingBias="Quality" ShadowDepth="10"/>
                </Popup.Effect>
                <Border BorderThickness="0,0,1,1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"/>
                    </Border.Effect>

                    <Grid Width="150" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Padding="5,1" Content="Payslip Amount" Foreground="White" Background="#FF34495E"/>
                        <SEACC_WPFControls:SEACC_Button_Close x:Name="btn_Close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="btn_Close_Click" Height="20" Width="20" HorizontalAlignment="Right"  VerticalAlignment="Top" BorderBrush="#FFEC0000"/>
                        <SEACC_WPFControls:SEACC_TextBox Grid.Row="1" Margin="2"  Name="txtPayslipAmount"/>
                        <SEACC_WPFControls:SEACC_Button Grid.Row="2" Content="Add" x:Name="btn_PoPPayslipAdd" Margin="2" Background="#FF41B1E1" Foreground="White" Click="btn_PoPSave_Click" />
                    </Grid>
                </Border>
            </Popup>

            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Margin="0,1,0,-1"/>
            <Grid Grid.Column="2" Margin="10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtDivision" Caption="Division" MouseDoubleClick="txtDevision_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtDepartment" Caption="Department" MouseDoubleClick="txtDepartment_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtsection" Caption="Section" MouseDoubleClick="txtsection_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtEmpNo" Caption="Employee No." MouseDoubleClick="txtEmpNo_MouseDoubleClick"/>
                        <SEACC_WPFControls:SEACC_LableTextBox FontSize="12" x:Name="txtPaySlipItem" Caption="Payslip Item" MouseDoubleClick="txtPaySlipItem_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_Button x:Name="btnLoad" FontSize="12" Content="Load" Background="#FF41B1E1" Foreground="White" Click="SEACC_Load_Button_Click" Width="75" Height="23" HorizontalAlignment="Left" Margin="195,20,0,0" />
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls1:SEACC_Form>
</UserControl>