<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls" 
             xmlns:SEACC_WPFControls1="clr-namespace:SEACC_WPFControls" 
             xmlns:SEACC_WPFControls2="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" x:Class="SEACC_PCB.Reports.UC_Report" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PCB.UserControls"
             xmlns:local="clr-namespace:SEACC_PCB"
             mc:Ignorable="d" Background="#FFFFFF">

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged">
        <Grid Margin="15,10,0,50" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="472"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Column="0">
                <SEACC_WPFControls2:SEACC_DataGrid x:Name="dgv_Reports" MouseLeftButtonUp="dgv_Reports_MouseLeftButtonUp" CanUserResizeColumns="True" HeadersVisibility="None" Background="#FF515151" HeaderColor="#FFF49F6D" RowHeight="35" AlternatingRowBackground="#FF2D3E4F" >
                    <SEACC_WPFControls2:SEACC_DataGrid.Columns>
                        <DataGridTextColumn Header="Report ID" Binding="{Binding ReportID}" Width="70" Visibility="Hidden" />
                        <DataGridTextColumn Header="Report Name" Binding="{Binding ReportName}" ClipboardContentBinding="{x:Null}" Width="300"/>
                    </SEACC_WPFControls2:SEACC_DataGrid.Columns>
                </SEACC_WPFControls2:SEACC_DataGrid>
            </ScrollViewer>

            <GridSplitter Background="#D5D5D5" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />

            <StackPanel Grid.Column="2" Margin="10,0">
                <Border  BorderThickness="1" Margin="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.1" BlurRadius="10"/>
                    </Border.Effect>
                    <Grid Margin="10,0" Grid.Column="2">
                        <StackPanel MaxWidth="550">
                            <SEACC_WPFControls2:SEACC_LableTextBox Caption="Petty Cash Account" x:Name="txtPCAccNo" MouseDoubleClick="txtPCAccNo_MouseDoubleClick" />
                            <SEACC_WPFControls2:SEACC_LableTextBox Caption="User" x:Name="txtUser" MouseDoubleClick="txtUser_MouseDoubleClick"  />
                            <SEACC_WPFControls2:SEACC_LabelComboBox  Caption="Status" x:Name="cmbStatus" />
                            <SEACC_WPFControls2:SEACC_LabelTimeSelector Caption="From Date" x:Name="dtpFromDate" ShowDate="Visible" ShowTime="Hidden" Foreground="White" />
                            <SEACC_WPFControls2:SEACC_LabelTimeSelector Caption="To Date" x:Name="dtpToDate" ShowDate="Visible" ShowTime="Hidden" Foreground="White" />

                            <Grid Margin="0,10,0,0" >
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <SEACC_WPFControls2:SEACC_Button x:Name="btn_Print" Content="Generate" Height="30" Width="90" Click="btn_Print_Click" Background="#FF7E7777" Foreground="White" Margin="5"/>
                                    <SEACC_WPFControls2:SEACC_Button x:Name="btn_Clear" Content="Clear" Height="30" Width="90" Click="btn_Clear_Click" Background="#FF7E7777" Foreground="White" Margin="5"/>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>


</UserControl>
