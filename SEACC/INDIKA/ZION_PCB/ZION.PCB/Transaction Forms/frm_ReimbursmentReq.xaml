<Window x:Class="SEACC_PCB.frm_ReimbursmentReq"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SEACC_PCB"
          mc:Ignorable="d" AllowsTransparency="True" WindowStyle="None"
         xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PCB.UserControls" FontWeight="Normal"
        Title="frm_ReimbursmentRequest" Height="700" Width="938" WindowStartupLocation="CenterScreen" MaxHeight="680" MaxWidth="950" MouseDown="Window_MouseDown" Background="Transparent">

    <Grid Margin="10" Background="White">
        <Grid.Effect>
            <DropShadowEffect ShadowDepth="4" Opacity="0.6" BlurRadius="10" />
        </Grid.Effect>
        <Border BorderThickness="1"></Border>

        <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" >
            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Name="row0" Height="30" />
                    <RowDefinition Name="rowA" Height="80" />
                    <RowDefinition Name="rowB" Height="280" />
                    <RowDefinition Name="rowC" Height="200"/>
                    <RowDefinition Name="rowd" Height="*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0" Background="#FFF49F6D">
                    <StackPanel Orientation="Horizontal" >
                        <Label Content="Add Reimbursment Request" FontSize="14" Foreground="White" Height="28" Width="874" Margin="2,0,0,2" />
                        <Button x:Name="btnCloseTop" Content="&#xE894;" Height="25" Width="44" FontSize="14" HorizontalAlignment="Right" FontFamily="Segoe MDL2 Assets" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" Margin="0,2" RenderTransformOrigin="-1.556,0.4" Click="btnCloseTop_Click" d:LayoutOverrides="TopMargin, BottomMargin" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="10,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Name="colA" Width="420" />
                            <ColumnDefinition Name="colB" Width="253*" />
                            <ColumnDefinition Width="12*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemReq" Caption="Reimbursment Req.#" MouseDoubleClick="txtRemReq_MouseDoubleClick" />
                                    <Label Name="lblCancel" Content="Cancelled" FontSize="12" Foreground="Red" Height="25" Width="80" Margin="350,-30,0,0" />
                                    <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpToDate" Caption="Reimbursment To"  ShowDate="Visible" ShowTime="Hidden" />
                                </StackPanel>
                            </SEACC_WPFControls:SEACC_ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Row="2" Margin="10">
                    <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp="dgr_Main_MouseLeftButtonUp" MouseDown="dgr_Main_MouseDown"  />
                </Grid>
                <Grid Grid.Row="3" Margin="10, 10, 10, 0">
                    <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_DEntry" Margin="10" Background="#FFEEEEEE" HeaderColor="#FF727272" RowHeight="18" FontSize="10" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="80" Foreground="Black" CanUserResizeColumns="True" Grid.Row="3" >
                        <SEACC_WPFControls:SEACC_DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                        </SEACC_WPFControls:SEACC_DataGrid.Resources>
                        <SEACC_WPFControls:SEACC_DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </SEACC_WPFControls:SEACC_DataGrid.CellStyle>

                        <SEACC_WPFControls:SEACC_DataGrid.Columns>

                            <DataGridTextColumn Binding="{Binding No, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="No" Width="30"  IsReadOnly="True" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                        <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding AccountCode, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="Account Code" Width="120"  IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                        <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding AccountName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="Account Name" Width="150"  IsReadOnly="True" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                        <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Remarks, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="Remarks" Width="360"  IsReadOnly="True" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                        <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding DebitAmount, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="Debit Amount" Width="100"  IsReadOnly="True" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding CreditAmount, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="Credit Amount" Width="100"  IsReadOnly="True" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </SEACC_WPFControls:SEACC_DataGrid.Columns>
                    </SEACC_WPFControls:SEACC_DataGrid>
                </Grid>

                <Grid Grid.Row="4" Margin="10, 0">
                    <StackPanel Orientation="Horizontal" >
                        <Label Content="Count" FontSize="12" Height="28" Margin="2,0,0,2" />
                        <Label Content="0" Name="lblSelectedCount" FontSize="12" Height="28" Margin="2,0,0,2" />
                        <Label Content="/" FontSize="12" Height="28" Margin="2,0,0,2" />
                        <Label Content="0" Name="lblTotCount" FontSize="12" Height="28" Margin="2,0,0,2" />
                        <Label Content="---" Foreground="White" FontSize="12" Height="28" Margin="2,0,0,2" />
                        <Label Content="Amount" FontSize="12" Height="28" Margin="2,0,0,2" />
                        <Label Content="0" Name="lblSelectedAmnt" FontSize="12" Height="28" Margin="2,0,0,2" />
                        <Label Content="/" FontSize="12" Height="28" Margin="2,0,0,2" />
                        <Label Content="0" Name="lblTotAmount" FontSize="12" Height="28" Margin="2,0,0,2" />
                    </StackPanel>
                    <!--<StackPanel Orientation="Horizontal" >
                        <Label Content="Count" FontSize="14" Height="28" Margin="2,0,0,2" />
                        <Label Content="0" Name="c" FontSize="14" Height="28" Margin="2,0,0,2" />
                        <Label Content="/" FontSize="14" Height="28" Margin="2,0,0,2" />
                        <Label Content="0" FontSize="14" Height="28" Margin="2,0,0,2" />
                    </StackPanel>-->
                </Grid>
            </Grid>


        </SEACC_WPFControls_Local:SEACC_Form>
    </Grid>
</Window>
