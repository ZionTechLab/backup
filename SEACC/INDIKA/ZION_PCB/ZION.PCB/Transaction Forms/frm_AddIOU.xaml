<Window x:Class="SEACC_PCB.Transaction_Forms.frm_AddIOU"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SEACC_PCB.Transaction_Forms"
        xmlns:sys="clr-namespace:System;assembly=mscorlib" 
        mc:Ignorable="d" AllowsTransparency="True" WindowStyle="None"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PCB.UserControls" FontWeight="Normal"
        Title="frm_AddIOU" Height="450" Width="445" WindowStartupLocation="CenterScreen" BorderBrush="Black" BorderThickness="0,0,0,0" Background="Transparent" MaxHeight="450" MaxWidth="445" >

    <Grid x:Name="frm_IOU" Background="White"  Margin="10">
        <Grid.Effect>
            <DropShadowEffect ShadowDepth="4" Opacity="0.6" BlurRadius="10"/>
        </Grid.Effect>
        <Border BorderBrush="#FFF49F6D" BorderThickness="0" Background="White"></Border>
        <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form"   >

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Name="row0" Height="27" />
                    <RowDefinition Name="rowA" Height="130" />
                    <RowDefinition Name="rowB"  Height="200"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0" Background="#FFF49F6D" MouseDown="Grid_MouseDown">
                    <StackPanel Orientation="Horizontal" >
                        <Label Content="Add IOU" FontSize="14" Foreground="White" Height="25" Width="343" Margin="2,0,44,0" />
                        <Button x:Name="btnCloseTop" Content="&#xE894;" Height="25" Width="33" FontSize="14" HorizontalAlignment="Right" FontFamily="Segoe MDL2 Assets" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" Margin="0,1" Click="btnCloseTop_Click" RenderTransformOrigin="-1.556,0.4"/>
                    </StackPanel>
                </Grid>

                <Grid  Grid.Row="1" >
                    <Border BorderThickness="1" Margin="10,10" BorderBrush="#FFF49F6D" CornerRadius="2" Background="#FFF9F9F9">
                        <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto" >
                            <StackPanel  >
                                <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRequestID" Margin="0,5,0,0" Caption="Request ID" MouseDoubleClick="txtRequestID_MouseDoubleClick" />
                                <TextBlock  x:Name="lblDate" Width="120" Margin="10,0" HorizontalAlignment="Left">Date</TextBlock>
                                <TextBlock x:Name="lblRequestedBy" Width="120" Margin="10,0" HorizontalAlignment="Left">Requested By</TextBlock>
                                <TextBlock x:Name="lblAmount" Width="120" Margin="10,0" HorizontalAlignment="Left">Amount</TextBlock>
                                <TextBlock x:Name="lblRemarks" Width="120" Margin="10,0" HorizontalAlignment="Left">Remarks</TextBlock>
                                <TextBlock x:Name="lblDateVal" Width="250" Margin="125,-64">2017/10/15</TextBlock>
                                <TextBlock x:Name="lblRequestedByVal" Width="250" Margin="125,-48">Abc</TextBlock>
                                <TextBlock x:Name="lblAmountVal" Width="250" Margin="125,-32">1500.00</TextBlock>
                                <TextBlock x:Name="lblRemarksVal" Width="250" Margin="125,-16,0,5">Asad......</TextBlock>
                            </StackPanel>
                        </SEACC_WPFControls:SEACC_ScrollViewer>
                    </Border>
                </Grid>

                <Grid  Grid.Row="2" Margin="10,0">
                    <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtIOUID" Caption="IOU ID" MouseDoubleClick="txtIOUID_MouseDoubleClick"  />
                            <Label Name="lblCancel" Content="Cancelled" FontSize="12" Foreground="Red" Height="25" Width="70" Margin="345,-30,0,0" />
                            <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpIOUDate" Caption="IOU Date"  ShowDate="Visible" ShowTime="Hidden" />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAmount" Caption="Amount"  />
                            <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemarks" Caption="Remarks"  />
                        </StackPanel>
                    </SEACC_WPFControls:SEACC_ScrollViewer>
                </Grid>

            </Grid>
        </SEACC_WPFControls_Local:SEACC_Form>
    </Grid>

</Window>
