<Window x:Class="SEACC_PCB.Transaction_Forms.frm_IOURefund"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SEACC_PCB.Transaction_Forms"
        xmlns:sys="clr-namespace:System;assembly=mscorlib" 
        mc:Ignorable="d" AllowsTransparency="True" WindowStyle="None"
        xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
        xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PCB.UserControls" FontWeight="Normal"
        Title="frm_IOURefund" Height="450" Width="450" WindowStartupLocation="CenterScreen" Background="Transparent">

    <Grid x:Name="frm_Exp"  Background="White" Margin="10">
        <Grid.Effect>
            <DropShadowEffect ShadowDepth="4" Opacity="0.6" BlurRadius="10" />
        </Grid.Effect>
        
        <Border BorderThickness="1"></Border>
        <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Name="row0" Height="30" />
                    <RowDefinition Name="rowA" Height="170" />
                    <RowDefinition Name="rowB" Height="30" />
                    <RowDefinition Name="rowC" Height="140" />
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0" Background="#FFF49F6D" MouseDown="Grid_MouseDown">
                    <StackPanel Orientation="Horizontal" >
                        <Label Content="IOU Refund" FontSize="14" Foreground="White" Height="28" Width="395" Margin="2,0,0,0" />
                        <Button x:Name="btnCloseTop" Content="&#xE894;" Height="25" Width="33" FontSize="14" HorizontalAlignment="Right" FontFamily="Segoe MDL2 Assets" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" Margin="0,0" Click="btnCloseTop_Click" RenderTransformOrigin="-1.556,0.4"/>
                    </StackPanel>
                </Grid>
                <Grid  Grid.Row="1" Margin="10,10">
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRefundID" Caption="Refund ID" MouseDoubleClick="txtRefundID_MouseDoubleClick"   />
                        <Label Name="lblCancel" Content="Cancelled" FontSize="12" Foreground="Red" Height="25" Width="70" Margin="345,-30,0,0" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpRefundDate" Caption="Refund Date"  ShowDate="Visible" ShowTime="Hidden"  />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtUser" Caption="User" MouseDoubleClick="txtUser_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemarks" Caption="Remarks" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAmount" Caption="Amount" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="10,0">
                    <Label Foreground="#FF515151" FontSize="16" Visibility="Collapsed" >
                        <TextBlock TextDecorations="Underline">IOU Settlement</TextBlock>
                    </Label>
                    <StackPanel  Orientation="Horizontal"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="5,0,0,5"   Height="20" >
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridDelete" Content="&#xE10A;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,0,0"  Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" FlowDirection="RightToLeft" Click="btnGridDelete_Click" />
                        <Label></Label>
                        <SEACC_WPFControls:SEACC_Button x:Name="btnGridAddd" Content="&#xE109;" Width="30" FontFamily="Segoe MDL2 Assets" Margin="0,0,0,0"  Foreground="#FFE2E2E2" Background="#FF727272" BorderBrush="{x:Null}" Click="btnGridAdd_Click" FlowDirection="RightToLeft" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" Margin="10,0">

                    <SEACC_WPFControls:SEACC_DataGrid x:Name="dgr_IOURefund" Margin="0,0,0,-8" Background="White" HeaderColor="#FF727272" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="80" Foreground="Black" CanUserResizeColumns="True" MouseLeftButtonUp="dgr_IOURefund_MouseLeftButtonUp"  >
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"  Color="#FFF4E7A7"/>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding IOUNo ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="IOU #" Width="80"  IsReadOnly="True" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                        <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Amnt ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="IOU Amount" Width="110"  IsReadOnly="True" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding UnSetAmnt ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="Unsettled Amount" Width="110"  IsReadOnly="True" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding AlloAmnt ,Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" Foreground="Black"   Header="Allocated Amount" Width="110"  IsReadOnly="True" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </SEACC_WPFControls:SEACC_DataGrid>
                </Grid>
                
            </Grid>
        </SEACC_WPFControls_Local:SEACC_Form>
    </Grid>

</Window>
