<UserControl x:Class="SEACC_PCB.UC_IOURequest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SEACC_PCB"
             mc:Ignorable="d" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PCB.UserControls" Background="#FFFFFF" FontWeight="Normal">

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" PreviewKeyDown="SEACC_Form_PreviewKeyDown" >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Margin="0,0,5,0" Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" />
            <GridSplitter Background="#D5D5D5"  Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto" >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtReqID" Caption="IOU Request ID" MouseDoubleClick="txtReqID_MouseDoubleClick" />
                        <Label Name="lblCancel" Content="Cancelled" FontSize="12" Foreground="Red" Height="25" Width="100" Margin="100,-30,0,0" />
                        <SEACC_WPFControls:SEACC_LabelTimeSelector x:Name="dtpReq_Date" Caption="Requested Date"  ShowDate="Visible" ShowTime="Hidden" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRequestedBy" Caption="Requested By" MouseDoubleClick="txtRequestedBy_MouseDoubleClick"  />                        
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemarks" Caption="Remarks" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtAmount" Caption="Amount" />
                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>

</UserControl>
