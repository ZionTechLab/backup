<UserControl x:Class="ZION.PCB.UC_AccountCreation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZION.PCB"
             mc:Ignorable="d" 
             xmlns:SEACC_WPFControls="clr-namespace:SEACC_WPFControls;assembly=SEACC_WPFControls" 
             xmlns:SEACC_WPFControls_Local="clr-namespace:SEACC_PCB.UserControls" Background="#FFFFFF" FontWeight="Normal">

    <SEACC_WPFControls_Local:SEACC_Form x:Name="SEACC_Form" SizeChanged="SEACC_Form_SizeChanged" PreviewKeyDown="SEACC_Form_PreviewKeyDown" >
        <Grid Margin="15,10,0,50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="coloumnA" Width="472" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <SEACC_WPFControls:SEACC_DataGrid_Advanced x:Name="dgr_Main" Margin="0,0,5,0" Background="#FF515151" HeaderColor="#FFF49F6D" MouseLeftButtonUp1="dgr_Main_MouseLeftButtonUp1" />
            <GridSplitter Background="#D5D5D5"  Grid.Column="1" Width="5" HorizontalAlignment="Stretch"  Margin="0,1,0,-1" />
            <Grid  Grid.Column="2" Margin="10,0">
                <SEACC_WPFControls:SEACC_ScrollViewer VerticalScrollBarVisibility="Auto" >
                    <StackPanel>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPCAccountCode" Caption="PC Acount Code" MouseDoubleClick="txtPCAccountCode_MouseDoubleClick"  />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtPCAcountName" Caption="PC Acount Name" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtUser" Caption="User" MouseDoubleClick="txtUser_MouseDoubleClick"  />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtCurrency" Caption="Currency" MouseDoubleClick="txtCurrency_MouseDoubleClick" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtFloatAmount" Caption="Float Amount" />
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtRemarks" Caption="Remarks" />
                        <Label></Label>
                        <Label Foreground="#FF515151" FontSize="16" Visibility="Visible" >
                            <TextBlock TextDecorations="Underline">Accounts Configuration</TextBlock>
                        </Label>
                        <SEACC_WPFControls:SEACC_LableTextBox x:Name="txtMainAcount" Caption="PCB Ledger Acount" MouseDoubleClick="txtMainAcount_MouseDoubleClick"  />

                    </StackPanel>
                </SEACC_WPFControls:SEACC_ScrollViewer>
            </Grid>
        </Grid>
    </SEACC_WPFControls_Local:SEACC_Form>

</UserControl>
