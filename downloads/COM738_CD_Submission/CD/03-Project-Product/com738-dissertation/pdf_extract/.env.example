# COM738 Dissertation - PDF Extract Environment Variables (Example)
# Copy this file to .env and fill in actual values
# This file is git-ignored, so sensitive values are safe

# LLM Configuration (Local or API)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=no-key-needed
LLM_MODEL=9router-Gemini

# Optional: For API-based LLMs
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxx
# LLM_MODEL=deepseek-chat

# Optional: For OpenAI API
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxx
# LLM_MODEL=gpt-4o

# Optional: Debug mode
# DEBUG=true
